rationale\":\"Directly stated in both sources.\"},\n{\"claim_id\":\"M-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wipe the badge with the cleaning cloth kept in the top drawer\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"M-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"put it back in the return tray.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated as following the wiping step.\"},\n{\"claim_id\":\"M-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Badges in the return tray are re-used the same day.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in both sources.\"},\n{\"claim_id\":\"M-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Mark the visitor's line on the expected-visitor list with an N.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"M-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"At the end of\\nthe day, send the list of unreturned badges to the security office.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"M-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Badges that\\nhave been missing for 7 days are deactivated.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in both sources.\"},\n{\"claim_id\":\"M-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A badge handed in after it was reported missing goes to the security office\\nrather than back into the return tray.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly stated in source_b.\"},\n{\"claim_id\":\"M-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The security office decides whether to\\nreactivate it.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly stated in source_b.\"},\n{\"claim_id\":\"M-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Contractors on a job lasting more than one day are issued a week badge instead\\nof a day badge.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A week badge is valid for 7 days from the date printed on it.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Contractors sign the contractor register in addition to the visitor list.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"}\n]}","ttft_ms":9907,"type":"result","duration_ms":9942,"uuid":"78da422c-e7df-478a-bbce-d3bbb70ed818","ttft_stream_ms":2022,"time_to_request_ms":109,"first_content_frame_ms":2023,"queued_turn_count":0,"result_index":0}
