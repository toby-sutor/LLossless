{"duration_api_ms":81267,"stop_reason":"end_turn","session_id":"0b0d1c98-e7aa-469f-b4f6-4869a4c0dfdc","total_cost_usd":0.63650875,"usage":{"input_tokens":2,"cache_creation_input_tokens":8561,"cache_read_input_tokens":2075,"output_tokens":9295,"output_tokens_details":{"thinking_tokens":2955},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":8561,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":9295,"cache_read_input_tokens":2075,"cache_creation_input_tokens":8561,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8561},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-fable-5-1":{"inputTokens":2,"outputTokens":9295,"cacheReadInputTokens":2075,"cacheCreationInputTokens":8561,"webSearchRequests":0,"costUSD":0.63650875,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":2955,"canonicalModel":"claude-fable-5-1","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"verdicts\":[{\"claim_id\":\"M-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Author: Priya Raghunathan\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A carries this title and names Priya Raghunathan as its author.\"},{\"claim_id\":\"M-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Updated: 2026-03-18\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A, which carries this title, gives this update date.\"},{\"claim_id\":\"M-003\",\"verdict\":\"PARTIAL\",\"evidence\":\"Author: Devin Okonkwo\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Devin Okonkwo is named as an author, but of the differently titled source B document, not of the document with this title.\"},{\"claim_id\":\"M-004\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"Updated: 2026-03-18\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The document with this title was updated 2026-03-18; the date 2026-04-11 belongs to the differently titled source B document.\"},{\"claim_id\":\"M-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Append requests to Nimbrel Ledger come back with HTTP 429 `Too Many Requests`\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nimbrel Relay stalls\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A lists the Relay stalling as a symptom of the refusal.\"},{\"claim_id\":\"M-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"batch loaders resend the same envelope\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A lists this as a symptom of the refusal.\"},{\"claim_id\":\"M-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"reads against the same shard begin to time out\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A lists this as a symptom of the refusal.\"},{\"claim_id\":\"M-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The refusal reaches the client\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"is written to the Relay and Collector logs as well\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the refusal is written to these logs.\"},{\"claim_id\":\"M-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"whose share of HTTP `429` replies climbed over a fortnight, as counted at the front proxy\",\"evidence_source\":\"source_b.md\",\"rationale\":\"The claim generalises source B's account of the managed deployment's climbing 429 share.\"},{\"claim_id\":\"M-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The managed deployment returns HTTP `429` on a growing share of requests, which is what the Ledger does when it refuses work rather than queueing it\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this in near-identical words.\"},{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Front proxy counters agree with the client reports\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this directly.\"},{\"claim_id\":\"M-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"so the refusals are real and not a client-side accounting error\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this directly.\"},{\"claim_id\":\"M-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"append batch refused after 0 of 64 envelopes\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The example envelope in source A begins with this text.\"},{\"claim_id\":\"M-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"\\\"type\\\":\\\"nbl_queue_refused_exception\\\"\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The example envelope gives this error type.\"},{\"claim_id\":\"M-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"refused append on ingest path\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The example envelope gives this reason.\"},{\"claim_id\":\"M-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ingest_and_leader_bytes=88121344\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The value appears in the example envelope.\"},{\"claim_id\":\"M-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"follower_bytes=212992\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The value appears in the example envelope.\"},{\"claim_id\":\"M-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"all_bytes=88334336\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The value appears in the example envelope.\"},{\"claim_id\":\"M-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ingest_op_bytes=155648\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The value appears in the example envelope.\"},{\"claim_id\":\"M-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"max_ingest_bytes=88080384\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The value appears in the example envelope.\"},{\"claim_id\":\"M-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"\\\"status\\\":429\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The example envelope ends with status 429.\"},{\"claim_id\":\"M-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The Ledger operations handbook now covers the same ground under Refused Appends\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The note in source A states this.\"},{\"claim_id\":\"M-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"with a walkthrough for each of the three refusal paths set out below\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The note in source A states this.\"},{\"claim_id\":\"M-026\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Every Nimbrel Ledger release on every platform can refuse an append this way.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A's Environment section states this, where 'this way' refers to the HTTP 429 refusal.\"},{\"claim_id\":\"M-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Product: Nimbrel Ledger\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B's environment lists this product.\"},{\"claim_id\":\"M-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Version: 4.4, 5.x\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B's environment lists these versions.\"},{\"claim_id\":\"M-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Platform: Nimbrel Cloud\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B's environment lists this platform.\"},{\"claim_id\":\"M-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Deployment: Managed Ledger Service (MLS)\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B's environment lists this deployment type.\"},{\"claim_id\":\"M-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Production Environment: Yes\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B's environment marks it as production.\"},{\"claim_id\":\"M-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"is what a Ledger node sends once it has nowhere left to put the work\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A's Cause section states this.\"},{\"claim_id\":\"M-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"an append queue or a read queue is full\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A equates the 429 reply with a full append or read queue.\"},{\"claim_id\":\"M-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"There are 3 ways an append draws a 429\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The `append` or `system_append` worker pools hold more batches than they have slots for\",\"evidence_source\":\"source_a.md\",\"rationale\":\"This is the first of the three listed ways.\"},{\"claim_id\":\"M-036\",\"verdict\":\"SUPPORTED\",\"evidence\":\"(`nbctl pool status --all`)\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A attaches this command to the worker pool cause as the way to check it.\"},{\"claim_id\":\"M-037\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The ingest memory guard has refused the batch\",\"evidence_source\":\"source_a.md\",\"rationale\":\"This is the second of the three listed ways.\"},{\"claim_id\":\"M-038\",\"verdict\":\"SUPPORTED\",\"evidence\":\"(`nbctl guard report ingest --counters`)\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A attaches this command to the ingest memory guard cause.\"},{\"claim_id\":\"M-039\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A circuit breaker has tripped\",\"evidence_source\":\"source_a.md\",\"rationale\":\"This is the third of the three listed ways.\"},{\"claim_id\":\"M-040\",\"verdict\":\"SUPPORTED\",\"evidence\":\"(`nbctl breaker list --tripped`)\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A attaches this command to the tripped circuit breaker cause.\"},{\"claim_id\":\"M-041\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a breaker trips on any operation and is not particular to appends\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-042\",\"verdict\":\"SUPPORTED\",\"evidence\":\"appending to a `wide_text` column draws a 429 on its own account whenever the batch would otherwise have run the node out of memory\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Footnote 1 in source A states this for release 4.6 and release 5.1 onward.\"},{\"claim_id\":\"M-043\",\"verdict\":\"SUPPORTED\",\"evidence\":\"what the evidence pointed at, which was expensive queries and deep grouping\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B's summary states this.\"},{\"claim_id\":\"M-044\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a handful of queries run for as long as 2 seconds each\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this directly.\"},{\"claim_id\":\"M-045\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A worker slot is unavailable for as long as one of them holds it\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this of the expensive queries.\"},{\"claim_id\":\"M-046\",\"verdict\":\"SUPPORTED\",\"evidence\":\"and the queue behind it grows\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the queue behind the held slot grows.\"},{\"claim_id\":\"M-047\",\"verdict\":\"SUPPORTED\",\"evidence\":\"grouping on `channel.id` yields a very large number of groups\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this directly.\"},{\"claim_id\":\"M-048\",\"verdict\":\"SUPPORTED\",\"evidence\":\"the memory that costs is charged to the same pool the append path draws on\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this directly.\"},{\"claim_id\":\"M-049\",\"verdict\":\"SUPPORTED\",\"evidence\":\"processor load looks unremarkable while memory sits high\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this directly.\"},{\"claim_id\":\"M-050\",\"verdict\":\"SUPPORTED\",\"evidence\":\"which points at query cost rather than at an undersized cluster\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B draws this conclusion from the disagreement between processor load and memory.\"},{\"claim_id\":\"M-051\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Take append and query load off the cluster for long enough that the queues drain and the nodes fall back under their limits.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A's Workaround section states this.\"},{\"claim_id\":\"M-052\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Where batches carry `wide_text` columns and the cluster runs release 4.6 or release 5.1 or later, send fewer envelopes per batch.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A's Workaround section states this.\"},{\"claim_id\":\"M-053\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A cluster that refuses appends has been given more work than its hardware can carry\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A's Resolution section states this.\"},{\"claim_id\":\"M-054\",\"verdict\":\"SUPPORTED\",\"evidence\":\"so the answer is hardware: larger nodes (scale up), or more of them (scale out)\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A's Resolution section states this.\"},{\"claim_id\":\"M-055\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Scale up first in most cases\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this and attributes it to the sizing notes.\"},{\"claim_id\":\"M-056\",\"verdict\":\"SUPPORTED\",\"evidence\":\"scale out when what is wanted is a further copy of the data for availability\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this and attributes it to the sizing notes.\"},{\"claim_id\":\"M-057\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Splitting a hot stream over more leader shards spreads append load across more nodes\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-058\",\"verdict\":\"SUPPORTED\",\"evidence\":\"which helps in some layouts\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this of splitting a hot stream over more leader shards.\"},{\"claim_id\":\"M-059\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Begin by cutting the number of envelopes in each append batch.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"This is step 1 of source A's wide_text list.\"},{\"claim_id\":\"M-060\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Where smaller batches do not clear it, add processor and memory capacity to the nodes.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"This is step 2 of source A's wide_text list.\"},{\"claim_id\":\"M-061\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Only then raise the `ingest_guard.memory.leader.ceiling` cluster setting\",\"evidence_source\":\"source_a.md\",\"rationale\":\"This is step 3 of the list, to be taken only after the first two steps.\"},{\"claim_id\":\"M-062\",\"verdict\":\"SUPPORTED\",\"evidence\":\"which defaults to 10% of the heap\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A gives this default for the setting.\"},{\"claim_id\":\"M-063\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A higher ceiling lets a node hold more in-flight append memory before refusing\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-064\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a node holding too much runs out of memory instead of refusing\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-065\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The setting is read at startup\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-066\",\"verdict\":\"SUPPORTED\",\"evidence\":\"so the cluster must be restarted for a change to take\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-067\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Where none of that is open to you, the load itself is what changes: fewer appends, cheaper queries, or both.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"'None of that' refers to the scaling and setting changes described just before it.\"},{\"claim_id\":\"M-068\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Refusals that show up only during a spike usually clear on their own once the queues drain.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-069\",\"verdict\":\"SUPPORTED\",\"evidence\":\"**Lower the slow query threshold**: set it to 1 second\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B lists this as a proposed action.\"},{\"claim_id\":\"M-070\",\"verdict\":\"SUPPORTED\",\"evidence\":\"so that the queries actually responsible are recorded instead of averaged away\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B gives this as the purpose of the 1 second threshold.\"},{\"claim_id\":\"M-071\",\"verdict\":\"SUPPORTED\",\"evidence\":\"go through the expensive ones with the team that wrote them\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B lists this as a proposed action.\"},{\"claim_id\":\"M-072\",\"verdict\":\"SUPPORTED\",\"evidence\":\"several of which look like they could ask for less\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this of the expensive queries.\"},{\"claim_id\":\"M-073\",\"verdict\":\"SUPPORTED\",\"evidence\":\"while the refusal rate is high, take a thread dump and a heap snapshot\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B lists this as a proposed action.\"},{\"claim_id\":\"M-074\",\"verdict\":\"SUPPORTED\",\"evidence\":\"[Internal ticket NB-40917](https://tickets.nimbrel.example/issues/40917)\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B's references give this link for the ticket.\"},{\"claim_id\":\"M-075\",\"verdict\":\"SUPPORTED\",\"evidence\":\"[Ledger slow query log](https://docs.nimbrel.example/ledger/slow-query-log)\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B's references give this link.\"},{\"claim_id\":\"M-076\",\"verdict\":\"SUPPORTED\",\"evidence\":\"[HTTP 429 replies](https://support.nimbrel.example/knowledge/318kqp2)\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B's references give this link.\"}]}","ttft_ms":29844,"type":"result","duration_ms":81334,"uuid":"318aad43-e129-476d-9d28-5dc28ba426a9","ttft_stream_ms":1996,"time_to_request_ms":116,"first_content_frame_ms":1997,"queued_turn_count":0,"result_index":0}
