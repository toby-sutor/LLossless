rectly.\"},{\"claim_id\":\"B-055\",\"verdict\":\"SUPPORTED\",\"evidence\":\"An assertion that the current cap is too small is not enough\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states an assertion alone is not enough to raise a cap.\"}]}","ttft_ms":33958,"type":"result","duration_ms":101231,"uuid":"ed963e9e-58d4-4e3b-bdc0-db2dbbf2022e","ttft_stream_ms":4002,"time_to_request_ms":1874,"first_content_frame_ms":4002,"queued_turn_count":0,"result_index":0}
