{"duration_api_ms":45678,"stop_reason":"end_turn","session_id":"38092cc7-c46d-4bd5-9b11-0004a4cb790a","total_cost_usd":0.3434487500000001,"usage":{"input_tokens":2,"cache_creation_input_tokens":3618,"cache_read_input_tokens":2075,"output_tokens":5411,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3618,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":5411,"cache_read_input_tokens":2075,"cache_creation_input_tokens":3618,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3618},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-fable-5-1":{"inputTokens":2,"outputTokens":5411,"cacheReadInputTokens":2075,"cacheCreationInputTokens":3618,"webSearchRequests":0,"costUSD":0.3434487500000001,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":0,"canonicalModel":"claude-fable-5-1","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"claims\":[{\"text\":\"Every credential has a cap.\",\"line\":3,\"span\":\"Every credential has a cap.\"},{\"text\":\"When a credential's cap is spent the gateway answers 429 at the edge.\",\"line\":3,\"span\":\"When that cap is spent the gateway answers 429 at the edge — without waking the service behind it — so the refusal costs the platform almost nothing and costs a caller that files it under transport error a great deal.\"},{\"text\":\"The gateway answers 429 without waking the service behind it.\",\"line\":3,\"span\":\"When that cap is spent the gateway answers 429 at the edge — without waking the service behind it — so the refusal costs the platform almost nothing and costs a caller that files it under transport error a great deal.\"},{\"text\":\"An earlier draft of the note argued for a client-side token bucket that mirrored the gateway's own counters.\",\"line\":3,\"span\":\"An earlier draft of this note argued for a client-side token bucket that mirrored the gateway’s own counters, and that section has been left out on purpose — two counters that disagree are worse than one counter that refuses, which is the whole reason the header exists.\"},{\"text\":\"Requests are counted against the credential that presented them.\",\"line\":5,\"span\":\"Requests are counted against the credential that presented them, over a fixed window of 60 seconds whose start the gateway doesn’t disclose, and never against a connection.\"},{\"text\":\"Requests are counted over a fixed window of 60 seconds.\",\"line\":5,\"span\":\"Requests are counted against the credential that presented them, over a fixed window of 60 seconds whose start the gateway doesn’t disclose, and never against a connection.\"},{\"text\":\"The gateway doesn't disclose the start of the counting window.\",\"line\":5,\"span\":\"Requests are counted against the credential that presented them, over a fixed window of 60 seconds whose start the gateway doesn’t disclose, and never against a connection.\"},{\"text\":\"Requests are never counted against a connection.\",\"line\":5,\"span\":\"Requests are counted against the credential that presented them, over a fixed window of 60 seconds whose start the gateway doesn’t disclose, and never against a connection.\"},{\"text\":\"Opening a second socket buys a caller nothing with respect to the rate limit.\",\"line\":5,\"span\":\"Opening a second socket therefore buys a caller nothing.\"},{\"text\":\"The request count follows the credential across hosts.\",\"line\":5,\"span\":\"The count follows the credential wherever the caller happens to put it, including across hosts.\"},{\"text\":\"A client spread across eight worker processes is throttled at exactly the point one process would have been.\",\"line\":5,\"span\":\"A client spread across eight worker processes is throttled at exactly the point one process would have been — and pays for the extra file descriptors as well.\"},{\"text\":\"The default allowance is 100 requests in a window.\",\"line\":7,\"span\":\"The default allowance is 100 requests in a window, and a credential marked for batch work is allowed 1000 in the same window.\"},{\"text\":\"A credential marked for batch work is allowed 1000 requests in the same window as the default allowance.\",\"line\":7,\"span\":\"The default allowance is 100 requests in a window, and a credential marked for batch work is allowed 1000 in the same window.\"},{\"text\":\"The default allowance is enough for every interactive use of the API the platform team has seen.\",\"line\":7,\"span\":\"The default is enough for every interactive use of this API the platform team has seen, and a caller that needs more than that is almost always doing batch work under an interactive credential.\"},{\"text\":\"A caller that needs more than the default allowance is almost always doing batch work under an interactive credential.\",\"line\":7,\"span\":\"The default is enough for every interactive use of this API the platform team has seen, and a caller that needs more than that is almost always doing batch work under an interactive credential.\"},{\"text\":\"Callers that retry at once are the largest single reason the cap is there.\",\"line\":7,\"span\":\"Callers that retry at once are the largest single reason the cap is there at all.\"},{\"text\":\"The refusal carries a Retry-After header.\",\"line\":11,\"span\":\"The refusal carries a Retry-After header.\"},{\"text\":\"The Retry-After header value is a whole number of seconds to wait.\",\"line\":11,\"span\":\"Its value is a whole number of seconds to wait, and it is present on every refusal the gateway sends.\"},{\"text\":\"The Retry-After header is present on every refusal the gateway sends.\",\"line\":11,\"span\":\"Its value is a whole number of seconds to wait, and it is present on every refusal the gateway sends.\"},{\"text\":\"The gateway keeps no memory of who backed off politely.\",\"line\":11,\"span\":\"The gateway keeps no memory of who backed off politely, so waiting longer than the header asks earns a caller no credit at all.\"},{\"text\":\"Waiting longer than the Retry-After header asks earns a caller no credit.\",\"line\":11,\"span\":\"The gateway keeps no memory of who backed off politely, so waiting longer than the header asks earns a caller no credit at all.\"},{\"text\":\"The body of the refusal is JSON.\",\"line\":13,\"span\":\"The body of the refusal is JSON, and it names what the gateway calls the “window” it counted in.\"},{\"text\":\"The body of the refusal names what the gateway calls the \\\"window\\\" it counted in.\",\"line\":13,\"span\":\"The body of the refusal is JSON, and it names what the gateway calls the “window” it counted in.\"},{\"text\":\"The body of the refusal names the cap and the tier as plain fields.\",\"line\":13,\"span\":\"It names the cap and the tier as well, all as plain fields.\"},{\"text\":\"The refusal body is there so that a human reading a log afterwards can see why the request was refused.\",\"line\":13,\"span\":\"The body is there so that a human reading a log afterwards can see why the request was refused — nothing in it is meant for the retry loop.\"},{\"text\":\"Nothing in the refusal body is meant for the retry loop.\",\"line\":13,\"span\":\"The body is there so that a human reading a log afterwards can see why the request was refused — nothing in it is meant for the retry loop.\"},{\"text\":\"There are four rules for retrying, given in the order they should be applied.\",\"line\":17,\"span\":\"Four rules, given in the order they should be applied.\"},{\"text\":\"The gateway computes the wait with information the caller does not have.\",\"line\":19,\"span\":\"The gateway has already done that arithmetic, with information the caller does not have, and it does the same on the 503 path, even though the cause of the refusal there is an entirely different one.\"},{\"text\":\"The gateway also provides the computed wait on the 503 path.\",\"line\":19,\"span\":\"The gateway has already done that arithmetic, with information the caller does not have, and it does the same on the 503 path, even though the cause of the refusal there is an entirely different one.\"},{\"text\":\"The cause of the refusal on the 503 path is an entirely different one from the 429 refusal.\",\"line\":19,\"span\":\"The gateway has already done that arithmetic, with information the caller does not have, and it does the same on the 503 path, even though the cause of the refusal there is an entirely different one.\"},{\"text\":\"The client cannot see the gateway's counter.\",\"line\":19,\"span\":\"A wait derived on the client side is a guess about a counter it cannot see.\"},{\"text\":\"The set of responses that are safe to retry is smaller than the set of responses that aren't a success.\",\"line\":21,\"span\":\"Retry only what is safe to retry, which is a smaller set than the set of responses that aren’t a success.\"},{\"text\":\"A 200 needs nothing.\",\"line\":21,\"span\":\"A 200 needs nothing, a 429 needs the stated wait, a 500 can be retried once that wait has passed, and a 503 means the platform itself is overloaded.\"},{\"text\":\"A 429 needs the stated wait.\",\"line\":21,\"span\":\"A 200 needs nothing, a 429 needs the stated wait, a 500 can be retried once that wait has passed, and a 503 means the platform itself is overloaded.\"},{\"text\":\"A 500 can be retried once the stated wait has passed.\",\"line\":21,\"span\":\"A 200 needs nothing, a 429 needs the stated wait, a 500 can be retried once that wait has passed, and a 503 means the platform itself is overloaded.\"},{\"text\":\"A 503 means the platform itself is overloaded.\",\"line\":21,\"span\":\"A 200 needs nothing, a 429 needs the stated wait, a 500 can be retried once that wait has passed, and a 503 means the platform itself is overloaded.\"},{\"text\":\"A client that folds every non-success into one branch will retry hardest during exactly the incident the cap was installed to survive.\",\"line\":21,\"span\":\"A client that folds every non-success into one branch will retry hardest during exactly the incident the cap was installed to survive.\"},{\"text\":\"A batch credential is allowed 1000 requests in a window.\",\"line\":23,\"span\":\"A batch credential is allowed 1000 requests in a window, which is 50 times the default and not a separate counting scheme, and it is measured over exactly the same window.\"},{\"text\":\"The batch allowance of 1000 requests in a window is 50 times the default.\",\"line\":23,\"span\":\"A batch credential is allowed 1000 requests in a window, which is 50 times the default and not a separate counting scheme, and it is measured over exactly the same window.\"},{\"text\":\"The batch allowance is not a separate counting scheme.\",\"line\":23,\"span\":\"A batch credential is allowed 1000 requests in a window, which is 50 times the default and not a separate counting scheme, and it is measured over exactly the same window.\"},{\"text\":\"The batch allowance is measured over exactly the same window as the default.\",\"line\":23,\"span\":\"A batch credential is allowed 1000 requests in a window, which is 50 times the default and not a separate counting scheme, and it is measured over exactly the same window.\"},{\"text\":\"The tier is set on the credential when the credential is issued.\",\"line\":23,\"span\":\"The tier is set on the credential when it is issued and cannot be asked for per call.\"},{\"text\":\"The tier cannot be asked for per call.\",\"line\":23,\"span\":\"The tier is set on the credential when it is issued and cannot be asked for per call.\"},{\"text\":\"The window, the header and the body for the batch tier are identical to the interactive case.\",\"line\":23,\"span\":\"The window, the header and the body are identical to the interactive case, so a client written for one tier needs no change at all to run against the other.\"},{\"text\":\"A client written for one tier needs no change to run against the other tier.\",\"line\":23,\"span\":\"The window, the header and the body are identical to the interactive case, so a client written for one tier needs no change at all to run against the other.\"},{\"text\":\"Nothing other than the allowance differs between the two tiers.\",\"line\":23,\"span\":\"Nothing else about the two tiers differs in any way.\"},{\"text\":\"Callers should log every refusal seen and keep the log for at least a week.\",\"line\":25,\"span\":\"Log every refusal seen, and keep the log for at least a week.\"},{\"text\":\"Nobody at the platform end will assemble the argument for a larger cap on a caller's behalf.\",\"line\":25,\"span\":\"A caller that cannot say how often it was refused last week cannot argue for a larger cap, and nobody at the far end will assemble that argument on its behalf.\"},{\"text\":\"The refusal log line should carry the credential, the window and the wait.\",\"line\":25,\"span\":\"The log line should carry the credential, the window and the wait.\"},{\"text\":\"The gateway refuses a request for three reasons and only one of them is the cap.\",\"line\":29,\"span\":\"The gateway refuses a request for three reasons and only one of them is the one above.\"},{\"text\":\"Two of the three refusal reasons have nothing to do with how much traffic a caller has sent in the window it is currently in.\",\"line\":29,\"span\":\"Two of the three have nothing to do with how much traffic a caller has sent in the window it is currently in.\"},{\"text\":\"A credential may be suspended.\",\"line\":29,\"span\":\"A credential may be suspended, a route may be closed for maintenance, or a body may exceed the 5 megabyte limit, in which case it is refused before it has been read at all.\"},{\"text\":\"A route may be closed for maintenance.\",\"line\":29,\"span\":\"A credential may be suspended, a route may be closed for maintenance, or a body may exceed the 5 megabyte limit, in which case it is refused before it has been read at all.\"},{\"text\":\"The request body limit is 5 megabyte.\",\"line\":29,\"span\":\"A credential may be suspended, a route may be closed for maintenance, or a body may exceed the 5 megabyte limit, in which case it is refused before it has been read at all.\"},{\"text\":\"A body that exceeds the 5 megabyte limit is refused before it has been read at all.\",\"line\":29,\"span\":\"A credential may be suspended, a route may be closed for maintenance, or a body may exceed the 5 megabyte limit, in which case it is refused before it has been read at all.\"},{\"text\":\"None of a suspended credential, a route closed for maintenance, or an oversized body clears itself by waiting for a stated number of seconds.\",\"line\":29,\"span\":\"None of those three clears itself by waiting for a stated number of seconds.\"},{\"text\":\"A loop that waits and retries against a suspended credential spends its whole budget without ever reaching the service.\",\"line\":31,\"span\":\"A loop that waits and retries against a suspended credential spends its whole budget without ever reaching the service — and the log afterwards shows nothing at all except a long run of refusals.\"},{\"text\":\"After a loop retries against a suspended credential, the log shows nothing except a long run of refusals.\",\"line\":31,\"span\":\"A loop that waits and retries against a suspended credential spends its whole budget without ever reaching the service — and the log afterwards shows nothing at all except a long run of refusals.\"},{\"text\":\"Reading the status code rather than the class it belongs to costs one comparison.\",\"line\":31,\"span\":\"Reading the status code rather than the class it belongs to is what separates the two cases, and it costs one comparison.\"},{\"text\":\"A cap can be raised.\",\"line\":35,\"span\":\"A cap can be raised, and the number of caps raised without a measurement behind them is 0.\"},{\"text\":\"The number of caps raised without a measurement behind them is 0.\",\"line\":35,\"span\":\"A cap can be raised, and the number of caps raised without a measurement behind them is 0.\"},{\"text\":\"An assertion that the current cap is too small is not enough to get a cap raised.\",\"line\":35,\"span\":\"An assertion that the current cap is too small is not enough.\"},{\"text\":\"A request for a cap increase should bring a week of refusal counts, the shape of the traffic across the day, and the deadline that traffic is serving.\",\"line\":35,\"span\":\"Bring a week of refusal counts, the shape of the traffic across the day, and the deadline that traffic is serving.\"},{\"text\":\"The platform team looks at whether the load is smooth or bursty before it looks at the number.\",\"line\":35,\"span\":\"The platform team looks at whether the load is smooth or bursty before it looks at the number at all — a burst is cheaper to smooth than it is to serve at its peak.\"},{\"text\":\"A burst is cheaper to smooth than it is to serve at its peak.\",\"line\":35,\"span\":\"The platform team looks at whether the load is smooth or bursty before it looks at the number at all — a burst is cheaper to smooth than it is to serve at its peak.\"},{\"text\":\"A caller that can move half its work to a quieter hour usually gets what it needs without any change to the cap.\",\"line\":35,\"span\":\"A caller that can move half its work to a quieter hour usually gets what it needs without any change to the cap at all, which is the outcome everyone prefers.\"},{\"text\":\"Requests for a cap increase reach the platform team through the usual channel.\",\"line\":37,\"span\":\"Requests reach the platform team through the usual channel, and they are answered within two working days; chasing an answer doesn’t make it take fewer.\"},{\"text\":\"Requests for a cap increase are answered within two working days.\",\"line\":37,\"span\":\"Requests reach the platform team through the usual channel, and they are answered within two working days; chasing an answer doesn’t make it take fewer.\"},{\"text\":\"Chasing an answer to a cap increase request doesn't make it take fewer than two working days.\",\"line\":37,\"span\":\"Requests reach the platform team through the usual channel, and they are answered within two working days; chasing an answer doesn’t make it take fewer.\"},{\"text\":\"There is no expedited path for cap increase requests.\",\"line\":37,\"span\":\"There is no expedited path and no exception list.\"},{\"text\":\"There is no exception list for cap increase requests.\",\"line\":37,\"span\":\"There is no expedited path and no exception list.\"}]}","ttft_ms":45728,"type":"result","duration_ms":45745,"uuid":"de40d275-0844-4a4c-8bfb-bee650f94dc4","ttft_stream_ms":2210,"time_to_request_ms":112,"first_content_frame_ms":2210,"queued_turn_count":0,"result_index":0}
