ed\"}, {\"text\": \"A full peal could not be attempted with fewer than eight ringers.\", \"line\": 7, \"span\": \"We could not attempt a full peal with fewer than eight ringers\"}, {\"text\": \"One absence was enough to call the whole peal off.\", \"line\": 7, \"span\": \"one absence was enough to call the whole thing off\"}, {\"text\": \"A full peal took two hours from the first stroke to the last.\", \"line\": 9, \"span\": \"From the first stroke to the last a full peal took two hours\"}, {\"text\": \"Nobody left the ringing chamber between the first stroke and the last of a full peal.\", \"line\": 9, \"span\": \"nobody left the ringing chamber in between\"}, {\"text\": \"Ringing took place on the first Sunday of the month, every month.\", \"line\": 11, \"span\": \"We rang on the first Sunday of the month, every month\"}, {\"text\": \"People in the village knew the hour from the sound of the ringing.\", \"line\": 11, \"span\": \"people in the village knew the hour from the sound\"}]}","ttft_ms":4462,"type":"result","duration_ms":4497,"uuid":"32692f38-def0-42e5-aa67-166f9e6a1096","ttft_stream_ms":1269,"time_to_request_ms":113,"first_content_frame_ms":1269,"queued_turn_count":0,"result_index":0}
