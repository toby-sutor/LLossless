03\",\"verdict\":\"SUPPORTED\",\"evidence\":\"All six were cast in 1782 by a founder who put his mark on the tenor alone\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"All six were cast in 1782 by a founder who put his mark on the tenor alone\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A full peal needs eight ringers\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"so the band could never attempt one while a single ringer was missing\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Once the ringing starts a full peal runs for two hours\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"the band works through it without a break\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The bells are rung on the first Sunday of every month\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"the village has always kept the hour by them\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"we found six of them in the tower above the village\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The founder cut the year 1782 into the tenor\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"that was the only bell he signed\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"We could not attempt a full peal with fewer than eight ringers\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"one absence was enough to call the whole thing off\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"From the first stroke to the last a full peal took two hours\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"nobody left the ringing chamber in between\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"We rang on the first Sunday of the month, every month\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"people in the village knew the hour from the sound\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"}\n]}","ttft_ms":9639,"type":"result","duration_ms":9672,"uuid":"ee2717ef-0cc7-4418-8eb5-e1dd3b1dea39","ttft_stream_ms":1205,"time_to_request_ms":116,"first_content_frame_ms":1205,"queued_turn_count":0,"result_index":0}
