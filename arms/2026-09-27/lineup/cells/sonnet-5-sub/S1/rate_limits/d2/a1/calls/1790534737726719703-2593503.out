{"duration_api_ms":9875,"stop_reason":"end_turn","session_id":"5dc4933b-f989-472a-b43b-6f6789b50c07","total_cost_usd":0.0265196,"usage":{"input_tokens":2,"cache_creation_input_tokens":3297,"cache_read_input_tokens":4538,"output_tokens":1242,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3297,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1242,"cache_read_input_tokens":4538,"cache_creation_input_tokens":3297,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3297},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-sonnet-5":{"inputTokens":2,"outputTokens":1242,"cacheReadInputTokens":4538,"cacheCreationInputTokens":3297,"webSearchRequests":0,"costUSD":0.0265196,"contextWindow":1000000,"maxOutputTokens":64000,"thinkingTokens":0,"canonicalModel":"claude-sonnet-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"claims\": [\n{\"text\": \"The gateway answers 429 at the edge when the cap is spent, without troubling the service behind it.\", \"line\": 3, \"span\": \"When the cap is spent the gateway answers 429 at the edge, without troubling the service behind it\"},\n{\"text\": \"Requests are counted against the credential rather than the connection.\", \"line\": 5, \"span\": \"Requests are counted against the credential rather than the connection\"},\n{\"text\": \"Requests are counted over a fixed window of 60 seconds.\", \"line\": 5, \"span\": \"over a fixed window of 60 seconds\"},\n{\"text\": \"The gateway doesn't disclose the start of the fixed window.\", \"line\": 5, \"span\": \"whose start the gateway doesn’t disclose\"},\n{\"text\": \"The count follows the credential wherever the caller puts it, including across hosts.\", \"line\": 5, \"span\": \"The count follows the credential wherever the caller happens to put it, including across hosts\"},\n{\"text\": \"A caller spread over many worker processes is throttled at the same point a single process would have been.\", \"line\": 5, \"span\": \"A caller spread over many worker processes is throttled at the same point a single process would have been\"},\n{\"text\": \"The default allowance is 100 requests in a window.\", \"line\": 7, \"span\": \"The default allowance is 100 requests in a window\"},\n{\"text\": \"The header is called Retry-After.\", \"line\": 11, \"span\": \"The header is called Retry-After\"},\n{\"text\": \"The Retry-After header's value is a whole number of seconds.\", \"line\": 11, \"span\": \"Its value is a whole number of seconds\"},\n{\"text\": \"The Retry-After header is present on every refusal the gateway sends.\", \"line\": 11, \"span\": \"it is present on every refusal the gateway sends\"},\n{\"text\": \"The response body is JSON.\", \"line\": 13, \"span\": \"The response body is JSON\"},\n{\"text\": \"The response body repeats the cap, the window and the tier as plain fields.\", \"line\": 13, \"span\": \"it repeats the cap, the window and the tier as plain fields\"},\n{\"text\": \"There are four rules.\", \"line\": 17, \"span\": \"There are four rules\"},\n{\"text\": \"The same rule of honouring the header and not computing your own wait holds on the 503 path.\", \"line\": 19, \"span\": \"On the 503 path the same rule holds, even though the cause of the refusal is an entirely different one\"},\n{\"text\": \"A batch credential is allowed 1000 requests in a window.\", \"line\": 23, \"span\": \"A batch credential is allowed 1000 requests in a window\"},\n{\"text\": \"A batch credential's 1000 requests in a window is 50 times the default.\", \"line\": 23, \"span\": \"which is 50 times the default and not a separate counting scheme\"},\n{\"text\": \"The window, the header and the body are identical between the batch and interactive tiers.\", \"line\": 23, \"span\": \"The window, the header and the body are identical to the interactive case\"},\n{\"text\": \"The gateway refuses a request for three separate reasons.\", \"line\": 29, \"span\": \"The gateway refuses a request for three separate reasons\"},\n{\"text\": \"Only one of the gateway's three refusal reasons is a cap.\", \"line\": 29, \"span\": \"and only one of them is a cap\"},\n{\"text\": \"A credential can be suspended.\", \"line\": 29, \"span\": \"A credential can be suspended\"},\n{\"text\": \"A route can be closed while it is being repaired.\", \"line\": 29, \"span\": \"a route can be closed while it is being repaired\"},\n{\"text\": \"A request body over the 5 megabyte limit is refused before it has been read at all.\", \"line\": 29, \"span\": \"a request body over the 5 megabyte limit is refused before it has been read at all\"},\n{\"text\": \"An answer from the platform team takes two working days.\", \"line\": 37, \"span\": \"An answer takes two working days\"}\n]}","ttft_ms":9926,"type":"result","duration_ms":9940,"uuid":"c85396f4-3e79-4592-9c89-dd323789b1c2","ttft_stream_ms":1305,"time_to_request_ms":95,"first_content_frame_ms":1305,"queued_turn_count":0,"result_index":0}
