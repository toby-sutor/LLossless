{"duration_api_ms":14592,"stop_reason":"end_turn","session_id":"31956e65-721b-47fe-95f8-0397a5990f18","total_cost_usd":0.036519600000000006,"usage":{"input_tokens":2,"cache_creation_input_tokens":3297,"cache_read_input_tokens":4538,"output_tokens":2242,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3297,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":2242,"cache_read_input_tokens":4538,"cache_creation_input_tokens":3297,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3297},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-sonnet-5":{"inputTokens":2,"outputTokens":2242,"cacheReadInputTokens":4538,"cacheCreationInputTokens":3297,"webSearchRequests":0,"costUSD":0.036519600000000006,"contextWindow":1000000,"maxOutputTokens":64000,"thinkingTokens":0,"canonicalModel":"claude-sonnet-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"```json\n{\n  \"claims\": [\n    {\n      \"text\": \"The gateway answers 429 at the edge, without troubling the service behind it.\",\n      \"line\": 3,\n      \"span\": \"the gateway answers 429 at the edge, without troubling the service behind it\"\n    },\n    {\n      \"text\": \"An earlier draft of this note argued for a client-side token bucket that mirrored the gateway's own counters.\",\n      \"line\": 3,\n      \"span\": \"An earlier draft of this note argued for a client-side token bucket that mirrored the gateway’s own counters\"\n    },\n    {\n      \"text\": \"That section arguing for a client-side token bucket has been left out on purpose.\",\n      \"line\": 3,\n      \"span\": \"that section has been left out on purpose\"\n    },\n    {\n      \"text\": \"Requests are counted against the credential rather than the connection.\",\n      \"line\": 5,\n      \"span\": \"Requests are counted against the credential rather than the connection\"\n    },\n    {\n      \"text\": \"Requests are counted over a fixed window of 60 seconds whose start the gateway doesn't disclose.\",\n      \"line\": 5,\n      \"span\": \"over a fixed window of 60 seconds whose start the gateway doesn’t disclose\"\n    },\n    {\n      \"text\": \"There is nothing to be gained by opening more sockets.\",\n      \"line\": 5,\n      \"span\": \"There is nothing to be gained by opening more sockets\"\n    },\n    {\n      \"text\": \"The count follows the credential wherever the caller happens to put it, including across hosts.\",\n      \"line\": 5,\n      \"span\": \"The count follows the credential wherever the caller happens to put it, including across hosts\"\n    },\n    {\n      \"text\": \"A caller spread over many worker processes is throttled at the same point a single process would have been.\",\n      \"line\": 5,\n      \"span\": \"A caller spread over many worker processes is throttled at the same point a single process would have been\"\n    },\n    {\n      \"text\": \"The default allowance is 100 requests in a window.\",\n      \"line\": 7,\n      \"span\": \"The default allowance is 100 requests in a window\"\n    },\n    {\n      \"text\": \"The default allowance of 100 requests in a window is enough for every interactive use of this API the platform team has seen.\",\n      \"line\": 7,\n      \"span\": \"which is enough for every interactive use of this API the platform team has seen\"\n    },\n    {\n      \"text\": \"The header is called Retry-After.\",\n      \"line\": 11,\n      \"span\": \"The header is called Retry-After\"\n    },\n    {\n      \"text\": \"The Retry-After header's value is a whole number of seconds.\",\n      \"line\": 11,\n      \"span\": \"Its value is a whole number of seconds\"\n    },\n    {\n      \"text\": \"The Retry-After header is present on every refusal the gateway sends.\",\n      \"line\": 11,\n      \"span\": \"it is present on every refusal the gateway sends\"\n    },\n    {\n      \"text\": \"The response body is JSON.\",\n      \"line\": 13,\n      \"span\": \"The response body is JSON\"\n    },\n    {\n      \"text\": \"The response body repeats the cap, the window and the tier as plain fields.\",\n      \"line\": 13,\n      \"span\": \"it repeats the cap, the window and the tier as plain fields\"\n    },\n    {\n      \"text\": \"There are four rules.\",\n      \"line\": 17,\n      \"span\": \"There are four rules\"\n    },\n    {\n      \"text\": \"Rule 2 applies on the 503 path, even though the cause of the refusal is an entirely different one.\",\n      \"line\": 19,\n      \"span\": \"On the 503 path the same rule holds, even though the cause of the refusal is an entirely different one\"\n    },\n    {\n      \"text\": \"A 200 needs nothing.\",\n      \"line\": 21,\n      \"span\": \"A 200 needs nothing\"\n    },\n    {\n      \"text\": \"A 429 needs the stated wait.\",\n      \"line\": 21,\n      \"span\": \"a 429 needs the stated wait\"\n    },\n    {\n      \"text\": \"A 500 can be retried once that wait has passed.\",\n      \"line\": 21,\n      \"span\": \"a 500 can be retried once that wait has passed\"\n    },\n    {\n      \"text\": \"A 503 means the platform itself is overloaded.\",\n      \"line\": 21,\n      \"span\": \"a 503 means the platform itself is overloaded\"\n    },\n    {\n      \"text\": \"A batch credential is allowed 1000 requests in a window.\",\n      \"line\": 23,\n      \"span\": \"A batch credential is allowed 1000 requests in a window\"\n    },\n    {\n      \"text\": \"1000 requests in a window is 50 times the default.\",\n      \"line\": 23,\n      \"span\": \"which is 50 times the default and not a separate counting scheme\"\n    },\n    {\n      \"text\": \"1000 requests in a window is not a separate counting scheme.\",\n      \"line\": 23,\n      \"span\": \"which is 50 times the default and not a separate counting scheme\"\n    },\n    {\n      \"text\": \"The window, the header and the body are identical between the batch tier and the interactive case.\",\n      \"line\": 23,\n      \"span\": \"The window, the header and the body are identical to the interactive case\"\n    },\n    {\n      \"text\": \"Nothing else about the batch tier differs from the default.\",\n      \"line\": 23,\n      \"span\": \"Nothing else about the batch tier differs from the default\"\n    },\n    {\n      \"text\": \"Rule 4 states to log every refusal you see.\",\n      \"line\": 25,\n      \"span\": \"Log every refusal you see\"\n    },\n    {\n      \"text\": \"Rule 4 states to keep the log for at least a week.\",\n      \"line\": 25,\n      \"span\": \"keep the log for at least a week\"\n    },\n    {\n      \"text\": \"The gateway refuses a request for three separate reasons.\",\n      \"line\": 29,\n      \"span\": \"The gateway refuses a request for three separate reasons\"\n    },\n    {\n      \"text\": \"Only one of the three reasons for refusal is a cap.\",\n      \"line\": 29,\n      \"span\": \"and only one of them is a cap\"\n    },\n    {\n      \"text\": \"A credential can be suspended.\",\n      \"line\": 29,\n      \"span\": \"A credential can be suspended\"\n    },\n    {\n      \"text\": \"A route can be closed while it is being repaired.\",\n      \"line\": 29,\n      \"span\": \"a route can be closed while it is being repaired\"\n    },\n    {\n      \"text\": \"A request body over the 5 megabyte limit is refused before it has been read at all.\",\n      \"line\": 29,\n      \"span\": \"a request body over the 5 megabyte limit is refused before it has been read at all\"\n    },\n    {\n      \"text\": \"A loop retrying against a suspended credential burns its whole budget and reaches nothing.\",\n      \"line\": 31,\n      \"span\": \"A loop retrying against a suspended credential burns its whole budget and reaches nothing\"\n    },\n    {\n      \"text\": \"An answer from the platform team takes two working days.\",\n      \"line\": 37,\n      \"span\": \"An answer takes two working days\"\n    }\n  ]\n}\n```","ttft_ms":14607,"type":"result","duration_ms":14658,"uuid":"d2877894-02c3-40df-ba86-b0d30d165412","ttft_stream_ms":1197,"time_to_request_ms":96,"first_content_frame_ms":1198,"queued_turn_count":0,"result_index":0}
