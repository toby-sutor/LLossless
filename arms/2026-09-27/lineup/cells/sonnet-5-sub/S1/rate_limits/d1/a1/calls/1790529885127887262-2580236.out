{"duration_api_ms":30086,"stop_reason":"end_turn","session_id":"ea7ed49c-9c91-4971-993c-2e88c96b388c","total_cost_usd":0.0691936,"usage":{"input_tokens":2,"cache_creation_input_tokens":6708,"cache_read_input_tokens":4538,"output_tokens":4145,"output_tokens_details":{"thinking_tokens":1423},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":6708,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":4145,"cache_read_input_tokens":4538,"cache_creation_input_tokens":6708,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6708},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-sonnet-5":{"inputTokens":2,"outputTokens":4145,"cacheReadInputTokens":4538,"cacheCreationInputTokens":6708,"webSearchRequests":0,"costUSD":0.0691936,"contextWindow":1000000,"maxOutputTokens":64000,"thinkingTokens":1423,"canonicalModel":"claude-sonnet-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"verdicts\":[\n{\"claim_id\":\"M-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"the gateway answers 429 at the edge — without waking the service behind it\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Requests are counted against the credential rather than the connection\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly stated in source_b.\"},\n{\"claim_id\":\"M-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"over a fixed window of 60 seconds\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"over a fixed window of 60 seconds whose start the gateway doesn’t disclose\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly stated in source_b.\"},\n{\"claim_id\":\"M-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The count follows the credential wherever the caller happens to put it, including across hosts.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly stated in source_b.\"},\n{\"claim_id\":\"M-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The default allowance is 100 requests in a window\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a credential marked for batch work is allowed 1000 in the same window\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The refusal carries a Retry-After header.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Its value is a whole number of seconds to wait.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it is present on every refusal the gateway sends\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly stated in source_b.\"},\n{\"claim_id\":\"M-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The gateway keeps no memory of who backed off politely\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The body of the refusal is JSON\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"It names the cap and the tier as well.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Combined with the preceding sentence about the window, source_a names cap, tier, and window.\"},\n{\"claim_id\":\"M-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"and it does the same on the 503 path\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a that the gateway's arithmetic applies on the 503 path too.\"},\n{\"claim_id\":\"M-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"On the 503 path the same rule holds, even though the cause of the refusal is an entirely different one.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly stated in source_b.\"},\n{\"claim_id\":\"M-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A 200 wants nothing\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a 429 wants the stated wait\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a 500 may be retried once that wait has passed\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a 503 is the overload path\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A batch credential is allowed fifty times the default allowance\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it is measured over exactly the same window\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The tier is set on the credential when it is issued\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"and cannot be asked for per call\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The log line should carry the credential, the window and the wait.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The gateway refuses a request for three reasons\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-026\",\"verdict\":\"SUPPORTED\",\"evidence\":\"and only one of them is the one above\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A credential may be suspended\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a route may be closed for maintenance\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a request body over the 5 megabyte limit is refused before it has been read at all\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly stated in source_b.\"},\n{\"claim_id\":\"M-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"None of those three clears itself by waiting for a stated number of seconds.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a referring to the three non-cap reasons listed just before.\"},\n{\"claim_id\":\"M-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"the number of caps raised without a measurement behind them is 0\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Requests reach the platform team through the usual channel\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"they are answered within two working days\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"There is no expedited path\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"},\n{\"claim_id\":\"M-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"and no exception list\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly stated in source_a.\"}\n]}","ttft_ms":13815,"type":"result","duration_ms":30147,"uuid":"c4aa0527-930e-4279-b229-fbfb351ddc69","ttft_stream_ms":1918,"time_to_request_ms":90,"first_content_frame_ms":1919,"queued_turn_count":0,"result_index":0}
