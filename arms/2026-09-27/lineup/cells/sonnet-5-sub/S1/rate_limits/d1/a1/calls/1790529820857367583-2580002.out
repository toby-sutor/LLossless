{"duration_api_ms":48549,"stop_reason":"end_turn","session_id":"35949b88-51c8-4fe9-ae4a-421da3f7575a","total_cost_usd":0.0984656,"usage":{"input_tokens":2,"cache_creation_input_tokens":6526,"cache_read_input_tokens":4538,"output_tokens":7145,"output_tokens_details":{"thinking_tokens":1934},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":6526,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":7145,"cache_read_input_tokens":4538,"cache_creation_input_tokens":6526,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6526},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-sonnet-5":{"inputTokens":2,"outputTokens":7145,"cacheReadInputTokens":4538,"cacheCreationInputTokens":6526,"webSearchRequests":0,"costUSD":0.0984656,"contextWindow":1000000,"maxOutputTokens":64000,"thinkingTokens":1934,"canonicalModel":"claude-sonnet-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"verdicts\":[\n{\"claim_id\":\"A-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Every credential has a cap. When that cap is spent the gateway answers 429 at the edge\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"the gateway answers 429 at the edge — without waking the service behind it\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Requests are counted against the credential that presented them rather than the connection\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"over a fixed window of 60 seconds whose start the gateway doesn't disclose\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Requests are counted against the credential that presented them rather than the connection\",\"evidence_source\":\"merged.md\",\"rationale\":\"States counting is against credential rather than connection, implying never against connection.\"},\n{\"claim_id\":\"A-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a client spread across eight worker processes is throttled at exactly the point one process would have been\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The default allowance is 100 requests in a window\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a credential marked for batch work is allowed 1000 in the same window\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The refusal carries a header called Retry-After.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Its value is a whole number of seconds to wait\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The gateway keeps no memory of who backed off politely\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The body of the refusal is JSON\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it names the window the gateway counted in\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"along with the cap and the tier\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"along with the cap and the tier\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it holds on the 503 path too, even though the cause of that refusal is an entirely different one\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A 200 wants nothing\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a 429 wants the stated wait\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a 500 may be retried once that wait has passed\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a 503 is the overload path\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A batch credential is allowed fifty times the default allowance\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it is measured over exactly the same window\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The tier is set on the credential when it is issued\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"and cannot be asked for per call\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The gateway refuses a request for three reasons\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-026\",\"verdict\":\"SUPPORTED\",\"evidence\":\"and only one of them is the one above\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A credential may be suspended\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a route may be closed for maintenance\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a body may exceed the 5 megabyte limit and be refused before it has even been read\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"None of those three clears itself by waiting for a stated number of seconds.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"the number of caps raised without a measurement behind them is 0\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Requests reach the platform team through the usual channel\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"they are answered within two working days\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"There is no expedited path\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"and no exception list\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"the gateway answers 429 at the edge — without waking the service behind it\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"An earlier draft of this note argued for a client-side token bucket that mirrored the gateway's own counters\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"that section has been left out on purpose\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Requests are counted against the credential that presented them rather than the connection\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"over a fixed window of 60 seconds whose start the gateway doesn't disclose\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Opening a second socket therefore buys a caller nothing.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The count follows the credential wherever the caller puts it, including across hosts\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a client spread across eight worker processes is throttled at exactly the point one process would have been\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The default allowance is 100 requests in a window\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"enough for every interactive use of this API the platform team has seen\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The refusal carries a header called Retry-After.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Its value is a whole number of seconds to wait\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it is present on every refusal the gateway sends\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The body of the refusal is JSON\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it names the window the gateway counted in, along with the cap and the tier\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Four rules, given in the order they should be applied.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-017\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"1. Honour the header, every time, and don't compute a wait of your own.\\n   The gateway has already done that arithmetic, with information the caller cannot see, and it holds on the 503 path too, even though the cause of that refusal is an entirely different one.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The 503 statement is attached to rule 1, not rule 2, contradicting the claim's attribution.\"},\n{\"claim_id\":\"B-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A 200 wants nothing\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a 429 wants the stated wait\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a 500 may be retried once that wait has passed\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a 503 is the overload path\",\"evidence_source\":\"merged.md\",\"rationale\":\"Overload path implies the platform is overloaded.\"},\n{\"claim_id\":\"B-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a credential marked for batch work is allowed 1000 in the same window\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A batch credential is allowed fifty times the default allowance\",\"evidence_source\":\"merged.md\",\"rationale\":\"1000 is fifty times the default of 100 as stated.\"},\n{\"claim_id\":\"B-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The window, the header and the body are identical to the interactive case, so a client written for one tier needs no change to run against the other.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Implies the same counting scheme applies to batch.\"},\n{\"claim_id\":\"B-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The window, the header and the body are identical to the interactive case\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-026\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nothing else about the two tiers differs in any way.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Log every refusal seen, and keep the log for at least a week.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"keep the log for at least a week\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The gateway refuses a request for three reasons\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"and only one of them is the one above\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A credential may be suspended\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a route may be closed for maintenance\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a body may exceed the 5 megabyte limit and be refused before it has even been read\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A loop that waits and retries against a suspended credential spends its whole budget without ever reaching the service\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"they are answered within two working days\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"}\n]}","ttft_ms":17508,"type":"result","duration_ms":48612,"uuid":"2585a66f-2138-4a74-8f5e-216734b18874","ttft_stream_ms":2523,"time_to_request_ms":109,"first_content_frame_ms":2524,"queued_turn_