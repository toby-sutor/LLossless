{"duration_api_ms":16499,"stop_reason":"end_turn","session_id":"3b3c79d2-8d47-4204-9f87-0b156429c47c","total_cost_usd":0.036359600000000006,"usage":{"input_tokens":2,"cache_creation_input_tokens":3297,"cache_read_input_tokens":4538,"output_tokens":2226,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3297,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":2226,"cache_read_input_tokens":4538,"cache_creation_input_tokens":3297,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3297},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-sonnet-5":{"inputTokens":2,"outputTokens":2226,"cacheReadInputTokens":4538,"cacheCreationInputTokens":3297,"webSearchRequests":0,"costUSD":0.036359600000000006,"contextWindow":1000000,"maxOutputTokens":64000,"thinkingTokens":0,"canonicalModel":"claude-sonnet-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"claims\": [\n{\"text\": \"The gateway answers 429 at the edge when the cap is spent.\", \"line\": 3, \"span\": \"When the cap is spent the gateway answers 429 at the edge, without troubling the service behind it\"},\n{\"text\": \"The gateway does not trouble the service behind it when answering 429.\", \"line\": 3, \"span\": \"without troubling the service behind it\"},\n{\"text\": \"An earlier draft of this note argued for a client-side token bucket that mirrored the gateway's own counters.\", \"line\": 3, \"span\": \"An earlier draft of this note argued for a client-side token bucket that mirrored the gateway’s own counters\"},\n{\"text\": \"That section arguing for a client-side token bucket has been left out on purpose.\", \"line\": 3, \"span\": \"and that section has been left out on purpose\"},\n{\"text\": \"Requests are counted against the credential rather than the connection.\", \"line\": 5, \"span\": \"Requests are counted against the credential rather than the connection\"},\n{\"text\": \"Requests are counted over a fixed window of 60 seconds.\", \"line\": 5, \"span\": \"over a fixed window of 60 seconds whose start the gateway doesn’t disclose\"},\n{\"text\": \"The gateway does not disclose the start of the 60 second window.\", \"line\": 5, \"span\": \"whose start the gateway doesn’t disclose\"},\n{\"text\": \"The count follows the credential wherever the caller happens to put it, including across hosts.\", \"line\": 5, \"span\": \"The count follows the credential wherever the caller happens to put it, including across hosts\"},\n{\"text\": \"A caller spread over many worker processes is throttled at the same point a single process would have been.\", \"line\": 5, \"span\": \"A caller spread over many worker processes is throttled at the same point a single process would have been\"},\n{\"text\": \"The default allowance is 100 requests in a window.\", \"line\": 7, \"span\": \"The default allowance is 100 requests in a window\"},\n{\"text\": \"The header is called Retry-After.\", \"line\": 11, \"span\": \"The header is called Retry-After\"},\n{\"text\": \"The Retry-After header's value is a whole number of seconds.\", \"line\": 11, \"span\": \"Its value is a whole number of seconds\"},\n{\"text\": \"The Retry-After header is present on every refusal the gateway sends.\", \"line\": 11, \"span\": \"it is present on every refusal the gateway sends\"},\n{\"text\": \"The response body is JSON.\", \"line\": 13, \"span\": \"The response body is JSON and it repeats the cap, the window and the tier as plain fields\"},\n{\"text\": \"The response body repeats the cap, the window and the tier as plain fields.\", \"line\": 13, \"span\": \"The response body is JSON and it repeats the cap, the window and the tier as plain fields\"},\n{\"text\": \"There are four rules for what the client does.\", \"line\": 17, \"span\": \"There are four rules, and the order they are given in is the order to apply them\"},\n{\"text\": \"On the 503 path the same rule of honouring the header holds.\", \"line\": 19, \"span\": \"On the 503 path the same rule holds, even though the cause of the refusal is an entirely different one\"},\n{\"text\": \"The cause of a 503 refusal is an entirely different one from a 429.\", \"line\": 19, \"span\": \"even though the cause of the refusal is an entirely different one\"},\n{\"text\": \"A 200 needs nothing in terms of retry.\", \"line\": 21, \"span\": \"A 200 needs nothing\"},\n{\"text\": \"A 429 needs the stated wait.\", \"line\": 21, \"span\": \"a 429 needs the stated wait\"},\n{\"text\": \"A 500 can be retried once the stated wait has passed.\", \"line\": 21, \"span\": \"a 500 can be retried once that wait has passed\"},\n{\"text\": \"A 503 means the platform itself is overloaded.\", \"line\": 21, \"span\": \"a 503 means the platform itself is overloaded\"},\n{\"text\": \"A batch credential is allowed 1000 requests in a window.\", \"line\": 23, \"span\": \"A batch credential is allowed 1000 requests in a window, which is 50 times the default and not a separate counting scheme\"},\n{\"text\": \"1000 requests in a window is 50 times the default allowance.\", \"line\": 23, \"span\": \"which is 50 times the default and not a separate counting scheme\"},\n{\"text\": \"The window, the header and the body are identical between the batch tier and the interactive case.\", \"line\": 23, \"span\": \"The window, the header and the body are identical to the interactive case\"},\n{\"text\": \"A client written for one tier needs no change at all to run against the other.\", \"line\": 23, \"span\": \"so a client written for one tier needs no change at all to run against the other\"},\n{\"text\": \"Nothing else about the batch tier differs from the default.\", \"line\": 23, \"span\": \"Nothing else about the batch tier differs from the default\"},\n{\"text\": \"The rule instructs to log every refusal seen.\", \"line\": 25, \"span\": \"Log every refusal you see, and keep the log for at least a week\"},\n{\"text\": \"The rule instructs to keep the log for at least a week.\", \"line\": 25, \"span\": \"and keep the log for at least a week\"},\n{\"text\": \"The gateway refuses a request for three separate reasons.\", \"line\": 29, \"span\": \"The gateway refuses a request for three separate reasons, and only one of them is a cap\"},\n{\"text\": \"Only one of the three refusal reasons is a cap.\", \"line\": 29, \"span\": \"and only one of them is a cap\"},\n{\"text\": \"A credential can be suspended.\", \"line\": 29, \"span\": \"A credential can be suspended, a route can be closed while it is being repaired, and a request body over the 5 megabyte limit is refused before it has been read at all\"},\n{\"text\": \"A route can be closed while it is being repaired.\", \"line\": 29, \"span\": \"a route can be closed while it is being repaired\"},\n{\"text\": \"A request body over the 5 megabyte limit is refused before it has been read at all.\", \"line\": 29, \"span\": \"a request body over the 5 megabyte limit is refused before it has been read at all\"},\n{\"text\": \"A loop retrying against a suspended credential burns its whole budget and reaches nothing.\", \"line\": 31, \"span\": \"A loop retrying against a suspended credential burns its whole budget and reaches nothing\"},\n{\"text\": \"The log afterwards shows a long run of refusals and no successes at all in the case of a suspended credential.\", \"line\": 31, \"span\": \"The log afterwards shows a long run of refusals and no successes at all\"},\n{\"text\": \"An answer takes two working days.\", \"line\": 37, \"span\": \"An answer takes two working days\"},\n{\"text\": \"There is no expedited path for requests to the platform team.\", \"line\": 37, \"span\": \"There is no expedited path\"},\n{\"text\": \"Requests go to the platform team through the usual channel.\", \"line\": 35, \"span\": \"Requests go to the platform team through the usual channel\"}\n]}","ttft_ms":16445,"type":"result","duration_ms":16562,"uuid":"0f05a008-3fd5-43e0-a78f-9383933f4d49","ttft_stream_ms":1291,"time_to_request_ms":94,"first_content_frame_ms":1291,"queued_turn_count":0,"result_index":0}
