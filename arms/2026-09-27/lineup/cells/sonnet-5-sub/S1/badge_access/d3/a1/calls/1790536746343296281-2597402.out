\": \"ask the\\nvisitor to wear it above the waist and in view for the whole visit\"}, {\"text\": \"Visitors return badges at the front desk on their way out.\", \"line\": 12, \"span\": \"Visitors return badges at the front desk on their way out\"}, {\"text\": \"The badge is wiped with the cleaning cloth kept in the top drawer.\", \"line\": 12, \"span\": \"Wipe the badge with\\nthe cleaning cloth kept in the top drawer\"}, {\"text\": \"The cleaning cloth is kept in the top drawer.\", \"line\": 12, \"span\": \"the cleaning cloth kept in the top drawer\"}, {\"text\": \"The badge is put back in the return tray after being wiped.\", \"line\": 13, \"span\": \"put it back in the return tray\"}, {\"text\": \"Badges in the return tray are re-used the same day.\", \"line\": 14, \"span\": \"Badges in the return tray are re-used the same day\"}, {\"text\": \"If a badge is not returned, the visitor's line on the expected-visitor list is marked with an N.\", \"line\": 18, \"span\": \"Mark the visitor's line on the expected-visitor list with an N\"}, {\"text\": \"At the end of the day, the list of unreturned badges is sent to the security office.\", \"line\": 18, \"span\": \"At the end of\\nthe day, send the list of unreturned badges to the security office\"}, {\"text\": \"Badges that have been missing for 7 days are deactivated.\", \"line\": 19, \"span\": \"Badges that\\nhave been missing for 7 days are deactivated\"}, {\"text\": \"Contractors on a job lasting more than one day are issued a week badge instead of a day badge.\", \"line\": 24, \"span\": \"Contractors on a job lasting more than one day are issued a week badge instead\\nof a day badge\"}, {\"text\": \"A week badge is valid for 7 days from the date printed on it.\", \"line\": 25, \"span\": \"A week badge is valid for 7 days from the date printed on it\"}, {\"text\": \"Contractors sign the contractor register in addition to the visitor list.\", \"line\": 26, \"span\": \"Contractors sign the contractor register in addition to the visitor list\"}]}","ttft_ms":6012,"type":"result","duration_ms":6049,"uuid":"7eadcf78-9864-4784-bb11-8728d4968b2f","ttft_stream_ms":942,"time_to_request_ms":97,"first_content_frame_ms":942,"queued_turn_count":0,"result_index":0}
