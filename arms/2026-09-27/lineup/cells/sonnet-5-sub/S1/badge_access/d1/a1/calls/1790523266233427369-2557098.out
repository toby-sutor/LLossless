inal\"}, {\"text\": \"The host's name is written on the badge in the space provided.\", \"line\": 5, \"span\": \"Write the host's name on the badge in the space provided\"}, {\"text\": \"The visitor is asked to wear the badge above the waist and in view for the whole visit.\", \"line\": 5, \"span\": \"ask the visitor to wear it above the waist and in view for the whole visit\"}, {\"text\": \"Visitors return badges at the front desk on their way out.\", \"line\": 9, \"span\": \"Visitors return badges at the front desk on their way out\"}, {\"text\": \"The badge is wiped with the cleaning cloth kept in the top drawer.\", \"line\": 9, \"span\": \"Wipe the badge with the cleaning cloth kept in the top drawer\"}, {\"text\": \"The badge is put back in the return tray.\", \"line\": 9, \"span\": \"put it back in the return tray\"}, {\"text\": \"Badges in the return tray are re-used the same day.\", \"line\": 9, \"span\": \"Badges in the return tray are re-used the same day\"}, {\"text\": \"The visitor's line on the expected-visitor list is marked with an N if a badge is not returned.\", \"line\": 13, \"span\": \"Mark the visitor's line on the expected-visitor list with an N\"}, {\"text\": \"At the end of the day, the list of unreturned badges is sent to the security office.\", \"line\": 13, \"span\": \"At the end of the day, send the list of unreturned badges to the security office\"}, {\"text\": \"Badges that have been missing for 7 days are deactivated.\", \"line\": 13, \"span\": \"Badges that have been missing for 7 days are deactivated\"}, {\"text\": \"A badge handed in after it was reported missing goes to the security office rather than back into the return tray.\", \"line\": 17, \"span\": \"A badge handed in after it was reported missing goes to the security office rather than back into the return tray\"}, {\"text\": \"The security office decides whether to reactivate a badge handed in after it was reported missing.\", \"line\": 17, \"span\": \"The security office decides whether to reactivate it\"}, {\"text\": \"Contractors on a job lasting more than one day are issued a week badge instead of a day badge.\", \"line\": 21, \"span\": \"Contractors on a job lasting more than one day are issued a week badge instead of a day badge\"}, {\"text\": \"A week badge is valid for 7 days from the date printed on it.\", \"line\": 21, \"span\": \"A week badge is valid for 7 days from the date printed on it\"}, {\"text\": \"Contractors sign the contractor register in addition to the visitor list.\", \"line\": 21, \"span\": \"Contractors sign the contractor register in addition to the visitor list\"}]}","ttft_ms":8989,"type":"result","duration_ms":9034,"uuid":"6db81dd8-2a94-4e49-9d71-365241e99aa2","ttft_stream_ms":2487,"time_to_request_ms":103,"first_content_frame_ms":2487,"queued_turn_count":0,"result_index":0}
