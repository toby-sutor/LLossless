ct\":\"SUPPORTED\",\"evidence\":\"Author: Marlowe Ferrante\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source b lists Marlowe Ferrante as author.\"},\n{\"claim_id\":\"M-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Updated: 2026-02-03\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source b states this update date.\"},\n{\"claim_id\":\"M-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Stream name is one of the mandatry field for every Nimbrel Probe agent.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly states stream name is mandatory for every agent.\"},\n{\"claim_id\":\"M-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The Nimbrel Probe stream name is what seperates one instrumented process from the next.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Matches claim wording nearly verbatim.\"},\n{\"claim_id\":\"M-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The stream name cant contain arbitrary symbols\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly states this restriction.\"},\n{\"claim_id\":\"M-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"https://docs.nimbrel.example/probe/agent/java/current/config-core.html#config-stream-name\",\"evidence_source\":\"source_a.md\",\"rationale\":\"URL matches exactly as given in source a.\"},\n{\"claim_id\":\"M-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"https://docs.nimbrel.example/probe/agent/browser/current/configuration.html#stream-name\",\"evidence_source\":\"source_b.md\",\"rationale\":\"URL matches exactly as given in source b.\"},\n{\"claim_id\":\"M-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Only letters, digits, spaces and hyphens are accepted\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly states this restriction.\"},\n{\"claim_id\":\"M-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it has to match ^[A-Za-z0-9 -]+$\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly states the regex requirement.\"},\n{\"claim_id\":\"M-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Stream name containing a . (dot) for exampe` checkout.web` along with a number of other symbols are refused by Nimbrel Probe\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly states the dot example being refused.\"},\n{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Stream names are validated against ^[A-Za-z0-9 -]+$ before the agent registers.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Exact statement present in source a.\"},\n{\"claim_id\":\"M-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"letters, digits, spaces and hyphens only, and nothing else, or the agent refuses to start.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Matches claim wording closely.\"},\n{\"claim_id\":\"M-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Working as intended for now\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Cause and Resolution sections indicate no fix is planned currently.\"},\n{\"claim_id\":\"M-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"one customer wanted the stream name left exactly as it stood because that string was the product name in use everywhere in the org\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Matches claim almost verbatim.\"},\n{\"claim_id\":\"M-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"their reporting keyed of it when\",\"evidence_source\":\"source_a.md\",\"rationale\":\"States the customer's reporting keyed off the string, matching the claim.\"},\n{\"claim_id\":\"M-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"All Nimbrel Probe agents\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Environment section in source a states the issue applies to all agents.\"},\n{\"claim_id\":\"M-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"No fix at present , rename the stream without the refused symbol\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source b's Workaround/Resolution states no fix exists and renaming is the workaround, implying it is the only option.\"},\n{\"claim_id\":\"M-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Rename the stream to drop the unsupported symbols so the Nimbrel Probe agent will register\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Matches first workaround step exactly.\"},\n{\"claim_id\":\"M-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Then carry the orignal name along as a global tag\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Matches second workaround step.\"},\n{\"claim_id\":\"M-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"so at least each trace keeps a link between the real name and the renamed one\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Matches claim about global tag purpose.\"},\n{\"claim_id\":\"M-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"https://docs.nimbrel.example/probe/agent/nodejs/current/configuration.html#global-tags\",\"evidence_source\":\"source_a.md\",\"rationale\":\"URL matches exactly as given in source a.\"},\n{\"claim_id\":\"M-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"https://tickets.nimbrel.example/700Bb00000QrmTD\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Internal ticket URL matches source a.\"},\n{\"claim_id\":\"M-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"https://tickets.nimbrel.example/700Bb00000LnqWs\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Internal ticket URL matches source b.\"}\n]}","ttft_ms":11813,"type":"result","duration_ms":25568,"uuid":"41d6acda-cd51-402d-9249-bd8149b80637","ttft_stream_ms":1369,"time_to_request_ms":155,"first_content_frame_ms":1369,"queued_turn_count":0,"result_index":0}
