{"duration_api_ms":12341,"stop_reason":"end_turn","session_id":"0d7f9028-1df0-454d-923b-66cf1b446773","total_cost_usd":0.0275016,"usage":{"input_tokens":2,"cache_creation_input_tokens":2420,"cache_read_input_tokens":4538,"output_tokens":1691,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2420,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1691,"cache_read_input_tokens":4538,"cache_creation_input_tokens":2420,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2420},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-sonnet-5":{"inputTokens":2,"outputTokens":1691,"cacheReadInputTokens":4538,"cacheCreationInputTokens":2420,"webSearchRequests":0,"costUSD":0.0275016,"contextWindow":1000000,"maxOutputTokens":64000,"thinkingTokens":0,"canonicalModel":"claude-sonnet-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"claims\": [{\"text\": \"The author Rune Delacroix authored the document.\", \"line\": 3, \"span\": \"Author: Rune Delacroix\"}, {\"text\": \"The document was updated 2026-01-29.\", \"line\": 4, \"span\": \"Updated: 2026-01-29\"}, {\"text\": \"The author Marlowe Ferrante authored the document.\", \"line\": 5, \"span\": \"Author: Marlowe Ferrante\"}, {\"text\": \"The document was updated 2026-02-03.\", \"line\": 6, \"span\": \"Updated: 2026-02-03\"}, {\"text\": \"Stream name is one of the mandatory fields for every Nimbrel Probe agent.\", \"line\": 10, \"span\": \"Stream name is one of the mandatory fields for every Nimbrel Probe agent\"}, {\"text\": \"The stream name is what separates one instrumented process from the next.\", \"line\": 10, \"span\": \"is what separates one instrumented process from the next\"}, {\"text\": \"The stream name can't contain arbitrary symbols.\", \"line\": 10, \"span\": \"The stream name can't contain arbitrary symbols\"}, {\"text\": \"This is documented at https://docs.nimbrel.example/probe/agent/java/current/config-core.html#config-stream-name.\", \"line\": 10, \"span\": \"https://docs.nimbrel.example/probe/agent/java/current/config-core.html#config-stream-name\"}, {\"text\": \"This is documented at https://docs.nimbrel.example/probe/agent/browser/current/configuration.html#stream-name.\", \"line\": 10, \"span\": \"https://docs.nimbrel.example/probe/agent/browser/current/configuration.html#stream-name\"}, {\"text\": \"Only letters, digits, spaces and hyphens are accepted in a stream name.\", \"line\": 10, \"span\": \"only letters, digits, spaces and hyphens are accepted\"}, {\"text\": \"A stream name has to match ^[A-Za-z0-9 -]+$.\", \"line\": 10, \"span\": \"it has to match ^[A-Za-z0-9 -]+$\"}, {\"text\": \"A stream name containing a . (dot), such as checkout.web, is refused.\", \"line\": 10, \"span\": \"a stream name containing a . (dot), such as `checkout.web`, along with a number of other symbols, is refused\"}, {\"text\": \"Stream names are validated against ^[A-Za-z0-9 -]+$ before the agent registers.\", \"line\": 13, \"span\": \"Stream names are validated against ^[A-Za-z0-9 -]+$ before the agent registers\"}, {\"text\": \"Only letters, digits, spaces and hyphens are allowed in stream names, and nothing else, or the agent refuses to start.\", \"line\": 13, \"span\": \"letters, digits, spaces and hyphens only, and nothing else, or the agent refuses to start\"}, {\"text\": \"There is no fix planned for the stream name validation behavior.\", \"line\": 16, \"span\": \"there is no fix planned\"}, {\"text\": \"One customer wanted the stream name left exactly as it stood because that string was the product name in use everywhere in the org.\", \"line\": 16, \"span\": \"one customer wanted the stream name left exactly as it stood because that string was the product name in use everywhere in the org\"}, {\"text\": \"The customer's reporting keyed off that string.\", \"line\": 16, \"span\": \"their reporting keyed of it\"}, {\"text\": \"The issue applies to all Nimbrel Probe agents.\", \"line\": 20, \"span\": \"All Nimbrel Probe agents\"}, {\"text\": \"The workaround is the only option since no fix is planned.\", \"line\": 24, \"span\": \"A way round it that works, and the only option since no fix is planned\"}, {\"text\": \"The first step of the workaround is to rename the stream to drop the unsupported symbols so the Nimbrel Probe agent will register.\", \"line\": 26, \"span\": \"Rename the stream to drop the unsupported symbols so the Nimbrel Probe agent will register\"}, {\"text\": \"The second step of the workaround is to carry the original name along as a global tag.\", \"line\": 27, \"span\": \"Then carry the orignal name along as a global tag\"}, {\"text\": \"Carrying the original name as a global tag means each trace keeps a link between the real name and the renamed one.\", \"line\": 27, \"span\": \"so at least each trace keeps a link between the real name and the renamed one\"}, {\"text\": \"Global tags are documented at https://docs.nimbrel.example/probe/agent/nodejs/current/configuration.html#global-tags.\", \"line\": 28, \"span\": \"https://docs.nimbrel.example/probe/agent/nodejs/current/configuration.html#global-tags\"}, {\"text\": \"There is an internal ticket at https://tickets.nimbrel.example/700Bb00000QrmTD.\", \"line\": 31, \"span\": \"https://tickets.nimbrel.example/700Bb00000QrmTD\"}, {\"text\": \"There is an internal ticket at https://tickets.nimbrel.example/700Bb00000LnqWs.\", \"line\": 34, \"span\": \"https://tickets.nimbrel.example/700Bb00000LnqWs\"}]}","ttft_ms":12367,"type":"result","duration_ms":12403,"uuid":"f5f03db1-f0b3-42a9-9ac0-f72e7103fafa","ttft_stream_ms":1481,"time_to_request_ms":93,"first_content_frame_ms":1482,"queued_turn_count":0,"result_index":0}
