ct\":\"SUPPORTED\",\"evidence\":\"E2 is a mechanical fault\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"E4 is an electrical one\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated as an electrical fault.\"},\n{\"claim_id\":\"A-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"they are escalated differently\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Free the pin with the service key\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"cycle the dock twice\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"If the dock takes a bike and releases it on both cycles, close the fault on your handheld.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Escalate E2 to the workshop after 2 failed attempts\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"do not keep cycling a dock that has failed twice\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"repeated forcing bends the pin\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"turns a 20 minute workshop job into a replacement\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"E4 is never a field fix\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated as a heading and confirmed in body.\"},\n{\"claim_id\":\"A-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Report E4 to the electrical contractor the same day.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Field crew do not open the power enclosure under any circumstances.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A station with more than half its docks faulted is taken out of service in the app.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Tell the support desk before you do this, not after.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Riders call about bikes that will not release\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"bikes that will not lock\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"both usually indicate a dock fault rather than a bike fault\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A dock showing E2 has a jammed locking pin.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A dock showing E4 has lost power to the point.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Same meaning as loss of power to the point.\"},\n{\"claim_id\":\"B-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Support desk raises an E2 fault to the field crew.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-007\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"Escalate E2 to the workshop after 2 failed attempts\",\"evidence_source\":\"merged.md\",\"rationale\":\"Text states 2 failed attempts, not 3.\"},\n{\"claim_id\":\"B-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Report E4 to the electrical contractor the same day.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated as raised/reported to the electrical contractor same day.\"},\n{\"claim_id\":\"B-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A rider charged for a journey that ended at a faulted dock gets the journey refunded.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Refund at the time of the call\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"do not wait for the fault to be confirmed\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-012\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"A station with more than half its docks faulted is taken out of service in the app. Tell the support desk before you do this, not after.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The field crew takes the station out of service and merely tells the support desk beforehand, not the support desk itself.\"}\n]}","ttft_ms":7887,"type":"result","duration_ms":20952,"uuid":"9616694a-e410-4941-9094-beb902201cea","ttft_stream_ms":1427,"time_to_request_ms":92,"first_content_frame_ms":1428,"queued_turn_count":0,"result_index":0}
