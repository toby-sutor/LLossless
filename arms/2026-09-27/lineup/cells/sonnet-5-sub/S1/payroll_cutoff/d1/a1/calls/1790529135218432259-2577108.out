_id\":\"M-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Totals must be submitted by 12:00 on the 18th of the month.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Matches source_a's stated deadline exactly.\"},\n{\"claim_id\":\"M-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The 18th is a hard cut-off, not a target.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated verbatim in source_a.\"},\n{\"claim_id\":\"M-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Submissions that arrive after the cut-off are held for the following month's run.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Both sources state this fact in similar wording.\"},\n{\"claim_id\":\"M-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"If the 18th falls on a weekend or a public holiday, the cut-off moves to the last working day before it.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Matches source_a's exact rule.\"},\n{\"claim_id\":\"M-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Submit one file per team.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated in both sources.\"},\n{\"claim_id\":\"M-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The file must list every hourly worker with hours and\\nthe cost centre the hours are charged to.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated in source_a and echoed in source_b.\"},\n{\"claim_id\":\"M-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Blank rows are rejected by the upload page.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated verbatim in source_a.\"},\n{\"claim_id\":\"M-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A correction submitted before the cut-off replaces the earlier file entirely.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Identical statement in both sources.\"},\n{\"claim_id\":\"M-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"After the cut-off, corrections go to the payroll inbox as a written request\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated in both sources.\"},\n{\"claim_id\":\"M-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"After the cut-off, corrections go to the payroll inbox as a written request and\\nare applied to the following month.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states corrections after cutoff are applied to the following month.\"},\n{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"If the upload page is unavailable in the hour before the cut-off, email the\\npayroll team and keep the file.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated verbatim in source_a.\"},\n{\"claim_id\":\"M-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Do not send totals in the body of an email.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated verbatim in source_a.\"},\n{\"claim_id\":\"M-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Teams without terminal access may send paper timesheets to the payroll office by\\ninternal post\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Stated verbatim in source_b.\"},\n{\"claim_id\":\"M-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"to arrive no later than the cut-off.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Stated verbatim in source_b.\"}\n]}","ttft_ms":7427,"type":"result","duration_ms":15731,"uuid":"5f433fbc-1290-4b60-bb6a-b9da6ca7d475","ttft_stream_ms":1385,"time_to_request_ms":107,"first_content_frame_ms":1385,"queued_turn_count":0,"result_index":0}
