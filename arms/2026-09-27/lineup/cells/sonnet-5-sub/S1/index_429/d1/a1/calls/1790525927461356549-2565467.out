{"duration_api_ms":25018,"stop_reason":"end_turn","session_id":"d23d9f90-ba14-4702-b469-a76750f18ff5","total_cost_usd":0.0497356,"usage":{"input_tokens":2,"cache_creation_input_tokens":3166,"cache_read_input_tokens":4538,"output_tokens":3616,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3166,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":3616,"cache_read_input_tokens":4538,"cache_creation_input_tokens":3166,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3166},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-sonnet-5":{"inputTokens":2,"outputTokens":3616,"cacheReadInputTokens":4538,"cacheCreationInputTokens":3166,"webSearchRequests":0,"costUSD":0.0497356,"contextWindow":1000000,"maxOutputTokens":64000,"thinkingTokens":0,"canonicalModel":"claude-sonnet-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"claims\": [{\"text\": \"The document is authored by Priya Raghunathan.\", \"line\": 3, \"span\": \"Author: Priya Raghunathan\"}, {\"text\": \"The document was updated on 2026-03-18.\", \"line\": 4, \"span\": \"Updated: 2026-03-18\"}, {\"text\": \"Append requests to Nimbrel Ledger come back with HTTP 429 Too Many Requests.\", \"line\": 8, \"span\": \"Append requests to Nimbrel Ledger come back with HTTP 429 `Too Many Requests`\"}, {\"text\": \"Nimbrel Relay stalls when a write will not land.\", \"line\": 8, \"span\": \"Nimbrel Relay stalls\"}, {\"text\": \"Batch loaders resend the same envelope when a write will not land.\", \"line\": 8, \"span\": \"batch loaders resend the same envelope\"}, {\"text\": \"Reads against the same shard begin to time out when a write will not land.\", \"line\": 8, \"span\": \"reads against the same shard begin to time out\"}, {\"text\": \"The refusal reaches the client.\", \"line\": 8, \"span\": \"The refusal reaches the client\"}, {\"text\": \"The refusal is written to the Relay logs.\", \"line\": 8, \"span\": \"is written to the Relay and Collector logs as well\"}, {\"text\": \"The refusal is written to the Collector logs.\", \"line\": 8, \"span\": \"is written to the Relay and Collector logs as well\"}, {\"text\": \"A full refusal envelope from a batched append shows the append batch was refused after 0 of 64 envelopes.\", \"line\": 13, \"span\": \"append batch refused after 0 of 64 envelopes\"}, {\"text\": \"The example refusal envelope shows the error type nbl_queue_refused_exception.\", \"line\": 13, \"span\": \"\\\"type\\\":\\\"nbl_queue_refused_exception\\\"\"}, {\"text\": \"The example refusal envelope shows ingest_and_leader_bytes=88121344.\", \"line\": 13, \"span\": \"ingest_and_leader_bytes=88121344\"}, {\"text\": \"The example refusal envelope shows follower_bytes=212992.\", \"line\": 13, \"span\": \"follower_bytes=212992\"}, {\"text\": \"The example refusal envelope shows all_bytes=88334336.\", \"line\": 13, \"span\": \"all_bytes=88334336\"}, {\"text\": \"The example refusal envelope shows ingest_op_bytes=155648.\", \"line\": 13, \"span\": \"ingest_op_bytes=155648\"}, {\"text\": \"The example refusal envelope shows max_ingest_bytes=88080384.\", \"line\": 13, \"span\": \"max_ingest_bytes=88080384\"}, {\"text\": \"The example refusal envelope shows a status of 429.\", \"line\": 13, \"span\": \"\\\"status\\\":429\"}, {\"text\": \"The Ledger operations handbook now covers the same ground under Refused Appends.\", \"line\": 16, \"span\": \"The Ledger operations handbook now covers the same ground under Refused Appends\"}, {\"text\": \"The Ledger operations handbook provides a walkthrough for each of the three refusal paths.\", \"line\": 16, \"span\": \"with a walkthrough for each of the three refusal paths set out below\"}, {\"text\": \"Every Nimbrel Ledger release on every platform can refuse an append this way.\", \"line\": 20, \"span\": \"Every Nimbrel Ledger release on every platform can refuse an append this way\"}, {\"text\": \"A 429 - Too Many Requests reply is what a Ledger node sends once it has nowhere left to put the work.\", \"line\": 24, \"span\": \"A [`429 - Too Many Requests` reply](https://docs.nimbrel.example/ledger/http-status-codes) is what a Ledger node sends once it has nowhere left to put the work\"}, {\"text\": \"A Ledger node has nowhere left to put the work once an append queue or a read queue is full.\", \"line\": 24, \"span\": \"once [an append queue or a read queue is full](https://docs.nimbrel.example/ledger/why-appends-are-refused)\"}, {\"text\": \"There are 3 ways an append draws a 429.\", \"line\": 26, \"span\": \"There are 3 ways an append draws a 429\"}, {\"text\": \"The append or system_append worker pools hold more batches than they have slots for.\", \"line\": 28, \"span\": \"The `append` or `system_append` worker pools hold more batches than they have slots for\"}, {\"text\": \"The command nbctl pool status --all is used in relation to worker pools.\", \"line\": 28, \"span\": \"(`nbctl pool status --all`)\"}, {\"text\": \"The ingest memory guard can refuse the batch.\", \"line\": 29, \"span\": \"The ingest memory guard has refused the batch\"}, {\"text\": \"The command nbctl guard report ingest --counters is used in relation to the ingest memory guard.\", \"line\": 29, \"span\": \"(`nbctl guard report ingest --counters`)\"}, {\"text\": \"A circuit breaker can trip.\", \"line\": 30, \"span\": \"A circuit breaker has tripped\"}, {\"text\": \"The command nbctl breaker list --tripped is used in relation to circuit breakers.\", \"line\": 30, \"span\": \"(`nbctl breaker list --tripped`)\"}, {\"text\": \"A breaker trips on any operation and is not particular to appends.\", \"line\": 30, \"span\": \"a breaker trips on any operation and is not particular to appends\"}, {\"text\": \"From release 4.6 onward, appending to a wide_text column draws a 429 on its own account whenever the batch would otherwise have run the node out of memory.\", \"line\": 32, \"span\": \"**From release 4.6 and release 5.1 onward**, appending to a `wide_text` column draws a 429 on its own account whenever the batch would otherwise have run the node out of memory\"}, {\"text\": \"From release 5.1 onward, appending to a wide_text column draws a 429 on its own account whenever the batch would otherwise have run the node out of memory.\", \"line\": 32, \"span\": \"**From release 4.6 and release 5.1 onward**, appending to a `wide_text` column draws a 429 on its own account whenever the batch would otherwise have run the node out of memory\"}, {\"text\": \"The workaround for the issue is to take append and query load off the cluster for long enough that the queues drain and the nodes fall back under their limits.\", \"line\": 36, \"span\": \"Take append and query load off the cluster for long enough that the queues drain and the nodes fall back under their limits\"}, {\"text\": \"Where batches carry wide_text columns and the cluster runs release 4.6 or later, the workaround is to send fewer envelopes per batch.\", \"line\": 38, \"span\": \"Where batches carry `wide_text` columns and the cluster runs release 4.6 or release 5.1 or later, send fewer envelopes per batch\"}, {\"text\": \"Where batches carry wide_text columns and the cluster runs release 5.1 or later, the workaround is to send fewer envelopes per batch.\", \"line\": 38, \"span\": \"Where batches carry `wide_text` columns and the cluster runs release 4.6 or release 5.1 or later, send fewer envelopes per batch\"}, {\"text\": \"A cluster that refuses appends has been given more work than its hardware can carry.\", \"line\": 42, \"span\": \"A cluster that refuses appends has been given more work than its hardware can carry\"}, {\"text\": \"One resolution option is larger nodes, described as scaling up.\", \"line\": 42, \"span\": \"larger nodes (scale up)\"}, {\"text\": \"Another resolution option is more nodes, described as scaling out.\", \"line\": 42, \"span\": \"or more of them (scale out)\"}, {\"text\": \"Scaling out is recommended when what is wanted is a further copy of the data for availability, per the sizing notes.\", \"line\": 42, \"span\": \"and scale out when what is wanted is a further copy of the data for availability, per [the sizing notes](https://docs.nimbrel.example/ledger/sizing)\"}, {\"text\": \"Splitting a hot stream over more leader shards spreads append load across more nodes.\", \"line\": 44, \"span\": \"Splitting a hot stream over more leader shards spreads append load across more nodes\"}, {\"text\": \"Splitting a hot stream over more leader shards helps in some layouts.\", \"line\": 44, \"span\": \"which helps in some layouts\"}, {\"text\": \"For wide_text columns on release 4.6 and later, the first resolution step is to cut the number of envelopes in each append batch.\", \"line\": 48, \"span\": \"Begin by cutting the number of envelopes in each append batch\"}, {\"text\": \"For wide_text columns on release 5.1 and later, the first resolution step is to cut the number of envelopes in each append batch.\", \"line\": 48, \"span\": \"Begin by cutting the number of envelopes in each append batch\"}, {\"text\": \"Where smaller batches do not clear the issue, the second resolution step is to add processor and memory capacity to the nodes.\", \"line\": 49, \"span\": \"Where smaller batches do not clear it, add processor and memory capacity to the nodes\"}, {\"text\": \"The third resolution step is to raise the ingest_guard.memory.leader.ceiling cluster setting.\", \"line\": 50, \"span\": \"Only then raise the `ingest_guard.memory.leader.ceiling` cluster setting\"}, {\"text\": \"The ingest_guard.memory.leader.ceiling cluster setting defaults to 10% of the heap.\", \"line\": 50, \"span\": \"which defaults to 10% of the heap\"}, {\"text\": \"A higher ceiling lets a node hold more in-flight append memory before refusing.\", \"line\": 50, \"span\": \"A higher ceiling lets a node hold more in-flight append memory before refusing\"}, {\"text\": \"A node holding too much runs out of memory instead of refusing.\", \"line\": 50, \"span\": \"a node holding too much runs out of memory instead of refusing\"}, {\"text\": \"A node running out of memory instead of refusing is the worse outcome.\", \"line\": 50, \"span\": \"which is the worse outcome\"}, {\"text\": \"The ingest_guard.memory.leader.ceiling setting is read at startup.\", \"line\": 50, \"span\": \"The setting is read at startup\"}, {\"text\": \"The cluster must be restarted for a change to the ingest_guard.memory.leader.ceiling setting to take effect.\", \"line\": 50, \"span\": \"so the cluster must be restarted for a change to take\"}, {\"text\": \"Where scaling hardware or configuration changes are not open to you, the load itself is what changes.\", \"line\": 52, \"span\": \"Where none of that is open to you, the load itself is what changes\"}, {\"text\": \"The load can be changed via fewer appends, cheaper queries, or both.\", \"line\": 52, \"span\": \"fewer appends, cheaper queries, or both\"}, {\"text\": \"Refusals that show up only during a spike usually clear on their own once the queues drain.\", \"line\": 52, \"span\": \"Refusals that show up only during a spike usually clear on their own once the queues drain\"}]}","ttft_ms":25040,"type":"result","duration_ms":25081,"uuid":"6dc34da4-60eb-4b3a-bea5-5cc0d8973b37","ttft_stream_ms":1949,"time_to_request_ms":93,"first_content_frame_ms":1950,"queued_turn_count":0,"result_index":0}
