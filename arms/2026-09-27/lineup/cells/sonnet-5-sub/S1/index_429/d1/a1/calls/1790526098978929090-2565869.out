{"duration_api_ms":51970,"stop_reason":"end_turn","session_id":"00c75a70-120b-43b3-a3b9-9a7d77fd7cc2","total_cost_usd":0.09577359999999999,"usage":{"input_tokens":2,"cache_creation_input_tokens":6388,"cache_read_input_tokens":4538,"output_tokens":6931,"output_tokens_details":{"thinking_tokens":3306},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":6388,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":6931,"cache_read_input_tokens":4538,"cache_creation_input_tokens":6388,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6388},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-sonnet-5":{"inputTokens":2,"outputTokens":6931,"cacheReadInputTokens":4538,"cacheCreationInputTokens":6388,"webSearchRequests":0,"costUSD":0.09577359999999999,"contextWindow":1000000,"maxOutputTokens":64000,"thinkingTokens":3306,"canonicalModel":"claude-sonnet-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"verdicts\":[\n{\"claim_id\":\"M-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Append requests to Nimbrel Ledger come back with HTTP 429 `Too Many Requests`.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Matches source_a's opening statement almost verbatim.\"},\n{\"claim_id\":\"M-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nimbrel Relay stalls, batch loaders resend the same envelope, and reads against the same shard begin to time out.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly states Relay stalls when writes fail to land.\"},\n{\"claim_id\":\"M-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nimbrel Relay stalls, batch loaders resend the same envelope, and reads against the same shard begin to time out.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly states batch loaders resend the envelope.\"},\n{\"claim_id\":\"M-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nimbrel Relay stalls, batch loaders resend the same envelope, and reads against the same shard begin to time out.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Directly states reads against the same shard time out.\"},\n{\"claim_id\":\"M-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The refusal reaches the client and is written to the Relay and Collector logs as well.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"States the refusal reaches the client.\"},\n{\"claim_id\":\"M-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The refusal reaches the client and is written to the Relay and Collector logs as well.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"States the refusal is written to Relay and Collector logs.\"},\n{\"claim_id\":\"M-007\",\"verdict\":\"DERIVED\",\"evidence\":\"This note concerns a managed Nimbrel Ledger deployment (NMD) whose share of HTTP `429` replies climbed over a fortnight, as counted at the front proxy.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Fortnight climb at front proxy comes from the summary span; the MLS label is completed by the Environment section's 'Deployment: Managed Ledger Service (MLS)' line for the same deployment.\"},\n{\"claim_id\":\"M-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Front proxy counters agree with the client reports, so the refusals are real and not a client-side accounting error.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"States exactly this confirmation.\"},\n{\"claim_id\":\"M-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"which is what the Ledger does when it refuses work rather than queueing it\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly matches the claim's phrasing about refusing rather than queueing.\"},\n{\"claim_id\":\"M-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"It sets out what the evidence pointed at, which was expensive queries and deep grouping, and what was put forward in response.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"States investigation pointed to expensive queries and deep grouping.\"},\n{\"claim_id\":\"M-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"append batch refused after 0 of 64 envelopes: 429 Too Many Requests: {\\\"error\\\":{\\\"root_cause\\\":[{\\\"type\\\":\\\"nbl_queue_refused_exception\\\",\\\"reason\\\":\\\"refused append on ingest path [ingest_and_leader_bytes=88121344, follower_bytes=212992, all_bytes=88334336, ingest_op_bytes=155648, max_ingest_bytes=88080384]\\\"}]\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The claim's numeric values and description match the sample envelope exactly.\"},\n{\"claim_id\":\"M-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The Ledger operations handbook now covers the same ground under Refused Appends, with a walkthrough for each of the three refusal paths set out below.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"States exactly this.\"},\n{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"with a walkthrough for each of the three refusal paths set out below\",\"evidence_source\":\"source_a.md\",\"rationale\":\"States three refusal paths are set out.\"},\n{\"claim_id\":\"M-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Every Nimbrel Ledger release on every platform can refuse an append this way.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Exact match.\"},\n{\"claim_id\":\"M-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Version: 4.4, 5.x\",\"evidence_source\":\"source_b.md\",\"rationale\":\"States the recorded instance's version.\"},\n{\"claim_id\":\"M-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Deployment: Managed Ledger Service (MLS)\",\"evidence_source\":\"source_b.md\",\"rationale\":\"States the deployment ran on Nimbrel Cloud under MLS, matching the Environment section.\"},\n{\"claim_id\":\"M-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Production Environment: Yes\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Confirms production environment.\"},\n{\"claim_id\":\"M-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"is what a Ledger node sends once it has nowhere left to put the work\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"which is to say once an append queue or a read queue is full\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"There are 3 ways an append draws a 429:\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Exact match.\"},\n{\"claim_id\":\"M-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The `append` or `system_append` worker pools hold more batches than they have slots for\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The ingest memory guard has refused the batch\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A circuit breaker has tripped\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a breaker trips on any operation and is not particular to appends.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"From release 4.6 and release 5.1 onward, appending to a `wide_text` column draws a 429 on its own account whenever the batch would otherwise have run the node out of memory.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Exact match.\"},\n{\"claim_id\":\"M-026\",\"verdict\":\"PARTIAL\",\"evidence\":\"Expensive queries: a handful of queries run for as long as 2 seconds each. A worker slot is unavailable for as long as one of them holds it, and the queue behind it grows.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Contributing factors are supported but neither source labels this scenario a 'worker-pool exhaustion case'.\"},\n{\"claim_id\":\"M-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a handful of queries run for as long as 2 seconds each.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A worker slot is unavailable for as long as one of them holds it\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"and the queue behind it grows.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"grouping on `channel.id` yields a very large number of groups\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"and the memory that costs is charged to the same pool the append path draws on.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"processor load looks unremarkable while memory sits high.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Splitting a hot stream over more leader shards spreads append load across more nodes, which helps in some layouts.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Exact match.\"},\n{\"claim_id\":\"M-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"which defaults to 10% of the heap.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A higher ceiling lets a node hold more in-flight append memory before refusing\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-036\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a node holding too much runs out of memory instead of refusing, which is the worse outcome.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Direct match.\"},\n{\"claim_id\":\"M-037\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The setting is read at startup, so the cluster must be restarted for a change to take.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"States setting is read at startup.\"},\n{\"claim_id\":\"M-038\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The setting is read at startup, so the cluster must be restarted for a change to take.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"States the cluster must be restarted for a change to take effect.\"},\n{\"claim_id\":\"M-039\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Refusals that show up only during a spike usually clear on their own once the queues drain.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Exact match.\"}\n]}","ttft_ms":29572,"type":"result","duration_ms":52032,"uuid":"c1e7b042-5015-4894-94a4-59fde4e81146","ttft_stream_ms":2956,"time_to_request_ms":109,"first_content_frame_ms":2956,"queued_turn_count":0,"result_index":0}
