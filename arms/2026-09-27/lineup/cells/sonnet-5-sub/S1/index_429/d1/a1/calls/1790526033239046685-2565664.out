{"duration_api_ms":64411,"stop_reason":"end_turn","session_id":"31c64419-fda4-4ecb-a7f3-d56e40b340a8","total_cost_usd":0.09951159999999999,"usage":{"input_tokens":2,"cache_creation_input_tokens":3880,"cache_read_input_tokens":4538,"output_tokens":8308,"output_tokens_details":{"thinking_tokens":4901},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3880,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":8308,"cache_read_input_tokens":4538,"cache_creation_input_tokens":3880,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3880},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-sonnet-5":{"inputTokens":2,"outputTokens":8308,"cacheReadInputTokens":4538,"cacheCreationInputTokens":3880,"webSearchRequests":0,"costUSD":0.09951159999999999,"contextWindow":1000000,"maxOutputTokens":64000,"thinkingTokens":4901,"canonicalModel":"claude-sonnet-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"```json\n{\n  \"claims\": [\n    {\n      \"text\": \"Append requests to Nimbrel Ledger come back with HTTP 429 Too Many Requests.\",\n      \"line\": 8,\n      \"span\": \"Append requests to Nimbrel Ledger come back with HTTP 429 `Too Many Requests`.\"\n    },\n    {\n      \"text\": \"Nimbrel Relay stalls when an append write will not land.\",\n      \"line\": 8,\n      \"span\": \"Nimbrel Relay stalls\"\n    },\n    {\n      \"text\": \"Batch loaders resend the same envelope when an append write will not land.\",\n      \"line\": 8,\n      \"span\": \"batch loaders resend the same envelope\"\n    },\n    {\n      \"text\": \"Reads against the same shard begin to time out when an append write will not land.\",\n      \"line\": 8,\n      \"span\": \"reads against the same shard begin to time out\"\n    },\n    {\n      \"text\": \"The refusal reaches the client.\",\n      \"line\": 8,\n      \"span\": \"The refusal reaches the client\"\n    },\n    {\n      \"text\": \"The refusal is written to the Relay and Collector logs as well.\",\n      \"line\": 8,\n      \"span\": \"is written to the Relay and Collector logs as well\"\n    },\n    {\n      \"text\": \"On one managed Nimbrel Ledger deployment (MLS), the share of HTTP 429 replies climbed over a fortnight, as counted at the front proxy.\",\n      \"line\": 10,\n      \"span\": \"the share of HTTP 429 replies climbed over a fortnight, as counted at the front proxy\"\n    },\n    {\n      \"text\": \"Front proxy counters agreed with client-side reports, confirming the refusals were real rather than a client-side accounting error.\",\n      \"line\": 10,\n      \"span\": \"front proxy counters agreed with client-side reports, confirming the refusals were real rather than a client-side accounting error.\"\n    },\n    {\n      \"text\": \"A 429 is what the Ledger returns when it refuses work outright rather than queueing it.\",\n      \"line\": 10,\n      \"span\": \"A 429 is what the Ledger returns when it refuses work outright rather than queueing it.\"\n    },\n    {\n      \"text\": \"Investigation pointed to expensive queries and deep grouping as contributing factors.\",\n      \"line\": 10,\n      \"span\": \"Investigation pointed to expensive queries and deep grouping as contributing factors\"\n    },\n    {\n      \"text\": \"A full refusal envelope from a batched append shows the batch refused after 0 of 64 envelopes with a 429 Too Many Requests error, including ingest_and_leader_bytes=88121344, follower_bytes=212992, all_bytes=88334336, ingest_op_bytes=155648, and max_ingest_bytes=88080384.\",\n      \"line\": 15,\n      \"span\": \"append batch refused after 0 of 64 envelopes: 429 Too Many Requests: {\\\"error\\\":{\\\"root_cause\\\":[{\\\"type\\\":\\\"nbl_queue_refused_exception\\\",\\\"reason\\\":\\\"refused append on ingest path [ingest_and_leader_bytes=88121344, follower_bytes=212992, all_bytes=88334336, ingest_op_bytes=155648, max_ingest_bytes=88080384]\\\"}],\\\"type\\\":\\\"nbl_queue_refused_exception\\\",\\\"reason\\\":\\\"refused append on ingest path [ingest_and_leader_bytes=88121344, follower_bytes=212992, all_bytes=88334336, ingest_op_bytes=155648, max_ingest_bytes=88080384]\\\"},\\\"status\\\":429}\"\n    },\n    {\n      \"text\": \"The Ledger operations handbook now covers the same ground under Refused Appends.\",\n      \"line\": 18,\n      \"span\": \"The Ledger operations handbook now covers the same ground under Refused Appends\"\n    },\n    {\n      \"text\": \"There are three refusal paths set out in the document.\",\n      \"line\": 18,\n      \"span\": \"a walkthrough for each of the three refusal paths set out below\"\n    },\n    {\n      \"text\": \"Every Nimbrel Ledger release on every platform can refuse an append this way.\",\n      \"line\": 22,\n      \"span\": \"Every Nimbrel Ledger release on every platform can refuse an append this way.\"\n    },\n    {\n      \"text\": \"One recorded instance of the issue occurred on Nimbrel Ledger version 4.4 and 5.x.\",\n      \"line\": 22,\n      \"span\": \"One recorded instance occurred on Nimbrel Ledger version 4.4 and 5.x\"\n    },\n    {\n      \"text\": \"The recorded instance ran on Nimbrel Cloud under the Managed Ledger Service (MLS).\",\n      \"line\": 22,\n      \"span\": \"running on Nimbrel Cloud under the Managed Ledger Service (MLS)\"\n    },\n    {\n      \"text\": \"The recorded instance occurred in a production environment.\",\n      \"line\": 22,\n      \"span\": \"in a production environment\"\n    },\n    {\n      \"text\": \"A 429 Too Many Requests reply is what a Ledger node sends once it has nowhere left to put the work.\",\n      \"line\": 26,\n      \"span\": \"A [`429 - Too Many Requests` reply](https://docs.nimbrel.example/ledger/http-status-codes) is what a Ledger node sends once it has nowhere left to put the work\"\n    },\n    {\n      \"text\": \"A Ledger node has nowhere left to put the work once an append queue or a read queue is full.\",\n      \"line\": 26,\n      \"span\": \"which is to say once [an append queue or a read queue is full](https://docs.nimbrel.example/ledger/why-appends-are-refused)\"\n    },\n    {\n      \"text\": \"There are 3 ways an append draws a 429.\",\n      \"line\": 28,\n      \"span\": \"There are 3 ways an append draws a 429:\"\n    },\n    {\n      \"text\": \"The append or system_append worker pools hold more batches than they have slots for.\",\n      \"line\": 30,\n      \"span\": \"The `append` or `system_append` worker pools hold more batches than they have slots for (`nbctl pool status --all`)\"\n    },\n    {\n      \"text\": \"The ingest memory guard has refused the batch.\",\n      \"line\": 31,\n      \"span\": \"The ingest memory guard has refused the batch (`nbctl guard report ingest --counters`).\"\n    },\n    {\n      \"text\": \"A circuit breaker has tripped.\",\n      \"line\": 32,\n      \"span\": \"A circuit breaker has tripped (`nbctl breaker list --tripped`)\"\n    },\n    {\n      \"text\": \"A breaker trips on any operation and is not particular to appends.\",\n      \"line\": 32,\n      \"span\": \"a breaker trips on any operation and is not particular to appends.\"\n    },\n    {\n      \"text\": \"From release 4.6 and release 5.1 onward, appending to a wide_text column draws a 429 on its own account whenever the batch would otherwise have run the node out of memory.\",\n      \"line\": 34,\n      \"span\": \"**From release 4.6 and release 5.1 onward**, appending to a `wide_text` column draws a 429 on its own account whenever the batch would otherwise have run the node out of memory.\"\n    },\n    {\n      \"text\": \"In one worker-pool exhaustion case, contributing factors included expensive queries and deep grouping.\",\n      \"line\": 36,\n      \"span\": \"Contributing factors seen in one worker-pool exhaustion case included expensive queries and deep grouping\"\n    },\n    {\n      \"text\": \"A handful of queries ran for as long as 2 seconds each.\",\n      \"line\": 36,\n      \"span\": \"a handful of queries ran for as long as 2 seconds each\"\n    },\n    {\n      \"text\": \"A worker slot was unavailable for as long as one of the expensive queries held it.\",\n      \"line\": 36,\n      \"span\": \"a worker slot was unavailable for as long as one of them held it\"\n    },\n    {\n      \"text\": \"The queue behind the unavailable worker slot grew.\",\n      \"line\": 36,\n      \"span\": \"so the queue behind it grew\"\n    },\n    {\n      \"text\": \"Grouping on channel.id produced a very large number of groups.\",\n      \"line\": 36,\n      \"span\": \"Grouping on `channel.id` produced a very large number of groups\"\n    },\n    {\n      \"text\": \"The memory cost of grouping on channel.id was charged to the same pool the append path draws on.\",\n      \"line\": 36,\n      \"span\": \"the memory that cost was charged to the same pool the append path draws on\"\n    },\n    {\n      \"text\": \"Processor load looked unremarkable while memory sat high.\",\n      \"line\": 36,\n      \"span\": \"Processor load looked unremarkable while memory sat high\"\n    },\n    {\n      \"text\": \"Splitting a hot stream over more leader shards spreads append load across more nodes.\",\n      \"line\": 50,\n      \"span\": \"Splitting a hot stream over more leader shards spreads append load across more nodes\"\n    },\n    {\n      \"text\": \"The ingest_guard.memory.leader.ceiling cluster setting defaults to 10% of the heap.\",\n      \"line\": 56,\n      \"span\": \"the `ingest_guard.memory.leader.ceiling` cluster setting, which defaults to 10% of the heap\"\n    },\n    {\n      \"text\": \"A higher ceiling lets a node hold more in-flight append memory before refusing.\",\n      \"line\": 57,\n      \"span\": \"A higher ceiling lets a node hold more in-flight append memory before refusing\"\n    },\n    {\n      \"text\": \"A node holding too much memory runs out of memory instead of refusing.\",\n      \"line\": 57,\n      \"span\": \"a node holding too much runs out of memory instead of refusing\"\n    },\n    {\n      \"text\": \"The ingest_guard.memory.leader.ceiling setting is read at startup.\",\n      \"line\": 58,\n      \"span\": \"The setting is read at startup\"\n    },\n    {\n      \"text\": \"The cluster must be restarted for a change to the ingest_guard.memory.leader.ceiling setting to take effect.\",\n      \"line\": 58,\n      \"span\": \"so the cluster must be restarted for a change to take\"\n    },\n    {\n      \"text\": \"Refusals that show up only during a spike usually clear on their own once the queues drain.\",\n      \"line\": 60,\n      \"span\": \"Refusals that show up only during a spike usually clear on their own once the queues drain.\"\n    }\n  ]\n}\n```","ttft_ms":44642,"type":"result","duration_ms":64480,"uuid":"3344df0b-da50-49a7-9f1f-28de5f819e47","ttft_stream_ms":1471,"time_to_request_ms":115,"first_content_frame_ms":1471,"queued_turn_count":0,"result_index":0}
