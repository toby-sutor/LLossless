": 6, \"span\": \"Shelve items alphabetically by the borrower's\\nsurname\"}, {\"text\": \"An item waits on the hold shelf for 7 days.\", \"line\": 11, \"span\": \"An item waits on the hold shelf for 7 days\"}, {\"text\": \"Day one is the day the borrower is notified.\", \"line\": 11, \"span\": \"Day one is the day the borrower is\\nnotified\"}, {\"text\": \"Day one is not the day the item arrived.\", \"line\": 11, \"span\": \"not the day the item arrived\"}, {\"text\": \"The shelf is swept every morning before opening.\", \"line\": 16, \"span\": \"Sweep the shelf every morning before opening\"}, {\"text\": \"Items past 7 days go back into circulation, or on to the next borrower in the queue if there is one.\", \"line\": 16, \"span\": \"Items past 7 days go back into\\ncirculation, or on to the next borrower in the queue if there is one\"}, {\"text\": \"A borrower who asks before the 7 days are up can have the item held for a further 7 days.\", \"line\": 21, \"span\": \"A borrower who asks before the 7 days are up can have the item held for a further\\n7 days\"}, {\"text\": \"The further hold of 7 days is granted once per request.\", \"line\": 22, \"span\": \"This is granted once per request\"}, {\"text\": \"An item that has been on the hold shelf twice without being collected goes back to the shelves.\", \"line\": 26, \"span\": \"An item that has been on the hold shelf twice without being collected goes back\\nto the shelves\"}, {\"text\": \"The request is cancelled when an item has been on the hold shelf twice without being collected.\", \"line\": 26, \"span\": \"the request is cancelled\"}]}","ttft_ms":6091,"type":"result","duration_ms":6128,"uuid":"60df9e52-f747-4949-9ab6-2b6bdf8740b5","ttft_stream_ms":1532,"time_to_request_ms":106,"first_content_frame_ms":1533,"queued_turn_count":0,"result_index":0}
