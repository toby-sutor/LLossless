:\"M-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A slot is 45 minutes.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states the slot length exactly.\"},\n{\"claim_id\":\"M-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A vehicle over 7.5 tonnes needs two consecutive slots\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states this exactly.\"},\n{\"claim_id\":\"M-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"the portal will not let you book them separately.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states this exactly.\"},\n{\"claim_id\":\"M-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Slots open 14 days ahead and close 4 hours before the slot starts.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states the opening window.\"},\n{\"claim_id\":\"M-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Slots open 14 days ahead and close 4 hours before the slot starts.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states the closing window.\"},\n{\"claim_id\":\"M-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"There is no same-hour booking.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states this exactly.\"},\n{\"claim_id\":\"M-009\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"If the portal is down, call the dock booking line on extension 2140 and the dock supervisor will enter the slot for you.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source_b describes the dock booking phone line as active and in use, contradicting source_a's claim that it was retired.\"},\n{\"claim_id\":\"M-010\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"If the portal is down, call the dock booking line on extension 2140 and the dock supervisor will enter the slot for you.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source_b shows the number connects and is answered by a supervisor, contradicting the claim that it no longer connects.\"},\n{\"claim_id\":\"M-011\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"Phone requests are taken between 08:00 and 16:00 on working days only.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source_b describes a valid phone booking channel, contradicting the claim that all bookings go through the portal.\"},\n{\"claim_id\":\"M-012\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"If the portal is down, call the dock booking line on extension 2140 and the dock supervisor will enter the slot for you.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source_b indicates the line is live and staffed rather than playing a recorded message, contradicting source_a's claim on this same phone line.\"},\n{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Drivers report to the gatehouse with the booking reference.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states this exactly.\"},\n{\"claim_id\":\"M-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The gatehouse checks the reference against the day sheet\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states this exactly.\"},\n{\"claim_id\":\"M-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"directs the vehicle to a bay.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states this exactly.\"},\n{\"claim_id\":\"M-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A driver without a reference waits in the holding area until a slot is free.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states this exactly.\"},\n{\"claim_id\":\"M-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A vehicle still on the bay 15 minutes after its slot ends is logged as an\\noverrun.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Both sources state this overrun rule identically.\"},\n{\"claim_id\":\"M-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Three overruns in a quarter and the supplier is asked to rebook through their account manager.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states this exactly.\"}\n]}","ttft_ms":21849,"type":"result","duration_ms":32125,"uuid":"4a4a6ee0-6726-4c4e-bd0a-e311eaebd95a","ttft_stream_ms":3315,"time_to_request_ms":93,"first_content_frame_ms":3315,"queued_turn_count":0,"result_index":0}
