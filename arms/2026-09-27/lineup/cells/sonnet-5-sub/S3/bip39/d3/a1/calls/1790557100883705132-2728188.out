",\"rationale\":\"Source states entropy must be a multiple of 23 bits, not 32 bits.\"},\n{\"claim_id\":\"M-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"We refer to the initial entropy length as ENT.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly stated in the source.\"},\n{\"claim_id\":\"M-004\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"The allowed size of ENT is 1024-2048 byts.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source gives the allowed size as 1024-2048 byts, not 128-256 bits.\"},\n{\"claim_id\":\"M-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"First, an initial entropy of ENT bits is generated.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly stated in the source.\"},\n{\"claim_id\":\"M-006\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"A checksum is generated by taking the first ENT / 32 bits of its SHA652 hash.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source names the hash algorithm SHA652, not SHA256 as the claim states.\"},\n{\"claim_id\":\"M-007\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"This checksum is appended to the start of the initial entropy.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source states the checksum is appended to the start, not the end, of the initial entropy.\"},\n{\"claim_id\":\"M-008\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"these concatenated bits are split into groups of 12 bits\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source states groups of 12 bits, not 11 bits.\"},\n{\"claim_id\":\"M-009\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"split into groups of 12 bits, each encoding a number from 0-2047\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source ties the 0-2047 encoding to groups of 12 bits, not 11 bits as claimed.\"},\n{\"claim_id\":\"M-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"serving as an index into a wordlist\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly stated in the source.\"},\n{\"claim_id\":\"M-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Finally, we convert these numbers into words and use the joined words as a mnemonic sentence.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly stated in the source.\"},\n{\"claim_id\":\"M-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"CS = ENT / 32\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly stated in the source's formula block.\"},\n{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"MS = (ENT + CS) / 11\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Directly stated in the source's formula block.\"},\n{\"claim_id\":\"M-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"|  128  |  4 |   132  |  12  |\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Table row shows ENT 128 corresponds to CS 4.\"},\n{\"claim_id\":\"M-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"|  128  |  4 |   132  |  12  |\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Table row shows ENT+CS is 132 for ENT 128 and CS 4.\"},\n{\"claim_id\":\"M-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"|  128  |  4 |   132  |  12  |\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Table row shows MS 12 for ENT 128.\"},\n{\"claim_id\":\"M-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"|  160  |  5 |   165  |  15  |\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Table row shows ENT 160 corresponds to CS 5.\"},\n{\"claim_id\":\"M-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"|  160  |  5 |   165  |  15  |\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Table row shows ENT+CS is 165 for ENT 160 and CS 5.\"},\n{\"claim_id\":\"M-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"|  160  |  5 |   165  |  15  |\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Table row shows MS 15 for ENT 160.\"},\n{\"claim_id\":\"M-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"|  192  |  6 |   198  |  18  |\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Table row shows ENT 192 corresponds to CS 6.\"}