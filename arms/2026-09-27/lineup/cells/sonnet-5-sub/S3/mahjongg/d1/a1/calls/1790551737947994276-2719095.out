{"duration_api_ms":987365,"stop_reason":"end_turn","session_id":"aa6fe739-4103-4d40-8208-c90f9945ef60","total_cost_usd":0.24618560000000006,"usage":{"input_tokens":2,"cache_creation_input_tokens":18766,"cache_read_input_tokens":4538,"output_tokens":17021,"output_tokens_details":{"thinking_tokens":6537},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":18766,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":17021,"cache_read_input_tokens":4538,"cache_creation_input_tokens":18766,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18766},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-sonnet-5":{"inputTokens":2,"outputTokens":17021,"cacheReadInputTokens":4538,"cacheCreationInputTokens":18766,"webSearchRequests":0,"costUSD":0.24618560000000006,"contextWindow":1000000,"maxOutputTokens":64000,"thinkingTokens":6537,"canonicalModel":"claude-sonnet-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"verdicts\": [\n{\"claim_id\":\"C-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Babcock bezeichnet Mah-Jongg im Vorwort zu seinem Red Book als eine eigene Entwicklung, basierend auf dem alten chinesischen Spiel\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Als Entstehungsort nennt er an anderer Stelle die Stadt Ningpo (heute Ningbo)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"oder die Provinz Fukien (heute Fujian)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es wurde behauptet, es habe das Spiel schon vor 4.000 Jahren zur Zeit der Shang-Dynastie gegeben\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"oder Mah-Jongg sei lange Zeit dem einfachen Volk verboten und nur der Oberschicht vorbehalten gewesen\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Tatsächlich entstand Mah-Jongg erst in der zweiten Hälfte des 19. Jahrhunderts.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die ältesten erhaltenen Spiele datieren um 1870\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die ältesten schriftlichen Hinweise aus dem Jahr 1890\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ursprünglich war Mah-Jongg ein Glücksspiel, das mit Teehäusern und Bordellen in Verbindung stand\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"gegen Ende des 19. Jahrhunderts hatte es sich jedoch auch in bürgerlichen Haushalten etabliert\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und sich von Shanghai aus in andere Teile Chinas verbreitet\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Das Mah-Jongg-Spiel verbreitete sich rasch in China und Japan.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nachdem Babcock das Spiel in den USA bekanntgemacht hatte, erlangte Mah-Jongg weltweite Popularität\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es wurden eigens Fabriken gegründet, um die Nachfrage nach Mah-Jongg-Spielen zu befriedigen\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-026\",\"verdict\":\"SUPPORTED\",\"evidence\":\"zumal das Gerücht umging, importierte Spiele wären mit Viren verseucht\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In Deutschland wurde das Spiel eingeführt durch F. Ad. Richter & Cie, Baukastenfabrik, Rudolstadt\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"(Gebrauchsmusterschutz Nr. 722354 v. 6. November 1919)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein weiterer Mah-Jongg-Hersteller in Deutschland war die Hamburger Nordicus-Golconda Werke.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es gab Mah-Jongg-Zeitschriften\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"in vielen amerikanischen Städten wurden Mah-Jongg-Turniere veranstaltet\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zu den prominenten Förderern des amerikanischen Mah-Jongg-Booms der 1920er-Jahre zählten Fred Astaire sowie Präsident Warren G. Harding und First Lady Florence Harding.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zu den prominenten Förderern des amerikanischen Mah-Jongg-Booms der 1920er-Jahre zählten Fred Astaire sowie Präsident Warren G. Harding und First Lady Florence Harding.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zu den prominenten Förderern des amerikanischen Mah-Jongg-Booms der 1920er-Jahre zählten Fred Astaire sowie Präsident Warren G. Harding und First Lady Florence Harding.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In New York wurde 1937 die National Mah Jongg League gegründet\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-036\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die die Regeln weiter vereinheitlichte und damit die heute als American Mahjong bekannte Spielart maßgeblich prägte\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-037\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und damit die heute als American Mahjong bekannte Spielart maßgeblich prägte\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-038\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Doch bereits wenige Jahre später verschwand Mah-Jongg wie eine Mode und ebenso schnell, wie sie gekommen war.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-039\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Das Spiel ist in China und Japan überaus populär\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-040\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die weltweite Teilnahme an Mah-Jongg-Veranstaltungen hat sich innerhalb eines Jahres mehr als verdreifacht\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-041\",\"verdict\":\"SUPPORTED\",\"evidence\":\"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-042\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Auf YouTube existieren zahlreiche Einführungs- und Lernvideos\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-043\",\"verdict\":\"SUPPORTED\",\"evidence\":\"auf TikTok nahm die Menge der Mah-Jongg-bezogenen Inhalte innerhalb eines Jahres um rund 70 Prozent zu\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-044\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es gibt jedoch keine Hinweise, dass sich das Rummy-Spiel aus dem Mah-Jongg entwickelt hätte oder umgekehrt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-045\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Spielsteine sind bei den besseren Spielen aus zwei Teilen gearbeitet\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-046\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Bilder auf den Vorderseiten sind mit Sticheln in einen kleinen Block aus Bein – früher Elfenbein – eingraviert und koloriert\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-047\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Rückseiten sind aus Bambus\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-048\",\"verdict\":\"SUPPORTED\",\"evidence\":\"diese beiden Teile sind üblicherweise nicht einfach verklebt, sondern verzinkt\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-049\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Steine preisgünstigerer Spiele sind aus bedrucktem Holz oder aus Kunststoff gefertigt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-050\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es gibt auch Mah-Jongg-Kartenspiele.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-051\",\"verdict\":\"SUPPORTED\",\"evidence\":\"bieten auch Luxusmarken wie Hermès, Prada und Louis Vuitton eigene Ausführungen an\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-052\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Mah-Jongg-Spiel besteht aus 136 oder 144 Spielsteinen, die Ziegel genannt werden\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-053\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Mah-Jongg wird in unzähligen Regelvarianten von Chinese Traditional bis Jewish American gespielt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-054\",\"verdict\":\"SUPPORTED\",\"evidence\":\"welche bis auf wenige Unterschiede den Regeln von Joseph P. Babcock entsprechen\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-055\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Diese ist die in Europa gängige Spielweise.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-056\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In der Standard-Variante wird mit 136 Steinen gespielt\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-057\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die acht Ziegel der Hauptfarbe werden nicht verwendet\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-058\",\"verdict\":\"SUPPORTED\",\"evidence\":\"stehen die vier Spieler an den vier Seiten eines quadratischen Tisches\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-059\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der älteste Spieler mischt verdeckt die vier Platzsteine und stapelt sie aufeinander.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-060\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Sodann wirft er zwei Würfel und zählt die Augensumme gegen den Uhrzeigersinn ab, wobei er bei sich selbst zu zählen beginnt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-061\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der solcherart bestimmte Spieler nimmt den obersten Platzstein, der nächste den zweiten usw.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-062\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Spielfläche des Tisches wird als Himmelskarte interpretiert.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-063\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der Spieler, der den Platzstein Ostwind erhält, wird Spielleiter im ersten Spiel und bleibt an seinem Platz\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-064\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Westwind setzt sich gegenüber\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-065\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Südwind zur Rechten (!) von Ostwind\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-066\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und Nordwind zur Linken\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-067\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Ziegel werden verdeckt auf dem Tisch gemischt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-068\",\"verdict\":\"SUPPORTED\",\"evidence\":\"indem er 34 der Ziegel verdeckt nimmt und zu einer 17 Ziegel langen und zwei Ziegel hohen Mauer anordnet\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-069\",\"verdict\":\"SUPPORTED\",\"evidence\":\"so nimmt jeder Spieler 36 Ziegel und die Breite der Mauer beträgt 18 Stapel\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-070\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die vier Mauerstücke werden zusammengeschoben, so dass sie sich an den Ecken berühren und ein Quadrat bilden.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-071\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Außerhalb der asiatischen Länder wird dies manchmal Chinesische Mauer genannt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-072\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nun wirft Ostwind die zwei Würfel und zählt wie vorhin, bei sich selbst beginnend, die Augensumme gegen den Uhrzeigersinn an den Spielern ab.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-073\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der so bestimmte Spieler wirft ebenfalls beide Würfel und zählt die Augensumme beider Würfe zusammen.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-074\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ostwind zählt am rechten Ende der vor ihm befindlichen Mauer beginnend im Uhrzeigersinn der Gesamtsumme entsprechend Ziegelstapel ab.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-075\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Eventuell setzt er die Zählung mit Ziegeln aus der Mauer seines linken Nachbarn fort.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-076\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Den so bestimmten Stapel nimmt er heraus (Mauerdurchbruch) und stellt ihn auf den Stapel rechts neben der entstandenen Lücke.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-077\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die herausgenommenen Steine heißen lose Ziegel und markieren das tote Ende der Mauer\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-078\",\"verdict\":\"SUPPORTED\",\"evidence\":\"das Ende links der Lücke ist das lebende Ende der Mauer\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-079\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Gezogen werden die Steine regulär vom lebenden Ende der Mauer.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-080\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Vom toten Ende werden dagegen nur Ersatzziegel (siehe unten) genommen, beginnend mit den beiden losen Ziegeln.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-081\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Spieler nehmen dreimal reihum gegen den Uhrzeigersinn jeder zwei Stapel zu zwei Ziegel vom lebenden Ende der Mauer, wobei sich Ostwind als erster bedient.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-082\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zuletzt nimmt jeder Spieler noch einen weiteren, dreizehnten, und Ostwind außerdem einen vierzehnten Ziegel.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-083\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Steine werden von der Mauer gezogen oder nach Abwurf eines anderen Spielers aufgenommen.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-084\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Hat ein Spieler ein vollständiges Spielbild bestehend aus vier Figuren und schließlich einem Paar gebildet, so darf er „Mah-Jongg“ rufen und das Spiel beenden.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-085\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die vier Figuren können wahlweise Drillinge, Vierlinge oder Folgen sein.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-086\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Paar besteht aus zwei gleichen Steinen, z. B. zweimal Bambus-Fünf oder zwei grüne Drachen etc.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-087\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Um Mah-Jongg rufen zu können, ist ein vollständiges Spielbild nötig, in diesem muss genau ein Paar, das Schlusspaar (將, jiàng, manchmal 眼, yǎn), enthalten sein.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-088\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zur Vervollständigung eines Paares darf ein abgelegter Stein nur aufgerufen werden, wenn gleichzeitig Mah-Jongg gerufen wird.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-089\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Pong (碰, pèng) besteht aus drei gleichen Steinen.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-090\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird ein Pong ausschließlich aus Ziegeln der ursprünglichen Hand oder von der Mauer gezogenen Ziegeln gebildet, so handelt es sich um einen verdeckten Pong, der nicht gemeldet werden muss.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-091\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird er dennoch aufgedeckt, so sollte er durch ein Umdrehen eines der Steine als eigentlich verdeckt markiert werden.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-092\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Besitzt ein Spieler ein Paar und wird der dritte Stein von einem beliebigen anderen Spieler abgelegt, so darf der Spieler diesen Stein mit dem Ruf „Pong“ aufrufen.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-093\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Er legt sein Paar und den aufgerufenen Ziegel offen vor sich auf den Tisch und besitzt einen offenen Pong.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-094\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In den 1970er und 1980er Jahren wurde im deutschsprachigen Raum statt Pong oftmals der Begriff Pon verwendet.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-095\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Auch in dem 1982 erschienenen Anleitungsbuch von Ursula Eschenbach ist durchgehend von Pon, Kan und Chii die Rede.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-096\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Begriffe Pon (jap. ポン, 碰 pon), Kan (カン, 槓, 杠 kan) oder Chii (チー, 吃 chī) stammen aus der japanischen Spielart des Riichi Mahjong\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-097\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Kong (槓 / 杠, gàng) besteht aus vier gleichen Steinen.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-098\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird ein Kong ausschließlich aus Steinen der ursprünglichen Hand und von der Mauer gezogenen Ziegeln gebildet, so sollte der Spieler einen verdeckten Kong melden.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-099\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Tut er dies nicht, so kann er keinen Ersatzziegel aus der Mauer ziehen, der bei Kongs notwendig ist, um ein komplettes Spielbild zu erreichen.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-100\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird das Spiel beendet, bevor der Spieler den Vierling meldet, so wird der verdeckte Kong als verdeckter Pong gewertet.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-101\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein verdeckter Kong muss nicht sofort gemeldet werden, sondern kann auch später herausgelegt werden, wenn der Spieler erneut am Zug ist.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-102\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Bei der Meldung werden die vier Steine offen ausgelegt und zum Zeichen, dass es sich um einen verdeckten (auch: „halbverdeckten“, oder „aus der Hand gemeldeten“) Kong handelt, werden die beiden äußeren Steine mit der Rückseite nach oben gelegt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Text states tiles laid open (face up) and the two outer tiles placed back side up (face down), matching the claim.\"},\n{\"claim_id\":\"C-103\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Hält ein Spieler drei gleiche Steine in der Hand – also einen verdeckten Pong – so darf er, wenn ein Spieler den vierten Stein ablegt, diesen Ziegel mit dem Ruf „Kong“ für sich beanspruchen und erhält so einen offenen Kong.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-104\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Hat ein Spieler bereits einen offenen Pong gemeldet und wird der fehlende vierte Stein von einem anderen Spieler abgelegt, so kann dieser Ziegel nicht zur Komplettierung des Kongs aufgerufen werden.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-105\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Hat ein Spieler bereits einen Pong gemeldet und zieht er den fehlenden vierten Stein von der Mauer, so darf er ihn an den Pong anlegen und besitzt damit einen offenen Kong.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-106\",\"verdict\":\"SUPPORTED\",\"evidence\":\"kann ein anderer Spieler diesen vierten Stein für sich fordern, wenn er damit „Mah-Jongg“ rufen kann\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-107\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Sobald ein Spieler einen offenen oder verdeckten Kong meldet, muss er einen Ersatzziegel vom toten Ende der Mauer ziehen.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-108\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Chow (吃, chī, manchmal 上, shàng) ist eine Sequenz aus genau drei aufeinanderfolgenden Steinen einer Grundfarbe\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-109\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Sequenzen aus mehr als drei Steinen sind nicht gestattet.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-110\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Chow aus Steinen der Trumpffarbe ist nicht möglich.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-111\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein abgelegter Stein kann von einem Spieler mit „Chow“ aufgerufen werden, wenn der Spieler unmittelbar zur Rechten desjenigen Spielers sitzt, der den betreffenden Stein abgelegt hat.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"}\n]}","ttft_ms":403410,"type":"result","duration_ms":987434,"uuid":"10be65bb-3791-4959-a355-44fb3c866a74","ttft_stream_ms":10398,"time_to_request_ms":113,"first_content_frame_ms":10398,"queued_turn_count":0,"result_index":0}
