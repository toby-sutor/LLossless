{"duration_api_ms":93911,"stop_reason":"end_turn","session_id":"eca8f176-db88-4748-978b-da6dbace8aa6","total_cost_usd":0.1863516,"usage":{"input_tokens":2,"cache_creation_input_tokens":14800,"cache_read_input_tokens":4538,"output_tokens":12624,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":14800,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":12624,"cache_read_input_tokens":4538,"cache_creation_input_tokens":14800,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14800},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-sonnet-5":{"inputTokens":2,"outputTokens":12624,"cacheReadInputTokens":4538,"cacheCreationInputTokens":14800,"webSearchRequests":0,"costUSD":0.1863516,"contextWindow":1000000,"maxOutputTokens":64000,"thinkingTokens":0,"canonicalModel":"claude-sonnet-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"```json\n{\n  \"claims\": [\n    {\"text\": \"Mah-Jongg is a Chinese game for four people.\", \"line\": 1, \"span\": \"ist ein chinesisches Spiel für vier Personen\"},\n    {\"text\": \"Joseph Park Babcock lived from 1893 to 1949.\", \"line\": 5, \"span\": \"Joseph Park Babcock (1893–1949)\"},\n    {\"text\": \"Joseph Park Babcock was an American traveler in the Republic of China.\", \"line\": 5, \"span\": \"ein amerikanischer Reisender in der Republik China\"},\n    {\"text\": \"Joseph Park Babcock wrote a rulebook in the 1920s based on different variants he had encountered.\", \"line\": 5, \"span\": \"verfasste in den 1920er Jahren ein Regelwerk basierend auf unterschiedlichen Varianten, die er kennengelernt hatte\"},\n    {\"text\": \"Joseph Park Babcock brought the game to the USA.\", \"line\": 5, \"span\": \"brachte das Spiel in die USA\"},\n    {\"text\": \"Babcock gave the game the name MAH-JONGG in that spelling.\", \"line\": 5, \"span\": \"Babcock gab ihm den Namen MAH-JONGG (in dieser Schreibweise) genannt\"},\n    {\"text\": \"Babcock had the name MAH-JONGG registered as a trademark.\", \"line\": 5, \"span\": \"den er als Marke eintragen ließ\"},\n    {\"text\": \"This spelling was varied in many ways in order not to violate the trademark protection.\", \"line\": 5, \"span\": \"Um den Markenschutz nicht zu verletzen, wurde diese Schreibung vielfältig variiert\"},\n    {\"text\": \"The name used in the West refers to a sparrow depicted on the Bamboo-One playing tile.\", \"line\": 5, \"span\": \"Dieser im Westen gebräuchliche Name bezeichnet einen Sperling, der auf dem Spielstein Bambus-Eins abgebildet ist\"},\n    {\"text\": \"Babcock simplified the game for the American market.\", \"line\": 5, \"span\": \"Babcock vereinfachte das Spiel für den amerikanischen Markt\"},\n    {\"text\": \"Babcock provided the tiles with, among other things, Roman numerals.\", \"line\": 5, \"span\": \"versah die Steine unter anderem mit römischen Ziffern\"},\n    {\"text\": \"This additionally favored the spread of the game in the United States.\", \"line\": 5, \"span\": \"was die Verbreitung des Spiels in den Vereinigten Staaten zusätzlich begünstigte\"},\n    {\"text\": \"Babcock describes Mah-Jongg in the foreword to his Red Book as his own development based on the old Chinese game.\", \"line\": 7, \"span\": \"Babcock bezeichnet Mah-Jongg im Vorwort zu seinem Red Book als eine eigene Entwicklung, basierend auf dem alten chinesischen Spiel\"},\n    {\"text\": \"The old Chinese game's origin was said by Babcock to be centuries old.\", \"line\": 7, \"span\": \"das seinerseits – zumindest sein Ursprung – Jahrhunderte alt sei\"},\n    {\"text\": \"Babcock wrote \\\"The Chinese game itself was a gradual development of centuries of play in China\\\".\", \"line\": 7, \"span\": \"„The Chinese game itself was a gradual development of centuries of play in China“\"},\n    {\"text\": \"Babcock names the city of Ningpo (today Ningbo) as a possible place of origin elsewhere.\", \"line\": 7, \"span\": \"Als Entstehungsort nennt er an anderer Stelle die Stadt Ningpo (heute Ningbo)\"},\n    {\"text\": \"Babcock names the province of Fukien (today Fujian) as a possible place of origin elsewhere.\", \"line\": 7, \"span\": \"oder die Provinz Fukien (heute Fujian)\"},\n    {\"text\": \"It has been claimed that the game already existed 4,000 years ago at the time of the Shang dynasty.\", \"line\": 9, \"span\": \"Es wurde behauptet, es habe das Spiel schon vor 4.000 Jahren zur Zeit der Shang-Dynastie gegeben\"},\n    {\"text\": \"It has been claimed that Mah-Jongg was forbidden to common people for a long time and reserved only for the upper class.\", \"line\": 9, \"span\": \"oder Mah-Jongg sei lange Zeit dem einfachen Volk verboten und nur der Oberschicht vorbehalten gewesen\"},\n    {\"text\": \"Mah-Jongg actually originated in the second half of the 19th century.\", \"line\": 9, \"span\": \"Tatsächlich entstand Mah-Jongg erst in der zweiten Hälfte des 19. Jahrhunderts\"},\n    {\"text\": \"The oldest surviving sets date from around 1870.\", \"line\": 9, \"span\": \"Die ältesten erhaltenen Spiele datieren um 1870\"},\n    {\"text\": \"The oldest written references date from the year 1890.\", \"line\": 9, \"span\": \"die ältesten schriftlichen Hinweise aus dem Jahr 1890\"},\n    {\"text\": \"Mah-Jongg was originally a gambling game associated with teahouses and brothels.\", \"line\": 9, \"span\": \"Ursprünglich war Mah-Jongg ein Glücksspiel, das mit Teehäusern und Bordellen in Verbindung stand\"},\n    {\"text\": \"By the end of the 19th century Mah-Jongg had also established itself in bourgeois households.\", \"line\": 9, \"span\": \"gegen Ende des 19. Jahrhunderts hatte es sich jedoch auch in bürgerlichen Haushalten etabliert\"},\n    {\"text\": \"Mah-Jongg had spread from Shanghai to other parts of China.\", \"line\": 9, \"span\": \"sich von Shanghai aus in andere Teile Chinas verbreitet\"},\n    {\"text\": \"The Mah-Jongg game spread rapidly in China and Japan.\", \"line\": 9, \"span\": \"Das Mah-Jongg-Spiel verbreitete sich rasch in China und Japan\"},\n    {\"text\": \"After Babcock made the game known in the USA, Mah-Jongg gained worldwide popularity.\", \"line\": 9, \"span\": \"Nachdem Babcock das Spiel in den USA bekanntgemacht hatte, erlangte Mah-Jongg weltweite Popularität\"},\n    {\"text\": \"Factories were specifically founded to meet demand for Mah-Jongg games.\", \"line\": 11, \"span\": \"Es wurden eigens Fabriken gegründet, um die Nachfrage nach Mah-Jongg-Spielen zu befriedigen\"},\n    {\"text\": \"A rumor circulated that imported games were infested with vermin.\", \"line\": 11, \"span\": \"zumal das Gerücht umging, importierte Spiele wären mit Viren verseucht\"},\n    {\"text\": \"The game was introduced in Germany by F. Ad. Richter & Cie, Baukastenfabrik, Rudolstadt.\", \"line\": 11, \"span\": \"In Deutschland wurde das Spiel eingeführt durch F. Ad. Richter & Cie, Baukastenfabrik, Rudolstadt\"},\n    {\"text\": \"The utility model protection was Nr. 722354 dated 6 November 1919.\", \"line\": 11, \"span\": \"Gebrauchsmusterschutz Nr. 722354 v. 6. November 1919\"},\n    {\"text\": \"Another Mah-Jongg manufacturer in Germany was the Hamburg Nordicus-Golconda Werke.\", \"line\": 11, \"span\": \"Ein weiterer Mah-Jongg-Hersteller in Deutschland war die Hamburger Nordicus-Golconda Werke\"},\n    {\"text\": \"There were Mah-Jongg magazines.\", \"line\": 11, \"span\": \"Es gab Mah-Jongg-Zeitschriften\"},\n    {\"text\": \"Mah-Jongg tournaments were held in many American cities.\", \"line\": 11, \"span\": \"in vielen amerikanischen Städten wurden Mah-Jongg-Turniere veranstaltet\"},\n    {\"text\": \"Fred Astaire was among the prominent promoters of the American Mah-Jongg boom of the 1920s.\", \"line\": 11, \"span\": \"Zu den prominenten Förderern des amerikanischen Mah-Jongg-Booms der 1920er-Jahre zählten Fred Astaire\"},\n    {\"text\": \"President Warren G. Harding was among the prominent promoters of the American Mah-Jongg boom of the 1920s.\", \"line\": 11, \"span\": \"sowie Präsident Warren G. Harding\"},\n    {\"text\": \"First Lady Florence Harding was among the prominent promoters of the American Mah-Jongg boom of the 1920s.\", \"line\": 11, \"span\": \"und First Lady Florence Harding\"},\n    {\"text\": \"The National Mah Jongg League was founded in New York in 1937.\", \"line\": 11, \"span\": \"In New York wurde 1937 die National Mah Jongg League gegründet\"},\n    {\"text\": \"The National Mah Jongg League further standardized the rules.\", \"line\": 11, \"span\": \"die die Regeln weiter vereinheitlichte\"},\n    {\"text\": \"This standardization significantly shaped what is known today as American Mahjong.\", \"line\": 11, \"span\": \"und damit die heute als American Mahjong bekannte Spielart maßgeblich prägte\"},\n    {\"text\": \"The worldwide participation in Mah-Jongg events has more than tripled within one year.\", \"line\": 13, \"span\": \"Die weltweite Teilnahme an Mah-Jongg-Veranstaltungen hat sich innerhalb eines Jahres mehr als verdreifacht\"},\n    {\"text\": \"Regular Mah-Jongg events take place in Berlin.\", \"line\": 13, \"span\": \"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\"},\n    {\"text\": \"Regular Mah-Jongg events take place in Helsinki.\", \"line\": 13, \"span\": \"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\"},\n    {\"text\": \"Regular Mah-Jongg events take place in London.\", \"line\": 13, \"span\": \"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\"},\n    {\"text\": \"Regular Mah-Jongg events take place in Los Angeles.\", \"line\": 13, \"span\": \"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\"},\n    {\"text\": \"Regular Mah-Jongg events take place in New York.\", \"line\": 13, \"span\": \"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\"},\n    {\"text\": \"Regular Mah-Jongg events take place in Paris.\", \"line\": 13, \"span\": \"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\"},\n    {\"text\": \"Regular Mah-Jongg events take place in Sydney.\", \"line\": 13, \"span\": \"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\"},\n    {\"text\": \"Numerous introductory and tutorial videos exist on YouTube.\", \"line\": 13, \"span\": \"Auf YouTube existieren zahlreiche Einführungs- und Lernvideos\"},\n    {\"text\": \"On TikTok, the amount of Mah-Jongg-related content increased by around 70 percent within one year.\", \"line\": 13, \"span\": \"auf TikTok nahm die Menge der Mah-Jongg-bezogenen Inhalte innerhalb eines Jahres um rund 70 Prozent zu\"},\n    {\"text\": \"Mah-Jongg can be understood as a variant of the card game Rummy in terms of rules.\", \"line\": 15, \"span\": \"Von den Regeln her kann Mah-Jongg als eine Variante des Kartenspiels Rummy verstanden werden\"},\n    {\"text\": \"There is also a variant of Rummy played with playing stones.\", \"line\": 15, \"span\": \"von dem es ebenfalls eine Variante mit Spielsteinen gibt\"},\n    {\"text\": \"Mah-Jongg is then played with \\\"Chinese\\\" playing cards instead of a French deck.\", \"line\": 15, \"span\": \"Dann wird Mah-Jongg mit „chinesischen“ Spielkarten statt mit französischem Blatt gespielt\"},\n    {\"text\": \"There are no indications that the Rummy game developed from Mah-Jongg or vice versa.\", \"line\": 15, \"span\": \"Es gibt jedoch keine Hinweise, dass sich das Rummy-Spiel aus dem Mah-Jongg entwickelt hätte oder umgekehrt\"},\n    {\"text\": \"The stones of better games have their front faces engraved and colored with burins into a small block of bone, formerly ivory.\", \"line\": 19, \"span\": \"die Bilder auf den Vorderseiten sind mit Sticheln in einen kleinen Block aus Bein – früher Elfenbein – eingraviert und koloriert\"},\n    {\"text\": \"The backs of the tiles are made of bamboo.\", \"line\": 19, \"span\": \"die Rückseiten sind aus Bambus\"},\n    {\"text\": \"These two parts are usually not simply glued but dovetailed.\", \"line\": 19, \"span\": \"diese beiden Teile sind üblicherweise nicht einfach verklebt, sondern verzinkt\"},\n    {\"text\": \"The stones of cheaper games are made from printed wood or plastic.\", \"line\": 19, \"span\": \"Die Steine preisgünstigerer Spiele sind aus bedrucktem Holz oder aus Kunststoff gefertigt\"},\n    {\"text\": \"There are also Mah-Jongg card games.\", \"line\": 19, \"span\": \"Es gibt auch Mah-Jongg-Kartenspiele\"},\n    {\"text\": \"Luxury brands including Hermès offer their own versions of Mah-Jongg sets.\", \"line\": 19, \"span\": \"bieten auch Luxusmarken wie Hermès, Prada und Louis Vuitton eigene Ausführungen an\"},\n    {\"text\": \"Luxury brands including Prada offer their own versions of Mah-Jongg sets.\", \"line\": 19, \"span\": \"bieten auch Luxusmarken wie Hermès, Prada und Louis Vuitton eigene Ausführungen an\"},\n    {\"text\": \"Luxury brands including Louis Vuitton offer their own versions of Mah-Jongg sets.\", \"line\": 19, \"span\": \"bieten auch Luxusmarken wie Hermès, Prada und Louis Vuitton eigene Ausführungen an\"},\n    {\"text\": \"A Mah-Jongg game consists of 136 or 144 playing stones, which are called tiles (Ziegel).\", \"line\": 21, \"span\": \"Ein Mah-Jongg-Spiel besteht aus 136 oder 144 Spielsteinen, die Ziegel genannt werden\"},\n    {\"text\": \"Mah-Jongg is played in countless rule variants from Chinese Traditional to Jewish American.\", \"line\": 27, \"span\": \"Mah-Jongg wird in unzähligen Regelvarianten von Chinese Traditional bis Jewish American gespielt\"},\n    {\"text\": \"The described Hua Bao Rules correspond, apart from a few differences, to the rules of Joseph P. Babcock.\", \"line\": 27, \"span\": \"welche bis auf wenige Unterschiede den Regeln von Joseph P. Babcock entsprechen\"},\n    {\"text\": \"In the standard variant, the game is played with 136 tiles.\", \"line\": 29, \"span\": \"In der Standard-Variante wird mit 136 Steinen gespielt\"},\n    {\"text\": \"The eight tiles of the main suit are not used in the standard variant.\", \"line\": 29, \"span\": \"die acht Ziegel der Hauptfarbe werden nicht verwendet\"},\n    {\"text\": \"Before a game begins, the four players stand at the four sides of a square table.\", \"line\": 35, \"span\": \"Vor Beginn einer Partie stehen die vier Spieler an den vier Seiten eines quadratischen Tisches\"},\n    {\"text\": \"The oldest player shuffles the four seat tiles face down and stacks them on top of each other.\", \"line\": 35, \"span\": \"Der älteste Spieler mischt verdeckt die vier Platzsteine und stapelt sie aufeinander\"},\n    {\"text\": \"He then throws two dice and counts the pip total counterclockwise, starting with himself.\", \"line\": 35, \"span\": \"Sodann wirft er zwei Würfel und zählt die Augensumme gegen den Uhrzeigersinn ab, wobei er bei sich selbst zu zählen beginnt\"},\n    {\"text\": \"The player determined in this way takes the top seat tile, the next one takes the second, and so on.\", \"line\": 35, \"span\": \"Der solcherart bestimmte Spieler nimmt den obersten Platzstein, der nächste den zweiten usw\"},\n    {\"text\": \"The playing surface of the table is interpreted as a sky map.\", \"line\": 37, \"span\": \"Die Spielfläche des Tisches wird als Himmelskarte interpretiert\"},\n    {\"text\": \"The player who receives the seat tile East Wind becomes the game leader in the first game and stays in his place.\", \"line\": 37, \"span\": \"Der Spieler, der den Platzstein Ostwind erhält, wird Spielleiter im ersten Spiel und bleibt an seinem Platz\"},\n    {\"text\": \"West Wind sits opposite East Wind.\", \"line\": 37, \"span\": \"Westwind setzt sich gegenüber\"},\n    {\"text\": \"South Wind sits to the right of East Wind.\", \"line\": 37, \"span\": \"Südwind zur Rechten (!) von Ostwind\"},\n    {\"text\": \"North Wind sits to the left of East Wind.\", \"line\": 37, \"span\": \"und Nordwind zur Linken\"},\n    {\"text\": \"The tiles are shuffled face down on the table.\", \"line\": 41, \"span\": \"Die Ziegel werden verdeckt auf dem Tisch gemischt\"},\n    {\"text\": \"Each of the four players builds one side of the wall by taking 34 of the tiles face down.\", \"line\": 41, \"span\": \"indem er 34 der Ziegel verdeckt nimmt\"},\n    {\"text\": \"The wall is arranged 17 tiles long and two tiles high.\", \"line\": 41, \"span\": \"und zu einer 17 Ziegel langen und zwei Ziegel hohen Mauer anordnet\"},\n    {\"text\": \"When playing with flower and season tiles, each player takes 36 tiles.\", \"line\": 41, \"span\": \"Wird mit Blumen- und Jahreszeitenziegeln gespielt, so nimmt jeder Spieler 36 Ziegel\"},\n    {\"text\": \"When playing with flower and season tiles, the width of the wall is 18 stacks.\", \"line\": 41, \"span\": \"und die Breite der Mauer beträgt 18 Stapel\"},\n    {\"text\": \"The four wall pieces are pushed together so that they touch at the corners and form a square.\", \"line\": 41, \"span\": \"Die vier Mauerstücke werden zusammengeschoben, so dass sie sich an den Ecken berühren und ein Quadrat bilden\"},\n    {\"text\": \"Outside Asian countries this is sometimes called the Chinese Wall.\", \"line\": 41, \"span\": \"Außerhalb der asiatischen Länder wird dies manchmal Chinesische Mauer genannt\"},\n    {\"text\": \"Each player takes two stacks of two tiles three times in a row counterclockwise from the living end of the wall, with East Wind serving first.\", \"line\": 45, \"span\": \"Die Spieler nehmen dreimal reihum gegen den Uhrzeigersinn jeder zwei Stapel zu zwei Ziegel vom lebenden Ende der Mauer, wobei sich Ostwind als erster bedient\"},\n    {\"text\": \"Each player finally takes one more, a thirteenth, tile.\", \"line\": 45, \"span\": \"Zuletzt nimmt jeder Spieler noch einen weiteren, dreizehnten, und Ostwind außerdem einen vierzehnten Ziegel\"},\n    {\"text\": \"East Wind additionally takes a fourteenth tile.\", \"line\": 45, \"span\": \"Zuletzt nimmt jeder Spieler noch einen weiteren, dreizehnten, und Ostwind außerdem einen vierzehnten Ziegel\"},\n    {\"text\": \"A pair consists of two identical tiles, for example two Bamboo-Five tiles or two green dragons.\", \"line\": 55, \"span\": \"Ein Paar besteht aus zwei gleichen Steinen, z. B. zweimal Bambus-Fünf oder zwei grüne Drachen etc\"},\n    {\"text\": \"A complete hand must contain exactly one pair, the final pair.\", \"line\": 57, \"span\": \"in diesem muss genau ein Paar, das Schlusspaar (將, jiàng, manchmal 眼, yǎn), enthalten sein\"},\n    {\"text\": \"A discarded tile may only be called to complete a pair if Mah-Jongg is called at the same time.\", \"line\": 57, \"span\": \"Zur Vervollständigung eines Paares darf ein abgelegter Stein nur aufgerufen werden, wenn gleichzeitig Mah-Jongg gerufen wird\"},\n    {\"text\": \"A Pong consists of three identical tiles.\", \"line\": 61, \"span\": \"Ein Pong (碰, pèng) besteht aus drei gleichen Steinen\"},\n    {\"text\": \"A Pong formed exclusively from tiles of the original hand or tiles drawn from the wall is a concealed Pong that does not need to be declared.\", \"line\": 61, \"span\": \"Wird ein Pong ausschließlich aus Ziegeln der ursprünglichen Hand oder von der Mauer gezogenen Ziegeln gebildet, so handelt es sich um einen verdeckten Pong, der nicht gemeldet werden muss\"},\n    {\"text\": \"In the 1970s and 1980s, the term Pon was often used in German-speaking regions instead of Pong.\", \"line\": 65, \"span\": \"In den 1970er und 1980er Jahren wurde im deutschsprachigen Raum statt Pong oftmals der Begriff Pon verwendet\"},\n    {\"text\": \"In the instruction book published in 1982 by Ursula Eschenbach, the terms Pon, Kan, and Chii are used throughout.\", \"line\": 65, \"span\": \"Auch in dem 1982 erschienenen Anleitungsbuch von Ursula Eschenbach ist durchgehend von Pon, Kan und Chii die Rede\"},\n    {\"text\": \"The terms Pon, Kan, and Chii originate from the Japanese variant of Riichi Mahjong.\", \"line\": 65, \"span\": \"Die Begriffe Pon (jap. ポン, 碰 pon), Kan (カン, 槓, 杠 kan) oder Chii (チー, 吃 chī) stammen aus der japanischen Spielart des Riichi Mahjong\"},\n    {\"text\": \"A Kong consists of four identical tiles.\", \"line\": 69, \"span\": \"Ein Kong (槓 / 杠, gàng) besteht aus vier gleichen Steinen\"},\n    {\"text\": \"A Chow is a sequence of exactly three consecutive tiles of a basic suit.\", \"line\": 87, \"span\": \"Ein Chow (吃, chī, manchmal 上, shàng) ist eine Sequenz aus genau drei aufeinanderfolgenden Steinen einer Grundfarbe\"},\n    {\"text\": \"Sequences of more than three tiles are not permitted.\", \"line\": 87, \"span\": \"Sequenzen aus mehr als drei Steinen sind nicht gestattet\"},\n    {\"text\": \"A Chow made from tiles of the trump suit is not possible.\", \"line\": 89, \"span\": \"Ein Chow aus Steinen der Trumpffarbe ist nicht möglich\"},\n    {\"text\": \"A discarded tile can be called with \\\"Chow\\\" by a player only if that player sits immediately to the right of the player who discarded the tile.\", \"line\": 91, \"span\": \"Ein abgelegter Stein kann von einem Spieler mit „Chow“ aufgerufen werden, wenn der Spieler unmittelbar zur Rechten desjenigen Spielers sitzt, der den betreffenden Stein abgelegt hat\"},\n    {\"text\": \"Mah-Jongg is played counterclockwise.\", \"line\": 99, \"span\": \"Mah-Jongg wird gegen den Uhrzeigersinn gespielt\"},\n    {\"text\": \"The Mah-Jongg caller receives an additional bonus of 10 points credited, often 20 points.\", \"line\": 133, \"span\": \"Der Mah-Jongg-Rufer erhält eine zusätzliche Prämie von 10 (häufig 20) Punkten gutgeschrieben\"},\n    {\"text\": \"Concealed combinations count double.\", \"line\": 123, \"span\": \"Verdeckte Kombinationen zählen das Doppelte\"},\n    {\"text\": \"A Kong counts four times as much as the corresponding Pong.\", \"line\": 127, \"span\": \"Ein Kong zählt viermal so viel wie der entsprechende Pong\"},\n    {\"text\": \"A player who robs the Kong receives an additional bonus of 10 points.\", \"line\": 137, \"span\": \"Für diese Beraubung des Kong erhält er einen zusätzlichen Bonus von 10 Punkten\"},\n    {\"text\": \"Doubling twice quadruples the original value of the hand.\", \"line\": 141, \"span\": \"zweimaliges Verdoppeln vervierfacht beispielsweise den ursprünglichen Wert des Spielbildes\"},\n    {\"text\": \"The limit is usually agreed at 300 or 500 points.\", \"line\": 149, \"span\": \"Dieses beträgt meist 300 oder 500 Punkte\"},\n    {\"text\": \"If a hand consists exclusively of trump-suit tiles, i.e. only wind and dragon tiles, this hand is scored with the maximum point value.\", \"line\": 151, \"span\": \"Besteht das Spielbild des Mah-Jongg-Rufers ausschließlich aus Ziegeln der Trumpffarbe, also nur aus Wind- und Drachenziegeln, so wird diese Hand mit dem Punktemaximum bewertet\"},\n    {\"text\": \"If East Wind can call Mah-Jongg immediately after picking up his tiles, he possesses the Blessing of Heaven and receives the maximum score credited.\", \"line\": 153, \"span\": \"Kann Ostwind sofort nach Aufnehmen seiner Ziegel Mah-Jongg rufen, so besitzt er den Segen des Himmels und erhält das Punktemaximum gutgeschrieben\"},\n    {\"text\": \"If another player can call the first tile discarded by East Wind and thereby declare Mah-Jongg, this is called the Blessing of Earth and the player receives half the limit credited.\", \"line\": 153, \"span\": \"Kann ein anderer Spieler den ersten von Ostwind abgelegten Stein aufrufen und damit Mah-Jongg erklären, so ist dies der Segen der Erde und der Spieler erhält die Hälfte des Limits gutgeschrieben\"},\n    {\"text\": \"When playing with 144 tiles, including the main-suit tiles (flower and season tiles), each side of the wall consists of 18 stacks of tiles.\", \"line\": 165, \"span\": \"Wird Mah-Jongg mit 144 Steinen, also einschließlich der Steine der Hauptfarbe (der Blumen- und Jahreszeitenziegel), gespielt, so besteht jede Seite der Mauer aus 18 Ziegelstapeln\"},\n    {\"text\": \"Main-suit tile No. 1 is assigned to East Wind.\", \"line\": 167, \"span\": \"Nr. 1 gilt für den Ostwind\"},\n    {\"text\": \"Main-suit tile No. 2 is assigned to South Wind.\", \"line\": 167, \"span\": \"Nr. 2 für den Südwind\"},\n    {\"text\": \"Main-suit tile No. 3 is assigned to West Wind.\", \"line\": 167, \"span\": \"Nr. 3 für den Westwind\"},\n    {\"text\": \"Main-suit tile No. 4 is assigned to North Wind.\", \"line\": 167, \"span\": \"und Nr. 4. für den Nordwind\"},\n    {\"text\": \"A round ends as soon as the player who held the position of North Wind in the first game loses a game as East Wind.\", \"line\": 173, \"span\": \"Eine Runde ist beendet, sobald der Spieler, der im ersten Spiel die Position des Nordwindes innehatte, ein Spiel als Ostwind verliert\"},\n    {\"text\": \"A round consists of at least four games.\", \"line\": 173, \"span\": \"Eine Runde besteht aus mindestens vier Spielen\"},\n    {\"text\": \"A full match, if agreed, consists of four rounds.\", \"line\": 175, \"span\": \"so besteht diese aus vier Runden\"},\n    {\"text\": \"In the first round, the East Wind round, East is the prevailing wind.\", \"line\": 175, \"span\": \"In der ersten Runde, der Ostwindrunde, ist Ost der vorherrschende Wind (Rundenwind)\"},\n    {\"text\": \"In the second round, the South Wind round, South Wind prevails.\", \"line\": 175, \"span\": \"in der zweiten Runde (Südwindrunde) herrscht Südwind vor\"},\n    {\"text\": \"The third round is the West Wind round.\", \"line\": 175, \"span\": \"die dritte Runde ist die Westwindrunde\"},\n    {\"text\": \"The fourth round is the North Wind round.\", \"line\": 175, \"span\": \"und die vierte die Nordwindrunde\"},\n    {\"text\": \"Usually no more than two matches are played.\", \"line\": 181, \"span\": \"meist werden nicht mehr als zwei Partien gespielt\"},\n    {\"text\": \"The modern Mah-Jongg was officially recognized in 1998 by the state sports commission of China as the 255th sport.\", \"line\": 187, \"span\": \"so wie es 1998 von der staatlichen Sportkommission Chinas offiziell als 255. Sportart anerkannt wurde\"},\n    {\"text\": \"Babcock listed some of these classic hands in his Red Book of 1920.\", \"line\": 185, \"span\": \"die teilweise bereits Babcock in seinem Red Book von 1920 angeführt hat\"},\n    {\"text\": \"The Finnish manufacturer Lagarto offers a paid Windows version of traditional Mah-Jongg called Four Winds.\", \"line\": 193, \"span\": \"Der finnische Hersteller Lagarto bietet eine kostenpflichtige Windows-Version des traditionellen Mah-Jongg namens Four Winds an\"},\n    {\"text\": \"A player can compete against three players simulated by the software.\", \"line\": 193, \"span\": \"Ein Spieler kann gegen drei durch die Software nachgebildete Spieler antreten\"},\n    {\"text\": \"The KDE project includes a free version of Mah-Jongg called Kajongg.\", \"line\": 193, \"span\": \"Das KDE-Projekt enthält eine kostenfreie Version von Mah-Jongg, die Kajongg genannt wird\"},\n    {\"text\": \"In various parts of the Yakuza game series, such as Yakuza 0, the Japanese variant of Mah-Jongg (Riichi Mahjong) is present as a minigame.\", \"line\": 195, \"span\": \"In verschiedenen Teilen der Yakuza-Spieleserie, wie zum Beispiel Yakuza 0 ist die japanische Variante von Mah-Jongg (Riichi Mahjong) als Minispiel vorhanden\"},\n    {\"text\": \"For iPhone and iPad there is an app in the Apple App Store called Mahjong! by POK-Software, a traditional version simulating up to 3 co-players.\", \"line\": 197, \"span\": \"Für iPhone und iPad gibt es im Apple App Store unter dem Namen Mahjong! von POK-Software eine traditionelle Version, die bis zu 3 Mitspieler simuliert\"},\n    {\"text\": \"From the mid-1980s, Mah-Jongg Solitaire became popular as a computer game initially under the name Shanghai.\", \"line\": 201, \"span\": \"Ab Mitte der 1980er Jahre wurde Mah-Jongg Solitaire zunächst unter dem Namen Shanghai als Computerspiel populär\"},\n    {\"text\": \"The improved graphical capabilities of the new Amiga computer first allowed an appealing display of this game.\", \"line\": 201, \"span\": \"nachdem die verbesserten grafischen Möglichkeiten des neuen Amiga-Computers erstmals eine ansprechende Darstellung dieses Spiels erlaubten\"},\n    {\"text\": \"In the most popular computer game variant, all 144 tiles lie on the table at the start of the game, sometimes in several layers on top of each other.\", \"line\": 203, \"span\": \"Bei der beliebtesten Computerspiel-Variante liegen zu Spielbeginn alle 144 Steine auf dem Tisch, teils in mehreren Lagen übereinander\"},\n    {\"text\": \"Traditionally the playing tiles are arranged in the figure of a dragon or a turtle.\", \"line\": 203, \"span\": \"Traditionell werden die Spielsteine in der Figur eines Drachen oder einer Schildkröte aufgebaut\"},\n    {\"text\": \"A single player must remove all 144 tiles from the table in pairs.\", \"line\": 203, \"span\": \"Ein einzelner Spieler muss paarweise alle 144 Steine vom Tisch nehmen\"},\n    {\"text\": \"In the romantic film comedy Crazy Rich Asians (2018), a Mah-Jongg game forms the dramaturgical climax of a central confrontation.\", \"line\": 225, \"span\": \"In der romantischen Filmkomödie Crazy Rich Asians (2018) bildet eine Mah-Jongg-Partie den dramaturgischen Höhepunkt einer zentralen Konfrontation\"},\n    {\"text\": \"The film Gefahr und Begierde is based on the short story of the same name by Eileen Chang.\", \"line\": 227, \"span\": \"In dem Film Gefahr und Begierde, nach der gleichnamigen Kurzgeschichte von Eileen Chang\"},\n    {\"text\": \"Ang Lee tells the story of a tragic romantic relationship between a resistance fighter and the intelligence chief of the collaborationist government of Wang Jingwei.\", \"line\": 227, \"span\": \"erzählt Ang Lee die Geschichte einer tragischen Liebesbeziehung zwischen einer Widerstandskämpferin und dem Geheimdienstchef der Kollaborationsregierung von Wang Jingwei\"},\n    {\"text\": \"The resistance fighter in the film is played by Tang Wei.\", \"line\": 227, \"span\": \"in denen die Widerstandskämpferin, gespielt von Tang Wei, auf die Ehefrauen der Regierungsmitglieder trifft\"},\n    {\"text\": \"In the crime novel Sous les vents de Neptun (German title \\\"Der vierzehnte Stein\\\") by Fred Vargas (Frédérique Audoin-Rouzeau), the game Mah-Jongg plays a central role.\", \"line\": 229, \"span\": \"Im Kriminalroman Sous les vents de Neptun (dt. „Der vierzehnte Stein“) von Fred Vargas (Frédérique Audoin-Rouzeau) nimmt das Spiel Mah-Jongg eine zentrale Rolle ein\"},\n    {\"text\": \"The book was made into a film in 2008.\", \"line\": 229, \"span\": \"Das Buch wurde 2008 verfilmt\"},\n    {\"text\": \"In the French-Swiss feature film Die Gleichung ihres Lebens (2023), the main character Marguerite learns Mah-Jongg after abandoning her mathematics doctorate.\", \"line\": 231, \"span\": \"Im französisch-Schweizer Spielfilm Die Gleichung ihres Lebens (2023) lernt die Hauptperson Marguerite nach dem Abbruch ihrer Mathematik-Promotion Mah-Jongg\"},\n    {\"text\": \"Marguerite earns considerable income with Mah-Jongg.\", \"line\": 231, \"span\": \"und erzielt erhebliche Einnahmen damit\"}\n  ]\n}\n```","ttft_ms":93940,"type":"result","duration_ms":93975,"uuid":"f5c5c81d-5a82-4887-ab54-2d5dca33e7a0","ttft_stream_ms":1184,"time_to_request_ms":92,"first_content_frame_ms":1185,"queued_turn_count":0,"result_index":0}
