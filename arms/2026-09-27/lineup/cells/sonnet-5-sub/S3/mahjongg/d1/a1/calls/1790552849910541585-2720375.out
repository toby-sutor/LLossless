{"duration_api_ms":105867,"stop_reason":"end_turn","session_id":"9ec7b983-f5e1-4527-9f4f-eb516e92ad50","total_cost_usd":0.2268716,"usage":{"input_tokens":2,"cache_creation_input_tokens":18615,"cache_read_input_tokens":4538,"output_tokens":15150,"output_tokens_details":{"thinking_tokens":5050},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":18615,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":15150,"cache_read_input_tokens":4538,"cache_creation_input_tokens":18615,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18615},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-sonnet-5":{"inputTokens":2,"outputTokens":15150,"cacheReadInputTokens":4538,"cacheCreationInputTokens":18615,"webSearchRequests":0,"costUSD":0.2268716,"contextWindow":1000000,"maxOutputTokens":64000,"thinkingTokens":5050,"canonicalModel":"claude-sonnet-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"verdicts\": [\n{\"claim_id\":\"M-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ist ein chinesisches Spiel für vier Personen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Directly states the game is Chinese and for four people.\"},\n{\"claim_id\":\"M-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Joseph Park Babcock (1893–1949)\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Dates match exactly.\"},\n{\"claim_id\":\"M-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ein amerikanischer Reisender in der Republik China\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Matches claim directly.\"},\n{\"claim_id\":\"M-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"verfasste in den 1920er Jahren ein Regelwerk basierend auf unterschiedlichen Varianten, die er kennengelernt hatte\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Matches claim directly.\"},\n{\"claim_id\":\"M-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"brachte das Spiel in die USA\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Babcock gab ihm den Namen MAH-JONGG (in dieser Schreibweise)\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"den er als Marke eintragen ließ\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Um den Markenschutz nicht zu verletzen, wurde diese Schreibung vielfältig variiert.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Dieser im Westen gebräuchliche Name bezeichnet einen Sperling, der auf dem Spielstein Bambus-Eins abgebildet ist.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Babcock vereinfachte das Spiel für den amerikanischen Markt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"versah die Steine unter anderem mit römischen Ziffern\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"was die Verbreitung des Spiels in den Vereinigten Staaten zusätzlich begünstigte\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Babcock bezeichnet Mah-Jongg im Vorwort zu seinem Red Book als eine eigene Entwicklung, basierend auf dem alten chinesischen Spiel\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"das seinerseits – zumindest sein Ursprung – Jahrhunderte alt sei\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement about centuries-old origin.\"},\n{\"claim_id\":\"M-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The Chinese game itself was a gradual development of centuries of play in China\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Exact quoted phrase matches claim.\"},\n{\"claim_id\":\"M-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Als Entstehungsort nennt er an anderer Stelle die Stadt Ningpo (heute Ningbo) oder die Provinz Fukien (heute Fujian).\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Als Entstehungsort nennt er an anderer Stelle die Stadt Ningpo (heute Ningbo) oder die Provinz Fukien (heute Fujian).\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es wurde behauptet, es habe das Spiel schon vor 4.000 Jahren zur Zeit der Shang-Dynastie gegeben\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"oder Mah-Jongg sei lange Zeit dem einfachen Volk verboten und nur der Oberschicht vorbehalten gewesen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Tatsächlich entstand Mah-Jongg erst in der zweiten Hälfte des 19. Jahrhunderts.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die ältesten erhaltenen Spiele datieren um 1870\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die ältesten schriftlichen Hinweise aus dem Jahr 1890\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ursprünglich war Mah-Jongg ein Glücksspiel, das mit Teehäusern und Bordellen in Verbindung stand\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"gegen Ende des 19. Jahrhunderts hatte es sich jedoch auch in bürgerlichen Haushalten etabliert\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und sich von Shanghai aus in andere Teile Chinas verbreitet\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-026\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Das Mah-Jongg-Spiel verbreitete sich rasch in China und Japan.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nachdem Babcock das Spiel in den USA bekanntgemacht hatte, erlangte Mah-Jongg weltweite Popularität\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es wurden eigens Fabriken gegründet, um die Nachfrage nach Mah-Jongg-Spielen zu befriedigen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-029\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"zumal das Gerücht umging, importierte Spiele wären mit Viren verseucht\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source says the rumor was about games infested with viruses (Viren), not vermin.\"},\n{\"claim_id\":\"M-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In Deutschland wurde das Spiel eingeführt durch F. Ad. Richter & Cie, Baukastenfabrik, Rudolstadt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"(Gebrauchsmusterschutz Nr. 722354 v. 6. November 1919)\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein weiterer Mah-Jongg-Hersteller in Deutschland war die Hamburger Nordicus-Golconda Werke.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es gab Mah-Jongg-Zeitschriften\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"in vielen amerikanischen Städten wurden Mah-Jongg-Turniere veranstaltet\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zu den prominenten Förderern des amerikanischen Mah-Jongg-Booms der 1920er-Jahre zählten Fred Astaire sowie Präsident Warren G. Harding und First Lady Florence Harding.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Fred Astaire named among promoters.\"},\n{\"claim_id\":\"M-036\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zu den prominenten Förderern des amerikanischen Mah-Jongg-Booms der 1920er-Jahre zählten Fred Astaire sowie Präsident Warren G. Harding und First Lady Florence Harding.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Warren G. Harding named among promoters.\"},\n{\"claim_id\":\"M-037\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zu den prominenten Förderern des amerikanischen Mah-Jongg-Booms der 1920er-Jahre zählten Fred Astaire sowie Präsident Warren G. Harding und First Lady Florence Harding.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Florence Harding named among promoters.\"},\n{\"claim_id\":\"M-038\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In New York wurde 1937 die National Mah Jongg League gegründet\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-039\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die die Regeln weiter vereinheitlichte\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-040\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und damit die heute als American Mahjong bekannte Spielart maßgeblich prägte\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-041\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die weltweite Teilnahme an Mah-Jongg-Veranstaltungen hat sich innerhalb eines Jahres mehr als verdreifacht\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-042\",\"verdict\":\"SUPPORTED\",\"evidence\":\"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Berlin listed among cities.\"},\n{\"claim_id\":\"M-043\",\"verdict\":\"SUPPORTED\",\"evidence\":\"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Helsinki listed among cities.\"},\n{\"claim_id\":\"M-044\",\"verdict\":\"SUPPORTED\",\"evidence\":\"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"London listed among cities.\"},\n{\"claim_id\":\"M-045\",\"verdict\":\"SUPPORTED\",\"evidence\":\"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Los Angeles listed among cities.\"},\n{\"claim_id\":\"M-046\",\"verdict\":\"SUPPORTED\",\"evidence\":\"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"New York listed among cities.\"},\n{\"claim_id\":\"M-047\",\"verdict\":\"SUPPORTED\",\"evidence\":\"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Paris listed among cities.\"},\n{\"claim_id\":\"M-048\",\"verdict\":\"SUPPORTED\",\"evidence\":\"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Sydney listed among cities.\"},\n{\"claim_id\":\"M-049\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Auf YouTube existieren zahlreiche Einführungs- und Lernvideos\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-050\",\"verdict\":\"SUPPORTED\",\"evidence\":\"auf TikTok nahm die Menge der Mah-Jongg-bezogenen Inhalte innerhalb eines Jahres um rund 70 Prozent zu\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-051\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Von den Regeln her kann Mah-Jongg als eine Variante des Kartenspiels Rummy verstanden werden\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-052\",\"verdict\":\"SUPPORTED\",\"evidence\":\"von dem es ebenfalls eine Variante mit Spielsteinen gibt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-053\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Dann wird Mah-Jongg mit „chinesischen“ Spielkarten statt mit französischem Blatt gespielt.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-054\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es gibt jedoch keine Hinweise, dass sich das Rummy-Spiel aus dem Mah-Jongg entwickelt hätte oder umgekehrt.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-055\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Bilder auf den Vorderseiten sind mit Sticheln in einen kleinen Block aus Bein – früher Elfenbein – eingraviert und koloriert\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-056\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Rückseiten sind aus Bambus\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-057\",\"verdict\":\"SUPPORTED\",\"evidence\":\"diese beiden Teile sind üblicherweise nicht einfach verklebt, sondern verzinkt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-058\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Steine preisgünstigerer Spiele sind aus bedrucktem Holz oder aus Kunststoff gefertigt.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-059\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es gibt auch Mah-Jongg-Kartenspiele.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-060\",\"verdict\":\"SUPPORTED\",\"evidence\":\"bieten auch Luxusmarken wie Hermès, Prada und Louis Vuitton eigene Ausführungen an\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Hermès named among luxury brands.\"},\n{\"claim_id\":\"M-061\",\"verdict\":\"SUPPORTED\",\"evidence\":\"bieten auch Luxusmarken wie Hermès, Prada und Louis Vuitton eigene Ausführungen an\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Prada named among luxury brands.\"},\n{\"claim_id\":\"M-062\",\"verdict\":\"SUPPORTED\",\"evidence\":\"bieten auch Luxusmarken wie Hermès, Prada und Louis Vuitton eigene Ausführungen an\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Louis Vuitton named among luxury brands.\"},\n{\"claim_id\":\"M-063\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Mah-Jongg-Spiel besteht aus 136 oder 144 Spielsteinen, die Ziegel genannt werden\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-064\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Mah-Jongg wird in unzähligen Regelvarianten von Chinese Traditional bis Jewish American gespielt.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-065\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die folgende Anleitung beschreibt die Hua Bao Rules, welche bis auf wenige Unterschiede den Regeln von Joseph P. Babcock entsprechen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-066\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In der Standard-Variante wird mit 136 Steinen gespielt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-067\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die acht Ziegel der Hauptfarbe werden nicht verwendet\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-068\",\"verdict\":\"SUPPORTED\",\"evidence\":\"stehen die vier Spieler an den vier Seiten eines quadratischen Tisches\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-069\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der älteste Spieler mischt verdeckt die vier Platzsteine und stapelt sie aufeinander.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-070\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Sodann wirft er zwei Würfel und zählt die Augensumme gegen den Uhrzeigersinn ab, wobei er bei sich selbst zu zählen beginnt.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-071\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der solcherart bestimmte Spieler nimmt den obersten Platzstein, der nächste den zweiten usw.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-072\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Spielfläche des Tisches wird als Himmelskarte interpretiert.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-073\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der Spieler, der den Platzstein Ostwind erhält, wird Spielleiter im ersten Spiel und bleibt an seinem Platz\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-074\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Westwind setzt sich gegenüber\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-075\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Südwind zur Rechten (!) von Ostwind\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-076\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und Nordwind zur Linken\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-077\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Ziegel werden verdeckt auf dem Tisch gemischt.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-078\",\"verdict\":\"SUPPORTED\",\"evidence\":\"indem er 34 der Ziegel verdeckt nimmt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-079\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und zu einer 17 Ziegel langen und zwei Ziegel hohen Mauer anordnet\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-080\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird mit Blumen- und Jahreszeitenziegeln gespielt, so nimmt jeder Spieler 36 Ziegel\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-081\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und die Breite der Mauer beträgt 18 Stapel\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-082\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die vier Mauerstücke werden zusammengeschoben, so dass sie sich an den Ecken berühren und ein Quadrat bilden.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-083\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Außerhalb der asiatischen Länder wird dies manchmal Chinesische Mauer genannt.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-084\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Spieler nehmen dreimal reihum gegen den Uhrzeigersinn jeder zwei Stapel zu zwei Ziegel vom lebenden Ende der Mauer, wobei sich Ostwind als erster bedient.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-085\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zuletzt nimmt jeder Spieler noch einen weiteren, dreizehnten, und Ostwind außerdem einen vierzehnten Ziegel.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-086\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und Ostwind außerdem einen vierzehnten Ziegel\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-087\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Paar besteht aus zwei gleichen Steinen, z. B. zweimal Bambus-Fünf oder zwei grüne Drachen etc.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-088\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Um Mah-Jongg rufen zu können, ist ein vollständiges Spielbild nötig, in diesem muss genau ein Paar, das Schlusspaar (將,  jiàng, manchmal 眼,  yǎn), enthalten sein.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-089\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zur Vervollständigung eines Paares darf ein abgelegter Stein nur aufgerufen werden, wenn gleichzeitig Mah-Jongg gerufen wird.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-090\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Pong (碰,  pèng) besteht aus drei gleichen Steinen.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-091\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird ein Pong ausschließlich aus Ziegeln der ursprünglichen Hand oder von der Mauer gezogenen Ziegeln gebildet, so handelt es sich um einen verdeckten Pong, der nicht gemeldet werden muss.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-092\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In den 1970er und 1980er Jahren wurde im deutschsprachigen Raum statt Pong oftmals der Begriff Pon verwendet.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-093\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Auch in dem 1982 erschienenen Anleitungsbuch von Ursula Eschenbach ist durchgehend von Pon, Kan und Chii die Rede.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-094\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Begriffe Pon (jap. ポン, 碰 pon), Kan (カン, 槓, 杠 kan) oder Chii (チー, 吃 chī) stammen aus der japanischen Spielart des Riichi Mahjong (リーチ麻雀, 立直マージャン rīchi mājan).\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-095\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Kong (槓 / 杠,  gàng) besteht aus vier gleichen Steinen.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-096\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Chow (吃,  chī, manchmal 上,  shàng) ist eine Sequenz aus genau drei aufeinanderfolgenden Steinen einer Grundfarbe\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-097\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Sequenzen aus mehr als drei Steinen sind nicht gestattet.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-098\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Chow aus Steinen der Trumpffarbe ist nicht möglich.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-099\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein abgelegter Stein kann von einem Spieler mit „Chow“ aufgerufen werden, wenn der Spieler unmittelbar zur Rechten desjenigen Spielers sitzt, der den betreffenden Stein abgelegt hat.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"},\n{\"claim_id\":\"M-100\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Mah-Jongg wird gegen den Uhrzeigersinn gespielt.\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Direct statement.\"}\n]}","ttft_ms":45179,"type":"result","duration_ms":110426,"uuid":"ae7a81f4-b9ce-4e5c-bceb-dc1014d62951","ttft_stream_ms":5460,"time_to_request_ms":4555,"first_content_frame_ms":5460,"queued_turn_count":0,"result_index":0}
