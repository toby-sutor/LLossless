{"duration_api_ms":110240,"stop_reason":"end_turn","session_id":"7c99c1b8-8555-4442-a901-163db50aa13d","total_cost_usd":0.23154360000000002,"usage":{"input_tokens":2,"cache_creation_input_tokens":18578,"cache_read_input_tokens":4538,"output_tokens":15632,"output_tokens_details":{"thinking_tokens":5985},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":18578,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":15632,"cache_read_input_tokens":4538,"cache_creation_input_tokens":18578,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18578},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-sonnet-5":{"inputTokens":2,"outputTokens":15632,"cacheReadInputTokens":4538,"cacheCreationInputTokens":18578,"webSearchRequests":0,"costUSD":0.23154360000000002,"contextWindow":1000000,"maxOutputTokens":64000,"thinkingTokens":5985,"canonicalModel":"claude-sonnet-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"verdicts\":[\n{\"claim_id\":\"A-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der Mah-Jongg-Rufer erhält eine zusätzliche Prämie von 10 (häufig 20) Punkten gutgeschrieben.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Für diese Beraubung des Kong erhält er einen zusätzlichen Bonus von 10 Punkten.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"zweimaliges Verdoppeln vervierfacht beispielsweise den ursprünglichen Wert des Spielbildes\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Dieses beträgt meist 300 oder 500 Punkte.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Übersteigt der errechnete Punktewert das vereinbarte Limit, so wird das Spielbild nur mit diesem Höchstwert gezählt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Besteht das Spielbild des Mah-Jongg-Rufers ausschließlich aus Ziegeln der Trumpffarbe, also nur aus Wind- und Drachenziegeln, so wird diese Hand mit dem Punktemaximum bewertet.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Kann Ostwind sofort nach Aufnehmen seiner Ziegel Mah-Jongg rufen, so besitzt er den Segen des Himmels und erhält das Punktemaximum gutgeschrieben.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Kann ein anderer Spieler den ersten von Ostwind abgelegten Stein aufrufen und damit Mah-Jongg erklären, so ist dies der Segen der Erde und der Spieler erhält die Hälfte des Limits gutgeschrieben.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird Mah-Jongg mit 144 Steinen, also einschließlich der Steine der Hauptfarbe (der Blumen- und Jahreszeitenziegel), gespielt, so besteht jede Seite der Mauer aus 18 Ziegelstapeln.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Sobald ein Spieler zu Beginn eines Spieles seine Steine aufnimmt, legt er seine Blumen- und Jahreszeitenziegel offen vor sich\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und zieht dafür einen Ersatzziegel vom toten Ende der Mauer\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ebenso wird verfahren, wenn ein Spieler einen solchen Stein von der Mauer kauft.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Ziegel der Hauptfarbe sind den vier Winden zugeordnet\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nr. 1 gilt für den Ostwind\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nr. 2 für den Südwind\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nr. 3 für den Westwind\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nr. 4. für den Nordwind\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wenn Ostwind Mah-Jongg rufen kann, so bleibt er im nächsten Spiel weiter Ostwind\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und auch die übrigen Positionen bleiben unverändert.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wenn ein anderer Spieler Mah-Jongg ruft, so übernimmt der bisherige Südwind die Rolle von Ostwind\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und die Positionen wechseln um einen Platz gegen den Uhrzeigersinn.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Eine Runde ist beendet, sobald der Spieler, der im ersten Spiel die Position des Nordwindes innehatte, ein Spiel als Ostwind verliert\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Eine Runde besteht aus mindestens vier Spielen.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird nicht nur eine einzelne Runde gespielt, sondern eine Partie vereinbart, so besteht diese aus vier Runden.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In der ersten Runde, der Ostwindrunde, ist Ost der vorherrschende Wind (Rundenwind)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-026\",\"verdict\":\"SUPPORTED\",\"evidence\":\"in der zweiten Runde (Südwindrunde) herrscht Südwind vor\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die dritte Runde ist die Westwindrunde\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und die vierte die Nordwindrunde.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Um die einzelnen Spiele und Runden mitzuzählen, wird eine kleine Dose (Mingg) verwendet.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Diese stellt der jeweilige Spieler des Ostwindes vor sich auf den Tisch\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"der Platzstein des vorherrschenden Windes wird oben auf die Mingg gelegt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Vor einer weiteren Partie werden die Sitzplätze neu gelost\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"meist werden nicht mehr als zwei Partien gespielt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Im traditionellen chinesischen Spiel werden bestimmte Spielbilder mit dem Punktemaximum (Limit) bewertet.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die teilweise bereits Babcock in seinem Red Book von 1920 angeführt hat\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-036\",\"verdict\":\"SUPPORTED\",\"evidence\":\"so wie es 1998 von der staatlichen Sportkommission Chinas offiziell als 255. Sportart anerkannt wurde\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-037\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die offiziellen Regeln dieser modernen Spielweise finden bei internationalen Turnieren wie Welt- und Europameisterschaften Anwendung.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-038\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In der Rangliste der European Mahjong Association werden nur Ergebnisse berücksichtigt, die aufgrund dieser Spielregeln erzielt wurden.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-039\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der finnische Hersteller Lagarto bietet eine kostenpflichtige Windows-Version des traditionellen Mah-Jongg namens Four Winds an.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-040\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Spieler kann gegen drei durch die Software nachgebildete Spieler antreten.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-041\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ebenso können über ein Netzwerk mehrere reale Spieler gegeneinander oder gegen die Software antreten.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-042\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Das KDE-Projekt enthält eine kostenfreie Version von Mah-Jongg, die Kajongg genannt wird.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-043\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In verschiedenen Teilen der Yakuza-Spieleserie, wie zum Beispiel Yakuza 0 ist die japanische Variante von Mah-Jongg (Riichi Mahjong) als Minispiel vorhanden.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-044\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Für iPhone und iPad gibt es im Apple App Store unter dem Namen Mahjong! von POK-Software eine traditionelle Version\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"A-045\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die bis zu 3 Mitspieler simuliert.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Viele andere als Mah-Jongg bezeichnete Computerspiele verwenden zwar digitalisierte Formen der Spielsteine\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"sind jedoch meistens Spiele für nur eine Person\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und ähneln von den Regeln einer Patience (Mah-Jongg Solitaire).\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ab Mitte der 1980er Jahre wurde Mah-Jongg Solitaire zunächst unter dem Namen Shanghai als Computerspiel populär\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"nachdem die verbesserten grafischen Möglichkeiten des neuen Amiga-Computers erstmals eine ansprechende Darstellung dieses Spiels erlaubten.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Bei der beliebtesten Computerspiel-Variante liegen zu Spielbeginn alle 144 Steine auf dem Tisch\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"teils in mehreren Lagen übereinander.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Traditionell werden die Spielsteine in der Figur eines Drachen oder einer Schildkröte aufgebaut\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Computerspielvarianten bieten oft viele verschiedene Startfiguren an.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein einzelner Spieler muss paarweise alle 144 Steine vom Tisch nehmen.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Paar darf nur abgetragen werden, wenn beide Steine von keinem anderen Stein teilweise oder vollständig überdeckt sind und an zumindest einer Längsseite freiliegen.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Während die Steine der Hauptfarben jeweils nur einmal vorkommen und keine Paare bilden können\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"dürfen die Blumenziegel und die Jahreszeitenziegel jeweils untereinander beliebig kombiniert werden\",\"evidence_source\":\"merged.md\",\"rationale\":\"States flower tiles can be combined among themselves.\"},\n{\"claim_id\":\"B-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"dürfen die Blumenziegel und die Jahreszeitenziegel jeweils untereinander beliebig kombiniert werden\",\"evidence_source\":\"merged.md\",\"rationale\":\"States season tiles can be combined among themselves.\"},\n{\"claim_id\":\"B-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"beispielsweise Pflaume mit Orchidee\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"oder Winter mit Frühling\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In einigen Varianten sind die Blumen- und Jahreszeitenziegel verdoppelt\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und dafür zum Ausgleich beispielsweise die Windziegel nur zweimal enthalten.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Mitunter kommen die Jahreszeitenziegel doppelt vor und dafür keine Blumenziegel.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Als Weiterentwicklung der Computerspiele gibt es heute Angebote auf dem Netz, auf denen Mahjong Solitaire online gespielt werden kann.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Dabei handelt es sich in der Regel meist um die Spielvariante für Einzelspieler\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"aber durch Bestenlisten oder Wettkämpfe spielt man quasi gegen andere Mahjong-Spieler.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Oft gibt es zusätzliche Funktionen, wie die Anzeige der noch verfügbaren Paare\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"oder die Möglichkeit Spielzüge rückgängig zu machen.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Bei den Online-Varianten haben sich viele Spielarten jenseits der traditionellen Regeln etabliert.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-026\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zum Beispiel können beim Mahjong Connect die identischen Spielsteine nur ausgewählt werden, wenn zwischen ihnen eine Linie gezogen werden kann.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Beim Mahjong Dimensions gibt es kein zweidimensionales Spielfeld\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"sondern die Spielsteine sind zu einem dreidimensionalen Objekt gefügt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In Japan entwickelte sich auf Grundlage des Spiels das Genre Mah-Jongg in Anime und Manga\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"(siehe auch: Saki, Tobaku Mokushiroku Kaiji, Akagi, The Legend of Koizumi)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Dabei dient das Spiel dort häufig als erzählerisches Mittel zur Zuspitzung strategischer und dramatischer Konflikte.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In der romantischen Filmkomödie Crazy Rich Asians (2018)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"bildet eine Mah-Jongg-Partie den dramaturgischen Höhepunkt einer zentralen Konfrontation.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In dem Film Gefahr und Begierde, nach der gleichnamigen Kurzgeschichte von Eileen Chang\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"erzählt Ang Lee die Geschichte einer tragischen Liebesbeziehung zwischen einer Widerstandskämpferin und dem Geheimdienstchef der Kollaborationsregierung von Wang Jingwei.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-036\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Widerstandskämpferin, gespielt von Tang Wei\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-037\",\"verdict\":\"SUPPORTED\",\"evidence\":\"in denen die Widerstandskämpferin, gespielt von Tang Wei, auf die Ehefrauen der Regierungsmitglieder trifft.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-038\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Im Kriminalroman Sous les vents de Neptun (dt. „Der vierzehnte Stein“) von Fred Vargas (Frédérique Audoin-Rouzeau) nimmt das Spiel Mah-Jongg eine zentrale Rolle ein.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-039\",\"verdict\":\"SUPPORTED\",\"evidence\":\"von Fred Vargas (Frédérique Audoin-Rouzeau)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The parenthetical naming convention identifies Frédérique Audoin-Rouzeau as the real name behind the pen name Fred Vargas.\"},\n{\"claim_id\":\"B-040\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Das Buch wurde 2008 verfilmt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-041\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Im französisch-Schweizer Spielfilm Die Gleichung ihres Lebens (2023)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-042\",\"verdict\":\"SUPPORTED\",\"evidence\":\"lernt die Hauptperson Marguerite nach dem Abbruch ihrer Mathematik-Promotion Mah-Jongg\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-043\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und erzielt erhebliche Einnahmen damit.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"B-044\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Struktur des Spiels liefert ihr wiederum Inspirationen für einen Wiedereinstieg in die Mathematik.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ist ein chinesisches Spiel für vier Personen.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Joseph Park Babcock (1893–1949)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Birth year given.\"},\n{\"claim_id\":\"C-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Joseph Park Babcock (1893–1949)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Death year given.\"},\n{\"claim_id\":\"C-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ein amerikanischer Reisender in der Republik China\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"verfasste in den 1920er Jahren ein Regelwerk basierend auf unterschiedlichen Varianten, die er kennengelernt hatte\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und brachte das Spiel in die USA.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Babcock gab ihm den Namen MAH-JONGG (in dieser Schreibweise)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"den er als Marke eintragen ließ.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Dieser im Westen gebräuchliche Name bezeichnet einen Sperling, der auf dem Spielstein Bambus-Eins abgebildet ist.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Babcock vereinfachte das Spiel für den amerikanischen Markt\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"},\n{\"claim_id\":\"C-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und versah die Steine unter anderem mit römischen Ziffern\",\"evidence_source\":\"merged.md\",\"rationale\":\"Directly stated.\"}\n]}","ttft_ms":48256,"type":"result","duration_ms":110307,"uuid":"94b484a8-f111-49d1-a129-22b88df06f0c","ttft_stream_ms":1945,"time_to_request_ms":112,"first_content_frame_ms":1945,"queued_turn_count":0,"result_index":0}
