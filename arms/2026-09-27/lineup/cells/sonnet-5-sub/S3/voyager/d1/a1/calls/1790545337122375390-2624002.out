nditions.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Matches the claim exactly.\"},\n{\"claim_id\":\"A-011\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"Closest approach to Uranus took place at 17:59 ED Jan. 24, 1986\",\"evidence_source\":\"merged.md\",\"rationale\":\"The text gives the year as 1986, not 1968.\"},\n{\"claim_id\":\"A-012\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"at a range of about 81,500 kilometers (50,600 miles)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The text gives 81,500 kilometers with 50,600 miles as the mile equivalent, not 50,640 kilometers.\"},\n{\"claim_id\":\"A-013\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"at a range of about 81,500 kilometers (50,600 miles)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The text states 81,500 kilometers, not 81,500 miles; the mile figure given is 50,600.\"},\n{\"claim_id\":\"B-001\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"Voyager 2 discovered 10 new moons\",\"evidence_source\":\"merged.md\",\"rationale\":\"The text states 10 new moons, not 11.\"},\n{\"claim_id\":\"B-002\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"given such names as Puck, Portia, Juliet, Cressida, Rosalind, Belinda, Desdemona, Cordelia, Ophelia, and Bianca\",\"evidence_source\":\"merged.md\",\"rationale\":\"The names in the text differ in spelling and count from those in the claim.\"},\n{\"claim_id\":\"B-003\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"allusions to Shakespeare, continuing a naming tradition begun in 1852\",\"evidence_source\":\"merged.md\",\"rationale\":\"The text attributes the allusions to Shakespeare, not Goethe.\"},\n{\"claim_id\":\"B-004\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"continuing a naming tradition begun in 1852\",\"evidence_source\":\"merged.md\",\"rationale\":\"The text states the tradition began in 1852, not 1687.\"},\n{\"claim_id\":\"B-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"three new rings in addition to the \\\"older\\\" eight rings\",\"evidence_source\":\"merged.md\",\"rationale\":\"Matches the claim exactly.\"},\n{\"claim_id\":\"B-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a magnetic field tilted at 66 degrees off-axis and off-center\",\"evidence_source\":\"merged.md\",\"rationale\":\"Matches the claim exactly.\"},\n{\"claim_id\":\"B-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"wind speeds in Uranus' atmosphere as high as 450 km/h\",\"evidence_source\":\"merged.md\",\"rationale\":\"Matches the claim exactly.\"},\n{\"claim_id\":\"B-008\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"450 km/h (450.000 meters per hour)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The text states 450.000 meters per hour, not 72400.\"},\n{\"claim_id\":\"B-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a boiling lake of water some 479 miles (900 kilometers) below the top cloud surface\",\"evidence_source\":\"merged.md\",\"rationale\":\"Matches the claim exactly.\"},\n{\"claim_id\":\"B-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a boiling lake of water some 479 miles (900 kilometers) below the top cloud surface\",\"evidence_source\":\"merged.md\",\"rationale\":\"Matches the claim exactly.\"},\n{\"claim_id\":\"B-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Its rings were found to be extremely variable in thickness and transparency.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Matches the claim exactly.\"},\n{\"claim_id\":\"B-012\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"spectacular photos of Miranda, Ariel, Umbriel, Titania, and Oberon\",\"evidence_source\":\"merged.md\",\"rationale\":\"The text lists Ariel, Umbriel, and Titania, not Ariele, Umbrella, and Titan as in the claim.\"},\n{\"claim_id\":\"B-013\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"Miranda, Ariel, Umbriel, Titania, and Oberon, five of Uranus' smaller moons\",\"evidence_source\":\"merged.md\",\"rationale\":\"The text names Titania, not Titan, among the five smaller moons.\"},\n{\"claim_id\":\"B-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\