nce\":\"Light conditions were five-hundred times less than terrestrial conditions\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Exact match.\"},\n{\"claim_id\":\"M-011\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"Closest approach to Uranus took place at 17:59 ED Jan. 24, 1968\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source states the year 1968, not 1986.\"},\n{\"claim_id\":\"M-012\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"a range of about 50,640 kilometers (81,500 miles)\",\"evidence_source\":\"source_a.md\",\"rationale\":\"81,500 is stated as miles, not kilometers.\"},\n{\"claim_id\":\"M-013\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"a range of about 50,640 kilometers (81,500 miles)\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The kilometer figure is 50,640, and 50,600 miles does not match either figure or unit.\"},\n{\"claim_id\":\"M-014\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"Voyager 2 discovered 11 new moons\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source states 11 new moons, not 10.\"},\n{\"claim_id\":\"M-015\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"given such names as Pucka, Portila, Juliette, Kressida, Rosalinde, Belinda, Desdemona, Cordelina, Ophelia, and Bianca II\",\"evidence_source\":\"source_b.md\",\"rationale\":\"The source's names differ from the claim's list (e.g. Pucka vs Puck, Kressida vs Cressida).\"},\n{\"claim_id\":\"M-016\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"obvious allusions to Goethe\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source attributes the naming allusions to Goethe, not Shakespeare.\"},\n{\"claim_id\":\"M-017\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"continuing a naming tradition begun in 1687\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source states the tradition began in 1687, not 1852.\"},\n{\"claim_id\":\"M-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"three new rings in addition to the “older” eight rings\",\"evidence_source\":\"sourc