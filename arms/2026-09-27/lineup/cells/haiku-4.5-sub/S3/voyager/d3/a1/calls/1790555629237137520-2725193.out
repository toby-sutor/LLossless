   },\n    {\n      \"claim_id\": \"A-002\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Voyager 2 was directed to Uranus\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text directly states that the spacecraft was directed to Uranus, supporting the claim.\"\n    },\n    {\n      \"claim_id\": \"A-003\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"a journey that would take about 4,5 years\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text states exactly this duration for the journey to Uranus.\"\n    },\n    {\n      \"claim_id\": \"A-004\",\n      \"verdict\": \"CONTRADICTED\",\n      \"evidence\": \"Its encounter with Jupiter was optimized in part to ensure that future planetary flybys would be possible.\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference describes Voyager 2's Jupiter encounter, not Voyager 3's, contradicting the spacecraft identification in the claim.\"\n    },\n    {\n      \"claim_id\": \"A-005\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"The Uranus encounter's geometry was also defined by the possibility of a future encounter with Saturn\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text states this claim about Uranus encounter geometry and future Saturn encounter possibility.\"\n    },\n    {\n      \"claim_id\": \"A-006\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Voyager 1 had only 6.4 days of close study during its flyby\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text contains this exact statement about Voyager 1's observation duration.\"\n    },\n    {\n      \"claim_id\": \"A-007\",\n      \"verdict\": \"CONTRADICTED\",\n      \"evidence\": \"Voyager 2 became the first human-made object to fly past Uranus\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference identifies Voyager 2, not Voyager 1, as the first to fly past Uranus.\"\n    },\n    {\n      \"claim_id\": \"A-008\",\n      \"verdict\": \"CONTRADICTED\",\n      \"evidence\": \"Its observations began on January 24, 1986\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference gives January 24, 1986 as the observation date, contradicting the claim's Jan. 31, 1987; also refers to Voyager 2, not 1.\"\n    },\n    {\n      \"claim_id\": \"A-009\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"signals took approximately 2,5 hours to reach Earth\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text states this exact signal transmission time.\"\n    },\n    {\n      \"claim_id\": \"A-010\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Light conditions were five-hundred times less than terrestrial conditions\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text contains this exact statement about light conditions.\"\n    },\n    {\n      \"claim_id\": \"A-011\",\n      \"verdict\": \"CONTRADICTED\",\n      \"evidence\": \"Closest approach to Uranus took place at 17:59 on January 24, 1986\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference gives 1986 as the year, contradicting the claim's 1968; time is correct but year is wrong.\"\n    },\n    {\n      \"claim_id\": \"A-012\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"at a range of about 50,640 kilometers (81,500 miles)\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text provides this exact range for the closest approach to Uranus.\"\n    },\n    {\n      \"claim_id\": \"B-001\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Voyager 2 discovered 11 new moons\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text states this discovery directly.\"\n    },\n    {\n      \"claim_id\": \"B-002\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"given such names as Pucka, Portila, Juliette, Kressida, Rosalinde, Belinda, Desdemona, Cordelina, Ophelia, and Bianca II\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text lists these exact moon names.\"\n    },\n    {\n      \"claim_id\": \"B-003\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"a naming tradition begun in 1687\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text confirms a naming tradition was begun in 1687.\"\n    },\n    {\n      \"claim_id\": \"B-004\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"three new rings in addition to the \\\"older\\\" eight rings\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference states three new rings were discovered in addition to eight older rings.\"\n    },\n    {\n      \"claim_id\": \"B-005\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"a magnetic field tilted at 66 degrees off-axis and off-center\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text describes Uranus' magnetic field with these exact specifications.\"\n    },\n    {\n      \"claim_id\": \"B-006\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"wind speeds in Uranus' atmosphere as high as 450 km/h (72400 meters per hour)\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text provides these exact wind speed measurements.\"\n    },\n    {\n      \"claim_id\": \"B-007\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"evidence of a boiling lake of water some 479 miles (900 kilometers) below the top cloud surface\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text describes this finding about a subsurface water body.\"\n    },\n    {\n      \"claim_id\": \"B-008\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Its rings were found to be extremely variable in thickness and transparency\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference describes Uranus' rings as extremely variable in these properties.\"\n    },\n    {\n      \"claim_id\": \"B-009\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Voyager 2 also returned spectacular photos of Miranda, Oberon, Ariele, Umbrella, and Titan\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text confirms these photos were returned for these five moons.\"\n    },\n    {\n      \"claim_id\": \"B-010\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"five of Uranus' smaller moons\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference identifies these five objects as Uranus' smaller moons.\"\n    },\n    {\n      \"claim_id\": \"B-011\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"at a range of only 17.560 miles (28.260 kilometers)\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference provides this exact range for the Miranda flyby.\"\n    },\n    {\n      \"claim_id\": \"B-012\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"the spacecraft came closest to any object so far in its nearly century-long travels\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text states this about the spacecraft's closest approach in its long journey.\"\n    },\n    {\n      \"claim_id\": \"B-013\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Uranus itself appeared generally featureless\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference text characterizes Uranus' appearance as generally featureless.\"\n    },\n    {\n      \"claim_id\": \"B-014\",\n      \"verdict\": \"CONTRADICTED\",\n      \"evidence\": \"the tragic Challenger accident that killed six astronauts during their space shuttle launch on January 28, 1986\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference gives January 28, 1986 as the Challenger accident date, contradicting the claim's Feb. 28, 1986.\"\n    }\n  ]\n}\n```","ttft_ms":21997,"type":"result","duration_ms":34806,"uuid":"83aa39d7-5072-47db-8c7c-5a09346b8e57","ttft_stream_ms":5213,"time_to_request_ms":4465,"first_content_frame_ms":5214,"queued_turn_count":0,"result_index":0}
