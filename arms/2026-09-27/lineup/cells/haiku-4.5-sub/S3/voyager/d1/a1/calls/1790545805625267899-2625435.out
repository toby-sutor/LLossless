  },\n    {\n      \"claim_id\": \"A-008\",\n      \"verdict\": \"CONTRADICTED\",\n      \"evidence\": \"Its short-range observations of the planet began on January 24, 1986\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference identifies the spacecraft as Voyager 2 and the date as January 24, 1986, contradicting Voyager 1 and Jan. 31, 1987.\"\n    },\n    {\n      \"claim_id\": \"A-009\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"signals took approximately 2,5 hours to reach Earth\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference directly states this claim.\"\n    },\n    {\n      \"claim_id\": \"A-010\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Light conditions were five hundred times less than terrestrial conditions\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference states the same fact with identical meaning despite different hyphenation.\"\n    },\n    {\n      \"claim_id\": \"A-011\",\n      \"verdict\": \"CONTRADICTED\",\n      \"evidence\": \"Closest approach to Uranus took place at 17:59 UT on January 24, 1986\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference states 17:59 UT on January 24, 1986, contradicting the claim's 17:59 ED in 1968.\"\n    },\n    {\n      \"claim_id\": \"A-012\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"at a range of about 50,640 kilometers (81,500 miles)\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference directly states this claim.\"\n    },\n    {\n      \"claim_id\": \"B-001\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Voyager 2 discovered 11 new moons\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference directly states this claim.\"\n    },\n    {\n      \"claim_id\": \"B-002\",\n      \"verdict\": \"CONTRADICTED\",\n      \"evidence\": \"Puck, Portia, Juliet, Cressida, Rosalind, Belinda, Desdemona, Cordelia, Ophelia, and Bianca\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference lists different moon names; the claim uses incorrect variants like Pucka, Portila, Juliette, Kressida, Rosalinde, Cordelina, and Bianca II.\"\n    },\n    {\n      \"claim_id\": \"B-003\",\n      \"verdict\": \"CONTRADICTED\",\n      \"evidence\": \"continuing a naming tradition begun in 1787\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference states 1787, not 1687.\"\n    },\n    {\n      \"claim_id\": \"B-004\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"three new rings in addition to the eight older rings\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference directly states this claim.\"\n    },\n    {\n      \"claim_id\": \"B-005\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"a magnetic field tilted at 66 degrees off-axis and off-center\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference directly states this claim.\"\n    },\n    {\n      \"claim_id\": \"B-006\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"wind speeds in Uranus' atmosphere as high as 450 km/h (72,400 meters per hour)\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference states the same values with identical meaning despite comma formatting differences.\"\n    },\n    {\n      \"claim_id\": \"B-007\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"evidence of a boiling lake of water some 479 miles (900 kilometers) below the top cloud surface\",\n      \"evidence_source\": \"merged.md\",\n      \"rationale\": \"The reference directly states this claim.\"\n    },\n    {\n      \"claim_id\": \"B-008\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Its rings were found to be extremely variable in thickness and transparency\",\n      \"evidence_source\": \"merged.md\",\n      