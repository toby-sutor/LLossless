{"duration_api_ms":177679,"stop_reason":"end_turn","session_id":"a43aaa48-a1df-420f-8e97-0215678c7d5c","total_cost_usd":0.12193199999999998,"usage":{"input_tokens":10,"cache_creation_input_tokens":10261,"cache_read_input_tokens":0,"output_tokens":20280,"output_tokens_details":{"thinking_tokens":8966},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":10261,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":10,"output_tokens":20280,"cache_read_input_tokens":0,"cache_creation_input_tokens":10261,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10261},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":10,"outputTokens":20280,"cacheReadInputTokens":0,"cacheCreationInputTokens":10261,"webSearchRequests":0,"costUSD":0.12193199999999998,"contextWindow":200000,"maxOutputTokens":32000,"thinkingTokens":8966,"canonicalModel":"claude-haiku-4-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"```json\n{\n  \"claims\": [\n    {\n      \"text\": \"Mah-Jongg is a Chinese game for four persons.\",\n      \"line\": 2,\n      \"span\": \"ist ein chinesisches Spiel für vier Personen\"\n    },\n    {\n      \"text\": \"Joseph Park Babcock lived from 1893–1949.\",\n      \"line\": 6,\n      \"span\": \"Joseph Park Babcock (1893–1949)\"\n    },\n    {\n      \"text\": \"Joseph Park Babcock was an American traveler in the Republic of China.\",\n      \"line\": 6,\n      \"span\": \"ein amerikanischer Reisender in der Republik China\"\n    },\n    {\n      \"text\": \"Joseph Park Babcock wrote a ruleset in the 1920s.\",\n      \"line\": 6,\n      \"span\": \"verfasste in den 1920er Jahren ein Regelwerk\"\n    },\n    {\n      \"text\": \"Joseph Park Babcock brought the game to the USA.\",\n      \"line\": 6,\n      \"span\": \"brachte das Spiel in die USA\"\n    },\n    {\n      \"text\": \"Babcock gave the game the name MAH-JONGG.\",\n      \"line\": 6,\n      \"span\": \"Babcock gab ihm den Namen MAH-JONGG (in dieser Schreibweise)\"\n    },\n    {\n      \"text\": \"Babcock registered MAH-JONGG as a trademark.\",\n      \"line\": 6,\n      \"span\": \"den er als Marke eintragen ließ\"\n    },\n    {\n      \"text\": \"The Western name designates a sparrow depicted on the Bamboo-One tile.\",\n      \"line\": 6,\n      \"span\": \"Dieser im Westen gebräuchliche Name bezeichnet einen Sperling, der auf dem Spielstein Bambus-Eins abgebildet ist\"\n    },\n    {\n      \"text\": \"Babcock simplified the game for the American market.\",\n      \"line\": 6,\n      \"span\": \"Babcock vereinfachte das Spiel für den amerikanischen Markt\"\n    },\n    {\n      \"text\": \"Babcock equipped the tiles with Roman numerals among other things.\",\n      \"line\": 6,\n      \"span\": \"versah die Steine unter anderem mit römischen Ziffern\"\n    },\n    {\n      \"text\": \"The use of Roman numerals additionally facilitated the spread of the game in the United States.\",\n      \"line\": 6,\n      \"span\": \"was die Verbreitung des Spiels in den Vereinigten Staaten zusätzlich begünstigte\"\n    },\n    {\n      \"text\": \"In the foreword to his Red Book, Babcock describes Mah-Jongg as his own development based on the old Chinese game.\",\n      \"line\": 8,\n      \"span\": \"Babcock bezeichnet Mah-Jongg im Vorwort zu seinem Red Book als eine eigene Entwicklung, basierend auf dem alten chinesischen Spiel\"\n    },\n    {\n      \"text\": \"According to Babcock, the origin of the Chinese game is centuries old.\",\n      \"line\": 8,\n      \"span\": \"das seinerseits – zumindest sein Ursprung – Jahrhunderte alt sei\"\n    },\n    {\n      \"text\": \"Babcock names the city of Ningpo (today Ningbo) as a place of origin.\",\n      \"line\": 8,\n      \"span\": \"nennt er an anderer Stelle die Stadt Ningpo (heute Ningbo)\"\n    },\n    {\n      \"text\": \"Babcock names the province of Fukien (today Fujian) as a place of origin.\",\n      \"line\": 8,\n      \"span\": \"oder die Provinz Fukien (heute Fujian)\"\n    },\n    {\n      \"text\": \"It was claimed that the game existed 4,000 years ago at the time of the Shang Dynasty.\",\n      \"line\": 10,\n      \"span\": \"Es wurde behauptet, es habe das Spiel schon vor 4.000 Jahren zur Zeit der Shang-Dynastie gegeben\"\n    },\n    {\n      \"text\": \"It was claimed that Mah-Jongg was long forbidden to common people and reserved only for the upper class.\",\n      \"line\": 10,\n      \"span\": \"oder Mah-Jongg sei lange Zeit dem einfachen Volk verboten und nur der Oberschicht vorbehalten gewesen\"\n    },\n    {\n      \"text\": \"Mah-Jongg actually originated in the second half of the 19th century.\",\n      \"line\": 10,\n      \"span\": \"Tatsächlich entstand Mah-Jongg erst in der zweiten Hälfte des 19. Jahrhunderts\"\n    },\n    {\n      \"text\": \"The oldest surviving games date around 1870.\",\n      \"line\": 10,\n      \"span\": \"Die ältesten erhaltenen Spiele datieren um 1870\"\n    },\n    {\n      \"text\": \"The oldest written references are from the year 1890.\",\n      \"line\": 10,\n      \"span\": \"die ältesten schriftlichen Hinweise aus dem Jahr 1890\"\n    },\n    {\n      \"text\": \"Originally, Mah-Jongg was a gambling game associated with teahouses and brothels.\",\n      \"line\": 10,\n      \"span\": \"Ursprünglich war Mah-Jongg ein Glücksspiel, das mit Teehäusern und Bordellen in Verbindung stand\"\n    },\n    {\n      \"text\": \"By the end of the 19th century, Mah-Jongg had established itself in bourgeois households.\",\n      \"line\": 10,\n      \"span\": \"gegen Ende des 19. Jahrhunderts hatte es sich jedoch auch in bürgerlichen Haushalten etabliert\"\n    },\n    {\n      \"text\": \"By the end of the 19th century, Mah-Jongg had spread from Shanghai to other parts of China.\",\n      \"line\": 10,\n      \"span\": \"und sich von Shanghai aus in andere Teile Chinas verbreitet\"\n    },\n    {\n      \"text\": \"The Mah-Jongg game spread rapidly in China and Japan.\",\n      \"line\": 10,\n      \"span\": \"Das Mah-Jongg-Spiel verbreitete sich rasch in China und Japan\"\n    },\n    {\n      \"text\": \"After Babcock made the game known in the USA, Mah-Jongg gained worldwide popularity comparable to Canasta in the 1950s.\",\n      \"line\": 10,\n      \"span\": \"Nachdem Babcock das Spiel in den USA bekanntgemacht hatte, erlangte Mah-Jongg weltweite Popularität – vergleichbar dem Canasta in den 1950er Jahren\"\n    },\n    {\n      \"text\": \"Factories were established specifically to satisfy the demand for Mah-Jongg games.\",\n      \"line\": 12,\n      \"span\": \"Es wurden eigens Fabriken gegründet, um die Nachfrage nach Mah-Jongg-Spielen zu befriedigen\"\n    },\n    {\n      \"text\": \"There was a rumor that imported games were contaminated with viruses.\",\n      \"line\": 12,\n      \"span\": \"zumal das Gerücht umging, importierte Spiele wären mit Viren verseucht\"\n    },\n    {\n      \"text\": \"The game was introduced in Germany by F. Ad. Richter & Cie, Baukastenfabrik, Rudolstadt.\",\n      \"line\": 12,\n      \"span\": \"In Deutschland wurde das Spiel eingeführt durch F. Ad. Richter & Cie, Baukastenfabrik, Rudolstadt\"\n    },\n    {\n      \"text\": \"F. Ad. Richter & Cie received Gebrauchsmusterschutz Nr. 722354 v. 6. November 1919 for Mah-Jongg.\",\n      \"line\": 12,\n      \"span\": \"(Gebrauchsmusterschutz Nr. 722354 v. 6. November 1919)\"\n    },\n    {\n      \"text\": \"The Hamburger Nordicus-Golconda Werke was another Mah-Jongg manufacturer in Germany.\",\n      \"line\": 12,\n      \"span\": \"Ein weiterer Mah-Jongg-Hersteller in Deutschland war die Hamburger Nordicus-Golconda Werke\"\n    },\n    {\n      \"text\": \"There were Mah-Jongg magazines.\",\n      \"line\": 12,\n      \"span\": \"Es gab Mah-Jongg-Zeitschriften\"\n    },\n    {\n      \"text\": \"Mah-Jongg tournaments were held in many American cities.\",\n      \"line\": 12,\n      \"span\": \"in vielen amerikanischen Städten wurden Mah-Jongg-Turniere veranstaltet\"\n    },\n    {\n      \"text\": \"Fred Astaire was a prominent promoter of the American Mah-Jongg boom of the 1920s.\",\n      \"line\": 12,\n      \"span\": \"Zu den prominenten Förderern des amerikanischen Mah-Jongg-Booms der 1920er-Jahre zählten Fred Astaire\"\n    },\n    {\n      \"text\": \"President Warren G. Harding was a prominent promoter of the American Mah-Jongg boom of the 1920s.\",\n      \"line\": 12,\n      \"span\": \"sowie Präsident Warren G. Harding\"\n    },\n    {\n      \"text\": \"First Lady Florence Harding was a prominent promoter of the American Mah-Jongg boom of the 1920s.\",\n      \"line\": 12,\n      \"span\": \"und First Lady Florence Harding\"\n    },\n    {\n      \"text\": \"The National Mah Jongg League was founded in New York in 1937.\",\n      \"line\": 12,\n      \"span\": \"In New York wurde 1937 die National Mah Jongg League gegründet\"\n    },\n    {\n      \"text\": \"The National Mah Jongg League further standardized the rules.\",\n      \"line\": 12,\n      \"span\": \"die die Regeln weiter vereinheitlichte\"\n    },\n    {\n      \"text\": \"The National Mah Jongg League significantly shaped what is today known as American Mahjong.\",\n      \"line\": 12,\n      \"span\": \"und damit die heute als American Mahjong bekannte Spielart maßgeblich prägte\"\n    },\n    {\n      \"text\": \"A few years later, Mah-Jongg disappeared like a fad.\",\n      \"line\": 14,\n      \"span\": \"Doch bereits wenige Jahre später verschwand Mah-Jongg wie eine Mode\"\n    },\n    {\n      \"text\": \"The game is extremely popular in China and Japan.\",\n      \"line\": 14,\n      \"span\": \"Das Spiel ist in China und Japan überaus populär\"\n    },\n    {\n      \"text\": \"Outside East Asia, the number of interested people was long lower.\",\n      \"line\": 14,\n      \"span\": \"außerhalb Ostasiens war die Zahl der Interessenten lange geringer\"\n    },\n    {\n      \"text\": \"Since the 2020s, a clear resurgence can be observed particularly in major western cities.\",\n      \"line\": 14,\n      \"span\": \"seit den 2020er Jahren lässt sich jedoch besonders in westlichen Großstädten wieder ein deutlicher Aufschwung beobachten\"\n    },\n    {\n      \"text\": \"Worldwide participation in Mah-Jongg events has more than tripled within one year.\",\n      \"line\": 14,\n      \"span\": \"Die weltweite Teilnahme an Mah-Jongg-Veranstaltungen hat sich innerhalb eines Jahres mehr als verdreifacht\"\n    },\n    {\n      \"text\": \"Regular events take place in Berlin, Helsinki, London, Los Angeles, New York, Paris and Sydney among other places.\",\n      \"line\": 14,\n      \"span\": \"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\"\n    },\n    {\n      \"text\": \"Social media contributes to this development.\",\n      \"line\": 14,\n      \"span\": \"Auch soziale Medien tragen zu dieser Entwicklung bei\"\n    },\n    {\n      \"text\": \"Numerous introductory and educational videos exist on YouTube.\",\n      \"line\": 14,\n      \"span\": \"Auf YouTube existieren zahlreiche Einführungs- und Lernvideos\"\n    },\n    {\n      \"text\": \"The amount of Mah-Jongg-related content on TikTok increased by approximately 70 percent within one year.\",\n      \"line\": 14,\n      \"span\": \"auf TikTok nahm die Menge der Mah-Jongg-bezogenen Inhalte innerhalb eines Jahres um rund 70 Prozent zu\"\n    },\n    {\n      \"text\": \"Mah-Jongg can be understood in terms of rules as a variant of the card game Rummy.\",\n      \"line\": 16,\n      \"span\": \"Von den Regeln her kann Mah-Jongg als eine Variante des Kartenspiels Rummy verstanden werden\"\n    },\n    {\n      \"text\": \"Rummy also has a variant with tiles.\",\n      \"line\": 16,\n      \"span\": \"von dem es ebenfalls eine Variante mit Spielsteinen gibt\"\n    },\n    {\n      \"text\": \"Mah-Jongg is played with \\\"Chinese\\\" cards instead of a French deck.\",\n      \"line\": 16,\n      \"span\": \"Dann wird Mah-Jongg mit \\\"chinesischen\\\" Spielkarten statt mit französischem Blatt gespielt\"\n    },\n    {\n      \"text\": \"There is no evidence that Rummy developed from Mah-Jongg or vice versa.\",\n      \"line\": 16,\n      \"span\": \"Es gibt jedoch keine Hinweise, dass sich das Rummy-Spiel aus dem Mah-Jongg entwickelt hätte oder umgekehrt\"\n    },\n    {\n      \"text\": \"Descent from a (hypothetical) common ancestor is not proven.\",\n      \"line\": 16,\n      \"span\": \"Die Abstammung von einem (hypothetischen) gemeinsamen Vorfahren ist nicht erwiesen\"\n    },\n    {\n      \"text\": \"Mah-Jongg games are available in various versions.\",\n      \"line\": 20,\n      \"span\": \"Mah-Jongg-Spiele sind in den verschiedenen Ausführungen erhältlich\"\n    },\n    {\n      \"text\": \"The tiles in better games are made from two parts.\",\n      \"line\": 20,\n      \"span\": \"Die Spielsteine sind bei den besseren Spielen aus zwei Teilen gearbeitet\"\n    },\n    {\n      \"text\": \"The images on the front are engraved with chisels into a small block of bone (formerly ivory) and colored.\",\n      \"line\": 20,\n      \"span\": \"die Bilder auf den Vorderseiten sind mit Sticheln in einen kleinen Block aus Bein – früher Elfenbein – eingraviert und koloriert\"\n    },\n    {\n      \"text\": \"The backs are made of bamboo.\",\n      \"line\": 20,\n      \"span\": \"die Rückseiten sind aus Bambus\"\n    },\n    {\n      \"text\": \"The two parts are usually not simply glued but are riveted.\",\n      \"line\": 20,\n      \"span\": \"diese beiden Teile sind üblicherweise nicht einfach verklebt, sondern verzinkt\"\n    },\n    {\n      \"text\": \"The tiles of cheaper games are made from printed wood or plastic.\",\n      \"line\": 20,\n      \"span\": \"Die Steine preisgünstigerer Spiele sind aus bedrucktem Holz oder aus Kunststoff gefertigt\"\n    },\n    {\n      \"text\": \"There are also Mah-Jongg card games.\",\n      \"line\": 20,\n      \"span\": \"Es gibt auch Mah-Jongg-Kartenspiele\"\n    },\n    {\n      \"text\": \"In the 21st century, Mah-Jongg sets are increasingly marketed as design objects.\",\n      \"line\": 20,\n      \"span\": \"Im 21. Jahrhundert werden Mah-Jongg-Sets zudem zunehmend als Designobjekte vermarktet\"\n    },\n    {\n      \"text\": \"In addition to modernly designed thematic tile sets, luxury brands such as Hermès, Prada and Louis Vuitton also offer their own versions.\",\n      \"line\": 20,\n      \"span\": \"neben modern gestalteten thematischen Steinsätzen bieten auch Luxusmarken wie Hermès, Prada und Louis Vuitton eigene Ausführungen an\"\n    },\n    {\n      \"text\": \"A Mah-Jongg game consists of 136 or 144 tiles.\",\n      \"line\": 22,\n      \"span\": \"Ein Mah-Jongg-Spiel besteht aus 136 oder 144 Spielsteinen\"\n    },\n    {\n      \"text\": \"Mah-Jongg is played in countless rule variants from Chinese Traditional to Jewish American.\",\n      \"line\": 28,\n      \"span\": \"Mah-Jongg wird in unzähligen Regelvarianten von Chinese Traditional bis Jewish American gespielt\"\n    },\n    {\n      \"text\": \"The following instructions describe the Hua Bao Rules.\",\n      \"line\": 28,\n      \"span\": \"Die folgende Anleitung beschreibt die Hua Bao Rules\"\n    },\n    {\n      \"text\": \"The Hua Bao Rules correspond to the rules of Joseph P. Babcock except for a few differences.\",\n      \"line\": 28,\n      \"span\": \"welche bis auf wenige Unterschiede den Regeln von Joseph P. Babcock entsprechen\"\n    },\n    {\n      \"text\": \"The Hua Bao Rules represent the common core of the various variants.\",\n      \"line\": 28,\n      \"span\": \"und den gemeinsamen Kern der mannigfaltigen Varianten darstellen\"\n    },\n    {\n      \"text\": \"The Hua Bao Rules are the common way to play in Europe.\",\n      \"line\": 28,\n      \"span\": \"Diese ist die in Europa gängige Spielweise\"\n    },\n    {\n      \"text\": \"In the standard variant, 136 tiles are used.\",\n      \"line\": 30,\n      \"span\": \"In der Standard-Variante wird mit 136 Steinen gespielt\"\n    },\n    {\n      \"text\": \"In the standard variant, the eight tiles of the main color are not used.\",\n      \"line\": 30,\n      \"span\": \"die acht Ziegel der Hauptfarbe werden nicht verwendet\"\n    },\n    {\n      \"text\": \"Before the start of a game, the four players stand at the four sides of a square table.\",\n      \"line\": 36,\n      \"span\": \"Vor Beginn einer Partie stehen die vier Spieler an den vier Seiten eines quadratischen Tisches\"\n    },\n    {\n      \"text\": \"The oldest player shuffles the four seat tiles face-down and stacks them.\",\n      \"line\": 36,\n      \"span\": \"Der älteste Spieler mischt verdeckt die vier Platzsteine und stapelt sie aufeinander\"\n    },\n    {\n      \"text\": \"He then rolls two dice and counts the sum of the pips counterclockwise, starting with himself.\",\n      \"line\": 36,\n      \"span\": \"Sodann wirft er zwei Würfel und zählt die Augensumme gegen den Uhrzeigersinn ab, wobei er bei sich selbst zu zählen beginnt\"\n    },\n    {\n      \"text\": \"The player thus determined takes the top seat tile, the next one takes the second, etc.\",\n      \"line\": 36,\n      \"span\": \"Der solcherart bestimmte Spieler nimmt den obersten Platzstein, der nächste den zweiten usw\"\n    },\n    {\n      \"text\": \"The playing surface of the table is interpreted as a celestial map.\",\n      \"line\": 38,\n      \"span\": \"Die Spielfläche des Tisches wird als Himmelskarte interpretiert\"\n    },\n    {\n      \"text\": \"The player who receives the East Wind seat tile becomes the game leader in the first game and stays in his place.\",\n      \"line\": 38,\n      \"span\": \"Der Spieler, der den Platzstein Ostwind erhält, wird Spielleiter im ersten Spiel und bleibt an seinem Platz\"\n    },\n    {\n      \"text\": \"West Wind sits opposite.\",\n      \"line\": 38,\n      \"span\": \"Westwind setzt sich gegenüber\"\n    },\n    {\n      \"text\": \"South Wind sits to the right (!) of East Wind.\",\n      \"line\": 38,\n      \"span\": \"Südwind zur Rechten (!) von Ostwind\"\n    },\n    {\n      \"text\": \"North Wind sits to the left.\",\n      \"line\": 38,\n      \"span\": \"und Nordwind zur Linken\"\n    },\n    {\n      \"text\": \"The tiles are shuffled face-down on the table.\",\n      \"line\": 42,\n      \"span\": \"Die Ziegel werden verdeckt auf dem Tisch gemischt\"\n    },\n    {\n      \"text\": \"Each of the four players builds one side of the wall by taking 34 of the tiles face-down and arranging them into a wall that is 17 tiles long and two tiles high.\",\n      \"line\": 42,\n      \"span\": \"Anschließend baut jeder der vier Spieler eine Seite der Mauer, indem er 34 der Ziegel verdeckt nimmt und zu einer 17 Ziegel langen und zwei Ziegel hohen Mauer anordnet\"\n    },\n    {\n      \"text\": \"If playing with flower and season tiles, each player takes 36 tiles.\",\n      \"line\": 42,\n      \"span\": \"Wird mit Blumen- und Jahreszeitenziegeln gespielt, so nimmt jeder Spieler 36 Ziegel\"\n    },\n    {\n      \"text\": \"If playing with flower and season tiles, the width of the wall is 18 stacks.\",\n      \"line\": 42,\n      \"span\": \"und die Breite der Mauer beträgt 18 Stapel\"\n    },\n    {\n      \"text\": \"The four wall pieces are pushed together so they touch at the corners and form a square.\",\n      \"line\": 42,\n      \"span\": \"Die vier Mauerstücke werden zusammengeschoben, so dass sie sich an den Ecken berühren und ein Quadrat bilden\"\n    },\n    {\n      \"text\": \"Outside of Asian countries, this is sometimes called the Great Wall.\",\n      \"line\": 42,\n      \"span\": \"Außerhalb der asiatischen Länder wird dies manchmal Chinesische Mauer genannt\"\n    },\n    {\n      \"text\": \"East Wind now rolls the two dice and counts the sum of the pips counterclockwise to the players, starting with himself.\",\n      \"line\": 44,\n      \"span\": \"Nun wirft Ostwind die zwei Würfel und zählt wie vorhin, bei sich selbst beginnend, die Augensumme gegen den Uhrzeigersinn an den Spielern ab\"\n    },\n    {\n      \"text\": \"The player thus determined also rolls both dice and counts the sum of the pips of both rolls together.\",\n      \"line\": 44,\n      \"span\": \"Der so bestimmte Spieler wirft ebenfalls beide Würfel und zählt die Augensumme beider Würfe zusammen\"\n    },\n    {\n      \"text\": \"East Wind counts out the number of tile stacks corresponding to the total sum, starting at the right end of the wall in front of him going clockwise.\",\n      \"line\": 44,\n      \"span\": \"Ostwind zählt am rechten Ende der vor ihm befindlichen Mauer beginnend im Uhrzeigersinn der Gesamtsumme entsprechend Ziegelstapel ab\"\n    },\n    {\n      \"text\": \"If necessary, he continues counting with tiles from his left neighbor's wall.\",\n      \"line\": 44,\n      \"span\": \"Eventuell setzt er die Zählung mit Ziegeln aus der Mauer seines linken Nachbarn fort\"\n    },\n    {\n      \"text\": \"He takes out the stack thus determined (wall break) and places it on the stack to the right of the gap created.\",\n      \"line\": 44,\n      \"span\": \"Den so bestimmten Stapel nimmt er heraus (Mauerdurchbruch) und stellt ihn auf den Stapel rechts neben der entstandenen Lücke\"\n    },\n    {\n      \"text\": \"The removed tiles are called loose tiles and mark the dead end of the wall.\",\n      \"line\": 46,\n      \"span\": \"Die herausgenommenen Steine heißen lose Ziegel und markieren das tote Ende der Mauer\"\n    },\n    {\n      \"text\": \"The end to the left of the gap is the living end of the wall.\",\n      \"line\": 46,\n      \"span\": \"das Ende links der Lücke ist das lebende Ende der Mauer\"\n    },\n    {\n      \"text\": \"Tiles are regularly drawn from the living end of the wall.\",\n      \"line\": 46,\n      \"span\": \"Gezogen werden die Steine regulär vom lebenden Ende der Mauer\"\n    },\n    {\n      \"text\": \"From the dead end, only replacement tiles are taken, beginning with the two loose tiles.\",\n      \"line\": 46,\n      \"span\": \"Vom toten Ende werden dagegen nur Ersatzziegel (siehe unten) genommen, beginnend mit den beiden losen Ziegeln\"\n    },\n    {\n      \"text\": \"The players take turns three times, each taking two stacks of two tiles from the living end of the wall counterclockwise, with East Wind serving first.\",\n      \"line\": 46,\n      \"span\": \"Die Spieler nehmen dreimal reihum gegen den Uhrzeigersinn jeder zwei Stapel zu zwei Ziegel vom lebenden Ende der Mauer, wobei sich Ostwind als erster bedient\"\n    },\n    {\n      \"text\": \"Finally, each player takes one more, thirteenth tile, and East Wind also takes a fourteenth tile.\",\n      \"line\": 46,\n      \"span\": \"Zuletzt nimmt jeder Spieler noch einen weiteren, dreizehnten, und Ostwind außerdem einen vierzehnten Ziegel\"\n    },\n    {\n      \"text\": \"Each of the four players tries to improve their original hand by drawing and discarding tiles and form a complete hand from the most valuable figures possible.\",\n      \"line\": 50,\n      \"span\": \"Jeder der vier Spieler versucht, durch Ziehen und Abwerfen von Steinen seine ursprüngliche Hand zu verbessern und ein vollständiges Spielbild aus möglichst wertvollen Figuren zu formen\"\n    },\n    {\n      \"text\": \"Tiles are drawn from the wall or picked up after being discarded by another player.\",\n      \"line\": 50,\n      \"span\": \"Steine werden von der Mauer gezogen oder nach Abwurf eines anderen Spielers aufgenommen\"\n    },\n    {\n      \"text\": \"If a player has formed a complete hand consisting of four figures and finally a pair, he may call \\\"Mah-Jongg\\\" and end the game.\",\n      \"line\": 50,\n      \"span\": \"Hat ein Spieler ein vollständiges Spielbild bestehend aus vier Figuren und schließlich einem Paar gebildet, so darf er „Mah-Jongg\" rufen und das Spiel beenden\"\n    },\n    {\n      \"text\": \"The four figures can optionally be triples, quadruples or sequences.\",\n      \"line\": 50,\n      \"span\": \"Die vier Figuren können wahlweise Drillinge, Vierlinge oder Folgen sein\"\n    },\n    {\n      \"text\": \"A pair consists of two identical tiles, e.g. two Bamboo-Five or two green dragons etc.\",\n      \"line\": 56,\n      \"span\": \"Ein Paar besteht aus zwei gleichen Steinen, z. B. zweimal Bambus-Fünf oder zwei grüne Drachen etc\"\n    },\n    {\n      \"text\": \"To be able to call Mah-Jongg, a complete hand is needed that must contain exactly one pair, the final pair (將, jiàng, sometimes 眼, yǎn).\",\n      \"line\": 58,\n      \"span\": \"Um Mah-Jongg rufen zu können, ist ein vollständiges Spielbild nötig, in diesem muss genau ein Paar, das Schlusspaar (將,  jiàng, manchmal 眼,  yǎn), enthalten sein\"\n    },\n    {\n      \"text\": \"To complete a pair, a discarded tile may only be called if Mah-Jongg is called at the same time.\",\n      \"line\": 58,\n      \"span\": \"Zur Vervollständigung eines Paares darf ein abgelegter Stein nur aufgerufen werden, wenn gleichzeitig Mah-Jongg gerufen wird\"\n    },\n    {\n      \"text\": \"A Pong (碰, pèng) consists of three identical tiles.\",\n      \"line\": 62,\n      \"span\": \"Ein Pong (碰,  pèng) besteht aus drei gleichen Steinen\"\n    },\n    {\n      \"text\": \"If a Pong is formed exclusively from tiles of the original hand or tiles drawn from the wall, it is a concealed Pong that does not need to be declared.\",\n      \"line\": 62,\n      \"span\": \"Wird ein Pong ausschließlich aus Ziegeln der ursprünglichen Hand oder von der Mauer gezogenen Ziegeln gebildet, so handelt es sich um einen verdeckten Pong, der nicht gemeldet werden muss\"\n    },\n    {\n      \"text\": \"If it is nevertheless revealed, it should be marked as actually concealed by flipping one of the tiles.\",\n      \"line\": 62,\n      \"span\": \"Wird er dennoch aufgedeckt, so sollte er durch ein Umdrehen eines der Steine als eigentlich verdeckt markiert werden\"\n    },\n    {\n      \"text\": \"If a player has a pair and the third tile is discarded by any other player, the player may call this tile with the cry \\\"Pong\\\".\",\n      \"line\": 64,\n      \"span\": \"Besitzt ein Spieler ein Paar und wird der dritte Stein von einem beliebigen anderen Spieler abgelegt, so darf der Spieler diesen Stein mit dem Ruf „Pong\" aufrufen\"\n    },\n    {\n      \"text\": \"He places his pair and the called tile openly in front of him on the table and has an open Pong.\",\n      \"line\": 64,\n      \"span\": \"Er legt sein Paar und den aufgerufenen Ziegel offen vor sich auf den Tisch und besitzt einen offenen Pong\"\n    },\n    {\n      \"text\": \"In the 1970s and 1980s, the term Pon was often used in German-speaking areas instead of Pong.\",\n      \"line\": 66,\n      \"span\": \"In den 1970er und 1980er Jahren wurde im deutschsprachigen Raum statt Pong oftmals der Begriff Pon verwendet\"\n    },\n    {\n      \"text\": \"In the instruction book by Ursula Eschenbach published in 1982, Pon, Kan and Chii are consistently mentioned.\",\n      \"line\": 66,\n      \"span\": \"Auch in dem 1982 erschienenen Anleitungsbuch von Ursula Eschenbach ist durchgehend von Pon, Kan und Chii die Rede\"\n    },\n    {\n      \"text\": \"The terms Pon (Japanese ポン, 碰 pon), Kan (Japanese カン, 槓, 杠 kan) or Chii (Japanese チー, 吃 chī) come from the Japanese variant of Riichi Mahjong (リーチ麻雀, 立直マージャン rīchi mājan).\",\n      \"line\": 66,\n      \"span\": \"Die Begriffe Pon (jap. ポン, 碰 pon), Kan (カン, 槓, 杠 kan) oder Chii (チー, 吃 chī) stammen aus der japanischen Spielart des Riichi Mahjong (リーチ麻雀, 立直マージャン rīchi mājan)\"\n    },\n    {\n      \"text\": \"A Kong (槓 / 杠, gàng) consists of four identical tiles.\",\n      \"line\": 70,\n      \"span\": \"Ein Kong (槓 / 杠,  gàng) besteht aus vier gleichen Steinen\"\n    },\n    {\n      \"text\": \"If a Kong is formed exclusively from tiles of the original hand and tiles drawn from the wall, the player should declare a concealed Kong.\",\n      \"line\": 72,\n      \"span\": \"Wird ein Kong ausschließlich aus Steinen der ursprünglichen Hand und von der Mauer gezogenen Ziegeln gebildet, so sollte der Spieler einen verdeckten Kong melden\"\n    },\n    {\n      \"text\": \"If he does not do this, he cannot draw a replacement tile from the wall, which is necessary for Kongs to achieve a complete hand.\",\n      \"line\": 72,\n      \"span\": \"Tut er dies nicht, so kann er keinen Ersatzziegel aus der Mauer ziehen, der bei Kongs notwendig ist, um ein komplettes Spielbild zu erreichen\"\n    },\n    {\n      \"text\": \"If the game ends before the player declares the four-of-a-kind, the concealed Kong is valued as a concealed Pong.\",\n      \"line\": 72,\n      \"span\": \"Wird das Spiel beendet, bevor der Spieler den Vierling meldet, so wird der verdeckte Kong als verdeckter Pong gewertet\"\n    },\n    {\n      \"text\": \"A concealed Kong does not have to be declared immediately but can also be laid down later when the player's turn comes again.\",\n      \"line\": 74,\n      \"span\": \"Ein verdeckter Kong muss nicht sofort gemeldet werden, sondern kann auch später herausgelegt werden, wenn der Spieler erneut am Zug ist\"\n    },\n    {\n      \"text\": \"When declaring, the four tiles are laid out openly and to indicate that it is a concealed (also \\\"half-concealed\\\" or \\\"declared from hand\\\") Kong, the two outer tiles are placed face-up.\",\n      \"line\": 76,\n      \"span\": \"Bei der Meldung werden die vier Steine offen ausgelegt und zum Zeichen, dass es sich um einen verdeckten (auch: „halbverdeckten\", oder „aus der Hand gemeldeten\") Kong handelt, werden die beiden äußeren Steine mit der Rückseite nach oben gelegt\"\n    },\n    {\n      \"text\": \"If a player holds three identical tiles in his hand (i.e. a concealed Pong), he may claim this tile with the cry \\\"Kong\\\" if a player discards the fourth tile, and thus receives an open Kong.\",\n      \"line\": 78,\n      \"span\": \"Hält ein Spieler drei gleiche Steine in der Hand – also einen verdeckten Pong – so darf er, wenn ein Spieler den vierten Stein ablegt, diesen Ziegel mit dem Ruf „Kong\" für sich beanspruchen und erhält so einen offenen Kong\"\n    },\n    {\n      \"text\": \"If a player has already declared an open Pong and the missing fourth tile is discarded by another player, this tile cannot be called to complete the Kong.\",\n      \"line\": 80,\n      \"span\": \"Hat ein Spieler bereits einen offenen Pong gemeldet und wird der fehlende vierte Stein von einem anderen Spieler abgelegt, so kann dieser Ziegel nicht zur Komplettierung des Kongs aufgerufen werden\"\n    },\n    {\n      \"text\": \"If a player has already declared a Pong and draws the missing fourth tile from the wall, he may attach it to the Pong and thus has an open Kong.\",\n      \"line\": 82,\n      \"span\": \"Hat ein Spieler bereits einen Pong gemeldet und zieht er den fehlenden vierten Stein von der Mauer, so darf er ihn an den Pong anlegen und besitzt damit einen offenen Kong\"\n    },\n    {\n      \"text\": \"In this situation, a robbery of the Kong can occur.\",\n      \"line\": 82,\n      \"span\": \"In dieser Situation kann es zu einer Beraubung des Kong kommen\"\n    },\n    {\n      \"text\": \"The tile drawn from the wall can be claimed by another player if he can call \\\"Mah-Jongg\\\" with it.\",\n      \"line\": 82,\n      \"span\": \"Der von der Mauer gezogene Stein kann von einem anderen Spieler für sich gefordert werden, wenn er damit „Mah-Jongg\" rufen kann\"\n    },\n    {\n      \"text\": \"As soon as a player declares an open or concealed Kong, he must draw a replacement tile from the dead end of the wall.\",\n      \"line\": 84,\n      \"span\": \"Sobald ein Spieler einen offenen oder verdeckten Kong meldet, muss er einen Ersatzziegel vom toten Ende der Mauer ziehen\"\n    },\n    {\n      \"text\": \"A Chow (吃, chī, sometimes 上, shàng) is a sequence of exactly three consecutive tiles of a base suit.\",\n      \"line\": 88,\n      \"span\": \"Ein Chow (吃,  chī, manchmal 上,  shàng) ist eine Sequenz aus genau drei aufeinanderfolgenden Steinen einer Grundfarbe\"\n    },\n    {\n      \"text\": \"Sequences of more than three tiles are not permitted.\",\n      \"line\": 88,\n      \"span\": \"Sequenzen aus mehr als drei Steinen sind nicht gestattet\"\n    },\n    {\n      \"text\": \"A Chow made from tiles of the trump suit is not possible.\",\n      \"line\": 90,\n      \"span\": \"Ein Chow aus Steinen der Trumpffarbe ist nicht möglich\"\n    },\n    {\n      \"text\": \"A discarded tile can be called by a player with \\\"Chow\\\" if the player sits immediately to the right of the player who discarded the tile in question.\",\n      \"line\": 92,\n      \"span\": \"Ein abgelegter Stein kann von einem Spieler mit „Chow\" aufgerufen werden, wenn der Spieler unmittelbar zur Rechten desjenigen Spielers sitzt, der den betreffenden Stein abgelegt hat\"\n    },\n    {\n      \"text\": \"The calling player then places the sequence thus formed openly.\",\n      \"line\": 92,\n      \"span\": \"Der aufrufende Spieler legt dann die damit gebildete Folge offen\"\n    },\n    {\n      \"text\": \"Another player can only call a discarded tile for a sequence if he calls Mah-Jongg at the same time.\",\n      \"line\": 94,\n      \"span\": \"Ein anderer Spieler kann nur dann einen abgelegten Stein für eine Folge aufrufen, wenn er gleichzeitig Mah-Jongg ruft\"\n    },\n    {\n      \"text\": \"Sequences formed from tiles of the original hand or from drawn tiles can remain concealed until the end of the game.\",\n      \"line\": 96,\n      \"span\": \"Folgen, die aus Steinen der ursprünglichen Hand bzw. aus gezogenen Steinen gebildet werden, können bis zum Spielende verdeckt bleiben\"\n    },\n    {\n      \"text\": \"Mah-Jongg is played counterclockwise.\",\n      \"line\": 100,\n      \"span\": \"Mah-Jongg wird gegen den Uhrzeigersinn gespielt\"\n    },\n    {\n      \"text\": \"After East Wind has taken his 14 tiles, he begins the game by placing a tile openly in the middle of the table after any declaration, and names it.\",\n      \"line\": 100,\n      \"span\": \"Nachdem sich Ostwind seine 14 Ziegel genommen hat, beginnt er das Spiel, indem er nach einer eventuellen Meldung einen Stein offen in der Mitte des Tisches ablegt, dabei nennt er dessen Namen\"\n    },\n    {\n      \"text\": \"If no player calls the discarded tile, the player to the right draws a tile from the living end of the wall, declares one or more figures if he wishes, and finally discards a tile.\",\n      \"line\": 102,\n      \"span\": \"Wenn kein Spieler den abgelegten Stein aufruft, so zieht der rechte Nachbar einen Stein vom lebenden Ende der Mauer, meldet, wenn er möchte, eine oder mehrere Figuren und legt zuletzt einen Stein ab\"\n    },\n    {\n      \"text\": \"When a tile is discarded, it is dead, it remains openly in the middle of the table and the next player can play a Chow, as can that player and all subsequent players play a Pong or Kong.\",\n      \"line\": 104,\n      \"span\": \"Wird ein Stein abgelegt, so ist er tot, er bleibt offen in der Mitte des Tisches liegen und der nächste Spieler kann einen Chow spielen, sowie jener und alle weiteren Spieler einen Pong oder einen Kong\"\n    },\n    {\n      \"text\": \"After that, the tile is no longer available for the game or can be picked up.\",\n      \"line\": 104,\n      \"span\": \"Danach ist der Stein nicht mehr für das Spiel verfügbar beziehungsweise aufnehmbar\"\n    },\n    {\n      \"text\": \"If a tile is called by a player, the player takes the discarded tile and must place the corresponding figure openly.\",\n      \"line\": 106,\n      \"span\": \"Wird ein Stein von einem Spieler aufgerufen, so nimmt der Spieler den abgelegten Stein und muss die betreffende Figur offen auflegen\"\n    },\n    {\n      \"text\": \"After that, he discards a tile and the game continues with this player.\",\n      \"line\": 106,\n      \"span\": \"Danach wirft er einen Stein ab, und das Spiel wird mit diesem Spieler fortgesetzt\"\n    },\n    {\n      \"text\": \"In this way, players can also be skipped: For example, if South Wind discards a tile that is called by North Wind, West Wind is skipped.\",\n      \"line\": 106,\n      \"span\": \"Auf diese Weise können auch Spieler übergangen werden: Legt beispielsweise Südwind einen Stein ab, der von Nordwind gerufen wird, so wird Westwind übersprungen\"\n    },\n    {\n      \"text\": \"If a tile is called by several players, the following hierarchy applies: If a player needs the tile for a Mah-Jongg call, he has priority over a Kong or Pong call and these in turn have priority over a Chow.\",\n      \"line\": 108,\n      \"span\": \"Wird ein Ziegel von mehreren Spielern gerufen, so gilt folgende Rangordnung: Benötigt ein Spieler den Stein für einen Mah-Jongg-Ruf, so hat er Vorrang gegenüber einem Kong- oder Pong-Ruf und diese wiederum haben Vorrang vor einem Chow\"\n    },\n    {\n      \"text\": \"Concealed combinations count double.\",\n      \"line\": 124,\n      \"span\": \"Verdeckte Kombinationen zählen das Doppelte\"\n    },\n    {\n      \"text\": \"A Kong counts four times as much as the corresponding Pong.\",\n      \"line\": 128,\n      \"span\": \"Ein Kong zählt viermal so viel wie der entsprechende Pong\"\n    }\n  ]\n}\n```","ttft_ms":86329,"type":"result","duration_ms":177748,"uuid":"db5428c0-3441-453e-8a70-24821dfaf9c4","ttft_stream_ms":901,"time_to_request_ms":114,"first_content_frame_ms":901,"queued_turn_count":0,"result_index":0}
