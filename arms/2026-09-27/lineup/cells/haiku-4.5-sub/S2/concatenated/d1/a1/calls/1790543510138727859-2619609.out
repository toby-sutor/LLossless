\n    },\n    {\n      \"text\": \"The founder cut the year 1782 into the tenor.\",\n      \"line\": 5,\n      \"span\": \"The founder cut the year 1782 into the tenor\"\n    },\n    {\n      \"text\": \"The tenor was the only bell the founder signed.\",\n      \"line\": 5,\n      \"span\": \"that was the only bell he signed\"\n    },\n    {\n      \"text\": \"A full peal required at least eight ringers.\",\n      \"line\": 7,\n      \"span\": \"We could not attempt a full peal with fewer than eight ringers\"\n    },\n    {\n      \"text\": \"One absence was enough to cancel the peal.\",\n      \"line\": 7,\n      \"span\": \"one absence was enough to call the whole thing off\"\n    },\n    {\n      \"text\": \"A full peal took two hours from the first stroke to the last.\",\n      \"line\": 9,\n      \"span\": \"From the first stroke to the last a full peal took two hours\"\n    },\n    {\n      \"text\": \"Nobody left the ringing chamber during a full peal.\",\n      \"line\": 9,\n      \"span\": \"nobody left the ringing chamber in between\"\n    },\n    {\n      \"text\": \"The narrator and others rang the bells on the first Sunday of the month, every month.\",\n      \"line\": 11,\n      \"span\": \"We rang on the first Sunday of the month, every month\"\n    },\n    {\n      \"text\": \"People in the village knew the time from the sound of the bells.\",\n      \"line\": 11,\n      \"span\": \"people in the village knew the hour from the sound\"\n    }\n  ]\n}\n```","ttft_ms":95000,"type":"result","duration_ms":98313,"uuid":"31aac2fd-6f6d-4450-b1d3-5922d4fc489c","ttft_stream_ms":632,"time_to_request_ms":113,"first_content_frame_ms":632,"queued_turn_count":0,"result_index":0}
