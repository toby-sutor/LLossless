{"duration_api_ms":115962,"stop_reason":"end_turn","session_id":"f27ea018-f977-4c0c-b61a-87204edea446","total_cost_usd":0.071326,"usage":{"input_tokens":10,"cache_creation_input_tokens":5998,"cache_read_input_tokens":0,"output_tokens":11864,"output_tokens_details":{"thinking_tokens":9943},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":5998,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":10,"output_tokens":11864,"cache_read_input_tokens":0,"cache_creation_input_tokens":5998,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5998},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":10,"outputTokens":11864,"cacheReadInputTokens":0,"cacheCreationInputTokens":5998,"webSearchRequests":0,"costUSD":0.071326,"contextWindow":200000,"maxOutputTokens":32000,"thinkingTokens":9943,"canonicalModel":"claude-haiku-4-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"```json\n{\n  \"claims\": [\n    {\n      \"text\": \"Append requests to Nimbrel Ledger return HTTP 429 Too Many Requests.\",\n      \"line\": 8,\n      \"span\": \"Append requests to Nimbrel Ledger return HTTP 429 `Too Many Requests`\"\n    },\n    {\n      \"text\": \"Callers experience writes that will not land.\",\n      \"line\": 8,\n      \"span\": \"Callers experience writes that will not land\"\n    },\n    {\n      \"text\": \"Nimbrel Relay stalls.\",\n      \"line\": 8,\n      \"span\": \"Nimbrel Relay stalls\"\n    },\n    {\n      \"text\": \"Batch loaders resend the same envelope.\",\n      \"line\": 8,\n      \"span\": \"batch loaders resend the same envelope\"\n    },\n    {\n      \"text\": \"Reads against the same shard begin to time out.\",\n      \"line\": 8,\n      \"span\": \"reads against the same shard begin to time out\"\n    },\n    {\n      \"text\": \"The refusal reaches the client.\",\n      \"line\": 8,\n      \"span\": \"The refusal reaches the client\"\n    },\n    {\n      \"text\": \"The refusal is written to the Relay and Collector logs.\",\n      \"line\": 8,\n      \"span\": \"is written to the Relay and Collector logs as well\"\n    },\n    {\n      \"text\": \"Every Nimbrel Ledger release on every platform can refuse an append this way.\",\n      \"line\": 20,\n      \"span\": \"Every Nimbrel Ledger release on every platform can refuse an append this way\"\n    },\n    {\n      \"text\": \"A Ledger node sends a 429 reply when an append queue or a read queue is full.\",\n      \"line\": 24,\n      \"span\": \"is what a Ledger node sends once it has nowhere left to put the work, which is to say once [an append queue or a read queue is full]\"\n    },\n    {\n      \"text\": \"There are 3 ways an append draws a 429.\",\n      \"line\": 26,\n      \"span\": \"There are 3 ways an append draws a 429\"\n    },\n    {\n      \"text\": \"The append or system_append worker pools can hold more batches than they have slots for.\",\n      \"line\": 28,\n      \"span\": \"The `append` or `system_append` worker pools hold more batches than they have slots for\"\n    },\n    {\n      \"text\": \"The ingest memory guard can refuse a batch.\",\n      \"line\": 29,\n      \"span\": \"The ingest memory guard has refused the batch\"\n    },\n    {\n      \"text\": \"A circuit breaker can trip.\",\n      \"line\": 30,\n      \"span\": \"A circuit breaker has tripped\"\n    },\n    {\n      \"text\": \"A breaker trips on any operation and is not particular to appends.\",\n      \"line\": 30,\n      \"span\": \"a breaker trips on any operation and is not particular to appends\"\n    },\n    {\n      \"text\": \"A query that runs for several seconds holds a worker slot unavailable for other work.\",\n      \"line\": 32,\n      \"span\": \"A query that runs for several seconds holds a worker slot unavailable for other work\"\n    },\n    {\n      \"text\": \"The queue behind a long-running query grows.\",\n      \"line\": 32,\n      \"span\": \"the queue behind it grows\"\n    },\n    {\n      \"text\": \"Grouping on high-cardinality fields yields a very large number of groups.\",\n      \"line\": 32,\n      \"span\": \"Grouping on high-cardinality fields yields a very large number of groups\"\n    },\n    {\n      \"text\": \"The memory cost of grouping on high-cardinality fields is charged to the same pool the append path draws on.\",\n      \"line\": 32,\n      \"span\": \"the memory that costs is charged to the same pool the append path draws on\"\n    },\n    {\n      \"text\": \"When processor load looks unremarkable while memory sits high, this points toward query cost rather than an undersized cluster.\",\n      \"line\": 32,\n      \"span\": \"When processor load looks unremarkable while memory sits high, this points toward query cost rather than an undersized cluster\"\n    },\n    {\n      \"text\": \"From release 4.6 and release 5.1 onward, appending to a wide_text column draws a 429 on its own account whenever the batch would otherwise have run the node out of memory.\",\n      \"line\": 34,\n      \"span\": \"**From release 4.6 and release 5.1 onward**, appending to a `wide_text` column draws a 429 on its own account whenever the batch would otherwise have run the node out of memory\"\n    },\n    {\n      \"text\": \"Setting the slow query threshold to 1 second causes expensive queries to be recorded individually instead of being averaged into statistics.\",\n      \"line\": 40,\n      \"span\": \"set the slow query threshold to 1 second so that expensive queries are recorded individually instead of being averaged into statistics\"\n    },\n    {\n      \"text\": \"A cluster that refuses appends has been given more work than its hardware can carry.\",\n      \"line\": 44,\n      \"span\": \"A cluster that refuses appends has been given more work than its hardware can carry\"\n    },\n    {\n      \"text\": \"The answer to refusing appends is hardware: larger nodes (scale up) or more nodes (scale out).\",\n      \"line\": 44,\n      \"span\": \"the answer is hardware: larger nodes (scale up), or more of them (scale out)\"\n    },\n    {\n      \"text\": \"Splitting a hot stream over more leader shards spreads append load across more nodes.\",\n      \"line\": 46,\n      \"span\": \"Splitting a hot stream over more leader shards spreads append load across more nodes\"\n    },\n    {\n      \"text\": \"Spreading append load across more nodes helps in some layouts.\",\n      \"line\": 46,\n      \"span\": \"which helps in some layouts\"\n    },\n    {\n      \"text\": \"The ingest_guard.memory.leader.ceiling setting defaults to 10% of the heap.\",\n      \"line\": 52,\n      \"span\": \"which defaults to 10% of the heap\"\n    },\n    {\n      \"text\": \"A higher ceiling on ingest_guard.memory.leader.ceiling lets a node hold more in-flight append memory before refusing.\",\n      \"line\": 52,\n      \"span\": \"A higher ceiling lets a node hold more in-flight append memory before refusing\"\n    },\n    {\n      \"text\": \"A node holding too much memory runs out of memory instead of refusing.\",\n      \"line\": 52,\n      \"span\": \"a node holding too much runs out of memory instead of refusing\"\n    },\n    {\n      \"text\": \"Running out of memory is worse than refusing.\",\n      \"line\": 52,\n      \"span\": \"which is the worse outcome\"\n    },\n    {\n      \"text\": \"The ingest_guard.memory.leader.ceiling setting is read at startup.\",\n      \"line\": 52,\n      \"span\": \"The setting is read at startup\"\n    },\n    {\n      \"text\": \"The cluster must be restarted for a change to the ingest_guard.memory.leader.ceiling setting to take effect.\",\n      \"line\": 52,\n      \"span\": \"the cluster must be restarted for a change to take\"\n    },\n    {\n      \"text\": \"Refusals that show up only during a spike usually clear on their own once the queues drain.\",\n      \"line\": 54,\n      \"span\": \"Refusals that show up only during a spike usually clear on their own once the queues drain\"\n    }\n  ]\n}\n```","ttft_ms":100089,"type":"result","duration_ms":116032,"uuid":"339df966-9dda-4d77-a165-6035937d7a89","ttft_stream_ms":863,"time_to_request_ms":103,"first_content_frame_ms":863,"queued_turn_count":0,"result_index":0}
