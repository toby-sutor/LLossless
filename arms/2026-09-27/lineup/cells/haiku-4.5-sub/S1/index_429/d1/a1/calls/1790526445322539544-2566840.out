{"duration_api_ms":177719,"stop_reason":"end_turn","session_id":"4c12f035-a951-495e-9bad-dffd6ada8c67","total_cost_usd":0.10361100000000001,"usage":{"input_tokens":10,"cache_creation_input_tokens":5693,"cache_read_input_tokens":0,"output_tokens":18443,"output_tokens_details":{"thinking_tokens":17054},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":5693,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":10,"output_tokens":18443,"cache_read_input_tokens":0,"cache_creation_input_tokens":5693,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5693},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":10,"outputTokens":18443,"cacheReadInputTokens":0,"cacheCreationInputTokens":5693,"webSearchRequests":0,"costUSD":0.10361100000000001,"contextWindow":200000,"maxOutputTokens":32000,"thinkingTokens":17054,"canonicalModel":"claude-haiku-4-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"```json\n{\n  \"claims\": [\n    {\n      \"text\": \"Append requests to Nimbrel Ledger come back with HTTP 429 Too Many Requests.\",\n      \"line\": 8,\n      \"span\": \"Append requests to Nimbrel Ledger come back with HTTP 429 `Too Many Requests`\"\n    },\n    {\n      \"text\": \"When append requests return HTTP 429, Nimbrel Relay stalls.\",\n      \"line\": 8,\n      \"span\": \"Nimbrel Relay stalls\"\n    },\n    {\n      \"text\": \"When append requests return HTTP 429, batch loaders resend the same envelope.\",\n      \"line\": 8,\n      \"span\": \"batch loaders resend the same envelope\"\n    },\n    {\n      \"text\": \"When append requests return HTTP 429, reads against the same shard begin to time out.\",\n      \"line\": 8,\n      \"span\": \"reads against the same shard begin to time out\"\n    },\n    {\n      \"text\": \"The refusal reaches the client and is written to the Relay and Collector logs as well.\",\n      \"line\": 8,\n      \"span\": \"The refusal reaches the client and is written to the Relay and Collector logs as well\"\n    },\n    {\n      \"text\": \"Every Nimbrel Ledger release on every platform can refuse an append this way.\",\n      \"line\": 20,\n      \"span\": \"Every Nimbrel Ledger release on every platform can refuse an append this way\"\n    },\n    {\n      \"text\": \"A Ledger node sends a 429 - Too Many Requests reply once an append queue or a read queue is full.\",\n      \"line\": 24,\n      \"span\": \"A [`429 - Too Many Requests` reply](https://docs.nimbrel.example/ledger/http-status-codes) is what a Ledger node sends once it has nowhere left to put the work, which is to say once [an append queue or a read queue is full](https://docs.nimbrel.example/ledger/why-appends-are-refused)\"\n    },\n    {\n      \"text\": \"An append draws a 429 when the append or system_append worker pools hold more batches than they have slots for.\",\n      \"line\": 28,\n      \"span\": \"The `append` or `system_append` worker pools hold more batches than they have slots for\"\n    },\n    {\n      \"text\": \"An append draws a 429 when the ingest memory guard has refused the batch.\",\n      \"line\": 29,\n      \"span\": \"The ingest memory guard has refused the batch\"\n    },\n    {\n      \"text\": \"An append draws a 429 when a circuit breaker has tripped.\",\n      \"line\": 30,\n      \"span\": \"A circuit breaker has tripped\"\n    },\n    {\n      \"text\": \"A circuit breaker trips on any operation and is not particular to appends.\",\n      \"line\": 30,\n      \"span\": \"a breaker trips on any operation and is not particular to appends\"\n    },\n    {\n      \"text\": \"From release 4.6 and release 5.1 onward, appending to a wide_text column draws a 429 on its own account whenever the batch would otherwise have run the node out of memory.\",\n      \"line\": 32,\n      \"span\": \"From release 4.6 and release 5.1 onward, appending to a `wide_text` column draws a 429 on its own account whenever the batch would otherwise have run the node out of memory\"\n    },\n    {\n      \"text\": \"A cluster that refuses appends has been given more work than its hardware can carry.\",\n      \"line\": 42,\n      \"span\": \"A cluster that refuses appends has been given more work than its hardware can carry\"\n    },\n    {\n      \"text\": \"Splitting a hot stream over more leader shards spreads append load across more nodes, which helps in some layouts.\",\n      \"line\": 44,\n      \"span\": \"Splitting a hot stream over more leader shards spreads append load across more nodes, which helps in some layouts\"\n    },\n    {\n      \"text\": \"The ingest_guard.memory.leader.ceiling setting defaults to 10% of the heap.\",\n      \"line\": 50,\n      \"span\": \"which defaults to 10% of the heap\"\n    },\n    {\n      \"text\": \"A higher ceiling in the ingest_guard.memory.leader.ceiling setting allows a node to hold more in-flight append memory before refusing.\",\n      \"line\": 50,\n      \"span\": \"A higher ceiling lets a node hold more in-flight append memory before refusing\"\n    },\n    {\n      \"text\": \"A node holding too much in-flight append memory runs out of memory instead of refusing.\",\n      \"line\": 50,\n      \"span\": \"a node holding too much runs out of memory instead of refusing\"\n    },\n    {\n      \"text\": \"The ingest_guard.memory.leader.ceiling setting is read at startup.\",\n      \"line\": 50,\n      \"span\": \"The setting is read at startup\"\n    },\n    {\n      \"text\": \"The cluster must be restarted for changes to the ingest_guard.memory.leader.ceiling setting to take effect.\",\n      \"line\": 50,\n      \"span\": \"the cluster must be restarted for a change to take\"\n    },\n    {\n      \"text\": \"Refusals that show up only during a spike usually clear on their own once the queues drain.\",\n      \"line\": 52,\n      \"span\": \"Refusals that show up only during a spike usually clear on their own once the queues drain\"\n    }\n  ]\n}\n```","ttft_ms":167720,"type":"result","duration_ms":177781,"uuid":"c85d43c1-957e-4ff0-b35c-f5398b057300","ttft_stream_ms":996,"time_to_request_ms":92,"first_content_frame_ms":996,"queued_turn_count":0,"result_index":0}
