{"duration_api_ms":83095,"stop_reason":"end_turn","session_id":"be56654d-3e9d-43e5-ace5-289917a54166","total_cost_usd":0.065139,"usage":{"input_tokens":10,"cache_creation_input_tokens":8542,"cache_read_input_tokens":0,"output_tokens":9609,"output_tokens_details":{"thinking_tokens":5472},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":8542,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":10,"output_tokens":9609,"cache_read_input_tokens":0,"cache_creation_input_tokens":8542,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8542},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":10,"outputTokens":9609,"cacheReadInputTokens":0,"cacheCreationInputTokens":8542,"webSearchRequests":0,"costUSD":0.065139,"contextWindow":200000,"maxOutputTokens":32000,"thinkingTokens":5472,"canonicalModel":"claude-haiku-4-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"```json\n{\n  \"verdicts\": [\n    {\n      \"claim_id\": \"M-001\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Every credential has a cap.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md opens with this exact statement.\"\n    },\n    {\n      \"claim_id\": \"M-002\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"When that cap is spent the gateway answers 429 at the edge\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the opening paragraph.\"\n    },\n    {\n      \"claim_id\": \"M-003\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Requests are counted against the credential that presented them, over a fixed window of 60 seconds\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this directly in the second paragraph.\"\n    },\n    {\n      \"claim_id\": \"M-004\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"and never against a connection\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md explicitly states requests are never counted against a connection.\"\n    },\n    {\n      \"claim_id\": \"M-005\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Opening a second socket therefore buys a caller nothing.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this directly.\"\n    },\n    {\n      \"claim_id\": \"M-006\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"A client spread across eight worker processes is throttled at exactly the point one process would have been\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the second paragraph.\"\n    },\n    {\n      \"claim_id\": \"M-007\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"The default allowance is 100 requests in a window\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this directly.\"\n    },\n    {\n      \"claim_id\": \"M-008\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"a credential marked for batch work is allowed 1000 in the same window\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the opening section.\"\n    },\n    {\n      \"claim_id\": \"M-009\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"It is the platform declining to spend capacity that has already been promised to somebody else\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md defines a refusal this way in the opening section.\"\n    },\n    {\n      \"claim_id\": \"M-010\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Callers that retry at once are the largest single reason the cap is there at all.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this explicitly in the opening section.\"\n    },\n    {\n      \"claim_id\": \"M-011\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"The refusal carries a Retry-After header.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to read a refusal' section.\"\n    },\n    {\n      \"claim_id\": \"M-012\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Its value is a whole number of seconds to wait.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to read a refusal' section.\"\n    },\n    {\n      \"claim_id\": \"M-013\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"The gateway keeps no memory of who backed off politely\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to read a refusal' section.\"\n    },\n    {\n      \"claim_id\": \"M-014\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"waiting longer than the header asks earns a caller no credit at all\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to read a refusal' section.\"\n    },\n    {\n      \"claim_id\": \"M-015\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"The body of the refusal is JSON\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to read a refusal' section.\"\n    },\n    {\n      \"claim_id\": \"M-016\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"It names what the gateway calls the \\\"window\\\" it counted in.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to read a refusal' section.\"\n    },\n    {\n      \"claim_id\": \"M-017\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"It names the cap and the tier as well.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to read a refusal' section.\"\n    },\n    {\n      \"claim_id\": \"M-018\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"a caller that parses the body to compute its own wait is doing the same arithmetic twice\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to read a refusal' section.\"\n    },\n    {\n      \"claim_id\": \"M-019\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"The gateway has already done that arithmetic, with information the caller does not have\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to retry well' section.\"\n    },\n    {\n      \"claim_id\": \"M-020\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"and it does the same on the 503 path\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to retry well' section.\"\n    },\n    {\n      \"claim_id\": \"M-021\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"A wait derived on the client side is a guess about a counter it cannot see.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to retry well' section.\"\n    },\n    {\n      \"claim_id\": \"M-022\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"A 200 wants nothing\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to retry well' section rule 2.\"\n    },\n    {\n      \"claim_id\": \"M-023\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"a 429 wants the stated wait\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to retry well' section rule 2.\"\n    },\n    {\n      \"claim_id\": \"M-024\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"a 500 may be retried once that wait has passed\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to retry well' section rule 2.\"\n    },\n    {\n      \"claim_id\": \"M-025\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"and a 503 is the overload path\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to retry well' section rule 2.\"\n    },\n    {\n      \"claim_id\": \"M-026\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"A client that folds every non-success into one branch will retry hardest during exactly the incident the cap was installed to survive.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to retry well' section rule 2.\"\n    },\n    {\n      \"claim_id\": \"M-027\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"A batch credential is allowed fifty times the default allowance\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to retry well' section rule 3.\"\n    },\n    {\n      \"claim_id\": \"M-028\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"and it is measured over exactly the same window\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to retry well' section rule 3.\"\n    },\n    {\n      \"claim_id\": \"M-029\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"The tier is set on the credential when it is issued\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to retry well' section rule 3.\"\n    },\n    {\n      \"claim_id\": \"M-030\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"and cannot be asked for per call\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to retry well' section rule 3.\"\n    },\n    {\n      \"claim_id\": \"M-031\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Nothing else about the two tiers differs in any way.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to retry well' section rule 3.\"\n    },\n    {\n      \"claim_id\": \"M-032\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"and nobody at the far end will assemble that argument on its behalf\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'How to retry well' section rule 4.\"\n    },\n    {\n      \"claim_id\": \"M-033\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"A credential may be suspended\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Other refusals and their codes' section.\"\n    },\n    {\n      \"claim_id\": \"M-034\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"a route may be closed for maintenance\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Other refusals and their codes' section.\"\n    },\n    {\n      \"claim_id\": \"M-035\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"or a body may exceed the 5 megabyte limit\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Other refusals and their codes' section.\"\n    },\n    {\n      \"claim_id\": \"M-036\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"None of those three clears itself by waiting for a stated number of seconds.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Other refusals and their codes' section.\"\n    },\n    {\n      \"claim_id\": \"M-037\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"A loop that waits and retries against a suspended credential spends its whole budget without ever reaching the service\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Other refusals and their codes' section.\"\n    },\n    {\n      \"claim_id\": \"M-038\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"and the log afterwards shows nothing at all except a long run of refusals\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Other refusals and their codes' section.\"\n    },\n    {\n      \"claim_id\": \"M-039\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Reading the status code rather than the class it belongs to is what separates the two cases\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Other refusals and their codes' section.\"\n    },\n    {\n      \"claim_id\": \"M-040\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"and it costs one comparison\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Other refusals and their codes' section.\"\n    },\n    {\n      \"claim_id\": \"M-041\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"The platform team looks at whether the load is smooth or bursty\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Asking for an increase' section.\"\n    },\n    {\n      \"claim_id\": \"M-042\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"a burst is cheaper to smooth than it is to serve at its peak\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Asking for an increase' section.\"\n    },\n    {\n      \"claim_id\": \"M-043\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"A caller that can move half its work to a quieter hour usually gets what it needs without any change to the cap at all\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Asking for an increase' section.\"\n    },\n    {\n      \"claim_id\": \"M-044\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"which is the outcome everyone prefers\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Asking for an increase' section.\"\n    },\n    {\n      \"claim_id\": \"M-045\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Requests reach the platform team through the usual channel\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Asking for an increase' section.\"\n    },\n    {\n      \"claim_id\": \"M-046\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"and they are answered within two working days\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Asking for an increase' section.\"\n    },\n    {\n      \"claim_id\": \"M-047\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"There is no expedited path\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Asking for an increase' section.\"\n    },\n    {\n      \"claim_id\": \"M-048\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"and no exception list\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this in the 'Asking for an increase' section.\"\n    }\n  ]\n}\n```","ttft_ms":48203,"type":"result","duration_ms":83157,"uuid":"89bd1508-8617-4a3f-a38a-4c4f09f68d5b","ttft_stream_ms":1096,"time_to_request_ms":94,"first_content_frame_ms":1097,"queued_turn_count":0,"result_index":0}
