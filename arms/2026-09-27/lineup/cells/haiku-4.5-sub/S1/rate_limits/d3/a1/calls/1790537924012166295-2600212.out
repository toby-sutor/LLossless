{"duration_api_ms":124254,"stop_reason":"end_turn","session_id":"db329c4e-b9de-430d-813c-6f7dd65fcae1","total_cost_usd":0.098167,"usage":{"input_tokens":10,"cache_creation_input_tokens":5781,"cache_read_input_tokens":0,"output_tokens":17319,"output_tokens_details":{"thinking_tokens":15138},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":5781,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":10,"output_tokens":17319,"cache_read_input_tokens":0,"cache_creation_input_tokens":5781,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5781},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":10,"outputTokens":17319,"cacheReadInputTokens":0,"cacheCreationInputTokens":5781,"webSearchRequests":0,"costUSD":0.098167,"contextWindow":200000,"maxOutputTokens":32000,"thinkingTokens":15138,"canonicalModel":"claude-haiku-4-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"```json\n{\n  \"claims\": [\n    {\n      \"text\": \"Every credential has a cap of its own.\",\n      \"line\": 3,\n      \"span\": \"Every credential has a cap of its own\"\n    },\n    {\n      \"text\": \"When a credential's cap is spent, the gateway answers 429 at the edge, without troubling the service behind it.\",\n      \"line\": 3,\n      \"span\": \"When the cap is spent the gateway answers 429 at the edge, without troubling the service behind it\"\n    },\n    {\n      \"text\": \"Requests are counted against the credential rather than the connection.\",\n      \"line\": 5,\n      \"span\": \"Requests are counted against the credential rather than the connection\"\n    },\n    {\n      \"text\": \"Requests are counted over a fixed window of 60 seconds.\",\n      \"line\": 5,\n      \"span\": \"over a fixed window of 60 seconds\"\n    },\n    {\n      \"text\": \"The gateway doesn't disclose the start of the window.\",\n      \"line\": 5,\n      \"span\": \"whose start the gateway doesn't disclose\"\n    },\n    {\n      \"text\": \"The count follows the credential wherever the caller happens to put it, including across hosts.\",\n      \"line\": 5,\n      \"span\": \"The count follows the credential wherever the caller happens to put it, including across hosts\"\n    },\n    {\n      \"text\": \"A caller spread over many worker processes is throttled at the same point a single process would have been.\",\n      \"line\": 5,\n      \"span\": \"A caller spread over many worker processes is throttled at the same point a single process would have been\"\n    },\n    {\n      \"text\": \"The default allowance is 100 requests in a window.\",\n      \"line\": 7,\n      \"span\": \"The default allowance is 100 requests in a window\"\n    },\n    {\n      \"text\": \"The header is called Retry-After.\",\n      \"line\": 11,\n      \"span\": \"The header is called Retry-After\"\n    },\n    {\n      \"text\": \"The header's value is a whole number of seconds.\",\n      \"line\": 11,\n      \"span\": \"Its value is a whole number of seconds\"\n    },\n    {\n      \"text\": \"The header is present on every refusal the gateway sends.\",\n      \"line\": 11,\n      \"span\": \"it is present on every refusal the gateway sends\"\n    },\n    {\n      \"text\": \"The response body is JSON.\",\n      \"line\": 13,\n      \"span\": \"The response body is JSON\"\n    },\n    {\n      \"text\": \"The response body repeats the cap, the window and the tier as plain fields.\",\n      \"line\": 13,\n      \"span\": \"it repeats the cap, the window and the tier as plain fields\"\n    },\n    {\n      \"text\": \"The body is for the human reading the log afterwards.\",\n      \"line\": 13,\n      \"span\": \"The body is for the human reading the log afterwards\"\n    },\n    {\n      \"text\": \"There are four rules.\",\n      \"line\": 17,\n      \"span\": \"There are four rules\"\n    },\n    {\n      \"text\": \"On the 503 path the same rule holds.\",\n      \"line\": 19,\n      \"span\": \"On the 503 path the same rule holds\"\n    },\n    {\n      \"text\": \"The set of safe-to-retry responses is a smaller set than the set of responses that aren't a success.\",\n      \"line\": 21,\n      \"span\": \"which is a smaller set than the set of responses that aren't a success\"\n    },\n    {\n      \"text\": \"A 200 response needs nothing.\",\n      \"line\": 21,\n      \"span\": \"A 200 needs nothing\"\n    },\n    {\n      \"text\": \"A 429 response needs the stated wait.\",\n      \"line\": 21,\n      \"span\": \"a 429 needs the stated wait\"\n    },\n    {\n      \"text\": \"A 500 response can be retried once that wait has passed.\",\n      \"line\": 21,\n      \"span\": \"a 500 can be retried once that wait has passed\"\n    },\n    {\n      \"text\": \"A 503 response means the platform itself is overloaded.\",\n      \"line\": 21,\n      \"span\": \"a 503 means the platform itself is overloaded\"\n    },\n    {\n      \"text\": \"A batch credential is allowed 1000 requests in a window.\",\n      \"line\": 23,\n      \"span\": \"A batch credential is allowed 1000 requests in a window\"\n    },\n    {\n      \"text\": \"1000 is 50 times the default.\",\n      \"line\": 23,\n      \"span\": \"which is 50 times the default\"\n    },\n    {\n      \"text\": \"The batch tier is not a separate counting scheme.\",\n      \"line\": 23,\n      \"span\": \"not a separate counting scheme\"\n    },\n    {\n      \"text\": \"The window, the header and the body are identical to the interactive case.\",\n      \"line\": 23,\n      \"span\": \"The window, the header and the body are identical to the interactive case\"\n    },\n    {\n      \"text\": \"Nothing else about the batch tier differs from the default.\",\n      \"line\": 23,\n      \"span\": \"Nothing else about the batch tier differs from the default\"\n    },\n    {\n      \"text\": \"The gateway refuses a request for three separate reasons.\",\n      \"line\": 29,\n      \"span\": \"The gateway refuses a request for three separate reasons\"\n    },\n    {\n      \"text\": \"Only one of them is a cap.\",\n      \"line\": 29,\n      \"span\": \"only one of them is a cap\"\n    },\n    {\n      \"text\": \"Two of the three refusal reasons have nothing to do with how much traffic a caller has sent in the window it is currently in.\",\n      \"line\": 29,\n      \"span\": \"Two of the three have nothing to do with how much traffic a caller has sent in the window it is currently in\"\n    },\n    {\n      \"text\": \"A credential can be suspended.\",\n      \"line\": 29,\n      \"span\": \"A credential can be suspended\"\n    },\n    {\n      \"text\": \"A route can be closed while it is being repaired.\",\n      \"line\": 29,\n      \"span\": \"a route can be closed while it is being repaired\"\n    },\n    {\n      \"text\": \"A request body over the 5 megabyte limit is refused before it has been read at all.\",\n      \"line\": 29,\n      \"span\": \"a request body over the 5 megabyte limit is refused before it has been read at all\"\n    },\n    {\n      \"text\": \"A loop retrying against a suspended credential burns its whole budget and reaches nothing.\",\n      \"line\": 31,\n      \"span\": \"A loop retrying against a suspended credential burns its whole budget and reaches nothing\"\n    },\n    {\n      \"text\": \"The log afterwards shows a long run of refusals and no successes at all.\",\n      \"line\": 31,\n      \"span\": \"The log afterwards shows a long run of refusals and no successes at all\"\n    },\n    {\n      \"text\": \"The wasted budget is the caller's own.\",\n      \"line\": 31,\n      \"span\": \"the wasted budget is the caller's own\"\n    },\n    {\n      \"text\": \"A cap can be raised.\",\n      \"line\": 33,\n      \"span\": \"A cap can be raised\"\n    },\n    {\n      \"text\": \"A cap cannot be raised on the strength of an assertion that the current one is too small.\",\n      \"line\": 33,\n      \"span\": \"but not on the strength of an assertion that the current one is too small\"\n    },\n    {\n      \"text\": \"The team wants to know whether the load is smooth or bursty before it looks at the number at all.\",\n      \"line\": 35,\n      \"span\": \"The team wants to know whether the load is smooth or bursty before it looks at the number at all\"\n    },\n    {\n      \"text\": \"Requests go to the platform team through the usual channel.\",\n      \"line\": 35,\n      \"span\": \"Requests go to the platform team through the usual channel\"\n    },\n    {\n      \"text\": \"There is no expedited path.\",\n      \"line\": 37,\n      \"span\": \"There is no expedited path\"\n    },\n    {\n      \"text\": \"An answer takes two working days.\",\n      \"line\": 37,\n      \"span\": \"An answer takes two working days\"\n    },\n    {\n      \"text\": \"Chasing the request doesn't make it take fewer days.\",\n      \"line\": 37,\n      \"span\": \"chasing it doesn't make it take fewer\"\n    }\n  ]\n}\n```","ttft_ms":113808,"type":"result","duration_ms":124323,"uuid":"16f7a804-3542-4279-9f7f-5c1f76be4a76","ttft_stream_ms":858,"time_to_request_ms":101,"first_content_frame_ms":859,"queued_turn_count":0,"result_index":0}
