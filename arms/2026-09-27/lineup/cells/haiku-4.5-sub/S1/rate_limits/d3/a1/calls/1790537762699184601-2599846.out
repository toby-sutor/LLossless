{"duration_api_ms":157336,"stop_reason":"end_turn","session_id":"efef8dcc-4879-41d4-9924-e824941ee90e","total_cost_usd":0.094306,"usage":{"input_tokens":10,"cache_creation_input_tokens":5638,"cache_read_input_tokens":0,"output_tokens":16604,"output_tokens_details":{"thinking_tokens":13620},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":5638,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":10,"output_tokens":16604,"cache_read_input_tokens":0,"cache_creation_input_tokens":5638,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5638},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":10,"outputTokens":16604,"cacheReadInputTokens":0,"cacheCreationInputTokens":5638,"webSearchRequests":0,"costUSD":0.094306,"contextWindow":200000,"maxOutputTokens":32000,"thinkingTokens":13620,"canonicalModel":"claude-haiku-4-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"```json\n{\n  \"claims\": [\n    {\n      \"text\": \"Every credential has a cap.\",\n      \"line\": 3,\n      \"span\": \"Every credential has a cap\"\n    },\n    {\n      \"text\": \"When a cap is spent the gateway answers 429 at the edge without waking the service behind it.\",\n      \"line\": 3,\n      \"span\": \"When that cap is spent the gateway answers 429 at the edge — without waking the service behind it\"\n    },\n    {\n      \"text\": \"Requests are counted against the credential that presented them.\",\n      \"line\": 5,\n      \"span\": \"Requests are counted against the credential that presented them\"\n    },\n    {\n      \"text\": \"Requests are counted over a fixed window of 60 seconds.\",\n      \"line\": 5,\n      \"span\": \"over a fixed window of 60 seconds\"\n    },\n    {\n      \"text\": \"Requests are never counted against a connection.\",\n      \"line\": 5,\n      \"span\": \"never against a connection\"\n    },\n    {\n      \"text\": \"Opening a second socket buys a caller nothing.\",\n      \"line\": 5,\n      \"span\": \"Opening a second socket therefore buys a caller nothing\"\n    },\n    {\n      \"text\": \"A client spread across eight worker processes is throttled at exactly the point one process would have been.\",\n      \"line\": 5,\n      \"span\": \"A client spread across eight worker processes is throttled at exactly the point one process would have been\"\n    },\n    {\n      \"text\": \"A client spread across eight worker processes pays for the extra file descriptors.\",\n      \"line\": 5,\n      \"span\": \"pays for the extra file descriptors as well\"\n    },\n    {\n      \"text\": \"The default allowance is 100 requests in a window.\",\n      \"line\": 7,\n      \"span\": \"The default allowance is 100 requests in a window\"\n    },\n    {\n      \"text\": \"A credential marked for batch work is allowed 1000 in the same window.\",\n      \"line\": 7,\n      \"span\": \"a credential marked for batch work is allowed 1000 in the same window\"\n    },\n    {\n      \"text\": \"A refusal is not an outage.\",\n      \"line\": 7,\n      \"span\": \"A refusal is not an outage\"\n    },\n    {\n      \"text\": \"Callers that retry at once are the largest single reason the cap is there at all.\",\n      \"line\": 7,\n      \"span\": \"Callers that retry at once are the largest single reason the cap is there at all\"\n    },\n    {\n      \"text\": \"The refusal carries a Retry-After header.\",\n      \"line\": 11,\n      \"span\": \"The refusal carries a Retry-After header\"\n    },\n    {\n      \"text\": \"The Retry-After header value is a whole number of seconds to wait.\",\n      \"line\": 11,\n      \"span\": \"Its value is a whole number of seconds to wait\"\n    },\n    {\n      \"text\": \"Waiting that long and then continuing is the whole of the contract.\",\n      \"line\": 11,\n      \"span\": \"Waiting that long and then continuing is the whole of the contract\"\n    },\n    {\n      \"text\": \"The gateway keeps no memory of who backed off politely.\",\n      \"line\": 11,\n      \"span\": \"The gateway keeps no memory of who backed off politely\"\n    },\n    {\n      \"text\": \"Waiting longer than the header asks earns a caller no credit at all.\",\n      \"line\": 11,\n      \"span\": \"waiting longer than the header asks earns a caller no credit at all\"\n    },\n    {\n      \"text\": \"The body of the refusal is JSON.\",\n      \"line\": 13,\n      \"span\": \"The body of the refusal is JSON\"\n    },\n    {\n      \"text\": \"The body names what the gateway calls the window it counted in.\",\n      \"line\": 13,\n      \"span\": \"it names what the gateway calls the \\\"window\\\" it counted in\"\n    },\n    {\n      \"text\": \"The body names the cap and the tier.\",\n      \"line\": 13,\n      \"span\": \"It names the cap and the tier as well\"\n    },\n    {\n      \"text\": \"None of the fields in the body is a substitute for the header.\",\n      \"line\": 13,\n      \"span\": \"None of those fields is a substitute for the header\"\n    },\n    {\n      \"text\": \"A caller that parses the body to compute its own wait is doing the same arithmetic twice.\",\n      \"line\": 13,\n      \"span\": \"a caller that parses the body to compute its own wait is doing the same arithmetic twice\"\n    },\n    {\n      \"text\": \"The gateway has already done the arithmetic, with information the caller does not have.\",\n      \"line\": 19,\n      \"span\": \"The gateway has already done that arithmetic, with information the caller does not have\"\n    },\n    {\n      \"text\": \"The gateway does the same on the 503 path.\",\n      \"line\": 19,\n      \"span\": \"and it does the same on the 503 path\"\n    },\n    {\n      \"text\": \"A wait derived on the client side is a guess about a counter it cannot see.\",\n      \"line\": 19,\n      \"span\": \"A wait derived on the client side is a guess about a counter it cannot see\"\n    },\n    {\n      \"text\": \"A 200 wants nothing.\",\n      \"line\": 21,\n      \"span\": \"A 200 wants nothing\"\n    },\n    {\n      \"text\": \"A 429 wants the stated wait.\",\n      \"line\": 21,\n      \"span\": \"a 429 wants the stated wait\"\n    },\n    {\n      \"text\": \"A 500 may be retried once that wait has passed.\",\n      \"line\": 21,\n      \"span\": \"a 500 may be retried once that wait has passed\"\n    },\n    {\n      \"text\": \"A 503 is the overload path.\",\n      \"line\": 21,\n      \"span\": \"a 503 is the overload path\"\n    },\n    {\n      \"text\": \"The four cases are not interchangeable.\",\n      \"line\": 21,\n      \"span\": \"The four cases are not interchangeable\"\n    },\n    {\n      \"text\": \"A client that folds every non-success into one branch will retry hardest during exactly the incident the cap was installed to survive.\",\n      \"line\": 21,\n      \"span\": \"A client that folds every non-success into one branch will retry hardest during exactly the incident the cap was installed to survive\"\n    },\n    {\n      \"text\": \"A batch credential is allowed fifty times the default allowance.\",\n      \"line\": 23,\n      \"span\": \"A batch credential is allowed fifty times the default allowance\"\n    },\n    {\n      \"text\": \"A batch credential is measured over exactly the same window.\",\n      \"line\": 23,\n      \"span\": \"and it is measured over exactly the same window\"\n    },\n    {\n      \"text\": \"The tier is set on the credential when it is issued.\",\n      \"line\": 23,\n      \"span\": \"The tier is set on the credential when it is issued\"\n    },\n    {\n      \"text\": \"The tier cannot be asked for per call.\",\n      \"line\": 23,\n      \"span\": \"and cannot be asked for per call\"\n    },\n    {\n      \"text\": \"Nothing else about the two tiers differs in any way.\",\n      \"line\": 23,\n      \"span\": \"Nothing else about the two tiers differs in any way\"\n    },\n    {\n      \"text\": \"A caller that cannot say how often it was refused last week cannot argue for a larger cap.\",\n      \"line\": 25,\n      \"span\": \"A caller that cannot say how often it was refused last week cannot argue for a larger cap\"\n    },\n    {\n      \"text\": \"Nobody at the far end will assemble that argument on the caller's behalf.\",\n      \"line\": 25,\n      \"span\": \"nobody at the far end will assemble that argument on its behalf\"\n    },\n    {\n      \"text\": \"The log line should carry the credential, the window and the wait.\",\n      \"line\": 25,\n      \"span\": \"The log line should carry the credential, the window and the wait\"\n    },\n    {\n      \"text\": \"The gateway refuses requests for three reasons.\",\n      \"line\": 29,\n      \"span\": \"The gateway refuses a request for three reasons and only one of them is the one above\"\n    },\n    {\n      \"text\": \"One of those reasons is the rate cap mentioned above.\",\n      \"line\": 29,\n      \"span\": \"only one of them is the one above\"\n    },\n    {\n      \"text\": \"A credential may be suspended.\",\n      \"line\": 29,\n      \"span\": \"A credential may be suspended\"\n    },\n    {\n      \"text\": \"A route may be closed for maintenance.\",\n      \"line\": 29,\n      \"span\": \"a route may be closed for maintenance\"\n    },\n    {\n      \"text\": \"A body may exceed the 5 megabyte limit.\",\n      \"line\": 29,\n      \"span\": \"a body may exceed the 5 megabyte limit\"\n    },\n    {\n      \"text\": \"Suspended credentials, closed routes, and body size limits do not clear themselves by waiting for a stated number of seconds.\",\n      \"line\": 29,\n      \"span\": \"None of those three clears itself by waiting for a stated number of seconds\"\n    },\n    {\n      \"text\": \"A loop that waits and retries against a suspended credential spends its whole budget without ever reaching the service.\",\n      \"line\": 31,\n      \"span\": \"A loop that waits and retries against a suspended credential spends its whole budget without ever reaching the service\"\n    },\n    {\n      \"text\": \"The log shows nothing except a long run of refusals when retrying against a suspended credential.\",\n      \"line\": 31,\n      \"span\": \"the log afterwards shows nothing at all except a long run of refusals\"\n    },\n    {\n      \"text\": \"Reading the status code rather than the class separates the two cases.\",\n      \"line\": 31,\n      \"span\": \"Reading the status code rather than the class it belongs to is what separates the two cases\"\n    },\n    {\n      \"text\": \"Distinguishing by status code costs one comparison.\",\n      \"line\": 31,\n      \"span\": \"it costs one comparison\"\n    },\n    {\n      \"text\": \"A cap can be raised.\",\n      \"line\": 35,\n      \"span\": \"A cap can be raised\"\n    },\n    {\n      \"text\": \"The number of caps raised without a measurement behind them is 0.\",\n      \"line\": 35,\n      \"span\": \"the number of caps raised without a measurement behind them is 0\"\n    },\n    {\n      \"text\": \"A burst is cheaper to smooth than to serve at its peak.\",\n      \"line\": 35,\n      \"span\": \"a burst is cheaper to smooth than it is to serve at its peak\"\n    },\n    {\n      \"text\": \"A caller that can move half its work to a quieter hour usually gets what it needs without any change to the cap.\",\n      \"line\": 35,\n      \"span\": \"A caller that can move half its work to a quieter hour usually gets what it needs without any change to the cap at all\"\n    },\n    {\n      \"text\": \"Requests reach the platform team through the usual channel.\",\n      \"line\": 37,\n      \"span\": \"Requests reach the platform team through the usual channel\"\n    },\n    {\n      \"text\": \"Requests are answered within two working days.\",\n      \"line\": 37,\n      \"span\": \"they are answered within two working days\"\n    },\n    {\n      \"text\": \"There is no expedited path.\",\n      \"line\": 37,\n      \"span\": \"There is no expedited path\"\n    },\n    {\n      \"text\": \"There is no exception list.\",\n      \"line\": 37,\n      \"span\": \"no exception list\"\n    }\n  ]\n}\n```","ttft_ms":136889,"type":"result","duration_ms":157401,"uuid":"0daf92ac-a9c1-4408-ba06-e732c78c9244","ttft_stream_ms":912,"time_to_request_ms":95,"first_content_frame_ms":913,"queued_turn_count":0,"result_index":0}
