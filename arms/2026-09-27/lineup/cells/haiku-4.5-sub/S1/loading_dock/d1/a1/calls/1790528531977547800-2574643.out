idence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states that slots are booked through the facilities portal.\"\n    },\n    {\n      \"claim_id\": \"M-003\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"A slot is 45 minutes.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md directly states the slot duration.\"\n    },\n    {\n      \"claim_id\": \"M-004\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"A vehicle over 7.5 tonnes needs two consecutive slots\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this requirement for larger vehicles.\"\n    },\n    {\n      \"claim_id\": \"M-005\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"the portal will not let you book them separately\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md specifies the portal's restriction on separate booking of consecutive slots.\"\n    },\n    {\n      \"claim_id\": \"M-006\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Slots open 14 days ahead\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states the booking window opening time.\"\n    },\n    {\n      \"claim_id\": \"M-007\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"close 4 hours before the slot starts\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md specifies when the booking window closes.\"\n    },\n    {\n      \"claim_id\": \"M-008\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"There is no same-hour booking.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md directly states this booking restriction.\"\n    },\n    {\n      \"claim_id\": \"M-009\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"The dock booking phone line was retired\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states the phone line was retired.\"\n    },\n    {\n      \"claim_id\": \"M-010\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"the number no longer connects\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states the retired phone line no longer connects.\"\n    },\n    {\n      \"claim_id\": \"M-011\",\n      \"verdict\": \"CONTRADICTED\",\n      \"evidence\": \"If the portal is down, call the dock booking line on extension 2140 and the dock supervisor will enter the slot for you.\",\n      \"evidence_source\": \"source_b.md\",\n      \"rationale\": \"source_a.md claims all bookings go through the portal, but source_b.md describes an alternative phone booking method, contradicting universal portal usage.\"\n    },\n    {\n      \"claim_id\": \"M-012\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Drivers who call the old number hear a recorded message pointing them at the portal.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states what drivers hear when calling the retired phone line.\"\n    },\n    {\n      \"claim_id\": \"M-013\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Drivers report to the gatehouse with the booking reference.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states this procedure on arrival at the dock.\"\n    },\n    {\n      \"claim_id\": \"M-014\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"The gatehouse checks the reference against the day sheet\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md describes the gatehouse's verification process.\"\n    },\n    {\n      \"claim_id\": \"M-015\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"directs the vehicle to a bay\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states the gatehouse directs vehicles to bays.\"\n    },\n    {\n      \"claim_id\": \"M-016\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"A driver without a reference waits in the holding area until a slot is free.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md fully states this procedure for drivers without a booking reference.\"\n    },\n    {\n      \"claim_id\": \"M-017\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"A vehicle still on the bay 15 minutes after its slot ends is logged as an overrun.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"Both sources state this overrun definition; source_a.md provides the full claim.\"\n    },\n    {\n      \"claim_id\": \"M-018\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Three overruns in a quarter and the supplier is asked to rebook through their account manager.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"source_a.md states the consequence of three quarterly overruns.\"\n    }\n  ]\n}\n```","ttft_ms":47986,"type":"result","duration_ms":55699,"uuid":"b6cdbc12-174f-43f6-b138-485b3a5018e2","ttft_stream_ms":1007,"time_to_request_ms":91,"first_content_frame_ms":1008,"queued_turn_count":0,"result_index":0}
