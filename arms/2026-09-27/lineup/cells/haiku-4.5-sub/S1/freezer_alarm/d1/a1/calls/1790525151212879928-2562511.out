,\n      \"evidence\": \"The alarm sounds locally and sends a message to the night phone.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"Source_a.md directly states how the alarm operates.\"\n    },\n    {\n      \"claim_id\": \"M-003\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"The night phone is carried by the weekend duty officer from 18:00 on Friday until 08:00 on Monday.\",\n      \"evidence_source\": \"source_b.md\",\n      \"rationale\": \"Source_b.md directly states the night phone coverage schedule.\"\n    },\n    {\n      \"claim_id\": \"M-004\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"The alarm panel names the unit and shows the temperature that triggered it.\",\n      \"evidence_source\": \"source_b.md\",\n      \"rationale\": \"Source_b.md directly states what the alarm panel displays.\"\n    },\n    {\n      \"claim_id\": \"M-005\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"there are three units on this floor\",\n      \"evidence_source\": \"source_b.md\",\n      \"rationale\": \"Source_b.md states this fact in describing the alarm setup.\"\n    },\n    {\n      \"claim_id\": \"M-006\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"two of them alarm at the same set point\",\n      \"evidence_source\": \"source_b.md\",\n      \"rationale\": \"Source_b.md states this fact in describing the alarm setup.\"\n    },\n    {\n      \"claim_id\": \"M-007\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"The reading at the moment of arrival is the one the lab needs\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"Source_a.md states this as part of instructions for first response.\"\n    },\n    {\n      \"claim_id\": \"M-008\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"it cannot be recovered later\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"Source_a.md states this consequence of not recording the arrival reading.\"\n    },\n    {\n      \"claim_id\": \"M-009\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Every alarm gets a line in the freezer log whether or not anything was wrong.\",\n      \"evidence_source\": \"source_b.md\",\n      \"rationale\": \"Source_b.md directly states this logging requirement.\"\n    },\n    {\n      \"claim_id\": \"M-010\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"An alarm with no line in the log is indistinguishable from an alarm nobody attended.\",\n      \"evidence_source\": \"source_b.md\",\n      \"rationale\": \"Source_b.md directly states this consequence of missing log entries.\"\n    },\n    {\n      \"claim_id\": \"M-011\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Ice on the seal holds the door open by a few millimetres\",\n      \"evidence_source\": \"source_b.md\",\n      \"rationale\": \"Source_b.md states this as part of its description of seal inspection.\"\n    },\n    {\n      \"claim_id\": \"M-012\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"is the usual cause of a slow rise\",\n      \"evidence_source\": \"source_b.md\",\n      \"rationale\": \"Source_b.md states ice on the seal is the usual cause of slow temperature rise.\"\n    },\n    {\n      \"claim_id\": \"M-013\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Opening a door on a failing freezer to check the contents is the most common cause of loss in this building.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"Source_a.md directly states this as the most common cause of loss.\"\n    },\n    {\n      \"claim_id\": \"M-014\",\n      \"verdict\": \"SUPPORTED\",\n      \"evidence\": \"Contents are moved only on the technician's instruction and only into a freezer that already has space at the same set point.\",\n      \"evidence_source\": \"source_a.md\",\n      \"rationale\": \"Source_a.md directly states the conditions for moving contents.\"\n    }\n  ]\n}\n