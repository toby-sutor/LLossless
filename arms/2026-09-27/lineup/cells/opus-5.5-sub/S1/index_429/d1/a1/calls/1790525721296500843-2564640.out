{"duration_api_ms":55670,"stop_reason":"end_turn","session_id":"e418b28d-9ad6-4e2c-a695-9f83778f79ca","total_cost_usd":0.21172780000000002,"usage":{"input_tokens":2,"cache_creation_input_tokens":7556,"cache_read_input_tokens":1459,"output_tokens":7549,"output_tokens_details":{"thinking_tokens":1034},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":7556,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":7549,"cache_read_input_tokens":1459,"cache_creation_input_tokens":7556,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7556},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-opus-5-5":{"inputTokens":2,"outputTokens":7549,"cacheReadInputTokens":1459,"cacheCreationInputTokens":7556,"webSearchRequests":0,"costUSD":0.21172780000000002,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":1034,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"verdicts\":[{\"claim_id\":\"M-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Author: Priya Raghunathan\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A names Priya Raghunathan as author of the append-rejected-with-429 document.\"},{\"claim_id\":\"M-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Updated: 2026-03-18\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A gives the update date as 2026-03-18.\"},{\"claim_id\":\"M-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Append requests to Nimbrel Ledger come back with HTTP 429 `Too Many Requests`.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated verbatim in source A.\"},{\"claim_id\":\"M-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nimbrel Relay stalls\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A lists Relay stalling as a consequence of the refused append.\"},{\"claim_id\":\"M-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"batch loaders resend the same envelope\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A lists batch loaders resending the same envelope.\"},{\"claim_id\":\"M-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"reads against the same shard begin to time out\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states reads against the same shard begin to time out.\"},{\"claim_id\":\"M-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The refusal reaches the client and is written to the Relay and Collector logs as well.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the refusal reaches the client.\"},{\"claim_id\":\"M-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The refusal reaches the client and is written to the Relay and Collector logs as well.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the refusal is written to the Relay and Collector logs.\"},{\"claim_id\":\"M-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"which is what the Ledger does when it refuses work rather than queueing it\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states that returning 429 is what the Ledger does when it refuses work rather than queueing it.\"},{\"claim_id\":\"M-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"This note concerns a managed Nimbrel Ledger deployment (NMD) whose share of HTTP `429` replies climbed over a fortnight, as counted at the front proxy.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B describes an NMD whose share of 429 replies grew as counted at the front proxy; the claim generalises this occasion.\"},{\"claim_id\":\"M-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"This note concerns a managed Nimbrel Ledger deployment (NMD) whose share of HTTP `429` replies climbed over a fortnight, as counted at the front proxy.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the share of 429 replies climbed over a fortnight on one managed deployment.\"},{\"claim_id\":\"M-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Front proxy counters agree with the client reports, so the refusals are real and not a client-side accounting error.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B draws this conclusion from the agreement of proxy counters and client reports; the claim generalises it.\"},{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"append batch refused after 0 of 64 envelopes\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The example envelope in source A shows refusal after 0 of 64 envelopes.\"},{\"claim_id\":\"M-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"\\\"type\\\":\\\"nbl_queue_refused_exception\\\"\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The example envelope gives the error type as nbl_queue_refused_exception.\"},{\"claim_id\":\"M-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ingest_and_leader_bytes=88121344\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Value appears in the example envelope in source A.\"},{\"claim_id\":\"M-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"follower_bytes=212992\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Value appears in the example envelope in source A.\"},{\"claim_id\":\"M-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"all_bytes=88334336\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Value appears in the example envelope in source A.\"},{\"claim_id\":\"M-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ingest_op_bytes=155648\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Value appears in the example envelope in source A.\"},{\"claim_id\":\"M-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"max_ingest_bytes=88080384\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Value appears in the example envelope in source A.\"},{\"claim_id\":\"M-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The Ledger operations handbook now covers the same ground under Refused Appends\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the handbook covers this under Refused Appends.\"},{\"claim_id\":\"M-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"with a walkthrough for each of the three refusal paths set out below\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the handbook has a walkthrough for each of the three refusal paths.\"},{\"claim_id\":\"M-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Every Nimbrel Ledger release on every platform can refuse an append this way.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states every release on every platform can refuse an append this way, meaning with a 429.\"},{\"claim_id\":\"M-023\",\"verdict\":\"DERIVED\",\"evidence\":\"Every Nimbrel Ledger release on every platform can refuse an append this way.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A says every release on every platform can refuse appends with 429, and source B shows a managed deployment on Nimbrel Cloud returning 429s; together they entail that managed deployments are affected.\"},{\"claim_id\":\"M-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"- Version: 4.4, 5.x\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B's environment lists versions 4.4, 5.x.\"},{\"claim_id\":\"M-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"- Platform: Nimbrel Cloud\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B's environment lists the platform as Nimbrel Cloud.\"},{\"claim_id\":\"M-026\",\"verdict\":\"SUPPORTED\",\"evidence\":\"- Deployment: Managed Ledger Service (MLS)\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B's environment lists the deployment as Managed Ledger Service (MLS).\"},{\"claim_id\":\"M-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"- Production Environment: Yes\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B marks the environment as production.\"},{\"claim_id\":\"M-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"is what a Ledger node sends once it has nowhere left to put the work\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states a node sends a 429 once it has nowhere left to put the work.\"},{\"claim_id\":\"M-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"an append queue or a read queue is full\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A equates having nowhere to put the work with an append or read queue being full.\"},{\"claim_id\":\"M-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"There are 3 ways an append draws a 429:\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated directly in source A.\"},{\"claim_id\":\"M-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The `append` or `system_append` worker pools hold more batches than they have slots for\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A lists this as one of the three ways an append draws a 429.\"},{\"claim_id\":\"M-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The `append` or `system_append` worker pools hold more batches than they have slots for (`nbctl pool status --all`)\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A gives this command alongside the worker pool condition as the way to check it.\"},{\"claim_id\":\"M-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The ingest memory guard has refused the batch\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A lists the ingest memory guard refusal as a 429 path.\"},{\"claim_id\":\"M-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The ingest memory guard has refused the batch (`nbctl guard report ingest --counters`)\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A pairs this command with the ingest memory guard condition.\"},{\"claim_id\":\"M-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A circuit breaker has tripped\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A lists a tripped circuit breaker as a 429 path.\"},{\"claim_id\":\"M-036\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A circuit breaker has tripped (`nbctl breaker list --tripped`)\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A pairs this command with the tripped circuit breaker condition.\"},{\"claim_id\":\"M-037\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a breaker trips on any operation and is not particular to appends\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated directly in source A.\"},{\"claim_id\":\"M-038\",\"verdict\":\"SUPPORTED\",\"evidence\":\"appending to a `wide_text` column draws a 429 on its own account whenever the batch would otherwise have run the node out of memory\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this for release 4.6 and release 5.1 onward.\"},{\"claim_id\":\"M-039\",\"verdict\":\"SUPPORTED\",\"evidence\":\"It sets out what the evidence pointed at, which was expensive queries and deep grouping\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B found that a climbing refusal rate pointed at expensive queries and deep grouping; the claim generalises that occasion.\"},{\"claim_id\":\"M-040\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a handful of queries run for as long as 2 seconds each\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Stated directly in source B.\"},{\"claim_id\":\"M-041\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A worker slot is unavailable for as long as one of them holds it\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states a worker slot is unavailable while an expensive query holds it.\"},{\"claim_id\":\"M-042\",\"verdict\":\"SUPPORTED\",\"evidence\":\"and the queue behind it grows\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the queue behind the held slot grows.\"},{\"claim_id\":\"M-043\",\"verdict\":\"SUPPORTED\",\"evidence\":\"grouping on `channel.id` yields a very large number of groups\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Stated directly in source B.\"},{\"claim_id\":\"M-044\",\"verdict\":\"SUPPORTED\",\"evidence\":\"the memory that costs is charged to the same pool the append path draws on\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the grouping memory is charged to the pool the append path uses.\"},{\"claim_id\":\"M-045\",\"verdict\":\"SUPPORTED\",\"evidence\":\"processor load looks unremarkable while memory sits high\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Stated directly in source B.\"},{\"claim_id\":\"M-046\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The two do not agree, which points at query cost rather than at an undersized cluster.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Stated directly in source B.\"},{\"claim_id\":\"M-047\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Take append and query load off the cluster for long enough that the queues drain and the nodes fall back under their limits.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A's workaround states this in different words.\"},{\"claim_id\":\"M-048\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Where batches carry `wide_text` columns and the cluster runs release 4.6 or release 5.1 or later, send fewer envelopes per batch.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated in source A's workaround section.\"},{\"claim_id\":\"M-049\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A cluster that refuses appends has been given more work than its hardware can carry\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated directly in source A.\"},{\"claim_id\":\"M-050\",\"verdict\":\"SUPPORTED\",\"evidence\":\"so the answer is hardware: larger nodes (scale up), or more of them (scale out)\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A gives scaling up or out as the resolution.\"},{\"claim_id\":\"M-051\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Scale up first in most cases\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A attributes this guidance to the sizing notes.\"},{\"claim_id\":\"M-052\",\"verdict\":\"SUPPORTED\",\"evidence\":\"scale out when what is wanted is a further copy of the data for availability, per [the sizing notes]\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this per the sizing notes.\"},{\"claim_id\":\"M-053\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Splitting a hot stream over more leader shards spreads append load across more nodes\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated directly in source A.\"},{\"claim_id\":\"M-054\",\"verdict\":\"SUPPORTED\",\"evidence\":\"which helps in some layouts\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states splitting helps in some layouts.\"},{\"claim_id\":\"M-055\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Begin by cutting the number of envelopes in each append batch.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A's first step for wide_text columns on those releases.\"},{\"claim_id\":\"M-056\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Where smaller batches do not clear it, add processor and memory capacity to the nodes.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A's second step for wide_text columns.\"},{\"claim_id\":\"M-057\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Only then raise the `ingest_guard.memory.leader.ceiling` cluster setting\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A orders raising the ceiling after cutting batch size and adding capacity.\"},{\"claim_id\":\"M-058\",\"verdict\":\"SUPPORTED\",\"evidence\":\"which defaults to 10% of the heap\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A gives the default as 10% of the heap.\"},{\"claim_id\":\"M-059\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A higher ceiling lets a node hold more in-flight append memory before refusing\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated directly in source A.\"},{\"claim_id\":\"M-060\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a node holding too much runs out of memory instead of refusing\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated directly in source A.\"},{\"claim_id\":\"M-061\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a node holding too much runs out of memory instead of refusing, which is the worse outcome\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A calls running out of memory the worse outcome compared with refusing.\"},{\"claim_id\":\"M-062\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The setting is read at startup\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated directly in source A.\"},{\"claim_id\":\"M-063\",\"verdict\":\"SUPPORTED\",\"evidence\":\"so the cluster must be restarted for a change to take\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated directly in source A.\"},{\"claim_id\":\"M-064\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Where none of that is open to you, the load itself is what changes: fewer appends, cheaper queries, or both.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A says that when the scaling and setting options are unavailable, the load must change.\"},{\"claim_id\":\"M-065\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Refusals that show up only during a spike usually clear on their own once the queues drain.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Stated verbatim in source A.\"},{\"claim_id\":\"M-066\",\"verdict\":\"SUPPORTED\",\"evidence\":\"go through the expensive ones with the team that wrote them, several of which look like they could ask for less\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B found that query cost rather than cluster size was behind the refusals and proposed acting on the queries; the claim generalises that response.\"},{\"claim_id\":\"M-067\",\"verdict\":\"SUPPORTED\",\"evidence\":\"set it to 1 second\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B proposes lowering the slow query threshold to 1 second.\"},{\"claim_id\":\"M-068\",\"verdict\":\"SUPPORTED\",\"evidence\":\"so that the queries actually responsible are recorded instead of averaged away\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B gives this as the reason for the 1 second threshold.\"},{\"claim_id\":\"M-069\",\"verdict\":\"SUPPORTED\",\"evidence\":\"go through the expensive ones with the team that wrote them\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Stated among source B's proposed actions.\"},{\"claim_id\":\"M-070\",\"verdict\":\"SUPPORTED\",\"evidence\":\"while the refusal rate is high, take a thread dump and a heap snapshot rather than reasoning from counters alone\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Stated among source B's proposed actions.\"},{\"claim_id\":\"M-071\",\"verdict\":\"SUPPORTED\",\"evidence\":\"[Internal ticket NB-40917](https://tickets.nimbrel.example/issues/40917)\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B references internal ticket NB-40917 for this issue.\"}]}","ttft_ms":11115,"type":"result","duration_ms":55732,"uuid":"a27e0607-d4a9-497d-bc3c-d4afd44e8794","ttft_stream_ms":1574,"time_to_request_ms":110,"first_content_frame_ms":1575,"queued_turn_count":0,"result_index":0}
