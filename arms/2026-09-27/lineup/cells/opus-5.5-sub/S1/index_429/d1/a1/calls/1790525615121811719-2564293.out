{"duration_api_ms":48734,"stop_reason":"end_turn","session_id":"fc49884a-82d3-4e37-978a-fd58f2468451","total_cost_usd":0.19221580000000002,"usage":{"input_tokens":2,"cache_creation_input_tokens":7157,"cache_read_input_tokens":1459,"output_tokens":6733,"output_tokens_details":{"thinking_tokens":1265},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":7157,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":6733,"cache_read_input_tokens":1459,"cache_creation_input_tokens":7157,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7157},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-opus-5-5":{"inputTokens":2,"outputTokens":6733,"cacheReadInputTokens":1459,"cacheCreationInputTokens":7157,"webSearchRequests":0,"costUSD":0.19221580000000002,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":1265,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"verdicts\":[{\"claim_id\":\"A-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Append requests to Nimbrel Ledger come back with HTTP 429 `Too Many Requests`.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this verbatim.\"},{\"claim_id\":\"A-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nimbrel Relay stalls\",\"evidence_source\":\"merged.md\",\"rationale\":\"The consequences of the refusal include Nimbrel Relay stalling.\"},{\"claim_id\":\"A-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"batch loaders resend the same envelope\",\"evidence_source\":\"merged.md\",\"rationale\":\"The consequences of the refusal include batch loaders resending the same envelope.\"},{\"claim_id\":\"A-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"reads against the same shard begin to time out\",\"evidence_source\":\"merged.md\",\"rationale\":\"The consequences of the refusal include reads against the same shard timing out.\"},{\"claim_id\":\"A-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The refusal reaches the client\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states the refusal reaches the client.\"},{\"claim_id\":\"A-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"is written to the Relay and Collector logs as well\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states the refusal is written to the Relay and Collector logs.\"},{\"claim_id\":\"A-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The Ledger operations handbook now covers the same ground under Refused Appends\",\"evidence_source\":\"merged.md\",\"rationale\":\"The note says the handbook covers the topic under Refused Appends.\"},{\"claim_id\":\"A-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"with a walkthrough for each of the three refusal paths set out below\",\"evidence_source\":\"merged.md\",\"rationale\":\"The note says the handbook section has a walkthrough for each of the three refusal paths.\"},{\"claim_id\":\"A-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Every Nimbrel Ledger release on every platform can refuse an append this way.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states every release on every platform can refuse an append this way, meaning with HTTP 429.\"},{\"claim_id\":\"A-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A [`429 - Too Many Requests` reply](https://docs.nimbrel.example/ledger/http-status-codes) is what a Ledger node sends once it has nowhere left to put the work\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states a node sends a 429 once it has nowhere left to put the work.\"},{\"claim_id\":\"A-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"once [an append queue or a read queue is full](https://docs.nimbrel.example/ledger/why-appends-are-refused)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states the 429 is sent once an append queue or a read queue is full.\"},{\"claim_id\":\"A-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"There are 3 ways an append draws a 429:\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states there are 3 ways an append draws a 429.\"},{\"claim_id\":\"A-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The `append` or `system_append` worker pools hold more batches than they have slots for\",\"evidence_source\":\"merged.md\",\"rationale\":\"This is listed as the first of the three ways an append draws a 429.\"},{\"claim_id\":\"A-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"(`nbctl pool status --all`)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The command is given alongside the worker pool condition as the way to check it.\"},{\"claim_id\":\"A-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The ingest memory guard has refused the batch\",\"evidence_source\":\"merged.md\",\"rationale\":\"This is listed as one of the three ways an append draws a 429.\"},{\"claim_id\":\"A-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"(`nbctl guard report ingest --counters`)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The command is given alongside the ingest memory guard condition as the way to check it.\"},{\"claim_id\":\"A-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A circuit breaker has tripped\",\"evidence_source\":\"merged.md\",\"rationale\":\"This is listed as one of the three ways an append draws a 429.\"},{\"claim_id\":\"A-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"(`nbctl breaker list --tripped`)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The command is given alongside the tripped circuit breaker condition.\"},{\"claim_id\":\"A-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a breaker trips on any operation and is not particular to appends\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this directly.\"},{\"claim_id\":\"A-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"**From release 4.6 and release 5.1 onward**, appending to a `wide_text` column draws a 429 on its own account whenever the batch would otherwise have run the node out of memory.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The footnote states this with the same meaning.\"},{\"claim_id\":\"A-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Take append and query load off the cluster for long enough that the queues drain and the nodes fall back under their limits.\",\"evidence_source\":\"merged.md\",\"rationale\":\"This is the stated workaround.\"},{\"claim_id\":\"A-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Where batches carry `wide_text` columns and the cluster runs release 4.6 or release 5.1 or later, send fewer envelopes per batch.\",\"evidence_source\":\"merged.md\",\"rationale\":\"This is stated in the Workaround section.\"},{\"claim_id\":\"A-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A cluster that refuses appends has been given more work than its hardware can carry\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this directly.\"},{\"claim_id\":\"A-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"so the answer is hardware: larger nodes (scale up), or more of them (scale out)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The resolution is stated as hardware, either scaling up or scaling out.\"},{\"claim_id\":\"A-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Scale up first in most cases\",\"evidence_source\":\"merged.md\",\"rationale\":\"This is stated with attribution to the sizing notes.\"},{\"claim_id\":\"A-026\",\"verdict\":\"SUPPORTED\",\"evidence\":\"scale out when what is wanted is a further copy of the data for availability, per [the sizing notes](https://docs.nimbrel.example/ledger/sizing)\",\"evidence_source\":\"merged.md\",\"rationale\":\"This is stated with attribution to the sizing notes.\"},{\"claim_id\":\"A-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Splitting a hot stream over more leader shards spreads append load across more nodes\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this directly.\"},{\"claim_id\":\"A-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Begin by cutting the number of envelopes in each append batch.\",\"evidence_source\":\"merged.md\",\"rationale\":\"This is the first step listed for wide_text columns on those releases.\"},{\"claim_id\":\"A-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Where smaller batches do not clear it, add processor and memory capacity to the nodes.\",\"evidence_source\":\"merged.md\",\"rationale\":\"This is the second step listed for wide_text columns on those releases.\"},{\"claim_id\":\"A-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Only then raise the `ingest_guard.memory.leader.ceiling` cluster setting\",\"evidence_source\":\"merged.md\",\"rationale\":\"The third step says to raise the setting only after the first two steps.\"},{\"claim_id\":\"A-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"which defaults to 10% of the heap\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states the default is 10% of the heap.\"},{\"claim_id\":\"A-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A higher ceiling lets a node hold more in-flight append memory before refusing\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this directly.\"},{\"claim_id\":\"A-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a node holding too much runs out of memory instead of refusing\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this in the context of in-flight append memory.\"},{\"claim_id\":\"A-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The setting is read at startup\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states the setting is read at startup.\"},{\"claim_id\":\"A-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"so the cluster must be restarted for a change to take\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states a restart is required for a change to take effect.\"},{\"claim_id\":\"A-036\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Where none of that is open to you, the load itself is what changes: fewer appends, cheaper queries, or both.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this with the same meaning.\"},{\"claim_id\":\"A-037\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Refusals that show up only during a spike usually clear on their own once the queues drain.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this directly.\"},{\"claim_id\":\"B-001\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"Author: Priya Raghunathan\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text names a different author.\"},{\"claim_id\":\"B-002\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"Updated: 2026-03-18\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text gives a different update date.\"},{\"claim_id\":\"B-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"can take a growing share of requests as counted at the front proxy; on one deployment that share climbed over a fortnight\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states the 429 share, counted at the front proxy, climbed over a fortnight on one managed deployment.\"},{\"claim_id\":\"B-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A refusal rate that climbs steadily can point at expensive queries and deep grouping\",\"evidence_source\":\"merged.md\",\"rationale\":\"The generalized statement carries the claim that a rising refusal rate points at expensive queries and deep grouping.\"},{\"claim_id\":\"B-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"- Product: Nimbrel Ledger\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Environment section lists the product as Nimbrel Ledger.\"},{\"claim_id\":\"B-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"- Version: 4.4, 5.x\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Environment section lists the version as 4.4, 5.x.\"},{\"claim_id\":\"B-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"- Platform: Nimbrel Cloud\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Environment section lists the platform as Nimbrel Cloud.\"},{\"claim_id\":\"B-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"- Deployment: Managed Ledger Service (MLS)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Environment section lists the deployment as Managed Ledger Service (MLS).\"},{\"claim_id\":\"B-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"- Production Environment: Yes\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Environment section states it is a production environment.\"},{\"claim_id\":\"B-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"On a managed Nimbrel Ledger deployment (NMD), HTTP `429` replies, which the Ledger sends when it refuses work rather than queueing it, can take a growing share of requests\",\"evidence_source\":\"merged.md\",\"rationale\":\"The generalized statement, with the fortnight example, carries the growing share of 429 replies on the managed deployment.\"},{\"claim_id\":\"B-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"which the Ledger sends when it refuses work rather than queueing it\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this directly.\"},{\"claim_id\":\"B-012\",\"verdict\":\"PARTIAL\",\"evidence\":\"Where front proxy counters agree with the client reports\",\"evidence_source\":\"merged.md\",\"rationale\":\"The text raises front proxy counters agreeing with client reports only as a condition and does not state that they did agree.\"},{\"claim_id\":\"B-013\",\"verdict\":\"PARTIAL\",\"evidence\":\"the refusals are real and not a client-side accounting error\",\"evidence_source\":\"merged.md\",\"rationale\":\"The text states the refusals are real only conditionally, when the counters agree, and does not assert it outright.\"},{\"claim_id\":\"B-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a handful of queries run for as long as 2 seconds each\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this directly.\"},{\"claim_id\":\"B-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A worker slot is unavailable for as long as one of them holds it\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this about the expensive queries.\"},{\"claim_id\":\"B-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"and the queue behind it grows\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states the queue behind the held slot grows.\"},{\"claim_id\":\"B-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"grouping on `channel.id` yields a very large number of groups\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this directly.\"},{\"claim_id\":\"B-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"the memory that costs is charged to the same pool the append path draws on\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this directly.\"},{\"claim_id\":\"B-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"processor load looks unremarkable while memory sits high\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this directly.\"},{\"claim_id\":\"B-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The two do not agree, which points at query cost rather than at an undersized cluster.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this directly.\"},{\"claim_id\":\"B-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"**Lower the slow query threshold**: set it to 1 second\",\"evidence_source\":\"merged.md\",\"rationale\":\"This is listed as a recommended action.\"},{\"claim_id\":\"B-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"several of which look like they could ask for less\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this about the expensive queries.\"},{\"claim_id\":\"B-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"while the refusal rate is high, take a thread dump and a heap snapshot\",\"evidence_source\":\"merged.md\",\"rationale\":\"This is listed as a recommended action.\"},{\"claim_id\":\"B-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"[Internal ticket NB-40917](https://tickets.nimbrel.example/issues/40917)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The References section lists internal ticket NB-40917.\"}]}","ttft_ms":12874,"type":"result","duration_ms":48797,"uuid":"468ad481-b8fa-4310-8951-94b818d33f43","ttft_stream_ms":1509,"time_to_request_ms":94,"first_content_frame_ms":1510,"queued_turn_count":0,"result_index":0}
