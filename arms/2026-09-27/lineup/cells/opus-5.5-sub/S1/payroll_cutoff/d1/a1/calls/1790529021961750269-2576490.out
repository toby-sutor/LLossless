tionale\":\"Source_a states salaried staff are not covered by the page.\"},{\"claim_id\":\"M-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Totals must be submitted by 12:00 on the 18th of the month.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a (2026 schedule) states this deadline verbatim; source_b's different 2025 deadline does not negate support from source_a.\"},{\"claim_id\":\"M-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The 18th is a hard\\ncut-off, not a target.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states the 18th is a hard cut-off, not a target.\"},{\"claim_id\":\"M-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Submissions that arrive after it are held for the\\nfollowing month's run.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states submissions after the 18th cut-off are held for the following month's run.\"},{\"claim_id\":\"M-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"If the 18th falls on a weekend or a public holiday, the cut-off moves to the\\nlast working day before it.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states this rule in essentially the same words.\"},{\"claim_id\":\"M-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Submit one file per team.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Both sources require one file per team.\"},{\"claim_id\":\"M-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The file must list every hourly worker with hours and\\nthe cost centre the hours are charged to.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states the file lists every hourly worker with hours and cost centre.\"},{\"claim_id\":\"M-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Blank rows are rejected by the upload\\npage.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states the upload page rejects blank rows.\"},{\"claim_id\":\"M-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A correction submitted before the cut-off replaces the earlier file entirely.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Both sources state this verbatim.\"},{\"claim_id\":\"M-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"After the cut-off, corrections go to the payroll inbox as a written request.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source_b states this verbatim, and source_a says the same.\"},{\"claim_id\":\"M-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"are applied to the following month.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states post-cut-off corrections are applied to the following month.\"},{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Teams without terminal access may send paper timesheets to the payroll office by\\ninternal post\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source_b states teams without terminal access may send paper timesheets by internal post.\"},{\"claim_id\":\"M-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"to arrive no later than the cut-off.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source_b states paper timesheets must arrive no later than the cut-off.\"},{\"claim_id\":\"M-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"If the upload page is unavailable in the hour before the cut-off, email the\\npayroll team\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a instructs emailing the payroll team if the upload page is unavailable in the hour before cut-off.\"},{\"claim_id\":\"M-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"and keep the file.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a instructs keeping the file when the upload page is unavailable before cut-off.\"},{\"claim_id\":\"M-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Do not send totals in the body of an email.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states totals must not be sent in the body of an email.\"}]}","ttft_ms":2533,"type":"result","duration_ms":13095,"uuid":