pine.\"},{\"text\":\"Hold shelf items are shelved alphabetically by the borrower's surname.\",\"line\":6,\"span\":\"Shelve items alphabetically by the borrower's\\nsurname.\"},{\"text\":\"An item waits on the hold shelf for 7 days.\",\"line\":11,\"span\":\"An item waits on the hold shelf for 7 days.\"},{\"text\":\"Day one of the hold shelf wait is the day the borrower is notified.\",\"line\":11,\"span\":\"Day one is the day the borrower is\\nnotified, not the day the item arrived.\"},{\"text\":\"Day one of the hold shelf wait is not the day the item arrived.\",\"line\":11,\"span\":\"Day one is the day the borrower is\\nnotified, not the day the item arrived.\"},{\"text\":\"The hold shelf is swept every morning before opening.\",\"line\":16,\"span\":\"Sweep the shelf every morning before opening.\"},{\"text\":\"Items on the hold shelf past 7 days go back into circulation if there is no next borrower in the queue.\",\"line\":16,\"span\":\"Items past 7 days go back into\\ncirculation, or on to the next borrower in the queue if there is one.\"},{\"text\":\"Items on the hold shelf past 7 days go on to the next borrower in the queue if there is one.\",\"line\":16,\"span\":\"Items past 7 days go back into\\ncirculation, or on to the next borrower in the queue if there is one.\"},{\"text\":\"A borrower who asks before the 7 days are up can have the item held for a further 7 days.\",\"line\":21,\"span\":\"A borrower who asks before the 7 days are up can have the item held for a further\\n7 days.\"},{\"text\":\"The further 7-day hold extension is granted once per request.\",\"line\":22,\"span\":\"This is granted once per request.\"},{\"text\":\"An item that has been on the hold shelf twice without being collected goes back to the shelves.\",\"line\":26,\"span\":\"An item that has been on the hold shelf twice without being collected goes back\\nto the shelves and the request is cancelled.\"},{\"text\":\"When an item has been on the hold shelf twice without being collected, the request is cancelled.\",\"line\":26,\"span\":\"An item that has been on the hold shelf twice without being collected goes back\\nto the shelves and the request is cancelled.\"}]}","ttft_ms":7089,"type":"result","duration_ms":7126,"uuid":"5212fda5-d265-4b9e-98de-0868dbe736f7","ttft_stream_ms":1507,"time_to_request_ms":92,"first_content_frame_ms":1507,"queued_turn_count":0,"result_index":0}
