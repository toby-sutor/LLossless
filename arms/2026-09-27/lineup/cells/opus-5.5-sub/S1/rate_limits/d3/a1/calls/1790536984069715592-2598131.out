assed\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states a 500 may be retried once the wait has passed.\"},{\"claim_id\":\"A-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a 503 means the platform itself is overloaded\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text ties 503 to platform overload, which is the overload path.\"},{\"claim_id\":\"A-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A client that folds every non-success into one branch will retry hardest during exactly the incident the cap was installed to survive.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this directly.\"},{\"claim_id\":\"A-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"fifty times the default allowance\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states the batch allowance is fifty times the default.\"},{\"claim_id\":\"A-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it is measured over exactly the same window\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states batch is measured over exactly the same window.\"},{\"claim_id\":\"A-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The tier is set on the credential when it is issued\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states this directly.\"},{\"claim_id\":\"A-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"cannot be asked for per call\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states the tier cannot be asked for per call.\"},{\"claim_id\":\"A-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nothing else about the two tiers differs in any way.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference text states nothing else differs between the tiers.\"},{\"claim_id\":\"A-036\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The log line should carry the credential, the window and the wait.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The refere