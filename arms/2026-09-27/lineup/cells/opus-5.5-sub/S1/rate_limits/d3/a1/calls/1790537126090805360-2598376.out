{"duration_api_ms":50405,"stop_reason":"end_turn","session_id":"d07c803b-ebe0-4044-96df-633c19552819","total_cost_usd":0.21215980000000004,"usage":{"input_tokens":2,"cache_creation_input_tokens":7900,"cache_read_input_tokens":1459,"output_tokens":7433,"output_tokens_details":{"thinking_tokens":883},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":7900,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":7433,"cache_read_input_tokens":1459,"cache_creation_input_tokens":7900,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7900},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-opus-5-5":{"inputTokens":2,"outputTokens":7433,"cacheReadInputTokens":1459,"cacheCreationInputTokens":7900,"webSearchRequests":0,"costUSD":0.21215980000000004,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":883,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"verdicts\":[{\"claim_id\":\"M-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Every credential has a cap.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"When that cap is spent the gateway answers 429 at the edge\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the gateway answers 429 at the edge when the cap is spent.\"},{\"claim_id\":\"M-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"without waking the service behind it\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the 429 is answered without waking the service behind it.\"},{\"claim_id\":\"M-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"the refusal costs the platform almost nothing\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the refusal costs the platform almost nothing.\"},{\"claim_id\":\"M-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Requests are counted against the credential that presented them\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"never against a connection\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states requests are never counted against a connection.\"},{\"claim_id\":\"M-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"over a fixed window of 60 seconds\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the fixed 60-second window.\"},{\"claim_id\":\"M-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"over a fixed window of 60 seconds whose start the gateway doesn’t disclose\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the gateway does not disclose the window's start.\"},{\"claim_id\":\"M-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The count follows the credential wherever the caller happens to put it, including across hosts.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the count follows the credential across hosts.\"},{\"claim_id\":\"M-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Opening a second socket therefore buys a caller nothing.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states a second socket buys the caller nothing, which means the same.\"},{\"claim_id\":\"M-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A client spread across eight worker processes is throttled at exactly the point one process would have been\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The default allowance is 100 requests in a window\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Both sources state the default allowance of 100 requests per window.\"},{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a credential marked for batch work is allowed 1000 in the same window\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"which is enough for every interactive use of this API the platform team has seen\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the default allowance suffices for every interactive use seen.\"},{\"claim_id\":\"M-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a caller that needs more than that is almost always doing batch work under an interactive credential\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this directly.\"},{\"claim_id\":\"M-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A refusal is not an outage\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states a refusal is not an outage.\"},{\"claim_id\":\"M-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The refusal isn’t an outage and it isn’t a bug in the gateway\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the refusal is not a bug in the gateway.\"},{\"claim_id\":\"M-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"It is the platform declining to spend capacity that has already been promised to somebody else\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Callers that retry at once are the largest single reason the cap is there at all.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states immediate retriers are the largest single reason for the cap.\"},{\"claim_id\":\"M-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Callers that retry immediately are most of the reason the cap is there.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states immediate retriers are most of the reason for the cap.\"},{\"claim_id\":\"M-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The refusal carries a Retry-After header.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it is present on every refusal the gateway sends\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the header is present on every refusal.\"},{\"claim_id\":\"M-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Its value is a whole number of seconds to wait.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Waiting that long and then continuing is the whole of the contract\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The gateway keeps no memory of who backed off politely\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-026\",\"verdict\":\"SUPPORTED\",\"evidence\":\"waiting longer than the header asks earns a caller no credit at all\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The body of the refusal is JSON\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the refusal body is JSON.\"},{\"claim_id\":\"M-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it repeats the cap, the window and the tier as plain fields\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the body carries the cap, window and tier as plain fields.\"},{\"claim_id\":\"M-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"None of those fields is a substitute for the header\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Both sources state this directly.\"},{\"claim_id\":\"M-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The body is there so that a human reading a log afterwards can see why the request was refused\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"nothing in it is meant for the retry loop\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Four rules, given in the order they should be applied.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states there are four rules for retrying.\"},{\"claim_id\":\"M-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Honour the header and don’t compute your own wait.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this directly; Source A adds every time.\"},{\"claim_id\":\"M-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The gateway has already done that arithmetic, with information the caller does not have\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it does the same on the 503 path\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the gateway does the same arithmetic on the 503 path.\"},{\"claim_id\":\"M-036\",\"verdict\":\"SUPPORTED\",\"evidence\":\"even though the cause of the refusal is an entirely different one\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the 503 refusal has an entirely different cause.\"},{\"claim_id\":\"M-037\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A wait derived on the client side is a guess about a counter it cannot see.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-038\",\"verdict\":\"SUPPORTED\",\"evidence\":\"An earlier draft of this note argued for a client-side token bucket that mirrored the gateway’s own counters\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this directly.\"},{\"claim_id\":\"M-039\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Retry only what is safe to retry.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-040\",\"verdict\":\"SUPPORTED\",\"evidence\":\"which is a smaller set than the set of responses that aren’t a success\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the safe-to-retry set is smaller than the non-success set.\"},{\"claim_id\":\"M-041\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A 200 wants nothing\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-042\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a 429 wants the stated wait\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-043\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a 500 may be retried once that wait has passed\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-044\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a 503 means the platform itself is overloaded\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this verbatim.\"},{\"claim_id\":\"M-045\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The four cases are not interchangeable.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-046\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A client that folds every non-success into one branch will retry hardest during exactly the incident the cap was installed to survive.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-047\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A batch credential is allowed 1000 requests in a window\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this verbatim.\"},{\"claim_id\":\"M-048\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A batch credential is allowed fifty times the default allowance\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the batch allowance is fifty times the default; Source B says 50 times.\"},{\"claim_id\":\"M-049\",\"verdict\":\"SUPPORTED\",\"evidence\":\"not a separate counting scheme\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the batch allowance is not a separate counting scheme.\"},{\"claim_id\":\"M-050\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it is measured over exactly the same window\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the batch credential uses exactly the same window.\"},{\"claim_id\":\"M-051\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The window, the header and the body are identical to the interactive case\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the header and body are identical across tiers.\"},{\"claim_id\":\"M-052\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a client written for one tier needs no change at all to run against the other\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this directly.\"},{\"claim_id\":\"M-053\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The tier is set on the credential when it is issued\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-054\",\"verdict\":\"SUPPORTED\",\"evidence\":\"cannot be asked for per call\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the tier cannot be requested per call.\"},{\"claim_id\":\"M-055\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nothing else about the two tiers differs in any way.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-056\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Log every refusal seen.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-057\",\"verdict\":\"SUPPORTED\",\"evidence\":\"keep the log for at least a week\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the log should be kept for at least a week.\"},{\"claim_id\":\"M-058\",\"verdict\":\"SUPPORTED\",\"evidence\":\"nobody at the far end will assemble that argument on its behalf\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-059\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The log line should carry the credential, the window and the wait.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-060\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Not all are caps.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states not all refusals are caps.\"},{\"claim_id\":\"M-061\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The gateway refuses a request for three reasons\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-062\",\"verdict\":\"SUPPORTED\",\"evidence\":\"only one of them is the one above\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states only one of the three reasons is the cap.\"},{\"claim_id\":\"M-063\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A credential may be suspended\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-064\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a route may be closed for maintenance\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-065\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a body may exceed the 5 megabyte limit\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the body limit is 5 megabytes.\"},{\"claim_id\":\"M-066\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a request body over the 5 megabyte limit is refused before it has been read at all\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this directly.\"},{\"claim_id\":\"M-067\",\"verdict\":\"SUPPORTED\",\"evidence\":\"None of those three clears itself by waiting for a stated number of seconds.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-068\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A loop that waits and retries against a suspended credential spends its whole budget without ever reaching the service\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-069\",\"verdict\":\"SUPPORTED\",\"evidence\":\"the log afterwards shows nothing at all except a long run of refusals\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-070\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Reading the status code rather than the class it belongs to is what separates the two cases\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-071\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it costs one comparison\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-072\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A cap can be raised\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-073\",\"verdict\":\"SUPPORTED\",\"evidence\":\"the number of caps raised without a measurement behind them is 0\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-074\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Bring a week of refusal counts, the shape of the traffic across the day, and the deadline that traffic is serving.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-075\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The team wants to know whether the load is smooth or bursty before it looks at the number at all.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states the team checks smooth versus bursty before looking at the number.\"},{\"claim_id\":\"M-076\",\"verdict\":\"SUPPORTED\",\"evidence\":\"a burst is cheaper to smooth than it is to serve at its peak\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-077\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A caller that can move half its work to a quieter hour usually gets what it needs without any change to the cap at all\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-078\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Requests reach the platform team through the usual channel\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-079\",\"verdict\":\"SUPPORTED\",\"evidence\":\"they are answered within two working days\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-080\",\"verdict\":\"SUPPORTED\",\"evidence\":\"chasing it doesn’t make it take fewer\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states chasing the answer does not make it take fewer days.\"},{\"claim_id\":\"M-081\",\"verdict\":\"SUPPORTED\",\"evidence\":\"There is no expedited path\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Both sources state there is no expedited path.\"},{\"claim_id\":\"M-082\",\"verdict\":\"SUPPORTED\",\"evidence\":\"no exception list\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states there is no exception list.\"}]}","ttft_ms":8283,"type":"result","duration_ms":50469,"uuid":"4ddcc39a-87bd-48ef-9c3f-917873aeb1ea","ttft_stream_ms":1608,"time_to_request_ms":96,"first_content_frame_ms":1609,"queued_turn_count":0,"result_index":0}
