{"duration_api_ms":43350,"stop_reason":"end_turn","session_id":"cf159622-c281-44ef-9bdf-c7a5653f4eb1","total_cost_usd":0.15949180000000002,"usage":{"input_tokens":2,"cache_creation_input_tokens":3554,"cache_read_input_tokens":1459,"output_tokens":6538,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3554,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":6538,"cache_read_input_tokens":1459,"cache_creation_input_tokens":3554,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3554},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-opus-5-5":{"inputTokens":2,"outputTokens":6538,"cacheReadInputTokens":1459,"cacheCreationInputTokens":3554,"webSearchRequests":0,"costUSD":0.15949180000000002,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":0,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"claims\":[{\"text\":\"Every credential has a cap.\",\"line\":3,\"span\":\"Every credential has a cap.\"},{\"text\":\"When a credential's cap is spent, the gateway answers 429 at the edge.\",\"line\":3,\"span\":\"When that cap is spent the gateway answers 429 at the edge — without waking the service behind it — so the refusal costs the platform almost nothing and costs a caller that files it under transport error a great deal.\"},{\"text\":\"When a credential's cap is spent, the gateway answers 429 without waking the service behind it.\",\"line\":3,\"span\":\"When that cap is spent the gateway answers 429 at the edge — without waking the service behind it — so the refusal costs the platform almost nothing and costs a caller that files it under transport error a great deal.\"},{\"text\":\"A 429 refusal at the gateway edge costs the platform almost nothing.\",\"line\":3,\"span\":\"When that cap is spent the gateway answers 429 at the edge — without waking the service behind it — so the refusal costs the platform almost nothing and costs a caller that files it under transport error a great deal.\"},{\"text\":\"Requests are counted against the credential that presented them.\",\"line\":5,\"span\":\"Requests are counted against the credential that presented them, never against a connection, over a fixed window of 60 seconds whose start the gateway does not disclose.\"},{\"text\":\"Requests are never counted against a connection.\",\"line\":5,\"span\":\"Requests are counted against the credential that presented them, never against a connection, over a fixed window of 60 seconds whose start the gateway does not disclose.\"},{\"text\":\"Requests are counted over a fixed window of 60 seconds.\",\"line\":5,\"span\":\"Requests are counted against the credential that presented them, never against a connection, over a fixed window of 60 seconds whose start the gateway does not disclose.\"},{\"text\":\"The gateway does not disclose the start of the 60-second counting window.\",\"line\":5,\"span\":\"Requests are counted against the credential that presented them, never against a connection, over a fixed window of 60 seconds whose start the gateway does not disclose.\"},{\"text\":\"The request count follows the credential across hosts.\",\"line\":5,\"span\":\"The count follows the credential wherever the caller puts it, including across hosts, so opening a second socket buys a caller nothing.\"},{\"text\":\"Opening a second socket does not increase a caller's allowance.\",\"line\":5,\"span\":\"The count follows the credential wherever the caller puts it, including across hosts, so opening a second socket buys a caller nothing.\"},{\"text\":\"A client spread across eight worker processes is throttled at exactly the point one process would have been.\",\"line\":5,\"span\":\"A client spread across eight worker processes is throttled at exactly the point one process would have been — and pays for the extra file descriptors as well.\"},{\"text\":\"The default allowance is 100 requests in a window.\",\"line\":7,\"span\":\"The default allowance is 100 requests in a window, and a credential marked for batch work is allowed 1000 in the same window.\"},{\"text\":\"A credential marked for batch work is allowed 1000 requests in the same window.\",\"line\":7,\"span\":\"The default allowance is 100 requests in a window, and a credential marked for batch work is allowed 1000 in the same window.\"},{\"text\":\"The default allowance is enough for every interactive use of the API the platform team has seen.\",\"line\":7,\"span\":\"The default is enough for every interactive use of this API the platform team has seen, and a caller that needs more than that is almost always doing batch work under an interactive credential.\"},{\"text\":\"A caller that needs more than the default allowance is almost always doing batch work under an interactive credential.\",\"line\":7,\"span\":\"The default is enough for every interactive use of this API the platform team has seen, and a caller that needs more than that is almost always doing batch work under an interactive credential.\"},{\"text\":\"A 429 refusal is not an outage.\",\"line\":7,\"span\":\"A refusal is not an outage and not a bug in the gateway, whatever the error class in a client library happens to call it.\"},{\"text\":\"A 429 refusal is not a bug in the gateway.\",\"line\":7,\"span\":\"A refusal is not an outage and not a bug in the gateway, whatever the error class in a client library happens to call it.\"},{\"text\":\"A 429 refusal is the platform declining to spend capacity that has already been promised to somebody else.\",\"line\":7,\"span\":\"It is the platform declining to spend capacity that has already been promised to somebody else, and waiting is the only correct answer.\"},{\"text\":\"Callers that retry at once are the largest single reason the cap exists.\",\"line\":7,\"span\":\"Callers that retry at once are the largest single reason the cap is there at all, accounting for most of it.\"},{\"text\":\"Callers that retry at once account for most of the reason the cap exists.\",\"line\":7,\"span\":\"Callers that retry at once are the largest single reason the cap is there at all, accounting for most of it.\"},{\"text\":\"The 429 refusal carries a Retry-After header.\",\"line\":11,\"span\":\"The refusal carries a Retry-After header, present on every refusal the gateway sends.\"},{\"text\":\"The Retry-After header is present on every refusal the gateway sends.\",\"line\":11,\"span\":\"The refusal carries a Retry-After header, present on every refusal the gateway sends.\"},{\"text\":\"The Retry-After header value is a whole number of seconds to wait.\",\"line\":11,\"span\":\"Its value is a whole number of seconds to wait.\"},{\"text\":\"Waiting the Retry-After duration and then continuing is the whole of the contract.\",\"line\":11,\"span\":\"Waiting that long and then continuing is the whole of the contract — a client that does it needs nothing else from this document, which is the outcome the document was written for, however unlikely that makes it to be read at all.\"},{\"text\":\"The gateway keeps no memory of who backed off politely.\",\"line\":11,\"span\":\"The gateway keeps no memory of who backed off politely, so waiting longer than the header asks earns a caller no credit at all.\"},{\"text\":\"Waiting longer than the Retry-After header asks earns a caller no credit.\",\"line\":11,\"span\":\"The gateway keeps no memory of who backed off politely, so waiting longer than the header asks earns a caller no credit at all.\"},{\"text\":\"The body of the 429 refusal is JSON.\",\"line\":13,\"span\":\"The body of the refusal is JSON, and it names the cap, the tier and what the gateway calls the “window” it counted in, as plain fields.\"},{\"text\":\"The body of the 429 refusal names the cap, the tier and the window as plain fields.\",\"line\":13,\"span\":\"The body of the refusal is JSON, and it names the cap, the tier and what the gateway calls the “window” it counted in, as plain fields.\"},{\"text\":\"None of the refusal body fields is a substitute for the Retry-After header.\",\"line\":13,\"span\":\"None of those fields is a substitute for the header: a caller that parses the body to compute its own wait is doing the same arithmetic twice, in code whose only possible future is to disagree with the gateway it is talking to.\"},{\"text\":\"The refusal body exists so that a human reading a log afterwards can see why the request was refused.\",\"line\":13,\"span\":\"The body is there so that a human reading a log afterwards can see why the request was refused — nothing in it is meant for the retry loop.\"},{\"text\":\"Nothing in the refusal body is meant for the retry loop.\",\"line\":13,\"span\":\"The body is there so that a human reading a log afterwards can see why the request was refused — nothing in it is meant for the retry loop.\"},{\"text\":\"There are four rules for retrying well.\",\"line\":17,\"span\":\"Four rules, given in the order they should be applied.\"},{\"text\":\"Clients should honour the Retry-After header every time and not compute their own wait.\",\"line\":19,\"span\":\"Honour the header, every time, and do not compute your own wait.\"},{\"text\":\"The gateway computes the wait with information the caller does not have.\",\"line\":19,\"span\":\"The gateway has already done that arithmetic, with information the caller does not have, and it does the same on the 503 path, even though the cause of that refusal is an entirely different one.\"},{\"text\":\"The gateway also computes the wait on the 503 path.\",\"line\":19,\"span\":\"The gateway has already done that arithmetic, with information the caller does not have, and it does the same on the 503 path, even though the cause of that refusal is an entirely different one.\"},{\"text\":\"The cause of a 503 refusal is different from the cause of a 429 refusal.\",\"line\":19,\"span\":\"The gateway has already done that arithmetic, with information the caller does not have, and it does the same on the 503 path, even though the cause of that refusal is an entirely different one.\"},{\"text\":\"A wait derived on the client side is a guess about a counter the client cannot see.\",\"line\":19,\"span\":\"A wait derived on the client side is a guess about a counter it cannot see.\"},{\"text\":\"An earlier draft of the document argued for a client-side token bucket that mirrored the gateway's own counters.\",\"line\":19,\"span\":\"An earlier draft of this document argued for a client-side token bucket that mirrored the gateway’s own counters; that section is left out on purpose, because two counters that disagree are worse than one counter that refuses, which is the whole reason the header exists.\"},{\"text\":\"Clients should retry only what is safe to retry.\",\"line\":20,\"span\":\"Retry only what is safe to retry, which is a smaller set than the set of responses that are not a success.\"},{\"text\":\"The set of responses safe to retry is smaller than the set of non-success responses.\",\"line\":20,\"span\":\"Retry only what is safe to retry, which is a smaller set than the set of responses that are not a success.\"},{\"text\":\"A 200 response wants nothing.\",\"line\":20,\"span\":\"A 200 wants nothing, a 429 wants the stated wait, a 500 may be retried once that wait has passed, and a 503 means the platform itself is overloaded.\"},{\"text\":\"A 429 response wants the stated wait.\",\"line\":20,\"span\":\"A 200 wants nothing, a 429 wants the stated wait, a 500 may be retried once that wait has passed, and a 503 means the platform itself is overloaded.\"},{\"text\":\"A 500 response may be retried once the stated wait has passed.\",\"line\":20,\"span\":\"A 200 wants nothing, a 429 wants the stated wait, a 500 may be retried once that wait has passed, and a 503 means the platform itself is overloaded.\"},{\"text\":\"A 503 response means the platform itself is overloaded.\",\"line\":20,\"span\":\"A 200 wants nothing, a 429 wants the stated wait, a 500 may be retried once that wait has passed, and a 503 means the platform itself is overloaded.\"},{\"text\":\"The 200, 429, 500 and 503 cases are not interchangeable.\",\"line\":20,\"span\":\"The four cases are not interchangeable.\"},{\"text\":\"A client that folds every non-success into one branch will retry hardest during exactly the incident the cap was installed to survive.\",\"line\":20,\"span\":\"A client that folds every non-success into one branch will retry hardest during exactly the incident the cap was installed to survive.\"},{\"text\":\"A batch credential is allowed 1000 requests in a window.\",\"line\":21,\"span\":\"A batch credential is allowed 1000 requests in a window, fifty times the default allowance rather than a separate counting scheme, and it is measured over exactly the same window with the same header and the same body, so a client written for one tier needs no change at all to run against the other.\"},{\"text\":\"The batch allowance is fifty times the default allowance.\",\"line\":21,\"span\":\"A batch credential is allowed 1000 requests in a window, fifty times the default allowance rather than a separate counting scheme, and it is measured over exactly the same window with the same header and the same body, so a client written for one tier needs no change at all to run against the other.\"},{\"text\":\"The batch allowance is not a separate counting scheme.\",\"line\":21,\"span\":\"A batch credential is allowed 1000 requests in a window, fifty times the default allowance rather than a separate counting scheme, and it is measured over exactly the same window with the same header and the same body, so a client written for one tier needs no change at all to run against the other.\"},{\"text\":\"A batch credential is measured over exactly the same window as the default tier.\",\"line\":21,\"span\":\"A batch credential is allowed 1000 requests in a window, fifty times the default allowance rather than a separate counting scheme, and it is measured over exactly the same window with the same header and the same body, so a client written for one tier needs no change at all to run against the other.\"},{\"text\":\"A batch credential's refusals use the same header and the same body as the default tier.\",\"line\":21,\"span\":\"A batch credential is allowed 1000 requests in a window, fifty times the default allowance rather than a separate counting scheme, and it is measured over exactly the same window with the same header and the same body, so a client written for one tier needs no change at all to run against the other.\"},{\"text\":\"A client written for one tier needs no change to run against the other tier.\",\"line\":21,\"span\":\"A batch credential is allowed 1000 requests in a window, fifty times the default allowance rather than a separate counting scheme, and it is measured over exactly the same window with the same header and the same body, so a client written for one tier needs no change at all to run against the other.\"},{\"text\":\"The tier is set on the credential when it is issued.\",\"line\":21,\"span\":\"The tier is set on the credential when it is issued and cannot be asked for per call.\"},{\"text\":\"The tier cannot be asked for per call.\",\"line\":21,\"span\":\"The tier is set on the credential when it is issued and cannot be asked for per call.\"},{\"text\":\"Nothing else about the default and batch tiers differs.\",\"line\":21,\"span\":\"Nothing else about the two tiers differs in any way.\"},{\"text\":\"Clients should log every refusal seen.\",\"line\":22,\"span\":\"Log every refusal seen, and keep the log for at least a week.\"},{\"text\":\"Clients should keep the refusal log for at least a week.\",\"line\":22,\"span\":\"Log every refusal seen, and keep the log for at least a week.\"},{\"text\":\"Nobody at the far end will assemble the argument for a larger cap on the caller's behalf.\",\"line\":22,\"span\":\"A caller that cannot say how often it was refused last week cannot argue for a larger cap, and nobody at the far end will assemble that argument on its behalf.\"},{\"text\":\"The refusal log line should carry the credential, the window and the wait.\",\"line\":22,\"span\":\"The log line should carry the credential, the window and the wait.\"},{\"text\":\"Not all gateway refusals are caps.\",\"line\":26,\"span\":\"Not all are caps.\"},{\"text\":\"The gateway refuses a request for three reasons.\",\"line\":26,\"span\":\"The gateway refuses a request for three reasons and only one of them is the one above; the other two have nothing to do with how much traffic a caller has sent in the window it is currently in.\"},{\"text\":\"Only one of the gateway's refusal reasons is the rate cap.\",\"line\":26,\"span\":\"The gateway refuses a request for three reasons and only one of them is the one above; the other two have nothing to do with how much traffic a caller has sent in the window it is currently in.\"},{\"text\":\"A credential may be suspended.\",\"line\":26,\"span\":\"A credential may be suspended, a route may be closed for maintenance, or a body may exceed the 5 megabyte limit, in which case it is refused before it has been read at all.\"},{\"text\":\"A route may be closed for maintenance.\",\"line\":26,\"span\":\"A credential may be suspended, a route may be closed for maintenance, or a body may exceed the 5 megabyte limit, in which case it is refused before it has been read at all.\"},{\"text\":\"The request body limit is 5 megabytes.\",\"line\":26,\"span\":\"A credential may be suspended, a route may be closed for maintenance, or a body may exceed the 5 megabyte limit, in which case it is refused before it has been read at all.\"},{\"text\":\"A body exceeding the 5 megabyte limit is refused before it has been read.\",\"line\":26,\"span\":\"A credential may be suspended, a route may be closed for maintenance, or a body may exceed the 5 megabyte limit, in which case it is refused before it has been read at all.\"},{\"text\":\"None of the suspended credential, closed route or oversized body refusals clears itself by waiting for a stated number of seconds.\",\"line\":26,\"span\":\"None of those three clears itself by waiting for a stated number of seconds.\"},{\"text\":\"A loop that waits and retries against a suspended credential spends its whole budget without ever reaching the service.\",\"line\":28,\"span\":\"A loop that waits and retries against a suspended credential spends its whole budget without ever reaching the service — and the log afterwards shows nothing at all except a long run of refusals, which reads like an outage and is not one, and the wasted budget is the caller's own.\"},{\"text\":\"The log of a loop retrying against a suspended credential shows only a long run of refusals.\",\"line\":28,\"span\":\"A loop that waits and retries against a suspended credential spends its whole budget without ever reaching the service — and the log afterwards shows nothing at all except a long run of refusals, which reads like an outage and is not one, and the wasted budget is the caller's own.\"},{\"text\":\"Reading the status code rather than its class separates cap refusals from other refusals.\",\"line\":28,\"span\":\"Reading the status code rather than the class it belongs to is what separates the two cases, and it costs one comparison.\"},{\"text\":\"Reading the status code costs one comparison.\",\"line\":28,\"span\":\"Reading the status code rather than the class it belongs to is what separates the two cases, and it costs one comparison.\"},{\"text\":\"A cap can be raised.\",\"line\":32,\"span\":\"A cap can be raised, but not on the strength of an assertion that the current one is too small: the number of caps raised without a measurement behind them is 0.\"},{\"text\":\"The number of caps raised without a measurement behind them is 0.\",\"line\":32,\"span\":\"A cap can be raised, but not on the strength of an assertion that the current one is too small: the number of caps raised without a measurement behind them is 0.\"},{\"text\":\"A request for a cap increase should include a week of refusal counts, the shape of the traffic across the day, and the deadline that traffic is serving.\",\"line\":32,\"span\":\"Bring a week of refusal counts, the shape of the traffic across the day, and the deadline that traffic is serving.\"},{\"text\":\"The platform team looks at whether the load is smooth or bursty before it looks at the number.\",\"line\":32,\"span\":\"The platform team looks at whether the load is smooth or bursty before it looks at the number at all — a burst is cheaper to smooth than it is to serve at its peak.\"},{\"text\":\"A burst is cheaper to smooth than to serve at its peak.\",\"line\":32,\"span\":\"The platform team looks at whether the load is smooth or bursty before it looks at the number at all — a burst is cheaper to smooth than it is to serve at its peak.\"},{\"text\":\"A caller that can move half its work to a quieter hour usually gets what it needs without any change to the cap.\",\"line\":32,\"span\":\"A caller that can move half its work to a quieter hour usually gets what it needs without any change to the cap at all, which is the outcome everyone prefers and the cheapest fix available to almost everybody.\"},{\"text\":\"Cap increase requests reach the platform team through the usual channel.\",\"line\":34,\"span\":\"Requests reach the platform team through the usual channel, and they are answered within two working days; chasing an answer does not make it take fewer.\"},{\"text\":\"Cap increase requests are answered within two working days.\",\"line\":34,\"span\":\"Requests reach the platform team through the usual channel, and they are answered within two working days; chasing an answer does not make it take fewer.\"},{\"text\":\"Chasing an answer to a cap increase request does not make it take fewer days.\",\"line\":34,\"span\":\"Requests reach the platform team through the usual channel, and they are answered within two working days; chasing an answer does not make it take fewer.\"},{\"text\":\"There is no expedited path for cap increase requests.\",\"line\":34,\"span\":\"There is no expedited path and no exception list.\"},{\"text\":\"There is no exception list for cap increase requests.\",\"line\":34,\"span\":\"There is no expedited path and no exception list.\"}]}","ttft_ms":43392,"type":"result","duration_ms":43413,"uuid":"c6ed506c-2cc7-49bb-956d-f35b1b1b8065","ttft_stream_ms":1502,"time_to_request_ms":92,"first_content_frame_ms":1502,"queued_turn_count":0,"result_index":0}
