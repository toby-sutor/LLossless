{"duration_api_ms":36786,"stop_reason":"end_turn","session_id":"60110399-fd1d-4125-b861-85fec8904b9a","total_cost_usd":0.1397518,"usage":{"input_tokens":2,"cache_creation_input_tokens":3604,"cache_read_input_tokens":1459,"output_tokens":5531,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3604,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":5531,"cache_read_input_tokens":1459,"cache_creation_input_tokens":3604,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3604},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-opus-5-5":{"inputTokens":2,"outputTokens":5531,"cacheReadInputTokens":1459,"cacheCreationInputTokens":3604,"webSearchRequests":0,"costUSD":0.1397518,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":0,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"claims\":[{\"text\":\"Every credential has its own cap.\",\"line\":3,\"span\":\"Every credential has its own cap.\"},{\"text\":\"When a credential's cap is spent, the gateway answers 429 at the edge.\",\"line\":3,\"span\":\"When that cap is spent the gateway answers 429 at the edge, without waking the service behind it, so the refusal costs the platform almost nothing and costs a caller that files it under transport error a great deal.\"},{\"text\":\"When a credential's cap is spent, the gateway answers without waking the service behind it.\",\"line\":3,\"span\":\"When that cap is spent the gateway answers 429 at the edge, without waking the service behind it, so the refusal costs the platform almost nothing and costs a caller that files it under transport error a great deal.\"},{\"text\":\"A 429 refusal at the gateway edge costs the platform almost nothing.\",\"line\":3,\"span\":\"When that cap is spent the gateway answers 429 at the edge, without waking the service behind it, so the refusal costs the platform almost nothing and costs a caller that files it under transport error a great deal.\"},{\"text\":\"Requests to the gateway are counted against the credential that presented them.\",\"line\":5,\"span\":\"Requests are counted against the credential that presented them, never against a connection, over a fixed window of 60 seconds whose start the gateway does not disclose.\"},{\"text\":\"Requests to the gateway are never counted against a connection.\",\"line\":5,\"span\":\"Requests are counted against the credential that presented them, never against a connection, over a fixed window of 60 seconds whose start the gateway does not disclose.\"},{\"text\":\"Requests are counted over a fixed window of 60 seconds.\",\"line\":5,\"span\":\"Requests are counted against the credential that presented them, never against a connection, over a fixed window of 60 seconds whose start the gateway does not disclose.\"},{\"text\":\"The gateway does not disclose the start of the 60-second counting window.\",\"line\":5,\"span\":\"Requests are counted against the credential that presented them, never against a connection, over a fixed window of 60 seconds whose start the gateway does not disclose.\"},{\"text\":\"Opening more sockets does not increase a caller's allowance.\",\"line\":5,\"span\":\"Opening more sockets therefore buys a caller nothing: the count follows the credential wherever the caller puts it, including across hosts.\"},{\"text\":\"The request count follows the credential across hosts.\",\"line\":5,\"span\":\"Opening more sockets therefore buys a caller nothing: the count follows the credential wherever the caller puts it, including across hosts.\"},{\"text\":\"A client spread across many worker processes is throttled at exactly the point one process would have been.\",\"line\":5,\"span\":\"A client spread across many worker processes, eight say, is throttled at exactly the point one process would have been, and pays for the extra file descriptors as well.\"},{\"text\":\"The default allowance is 100 requests in a window.\",\"line\":7,\"span\":\"The default allowance is 100 requests in a window, which covers every interactive use of this API the platform team has seen; a caller that needs more is almost always doing batch work under an interactive credential.\"},{\"text\":\"The default allowance of 100 requests covers every interactive use of the API the platform team has seen.\",\"line\":7,\"span\":\"The default allowance is 100 requests in a window, which covers every interactive use of this API the platform team has seen; a caller that needs more is almost always doing batch work under an interactive credential.\"},{\"text\":\"A caller that needs more than the default allowance is almost always doing batch work under an interactive credential.\",\"line\":7,\"span\":\"The default allowance is 100 requests in a window, which covers every interactive use of this API the platform team has seen; a caller that needs more is almost always doing batch work under an interactive credential.\"},{\"text\":\"A credential marked for batch work is allowed 1000 requests in the same window.\",\"line\":7,\"span\":\"A credential marked for batch work is allowed 1000 in the same window.\"},{\"text\":\"A 429 refusal is not an outage.\",\"line\":7,\"span\":\"A refusal is not an outage and not a bug in the gateway, whatever the error class in a client library happens to call it.\"},{\"text\":\"A 429 refusal is not a bug in the gateway.\",\"line\":7,\"span\":\"A refusal is not an outage and not a bug in the gateway, whatever the error class in a client library happens to call it.\"},{\"text\":\"A 429 refusal is the platform declining to spend capacity that has already been promised to somebody else.\",\"line\":7,\"span\":\"It is the platform declining to spend capacity that has already been promised to somebody else, and waiting is the only correct answer.\"},{\"text\":\"Callers that retry at once are the largest single reason the cap exists.\",\"line\":7,\"span\":\"Callers that retry at once are the largest single reason the cap is there at all.\"},{\"text\":\"An earlier draft of the guidance argued for a client-side token bucket that mirrored the gateway's own counters.\",\"line\":9,\"span\":\"An earlier draft of this guidance argued for a client-side token bucket that mirrored the gateway’s own counters, and that approach is deliberately left out: two counters that disagree are worse than one counter that refuses, which is the whole reason the Retry-After header exists.\"},{\"text\":\"Every refusal carries a Retry-After header.\",\"line\":13,\"span\":\"Every refusal carries a Retry-After header, and its value is a whole number of seconds to wait.\"},{\"text\":\"The Retry-After header value is a whole number of seconds to wait.\",\"line\":13,\"span\":\"Every refusal carries a Retry-After header, and its value is a whole number of seconds to wait.\"},{\"text\":\"The gateway keeps no memory of who backed off politely.\",\"line\":13,\"span\":\"The gateway keeps no memory of who backed off politely, so waiting longer than the header asks earns a caller nothing.\"},{\"text\":\"Waiting longer than the Retry-After header asks earns a caller nothing.\",\"line\":13,\"span\":\"The gateway keeps no memory of who backed off politely, so waiting longer than the header asks earns a caller nothing.\"},{\"text\":\"The body of the refusal is JSON.\",\"line\":15,\"span\":\"The body of the refusal is JSON, and it repeats as plain fields the cap, the tier and what the gateway calls the “window” it counted in.\"},{\"text\":\"The refusal body repeats as plain fields the cap, the tier and the window the gateway counted in.\",\"line\":15,\"span\":\"The body of the refusal is JSON, and it repeats as plain fields the cap, the tier and what the gateway calls the “window” it counted in.\"},{\"text\":\"The refusal body is there so that a human reading a log afterwards can see why the request was refused.\",\"line\":15,\"span\":\"The body is there so that a human reading a log afterwards can see why the request was refused; nothing in it is meant for the retry loop.\"},{\"text\":\"Nothing in the refusal body is meant for the retry loop.\",\"line\":15,\"span\":\"The body is there so that a human reading a log afterwards can see why the request was refused; nothing in it is meant for the retry loop.\"},{\"text\":\"There are four retry rules.\",\"line\":19,\"span\":\"There are four rules, and the order they are given in is the order to apply them.\"},{\"text\":\"The retry rules are to be applied in the order they are given.\",\"line\":19,\"span\":\"There are four rules, and the order they are given in is the order to apply them.\"},{\"text\":\"The gateway computes the wait with information the caller cannot see.\",\"line\":21,\"span\":\"The gateway has already done that arithmetic with information the caller cannot see, and the same rule holds on the 503 path, even though the cause of that refusal is entirely different.\"},{\"text\":\"The rule to honour the Retry-After header holds on the 503 path.\",\"line\":21,\"span\":\"The gateway has already done that arithmetic with information the caller cannot see, and the same rule holds on the 503 path, even though the cause of that refusal is entirely different.\"},{\"text\":\"The cause of a 503 refusal is entirely different from the cause of a 429 refusal.\",\"line\":21,\"span\":\"The gateway has already done that arithmetic with information the caller cannot see, and the same rule holds on the 503 path, even though the cause of that refusal is entirely different.\"},{\"text\":\"The set of responses safe to retry is smaller than the set of responses that are not a success.\",\"line\":23,\"span\":\"Retry only what is safe to retry, which is a smaller set than the set of responses that are not a success.\"},{\"text\":\"A 200 response wants nothing.\",\"line\":23,\"span\":\"A 200 wants nothing, a 429 wants the stated wait, a 500 may be retried once that wait has passed, and a 503 is the overload path: the platform itself is overloaded.\"},{\"text\":\"A 429 response wants the stated wait.\",\"line\":23,\"span\":\"A 200 wants nothing, a 429 wants the stated wait, a 500 may be retried once that wait has passed, and a 503 is the overload path: the platform itself is overloaded.\"},{\"text\":\"A 500 response may be retried once the wait has passed.\",\"line\":23,\"span\":\"A 200 wants nothing, a 429 wants the stated wait, a 500 may be retried once that wait has passed, and a 503 is the overload path: the platform itself is overloaded.\"},{\"text\":\"A 503 response is the overload path, meaning the platform itself is overloaded.\",\"line\":23,\"span\":\"A 200 wants nothing, a 429 wants the stated wait, a 500 may be retried once that wait has passed, and a 503 is the overload path: the platform itself is overloaded.\"},{\"text\":\"A client that folds every non-success into one branch will retry hardest during exactly the incident the cap was installed to survive.\",\"line\":23,\"span\":\"A client that folds every non-success into one branch will retry hardest during exactly the incident the cap was installed to survive.\"},{\"text\":\"A batch credential's allowance is measured over exactly the same window as the default.\",\"line\":25,\"span\":\"A batch credential’s allowance is measured over exactly the same window as the default, not under a separate counting scheme.\"},{\"text\":\"A batch credential's allowance is not measured under a separate counting scheme.\",\"line\":25,\"span\":\"A batch credential’s allowance is measured over exactly the same window as the default, not under a separate counting scheme.\"},{\"text\":\"The tier is set on the credential when it is issued.\",\"line\":25,\"span\":\"The tier is set on the credential when it is issued and cannot be asked for per call.\"},{\"text\":\"The tier cannot be asked for per call.\",\"line\":25,\"span\":\"The tier is set on the credential when it is issued and cannot be asked for per call.\"},{\"text\":\"The window, the header and the body are identical for the batch tier and the interactive tier.\",\"line\":25,\"span\":\"The window, the header and the body are identical to the interactive case, so a client written for one tier needs no change at all to run against the other.\"},{\"text\":\"A client written for one tier needs no change to run against the other tier.\",\"line\":25,\"span\":\"The window, the header and the body are identical to the interactive case, so a client written for one tier needs no change at all to run against the other.\"},{\"text\":\"Nothing else about the batch and interactive tiers differs.\",\"line\":25,\"span\":\"Nothing else about the two tiers differs.\"},{\"text\":\"Every refusal seen should be logged.\",\"line\":27,\"span\":\"Log every refusal seen, and keep the log for at least a week.\"},{\"text\":\"The refusal log should be kept for at least a week.\",\"line\":27,\"span\":\"Log every refusal seen, and keep the log for at least a week.\"},{\"text\":\"The refusal log line should carry the credential, the window and the wait.\",\"line\":27,\"span\":\"The log line should carry the credential, the window and the wait.\"},{\"text\":\"Nobody at the platform end will assemble the argument for a larger cap on a caller's behalf.\",\"line\":27,\"span\":\"A caller that cannot say how often it was refused last week cannot argue for a larger cap, and nobody at the far end will assemble that argument on its behalf.\"},{\"text\":\"Not all refusals are caps.\",\"line\":31,\"span\":\"Not all refusals are caps.\"},{\"text\":\"The gateway refuses a request for three reasons.\",\"line\":31,\"span\":\"The gateway refuses a request for three reasons, and only one of them is the cap described above; the other two have nothing to do with how much traffic a caller has sent in the window it is currently in.\"},{\"text\":\"Only one of the gateway's three refusal reasons is the cap.\",\"line\":31,\"span\":\"The gateway refuses a request for three reasons, and only one of them is the cap described above; the other two have nothing to do with how much traffic a caller has sent in the window it is currently in.\"},{\"text\":\"A credential may be suspended.\",\"line\":31,\"span\":\"A credential may be suspended, a route may be closed for maintenance, or a body may exceed the 5 megabyte limit, in which case it is refused before it has been read at all.\"},{\"text\":\"A route may be closed for maintenance.\",\"line\":31,\"span\":\"A credential may be suspended, a route may be closed for maintenance, or a body may exceed the 5 megabyte limit, in which case it is refused before it has been read at all.\"},{\"text\":\"The request body limit is 5 megabyte.\",\"line\":31,\"span\":\"A credential may be suspended, a route may be closed for maintenance, or a body may exceed the 5 megabyte limit, in which case it is refused before it has been read at all.\"},{\"text\":\"A body exceeding the 5 megabyte limit is refused before it has been read at all.\",\"line\":31,\"span\":\"A credential may be suspended, a route may be closed for maintenance, or a body may exceed the 5 megabyte limit, in which case it is refused before it has been read at all.\"},{\"text\":\"A suspended credential, a route closed for maintenance and an oversized body do not clear by waiting for a stated number of seconds.\",\"line\":31,\"span\":\"None of those three clears itself by waiting for a stated number of seconds.\"},{\"text\":\"A loop that waits and retries against a suspended credential spends its whole budget without ever reaching the service.\",\"line\":33,\"span\":\"A loop that waits and retries against a suspended credential spends its whole budget without ever reaching the service, and the log afterwards shows nothing but a long run of refusals and no successes, which reads like an outage and is not one; the wasted budget is the caller’s own.\"},{\"text\":\"Distinguishing the refusal cases by reading the status code costs one comparison.\",\"line\":33,\"span\":\"Reading the status code rather than the class it belongs to is what separates the two cases, and it costs one comparison.\"},{\"text\":\"A cap can be raised.\",\"line\":37,\"span\":\"A cap can be raised, but not on the strength of an assertion that the current one is too small: the number of caps raised without a measurement behind them is 0.\"},{\"text\":\"The number of caps raised without a measurement behind them is 0.\",\"line\":37,\"span\":\"A cap can be raised, but not on the strength of an assertion that the current one is too small: the number of caps raised without a measurement behind them is 0.\"},{\"text\":\"A cap increase request should include the refusal counts for a full week, the shape of the traffic across the day, and the deadline that traffic is serving.\",\"line\":37,\"span\":\"Bring the refusal counts for a full week, the shape of the traffic across the day, and the deadline that traffic is serving.\"},{\"text\":\"The platform team looks at whether the load is smooth or bursty before it looks at the number.\",\"line\":37,\"span\":\"The platform team looks at whether the load is smooth or bursty before it looks at the number at all; a burst is cheaper to smooth out than it is to serve at its peak.\"},{\"text\":\"A burst is cheaper to smooth out than to serve at its peak.\",\"line\":37,\"span\":\"The platform team looks at whether the load is smooth or bursty before it looks at the number at all; a burst is cheaper to smooth out than it is to serve at its peak.\"},{\"text\":\"A caller that can move half its work to a quieter hour usually gets what it needs without any change to the cap.\",\"line\":39,\"span\":\"A caller that can move half its work to a quieter hour usually gets what it needs without any change to the cap at all.\"},{\"text\":\"Requests for a cap increase reach the platform team through the usual channel.\",\"line\":41,\"span\":\"Requests reach the platform team through the usual channel and are answered within two working days.\"},{\"text\":\"Requests for a cap increase are answered within two working days.\",\"line\":41,\"span\":\"Requests reach the platform team through the usual channel and are answered within two working days.\"},{\"text\":\"There is no expedited path for cap increase requests.\",\"line\":41,\"span\":\"There is no expedited path and no exception list, and chasing an answer does not make it arrive any sooner.\"},{\"text\":\"There is no exception list for cap increase requests.\",\"line\":41,\"span\":\"There is no expedited path and no exception list, and chasing an answer does not make it arrive any sooner.\"},{\"text\":\"Chasing an answer to a cap increase request does not make it arrive any sooner.\",\"line\":41,\"span\":\"There is no expedited path and no exception list, and chasing an answer does not make it arrive any sooner.\"}]}","ttft_ms":36831,"type":"result","duration_ms":36851,"uuid":"d9eb71c2-4380-43db-a7fb-00606d3de429","ttft_stream_ms":1504,"time_to_request_ms":95,"first_content_frame_ms":1505,"queued_turn_count":0,"result_index":0}
