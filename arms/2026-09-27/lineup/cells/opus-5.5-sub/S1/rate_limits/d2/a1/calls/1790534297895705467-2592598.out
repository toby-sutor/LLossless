{"duration_api_ms":35585,"stop_reason":"end_turn","session_id":"f0f03bb5-b7e5-44b0-bdf4-9ab9b4b7d37e","total_cost_usd":0.13239179999999998,"usage":{"input_tokens":2,"cache_creation_input_tokens":3234,"cache_read_input_tokens":1459,"output_tokens":5311,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":3234,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":5311,"cache_read_input_tokens":1459,"cache_creation_input_tokens":3234,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3234},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-opus-5-5":{"inputTokens":2,"outputTokens":5311,"cacheReadInputTokens":1459,"cacheCreationInputTokens":3234,"webSearchRequests":0,"costUSD":0.13239179999999998,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":0,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"claims\":[{\"text\":\"Every credential has a cap of its own.\",\"line\":3,\"span\":\"Every credential has a cap of its own.\"},{\"text\":\"When the cap is spent the gateway answers 429 at the edge.\",\"line\":3,\"span\":\"When the cap is spent the gateway answers 429 at the edge, without troubling the service behind it.\"},{\"text\":\"When the cap is spent the gateway answers without troubling the service behind it.\",\"line\":3,\"span\":\"When the cap is spent the gateway answers 429 at the edge, without troubling the service behind it.\"},{\"text\":\"Requests are counted against the credential rather than the connection.\",\"line\":5,\"span\":\"Requests are counted against the credential rather than the connection, over a fixed window of 60 seconds whose start the gateway doesn’t disclose.\"},{\"text\":\"Requests are counted over a fixed window of 60 seconds.\",\"line\":5,\"span\":\"Requests are counted against the credential rather than the connection, over a fixed window of 60 seconds whose start the gateway doesn’t disclose.\"},{\"text\":\"The gateway doesn't disclose the start of the fixed window.\",\"line\":5,\"span\":\"Requests are counted against the credential rather than the connection, over a fixed window of 60 seconds whose start the gateway doesn’t disclose.\"},{\"text\":\"There is nothing to be gained by opening more sockets.\",\"line\":5,\"span\":\"There is nothing to be gained by opening more sockets.\"},{\"text\":\"The request count follows the credential wherever the caller puts it, including across hosts.\",\"line\":5,\"span\":\"The count follows the credential wherever the caller happens to put it, including across hosts.\"},{\"text\":\"A caller spread over many worker processes is throttled at the same point a single process would have been.\",\"line\":5,\"span\":\"A caller spread over many worker processes is throttled at the same point a single process would have been.\"},{\"text\":\"The default allowance is 100 requests in a window.\",\"line\":7,\"span\":\"The default allowance is 100 requests in a window, which is enough for every interactive use of this API the platform team has seen, and a caller that needs more than that is almost always doing batch work under an interactive credential.\"},{\"text\":\"The default allowance of 100 requests in a window is enough for every interactive use of the API the platform team has seen.\",\"line\":7,\"span\":\"The default allowance is 100 requests in a window, which is enough for every interactive use of this API the platform team has seen, and a caller that needs more than that is almost always doing batch work under an interactive credential.\"},{\"text\":\"A caller that needs more than the default allowance is almost always doing batch work under an interactive credential.\",\"line\":7,\"span\":\"The default allowance is 100 requests in a window, which is enough for every interactive use of this API the platform team has seen, and a caller that needs more than that is almost always doing batch work under an interactive credential.\"},{\"text\":\"The 429 refusal isn't an outage.\",\"line\":7,\"span\":\"The refusal isn’t an outage and it isn’t a bug in the gateway — it is capacity being held for a request somebody else has already been promised.\"},{\"text\":\"The 429 refusal isn't a bug in the gateway.\",\"line\":7,\"span\":\"The refusal isn’t an outage and it isn’t a bug in the gateway — it is capacity being held for a request somebody else has already been promised.\"},{\"text\":\"The 429 refusal is capacity being held for a request somebody else has already been promised.\",\"line\":7,\"span\":\"The refusal isn’t an outage and it isn’t a bug in the gateway — it is capacity being held for a request somebody else has already been promised.\"},{\"text\":\"Callers that retry immediately are most of the reason the cap is there.\",\"line\":7,\"span\":\"Callers that retry immediately are most of the reason the cap is there.\"},{\"text\":\"The header on a gateway refusal is called Retry-After.\",\"line\":11,\"span\":\"The header is called Retry-After.\"},{\"text\":\"The Retry-After value is a whole number of seconds.\",\"line\":11,\"span\":\"Its value is a whole number of seconds, and it is present on every refusal the gateway sends.\"},{\"text\":\"The Retry-After header is present on every refusal the gateway sends.\",\"line\":11,\"span\":\"Its value is a whole number of seconds, and it is present on every refusal the gateway sends.\"},{\"text\":\"Waiting the Retry-After duration and then continuing is the entire contract.\",\"line\":11,\"span\":\"Waiting that long and then continuing is the entire contract, and a caller that does exactly that will never need the rest of this note — which is the outcome it was written for, however unlikely that makes it to be read at all.\"},{\"text\":\"Waiting longer than the Retry-After header asks earns nothing.\",\"line\":11,\"span\":\"Waiting longer than the header asks earns nothing, because nobody at this end is keeping score.\"},{\"text\":\"Nobody at the gateway end is keeping score of how long callers wait.\",\"line\":11,\"span\":\"Waiting longer than the header asks earns nothing, because nobody at this end is keeping score.\"},{\"text\":\"The refusal response body is JSON.\",\"line\":13,\"span\":\"The response body is JSON and it repeats the cap, the window and the tier as plain fields.\"},{\"text\":\"The refusal response body repeats the cap, the window and the tier as plain fields.\",\"line\":13,\"span\":\"The response body is JSON and it repeats the cap, the window and the tier as plain fields.\"},{\"text\":\"None of the refusal response body fields is a substitute for the Retry-After header.\",\"line\":13,\"span\":\"None of those fields is a substitute for the header, and a caller that parses the body in order to compute its own wait has written code whose only possible future is to disagree with the gateway it is talking to.\"},{\"text\":\"The refusal response body is for the human reading the log afterwards.\",\"line\":13,\"span\":\"The body is for the human reading the log afterwards.\"},{\"text\":\"There are four rules for what the client does.\",\"line\":17,\"span\":\"There are four rules, and the order they are given in is the order to apply them.\"},{\"text\":\"The four client rules are to be applied in the order they are given.\",\"line\":17,\"span\":\"There are four rules, and the order they are given in is the order to apply them.\"},{\"text\":\"The client should honour the Retry-After header and not compute its own wait.\",\"line\":19,\"span\":\"Honour the header and don’t compute your own wait.\"},{\"text\":\"The gateway computes the wait using information the caller cannot see.\",\"line\":19,\"span\":\"The gateway has already done that arithmetic and it did it with information the caller cannot see.\"},{\"text\":\"On the 503 path the rule to honour the header holds as well.\",\"line\":19,\"span\":\"On the 503 path the same rule holds, even though the cause of the refusal is an entirely different one.\"},{\"text\":\"The cause of a 503 refusal is different from the cause of a 429 refusal.\",\"line\":19,\"span\":\"On the 503 path the same rule holds, even though the cause of the refusal is an entirely different one.\"},{\"text\":\"Anything computed on the client side is a guess.\",\"line\":19,\"span\":\"Anything computed on the client side is a guess.\"},{\"text\":\"The client should retry only what is safe to retry.\",\"line\":21,\"span\":\"Retry only what is safe to retry, which is a smaller set than the set of responses that aren’t a success.\"},{\"text\":\"The set of responses safe to retry is smaller than the set of responses that aren't a success.\",\"line\":21,\"span\":\"Retry only what is safe to retry, which is a smaller set than the set of responses that aren’t a success.\"},{\"text\":\"A 200 response needs nothing.\",\"line\":21,\"span\":\"A 200 needs nothing, a 429 needs the stated wait, a 500 can be retried once that wait has passed, and a 503 means the platform itself is overloaded.\"},{\"text\":\"A 429 response needs the stated wait.\",\"line\":21,\"span\":\"A 200 needs nothing, a 429 needs the stated wait, a 500 can be retried once that wait has passed, and a 503 means the platform itself is overloaded.\"},{\"text\":\"A 500 response can be retried once the stated wait has passed.\",\"line\":21,\"span\":\"A 200 needs nothing, a 429 needs the stated wait, a 500 can be retried once that wait has passed, and a 503 means the platform itself is overloaded.\"},{\"text\":\"A 503 response means the platform itself is overloaded.\",\"line\":21,\"span\":\"A 200 needs nothing, a 429 needs the stated wait, a 500 can be retried once that wait has passed, and a 503 means the platform itself is overloaded.\"},{\"text\":\"A caller that folds 200, 429, 500 and 503 into one branch will retry hardest during exactly the incident the cap was installed to survive.\",\"line\":21,\"span\":\"A caller that folds all four into one branch will retry hardest during exactly the incident the cap was installed to survive.\"},{\"text\":\"A batch credential is allowed 1000 requests in a window.\",\"line\":23,\"span\":\"A batch credential is allowed 1000 requests in a window, which is 50 times the default and not a separate counting scheme.\"},{\"text\":\"The batch allowance of 1000 requests is 50 times the default.\",\"line\":23,\"span\":\"A batch credential is allowed 1000 requests in a window, which is 50 times the default and not a separate counting scheme.\"},{\"text\":\"The batch allowance is not a separate counting scheme.\",\"line\":23,\"span\":\"A batch credential is allowed 1000 requests in a window, which is 50 times the default and not a separate counting scheme.\"},{\"text\":\"The window, the header and the body for the batch tier are identical to the interactive case.\",\"line\":23,\"span\":\"The window, the header and the body are identical to the interactive case, so a client written for one tier needs no change at all to run against the other.\"},{\"text\":\"A client written for one tier needs no change to run against the other tier.\",\"line\":23,\"span\":\"The window, the header and the body are identical to the interactive case, so a client written for one tier needs no change at all to run against the other.\"},{\"text\":\"Nothing else about the batch tier differs from the default.\",\"line\":23,\"span\":\"Nothing else about the batch tier differs from the default.\"},{\"text\":\"The client should log every refusal it sees.\",\"line\":25,\"span\":\"Log every refusal you see, and keep the log for at least a week.\"},{\"text\":\"The client should keep the refusal log for at least a week.\",\"line\":25,\"span\":\"Log every refusal you see, and keep the log for at least a week.\"},{\"text\":\"A caller that cannot say how often it was refused can't make a case for a larger cap.\",\"line\":25,\"span\":\"A caller that cannot say how often it was refused can’t make a case for a larger cap, and the platform team won’t assemble that case on its behalf.\"},{\"text\":\"The platform team won't assemble the case for a larger cap on a caller's behalf.\",\"line\":25,\"span\":\"A caller that cannot say how often it was refused can’t make a case for a larger cap, and the platform team won’t assemble that case on its behalf.\"},{\"text\":\"The gateway refuses a request for three separate reasons.\",\"line\":29,\"span\":\"The gateway refuses a request for three separate reasons, and only one of them is a cap.\"},{\"text\":\"Only one of the gateway's three refusal reasons is a cap.\",\"line\":29,\"span\":\"The gateway refuses a request for three separate reasons, and only one of them is a cap.\"},{\"text\":\"Two of the three gateway refusal reasons have nothing to do with how much traffic a caller has sent in the current window.\",\"line\":29,\"span\":\"Two of the three have nothing to do with how much traffic a caller has sent in the window it is currently in.\"},{\"text\":\"A credential can be suspended.\",\"line\":29,\"span\":\"A credential can be suspended, a route can be closed while it is being repaired, and a request body over the 5 megabyte limit is refused before it has been read at all.\"},{\"text\":\"A route can be closed while it is being repaired.\",\"line\":29,\"span\":\"A credential can be suspended, a route can be closed while it is being repaired, and a request body over the 5 megabyte limit is refused before it has been read at all.\"},{\"text\":\"The request body limit is 5 megabyte.\",\"line\":29,\"span\":\"A credential can be suspended, a route can be closed while it is being repaired, and a request body over the 5 megabyte limit is refused before it has been read at all.\"},{\"text\":\"A request body over the 5 megabyte limit is refused before it has been read at all.\",\"line\":29,\"span\":\"A credential can be suspended, a route can be closed while it is being repaired, and a request body over the 5 megabyte limit is refused before it has been read at all.\"},{\"text\":\"A loop retrying against a suspended credential burns its whole budget and reaches nothing.\",\"line\":31,\"span\":\"A loop retrying against a suspended credential burns its whole budget and reaches nothing.\"},{\"text\":\"The log after retrying against a suspended credential shows a long run of refusals and no successes.\",\"line\":31,\"span\":\"The log afterwards shows a long run of refusals and no successes at all, which reads like an outage and isn’t one — and the wasted budget is the caller’s own.\"},{\"text\":\"Refusals from a suspended credential are not an outage.\",\"line\":31,\"span\":\"The log afterwards shows a long run of refusals and no successes at all, which reads like an outage and isn’t one — and the wasted budget is the caller’s own.\"},{\"text\":\"The budget wasted retrying against a suspended credential is the caller's own.\",\"line\":31,\"span\":\"The log afterwards shows a long run of refusals and no successes at all, which reads like an outage and isn’t one — and the wasted budget is the caller’s own.\"},{\"text\":\"A caller that can move half its work to a quieter hour usually finds it doesn't need a larger cap.\",\"line\":33,\"span\":\"A caller that can move half its work to a quieter hour usually finds it doesn’t need a larger cap in the first place.\"},{\"text\":\"Moving work to a quieter hour is the cheapest fix available.\",\"line\":33,\"span\":\"That is the cheapest fix available to anybody, and it is available to almost everybody.\"},{\"text\":\"Moving work to a quieter hour is available to almost everybody.\",\"line\":33,\"span\":\"That is the cheapest fix available to anybody, and it is available to almost everybody.\"},{\"text\":\"A cap can be raised.\",\"line\":33,\"span\":\"A cap can be raised, but not on the strength of an assertion that the current one is too small.\"},{\"text\":\"A cap is not raised on the strength of an assertion that the current one is too small.\",\"line\":33,\"span\":\"A cap can be raised, but not on the strength of an assertion that the current one is too small.\"},{\"text\":\"A request to raise a cap should include the refusal counts for a full week.\",\"line\":33,\"span\":\"Bring the refusal counts for a full week, the shape of the traffic across the day, and the deadline the traffic exists to meet.\"},{\"text\":\"A request to raise a cap should include the shape of the traffic across the day.\",\"line\":33,\"span\":\"Bring the refusal counts for a full week, the shape of the traffic across the day, and the deadline the traffic exists to meet.\"},{\"text\":\"A request to raise a cap should include the deadline the traffic exists to meet.\",\"line\":33,\"span\":\"Bring the refusal counts for a full week, the shape of the traffic across the day, and the deadline the traffic exists to meet.\"},{\"text\":\"The platform team wants to know whether the load is smooth or bursty before it looks at the number.\",\"line\":35,\"span\":\"The team wants to know whether the load is smooth or bursty before it looks at the number at all.\"},{\"text\":\"A burst is cheaper to smooth out than to serve at its peak.\",\"line\":35,\"span\":\"A burst is cheaper to smooth out than it is to serve at its peak.\"},{\"text\":\"Cap-raise requests go to the platform team through the usual channel.\",\"line\":35,\"span\":\"Requests go to the platform team through the usual channel.\"},{\"text\":\"There is no expedited path for cap-raise requests.\",\"line\":37,\"span\":\"There is no expedited path.\"},{\"text\":\"An answer to a cap-raise request takes two working days.\",\"line\":37,\"span\":\"An answer takes two working days, and chasing it doesn’t make it take fewer.\"},{\"text\":\"Chasing a cap-raise request doesn't make the answer take fewer than two working days.\",\"line\":37,\"span\":\"An answer takes two working days, and chasing it doesn’t make it take fewer.\"}]}","ttft_ms":35633,"type":"result","duration_ms":35653,"uuid":"ef4c7f5a-55ef-4dfe-a789-0d7f405003dd","ttft_stream_ms":1352,"time_to_request_ms":100,"first_content_frame_ms":1353,"queued_turn_count":0,"result_index":0}
