{"duration_api_ms":11235,"stop_reason":"end_turn","session_id":"b21c522a-8739-409e-8a7d-e0c61bb9ec0b","total_cost_usd":0.0492758,"usage":{"input_tokens":2,"cache_creation_input_tokens":2282,"cache_read_input_tokens":1459,"output_tokens":1536,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2282,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":1536,"cache_read_input_tokens":1459,"cache_creation_input_tokens":2282,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2282},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-opus-5-5":{"inputTokens":2,"outputTokens":1536,"cacheReadInputTokens":1459,"cacheCreationInputTokens":2282,"webSearchRequests":0,"costUSD":0.0492758,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":0,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"claims\":[{\"text\":\"The document author is Rune Delacroix.\",\"line\":3,\"span\":\"Author: Rune Delacroix\"},{\"text\":\"The document was updated on 2026-01-29.\",\"line\":4,\"span\":\"Updated: 2026-01-29\"},{\"text\":\"The stream name is a mandatory field for every Nimbrel Probe agent.\",\"line\":8,\"span\":\"The stream name is a mandatory field for every Nimbrel Probe agent and is what separates one instrumented process from the next.\"},{\"text\":\"The Nimbrel Probe stream name is what separates one instrumented process from the next.\",\"line\":8,\"span\":\"The stream name is a mandatory field for every Nimbrel Probe agent and is what separates one instrumented process from the next.\"},{\"text\":\"The Nimbrel Probe stream name cannot contain arbitrary symbols.\",\"line\":8,\"span\":\"It cannot contain arbitrary symbols, as documented [here](https://docs.nimbrel.example/probe/agent/java/current/config-core.html#config-stream-name) and [here](https://docs.nimbrel.example/probe/agent/browser/current/configuration.html#stream-name):\"},{\"text\":\"Nimbrel Probe stream names are validated against ^[A-Za-z0-9 -]+$ before the agent registers.\",\"line\":11,\"span\":\"Stream names are validated against ^[A-Za-z0-9 -]+$ before the agent registers.\"},{\"text\":\"Nimbrel Probe stream names may contain letters, digits, spaces and hyphens only.\",\"line\":11,\"span\":\"Put plainly: letters, digits, spaces and hyphens only, and nothing else, or the agent refuses to start.\"},{\"text\":\"The Nimbrel Probe agent refuses to start if the stream name contains characters other than letters, digits, spaces and hyphens.\",\"line\":11,\"span\":\"Put plainly: letters, digits, spaces and hyphens only, and nothing else, or the agent refuses to start.\"},{\"text\":\"A Nimbrel Probe stream name containing a . (dot), for example ` checkout.web`, is refused.\",\"line\":14,\"span\":\"A stream name containing a . (dot), for example ` checkout.web`, is refused, as are names containing a number of other symbols.\"},{\"text\":\"Nimbrel Probe stream names containing a number of other symbols besides the dot are refused.\",\"line\":14,\"span\":\"A stream name containing a . (dot), for example ` checkout.web`, is refused, as are names containing a number of other symbols.\"},{\"text\":\"The refusal of Nimbrel Probe stream names containing unsupported symbols is working as intended for now.\",\"line\":14,\"span\":\"This is working as intended for now.\"},{\"text\":\"A Nimbrel Probe stream name sometimes has to stay exactly as it stands because that string is the product name in use everywhere in the organisation.\",\"line\":16,\"span\":\"However, a stream name sometimes has to stay exactly as it stands, because that string is the product name in use everywhere in the organisation and reporting keys off it.\"},{\"text\":\"Reporting sometimes keys off the Nimbrel Probe stream name.\",\"line\":16,\"span\":\"However, a stream name sometimes has to stay exactly as it stands, because that string is the product name in use everywhere in the organisation and reporting keys off it.\"},{\"text\":\"The stream name symbol restriction applies to all Nimbrel Probe agents.\",\"line\":20,\"span\":\"All Nimbrel Probe agents\"},{\"text\":\"There is no fix at present for Nimbrel Probe stream names with unsupported symbols.\",\"line\":24,\"span\":\"There is no fix at present.\"},{\"text\":\"A workaround exists for Nimbrel Probe stream names with unsupported symbols.\",\"line\":24,\"span\":\"The following workaround works:\"},{\"text\":\"Renaming the stream to drop the unsupported symbols allows the Nimbrel Probe agent to register.\",\"line\":26,\"span\":\"Rename the stream to drop the unsupported symbols so that the Nimbrel Probe agent registers.\"},{\"text\":\"Carrying the original stream name along as a global tag lets each trace keep a link between the real name and the renamed one.\",\"line\":27,\"span\":\"Carry the original name along as a global tag, so that each trace keeps a link between the real name and the renamed one:\"},{\"text\":\"Global tags configuration for the Nimbrel Probe Node.js agent is documented at https://docs.nimbrel.example/probe/agent/nodejs/current/configuration.html#global-tags.\",\"line\":28,\"span\":\"https://docs.nimbrel.example/probe/agent/nodejs/current/configuration.html#global-tags\"}]}","ttft_ms":11271,"type":"result","duration_ms":11304,"uuid":"a8adf599-da8d-4f03-b34a-d340a8e136b9","ttft_stream_ms":1417,"time_to_request_ms":102,"first_content_frame_ms":1418,"queued_turn_count":0,"result_index":0}
