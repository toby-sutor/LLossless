{"duration_api_ms":16227,"stop_reason":"end_turn","session_id":"ed9fb30a-25c8-490d-8d88-87805c5aba8f","total_cost_usd":0.06167980000000001,"usage":{"input_tokens":2,"cache_creation_input_tokens":2305,"cache_read_input_tokens":1459,"output_tokens":2147,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2305,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":2147,"cache_read_input_tokens":1459,"cache_creation_input_tokens":2305,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2305},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-opus-5-5":{"inputTokens":2,"outputTokens":2147,"cacheReadInputTokens":1459,"cacheCreationInputTokens":2305,"webSearchRequests":0,"costUSD":0.06167980000000001,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":0,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"claims\":[{\"text\":\"The author of the Nimbrel Probe stream name article is Rune Delacroix.\",\"line\":3,\"span\":\"Author: Rune Delacroix\"},{\"text\":\"The Nimbrel Probe stream name article was updated on 2026-01-29.\",\"line\":4,\"span\":\"Updated: 2026-01-29\"},{\"text\":\"The stream name is a mandatory field for every Nimbrel Probe agent.\",\"line\":8,\"span\":\"The stream name is a mandatory field for every Nimbrel Probe agent and is what separates one instrumented process from the next.\"},{\"text\":\"The Nimbrel Probe stream name is what separates one instrumented process from the next.\",\"line\":8,\"span\":\"The stream name is a mandatory field for every Nimbrel Probe agent and is what separates one instrumented process from the next.\"},{\"text\":\"The Nimbrel Probe stream name cannot contain arbitrary symbols.\",\"line\":8,\"span\":\"It cannot contain arbitrary symbols: only letters, digits, spaces and hyphens are accepted, as documented [here](https://docs.nimbrel.example/probe/agent/java/current/config-core.html#config-stream-name) and [here](https://docs.nimbrel.example/probe/agent/browser/current/configuration.html#stream-name).\"},{\"text\":\"Only letters, digits, spaces and hyphens are accepted in a Nimbrel Probe stream name.\",\"line\":8,\"span\":\"It cannot contain arbitrary symbols: only letters, digits, spaces and hyphens are accepted, as documented [here](https://docs.nimbrel.example/probe/agent/java/current/config-core.html#config-stream-name) and [here](https://docs.nimbrel.example/probe/agent/browser/current/configuration.html#stream-name).\"},{\"text\":\"The allowed characters for the Nimbrel Probe stream name are documented at https://docs.nimbrel.example/probe/agent/java/current/config-core.html#config-stream-name.\",\"line\":8,\"span\":\"It cannot contain arbitrary symbols: only letters, digits, spaces and hyphens are accepted, as documented [here](https://docs.nimbrel.example/probe/agent/java/current/config-core.html#config-stream-name) and [here](https://docs.nimbrel.example/probe/agent/browser/current/configuration.html#stream-name).\"},{\"text\":\"The allowed characters for the Nimbrel Probe stream name are documented at https://docs.nimbrel.example/probe/agent/browser/current/configuration.html#stream-name.\",\"line\":8,\"span\":\"It cannot contain arbitrary symbols: only letters, digits, spaces and hyphens are accepted, as documented [here](https://docs.nimbrel.example/probe/agent/java/current/config-core.html#config-stream-name) and [here](https://docs.nimbrel.example/probe/agent/browser/current/configuration.html#stream-name).\"},{\"text\":\"Nimbrel Probe stream names are validated against ^[A-Za-z0-9 -]+$ before the agent registers.\",\"line\":11,\"span\":\"Stream names are validated against ^[A-Za-z0-9 -]+$ before the agent registers.\"},{\"text\":\"Nimbrel Probe stream names may contain letters, digits, spaces and hyphens only, and nothing else.\",\"line\":11,\"span\":\"Put plainly: letters, digits, spaces and hyphens only, and nothing else, or the agent refuses to start.\"},{\"text\":\"The Nimbrel Probe agent refuses to start if the stream name contains characters other than letters, digits, spaces and hyphens.\",\"line\":11,\"span\":\"Put plainly: letters, digits, spaces and hyphens only, and nothing else, or the agent refuses to start.\"},{\"text\":\"A stream name containing a . (dot), for example ` checkout.web`, is refused by Nimbrel Probe.\",\"line\":14,\"span\":\"A stream name containing a . (dot), for example ` checkout.web`, or a number of other symbols is refused by Nimbrel Probe.\"},{\"text\":\"A stream name containing a number of other symbols is refused by Nimbrel Probe.\",\"line\":14,\"span\":\"A stream name containing a . (dot), for example ` checkout.web`, or a number of other symbols is refused by Nimbrel Probe.\"},{\"text\":\"Nimbrel Probe refusing stream names containing a dot or other symbols is working as intended for now.\",\"line\":14,\"span\":\"This is working as intended for now.\"},{\"text\":\"The Nimbrel Probe stream name sometimes has to stay exactly as it stands, for example because that string is the product name used everywhere in the organisation and reporting keys off it.\",\"line\":16,\"span\":\"However, the stream name sometimes has to stay exactly as it stands, for example because that string is the product name used everywhere in the organisation and reporting keys off it.\"},{\"text\":\"The stream name restriction applies to all Nimbrel Probe agents.\",\"line\":20,\"span\":\"All Nimbrel Probe agents\"},{\"text\":\"No fix is available at present for Nimbrel Probe stream names with unsupported symbols.\",\"line\":24,\"span\":\"No fix is available at present, but the following workaround works:\"},{\"text\":\"A workaround exists for Nimbrel Probe stream names with unsupported symbols.\",\"line\":24,\"span\":\"No fix is available at present, but the following workaround works:\"},{\"text\":\"Renaming the stream to drop the unsupported symbols allows the Nimbrel Probe agent to register.\",\"line\":26,\"span\":\"1) Rename the stream to drop the unsupported symbols so the Nimbrel Probe agent will register.\"},{\"text\":\"Carrying the original stream name along as a global tag lets each trace keep a link between the real name and the renamed one.\",\"line\":27,\"span\":\"2) Then carry the original name along as a global tag, so that each trace keeps a link between the real name and the renamed one: https://docs.nimbrel.example/probe/agent/nodejs/current/configuration.html#global-tags\"},{\"text\":\"Nimbrel Probe global tags are documented at https://docs.nimbrel.example/probe/agent/nodejs/current/configuration.html#global-tags.\",\"line\":27,\"span\":\"2) Then carry the original name along as a global tag, so that each trace keeps a link between the real name and the renamed one: https://docs.nimbrel.example/probe/agent/nodejs/current/configuration.html#global-tags\"}]}","ttft_ms":16255,"type":"result","duration_ms":16292,"uuid":"e25baa55-5e3e-4003-a79b-27eea4a66052","ttft_stream_ms":2355,"time_to_request_ms":95,"first_content_frame_ms":2355,"queued_turn_count":0,"result_index":0}
