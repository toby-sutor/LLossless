{"duration_api_ms":22450,"stop_reason":"end_turn","session_id":"c2267b81-791c-4cc2-be91-a951477227d4","total_cost_usd":0.0993398,"usage":{"input_tokens":2,"cache_creation_input_tokens":4580,"cache_read_input_tokens":1459,"output_tokens":3120,"output_tokens_details":{"thinking_tokens":993},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":4580,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":3120,"cache_read_input_tokens":1459,"cache_creation_input_tokens":4580,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4580},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-opus-5-5":{"inputTokens":2,"outputTokens":3120,"cacheReadInputTokens":1459,"cacheCreationInputTokens":4580,"webSearchRequests":0,"costUSD":0.0993398,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":993,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"verdicts\":[{\"claim_id\":\"M-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Author: Rune Delacroix\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A names Rune Delacroix as its author.\"},{\"claim_id\":\"M-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Updated: 2026-01-29\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A gives this update date.\"},{\"claim_id\":\"M-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Stream name is one of the mandatry field for every Nimbrel Probe agent.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A says the stream name is a mandatory field for every agent.\"},{\"claim_id\":\"M-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The Nimbrel Probe stream name is what seperates one instrumented process from the next.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states this directly.\"},{\"claim_id\":\"M-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The stream name cant contain arbitrary symbols\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the stream name cannot contain arbitrary symbols.\"},{\"claim_id\":\"M-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Only letters, digits, spaces and hyphens are accepted\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states only these characters are accepted.\"},{\"claim_id\":\"M-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"it has to match ^[A-Za-z0-9 -]+$\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B gives this exact pattern.\"},{\"claim_id\":\"M-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"[here](https://docs.nimbrel.example/probe/agent/java/current/config-core.html#config-stream-name)\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A cites this URL as the documentation for the restriction.\"},{\"claim_id\":\"M-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"as documented [here](https://docs.nimbrel.example/probe/agent/browser/current/configuration.html#stream-name)\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B cites this URL as the documentation for the restriction.\"},{\"claim_id\":\"M-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Stream name containing a . (dot) for exampe` checkout.web` along with a number of other symbols are refused by Nimbrel Probe\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states a dotted name such as checkout.web is refused.\"},{\"claim_id\":\"M-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Stream name containing a . (dot) for exampe` checkout.web` along with a number of other symbols are refused by Nimbrel Probe\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states a number of other symbols are also refused.\"},{\"claim_id\":\"M-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Working as intended for now\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B gives the cause as working as intended for now.\"},{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Stream names are validated against ^[A-Za-z0-9 -]+$ before the agent registers.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this verbatim.\"},{\"claim_id\":\"M-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"letters, digits, spaces and hyphens only\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states only these characters are allowed.\"},{\"claim_id\":\"M-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"letters, digits, spaces and hyphens only, and nothing else, or the agent refuses to start.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the agent refuses to start otherwise.\"},{\"claim_id\":\"M-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"one customer wanted the stream name left exactly as it stood because that string was the product name in use everywhere in the org\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The claim generalises Source A's single customer case, which is permitted at this fidelity level.\"},{\"claim_id\":\"M-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"their reporting keyed of it\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A says the customer's reporting keyed off the stream name, which supports 'in some cases'.\"},{\"claim_id\":\"M-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"All Nimbrel Probe agents\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A's Environment section scopes the restriction to all Nimbrel Probe agents.\"},{\"claim_id\":\"M-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"No fix at present , rename the stream without the refused symbol\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source B states there is no fix at present.\"},{\"claim_id\":\"M-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A way round it that works\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A presents a working workaround, and Source B also has a Workaround section.\"},{\"claim_id\":\"M-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Rename the stream to drop the unsupported symbols so the Nimbrel Probe agent will register\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that renaming lets the agent register.\"},{\"claim_id\":\"M-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Then carry the orignal name along as a global tag, so at least each trace keeps a link between the real name and the renamed one\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this directly.\"},{\"claim_id\":\"M-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"https://docs.nimbrel.example/probe/agent/nodejs/current/configuration.html#global-tags\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A cites this URL for global tags.\"}]}","ttft_ms":8557,"type":"result","duration_ms":22523,"uuid":"4ba5cba6-a6b2-42f2-b434-70a1e778704f","ttft_stream_ms":1494,"time_to_request_ms":106,"first_content_frame_ms":1494,"queued_turn_count":0,"result_index":0}
