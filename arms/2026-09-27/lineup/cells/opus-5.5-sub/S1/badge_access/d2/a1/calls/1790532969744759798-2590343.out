ce.\"},{\"text\":\"Badges that have been missing for 7 days are deactivated.\",\"line\":19,\"span\":\"Badges that\\nhave been missing for 7 days are deactivated.\"},{\"text\":\"Contractors on a job lasting more than one day are issued a week badge instead of a day badge.\",\"line\":24,\"span\":\"Contractors on a job lasting more than one day are issued a week badge instead\\nof a day badge.\"},{\"text\":\"A week badge is valid for 7 days from the date printed on it.\",\"line\":25,\"span\":\"A week badge is valid for 7 days from the date printed on it.\"},{\"text\":\"Contractors sign the contractor register.\",\"line\":26,\"span\":\"Contractors sign the contractor register in addition to the visitor list.\"},{\"text\":\"Contractors sign the visitor list.\",\"line\":26,\"span\":\"Contractors sign the contractor register in addition to the visitor list.\"}]}","ttft_ms":8437,"type":"result","duration_ms":8471,"uuid":"b5b29aa7-930d-4169-899a-cca8824b96c4","ttft_stream_ms":1373,"time_to_request_ms":109,"first_content_frame_ms":1373,"queued_turn_count":0,"result_index":0}
