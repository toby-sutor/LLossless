ce\":\"source_a.md\",\"rationale\":\"The source directs checking the visitor's name against the day's expected-visitor list.\"},{\"claim_id\":\"M-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Print a badge from the front desk terminal.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The source states badges are printed from the front desk terminal.\"},{\"claim_id\":\"M-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Write the\\nhost's name on the badge in the space provided.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The source states the host's name is written on the badge in the space provided.\"},{\"claim_id\":\"M-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ask the\\nvisitor to wear it above the waist\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The source directs asking the visitor to wear the badge above the waist.\"},{\"claim_id\":\"M-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"in view for the whole visit\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The source asks the visitor to wear the badge in view for the whole visit.\"},{\"claim_id\":\"M-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Visitors return badges at the front desk on their way out.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The source states this verbatim.\"},{\"claim_id\":\"M-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wipe the badge with\\nthe cleaning cloth kept in the top drawer\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The source directs wiping returned badges with the cleaning cloth from the top drawer.\"},{\"claim_id\":\"M-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"put it back in the return tray\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The source directs putting the returned badge back in the return tray.\"},{\"claim_id\":\"M-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Badges in the return tray are re-used the same day.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The source states this verbatim.\"},{\"claim_id\":\"M-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Mark the visitor's line on the expected-visitor list with an N.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Under the unreturned-badge heading, the source directs marking the visitor's line with an N.\"},{\"claim_id\":\"M-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"At the end of\\nthe day, send the list of unreturned badges to the security office.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The source states the unreturned badge list is sent to the security office at day's end.\"},{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Badges that\\nhave been missing for 7 days are deactivated.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"The source states this verbatim.\"},{\"claim_id\":\"M-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A badge handed in after it was reported missing goes to the security office\\nrather than back into the return tray.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source_b states this verbatim.\"},{\"claim_id\":\"M-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"The security office decides whether to\\nreactivate it.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"Source_b states the security office decides whether to reactivate a badge handed in after being reported missing.\"},{\"claim_id\":\"M-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Contractors on a job lasting more than one day are issued a week badge instead\\nof a day badge.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states this verbatim.\"},{\"claim_id\":\"M-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"A week badge is valid for 7 days from the date printed on it.\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source_a states this verbatim.\"},{\"claim_id\":\"M-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Contractors sign the contractor register in addition to the visitor list.\",\"evidence_source\":\"source_a.md\",