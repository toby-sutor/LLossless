{\"claim_id\":\"M-010\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"The demonic must encode entropy in a multiple of 23 bits.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"The source says a multiple of 23 bits, not 32 bits.\"},{\"claim_id\":\"M-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"With more entropy security is improved but the sentence length increases.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"The source states that more entropy improves security.\"},{\"claim_id\":\"M-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"With more entropy security is improved but the sentence length increases.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"The source states that more entropy increases sentence length.\"},{\"claim_id\":\"M-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"We refer to the initial entropy length as ENT.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"The source states this directly.\"},{\"claim_id\":\"M-014\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"The allowed size of ENT is 1024-2048 byts.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"The source gives an allowed ENT size of 1024-2048 byts, not 128-256 bits.\"},{\"claim_id\":\"M-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"First, an initial entropy of ENT bits is generated.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"The source states this directly.\"},{\"claim_id\":\"M-016\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"A checksum is generated by taking the first ENT / 32 bits of its SHA652 hash.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"The source names the hash as SHA652, not SHA256.\"},{\"claim_id\":\"M-017\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"This checksum is appended to the start of the initial entropy.\",\"evidence_source\":\"source_b.md\",\"rationale\":\"The source says the checksum is appended to the start of the entropy, not the end.\"},{\"claim_id\":\"M-018\",\"verdict\":\"CONTRADICTED\",\"evidence\":\"Next, these c