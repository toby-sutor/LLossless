{"duration_api_ms":103322,"stop_reason":"end_turn","session_id":"d37564f3-8010-4fb8-938b-474998d02b95","total_cost_usd":0.4670118000000001,"usage":{"input_tokens":2,"cache_creation_input_tokens":18744,"cache_read_input_tokens":1459,"output_tokens":15838,"output_tokens_details":{"thinking_tokens":5158},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":18744,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":15838,"cache_read_input_tokens":1459,"cache_creation_input_tokens":18744,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18744},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-opus-5-5":{"inputTokens":2,"outputTokens":15838,"cacheReadInputTokens":1459,"cacheCreationInputTokens":18744,"webSearchRequests":0,"costUSD":0.4670118000000001,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":5158,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"verdicts\":[{\"claim_id\":\"A-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der Mah-Jongg-Rufer erhält eine zusätzliche Prämie von 10 (häufig 20) Punkten gutgeschrieben\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states the 10 (often 20) point bonus for the Mah-Jongg caller.\"},{\"claim_id\":\"A-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wenn ein Spieler zu einem offenen Pong (z. B. drei Bambus-5-Ziegel) den passenden vierten Stein von der Mauer zieht und den Pong so zum offenen Kong ergänzen möchte, kann ein anderer Spieler diesen vierten Stein für sich fordern, wenn er damit „Mah-Jongg“ rufen kann\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference describes exactly this robbing situation.\"},{\"claim_id\":\"A-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Für diese Beraubung des Kong erhält er einen zusätzlichen Bonus von 10 Punkten\",\"evidence_source\":\"merged.md\",\"rationale\":\"The 10-point bonus for robbing the Kong is stated.\"},{\"claim_id\":\"A-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nach der Bewertung der einzelnen Figuren darf ein Spieler den Punktewert eventuell noch ein oder mehrere Male verdoppeln\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states doubling one or more times after scoring the sets.\"},{\"claim_id\":\"A-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Verdopplungen werden nacheinander gerechnet\",\"evidence_source\":\"merged.md\",\"rationale\":\"Successive calculation of doublings is stated.\"},{\"claim_id\":\"A-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"zweimaliges Verdoppeln vervierfacht beispielsweise den ursprünglichen Wert des Spielbildes\",\"evidence_source\":\"merged.md\",\"rationale\":\"Doubling twice quadrupling the value is stated.\"},{\"claim_id\":\"A-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Infolge der mannigfachen Verdopplungen können die Punktezahlen der Spielbilder sehr große Werte erreichen, sodass üblicherweise ein Limit vereinbart wird\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states the reason for the usual limit.\"},{\"claim_id\":\"A-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Dieses beträgt meist 300 oder 500 Punkte\",\"evidence_source\":\"merged.md\",\"rationale\":\"The limit values 300 or 500 are stated.\"},{\"claim_id\":\"A-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Übersteigt der errechnete Punktewert das vereinbarte Limit, so wird das Spielbild nur mit diesem Höchstwert gezählt\",\"evidence_source\":\"merged.md\",\"rationale\":\"Capping at the maximum value is stated.\"},{\"claim_id\":\"A-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Besteht das Spielbild des Mah-Jongg-Rufers ausschließlich aus Ziegeln der Trumpffarbe, also nur aus Wind- und Drachenziegeln, so wird diese Hand mit dem Punktemaximum bewertet\",\"evidence_source\":\"merged.md\",\"rationale\":\"The all-trump hand scoring at the maximum is stated.\"},{\"claim_id\":\"A-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ziegeln der Trumpffarbe, also nur aus Wind- und Drachenziegeln\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference equates trump suit tiles with wind and dragon tiles.\"},{\"claim_id\":\"A-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Kann Ostwind sofort nach Aufnehmen seiner Ziegel Mah-Jongg rufen, so besitzt er den Segen des Himmels und erhält das Punktemaximum gutgeschrieben\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Blessing of Heaven and its maximum score are stated.\"},{\"claim_id\":\"A-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Kann ein anderer Spieler den ersten von Ostwind abgelegten Stein aufrufen und damit Mah-Jongg erklären, so ist dies der Segen der Erde\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Blessing of Earth condition is stated.\"},{\"claim_id\":\"A-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"der Spieler erhält die Hälfte des Limits gutgeschrieben\",\"evidence_source\":\"merged.md\",\"rationale\":\"Half the limit for the Blessing of Earth is stated.\"},{\"claim_id\":\"A-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In vielen Regelbüchern finden sich weitere Punkteprämien oder Verdopplungen für Besonderheiten des Spielbildes des Mah-Jongg-Rufers\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"A-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Haben alle Spieler den Wert ihrer Spielbilder ermittelt, so erfolgt die Abrechnung\",\"evidence_source\":\"merged.md\",\"rationale\":\"Settlement after all hands are valued is stated.\"},{\"claim_id\":\"A-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird Mah-Jongg mit 144 Steinen, also einschließlich der Steine der Hauptfarbe (der Blumen- und Jahreszeitenziegel), gespielt, so besteht jede Seite der Mauer aus 18 Ziegelstapeln\",\"evidence_source\":\"merged.md\",\"rationale\":\"The 18-stack wall side with 144 tiles is stated.\"},{\"claim_id\":\"A-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird Mah-Jongg mit 144 Steinen, also einschließlich der Steine der Hauptfarbe (der Blumen- und Jahreszeitenziegel)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The 144-tile set including main suit flower and season tiles is stated.\"},{\"claim_id\":\"A-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Sobald ein Spieler zu Beginn eines Spieles seine Steine aufnimmt, legt er seine Blumen- und Jahreszeitenziegel offen vor sich und zieht dafür einen Ersatzziegel vom toten Ende der Mauer\",\"evidence_source\":\"merged.md\",\"rationale\":\"The procedure at pick-up is stated.\"},{\"claim_id\":\"A-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ebenso wird verfahren, wenn ein Spieler einen solchen Stein von der Mauer kauft\",\"evidence_source\":\"merged.md\",\"rationale\":\"The same procedure for drawing such a tile from the wall is stated.\"},{\"claim_id\":\"A-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Ziegel der Hauptfarbe sind den vier Winden zugeordnet\",\"evidence_source\":\"merged.md\",\"rationale\":\"The assignment to the four winds is stated.\"},{\"claim_id\":\"A-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nr. 1 gilt für den Ostwind\",\"evidence_source\":\"merged.md\",\"rationale\":\"No. 1 is assigned to East Wind.\"},{\"claim_id\":\"A-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nr. 2 für den Südwind\",\"evidence_source\":\"merged.md\",\"rationale\":\"No. 2 is assigned to South Wind.\"},{\"claim_id\":\"A-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nr. 3 für den Westwind\",\"evidence_source\":\"merged.md\",\"rationale\":\"No. 3 is assigned to West Wind.\"},{\"claim_id\":\"A-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nr. 4. für den Nordwind\",\"evidence_source\":\"merged.md\",\"rationale\":\"No. 4 is assigned to North Wind.\"},{\"claim_id\":\"A-026\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wenn Ostwind Mah-Jongg rufen kann, so bleibt er im nächsten Spiel weiter Ostwind und auch die übrigen Positionen bleiben unverändert\",\"evidence_source\":\"merged.md\",\"rationale\":\"East Wind remaining and positions unchanged is stated.\"},{\"claim_id\":\"A-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wenn ein anderer Spieler Mah-Jongg ruft, so übernimmt der bisherige Südwind die Rolle von Ostwind\",\"evidence_source\":\"merged.md\",\"rationale\":\"South Wind taking over as East Wind is stated.\"},{\"claim_id\":\"A-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Positionen wechseln um einen Platz gegen den Uhrzeigersinn\",\"evidence_source\":\"merged.md\",\"rationale\":\"Counterclockwise rotation by one place is stated.\"},{\"claim_id\":\"A-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Eine Runde ist beendet, sobald der Spieler, der im ersten Spiel die Position des Nordwindes innehatte, ein Spiel als Ostwind verliert\",\"evidence_source\":\"merged.md\",\"rationale\":\"The round-end condition is stated.\"},{\"claim_id\":\"A-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Eine Runde besteht aus mindestens vier Spielen\",\"evidence_source\":\"merged.md\",\"rationale\":\"At least four games per round is stated.\"},{\"claim_id\":\"A-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird nicht nur eine einzelne Runde gespielt, sondern eine Partie vereinbart, so besteht diese aus vier Runden\",\"evidence_source\":\"merged.md\",\"rationale\":\"A match of four rounds is stated.\"},{\"claim_id\":\"A-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In der ersten Runde, der Ostwindrunde, ist Ost der vorherrschende Wind (Rundenwind)\",\"evidence_source\":\"merged.md\",\"rationale\":\"East as prevailing wind in the first round is stated.\"},{\"claim_id\":\"A-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"in der zweiten Runde (Südwindrunde) herrscht Südwind vor\",\"evidence_source\":\"merged.md\",\"rationale\":\"South Wind prevailing in the second round is stated.\"},{\"claim_id\":\"A-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die dritte Runde ist die Westwindrunde\",\"evidence_source\":\"merged.md\",\"rationale\":\"The third round as West Wind round is stated.\"},{\"claim_id\":\"A-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die vierte die Nordwindrunde\",\"evidence_source\":\"merged.md\",\"rationale\":\"The fourth round as North Wind round is stated.\"},{\"claim_id\":\"A-036\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der vorherrschende Wind ist bei der Abrechnung des Spielbildes von Bedeutung\",\"evidence_source\":\"merged.md\",\"rationale\":\"The prevailing wind's relevance to scoring the hand is stated.\"},{\"claim_id\":\"A-037\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Um die einzelnen Spiele und Runden mitzuzählen, wird eine kleine Dose (Mingg) verwendet\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Mingg's counting purpose is stated.\"},{\"claim_id\":\"A-038\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Diese stellt der jeweilige Spieler des Ostwindes vor sich auf den Tisch\",\"evidence_source\":\"merged.md\",\"rationale\":\"The current East Wind player placing the Mingg is stated.\"},{\"claim_id\":\"A-039\",\"verdict\":\"SUPPORTED\",\"evidence\":\"der Platzstein des vorherrschenden Windes wird oben auf die Mingg gelegt\",\"evidence_source\":\"merged.md\",\"rationale\":\"The position tile on top of the Mingg is stated.\"},{\"claim_id\":\"A-040\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Vor einer weiteren Partie werden die Sitzplätze neu gelost\",\"evidence_source\":\"merged.md\",\"rationale\":\"Redrawing seats before another match is stated.\"},{\"claim_id\":\"A-041\",\"verdict\":\"SUPPORTED\",\"evidence\":\"meist werden nicht mehr als zwei Partien gespielt\",\"evidence_source\":\"merged.md\",\"rationale\":\"Usually no more than two matches is stated.\"},{\"claim_id\":\"A-042\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Im traditionellen chinesischen Spiel werden bestimmte Spielbilder mit dem Punktemaximum (Limit) bewertet\",\"evidence_source\":\"merged.md\",\"rationale\":\"Limit hands in the traditional game are stated.\"},{\"claim_id\":\"A-043\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die teilweise bereits Babcock in seinem Red Book von 1920 angeführt hat\",\"evidence_source\":\"merged.md\",\"rationale\":\"Babcock listing some of these hands in his 1920 Red Book is stated.\"},{\"claim_id\":\"A-044\",\"verdict\":\"SUPPORTED\",\"evidence\":\"in den 1920er Jahren wesentlich bei, als jedoch vor allem in den USA unzählige neue special hands erfunden wurden\",\"evidence_source\":\"merged.md\",\"rationale\":\"The invention of countless special hands, especially in the USA, is set in the 1920s context.\"},{\"claim_id\":\"A-045\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und das Regelwerk immer komplizierter wurde\",\"evidence_source\":\"merged.md\",\"rationale\":\"The increasingly complicated rules are stated in the same 1920s clause.\"},{\"claim_id\":\"A-046\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Das moderne Mah-Jongg, so wie es 1998 von der staatlichen Sportkommission Chinas offiziell als 255. Sportart anerkannt wurde\",\"evidence_source\":\"merged.md\",\"rationale\":\"The 1998 recognition as the 255th sport is stated.\"},{\"claim_id\":\"A-047\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ist eine Weiterentwicklung der klassischen Spielweise\",\"evidence_source\":\"merged.md\",\"rationale\":\"Modern Mah-Jongg as a development of the classical game is stated.\"},{\"claim_id\":\"A-048\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ähnlich wie das Bridge-Spiel aus dem älteren Whist hervorgegangen ist\",\"evidence_source\":\"merged.md\",\"rationale\":\"Bridge developing from Whist is stated.\"},{\"claim_id\":\"A-049\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die offiziellen Regeln dieser modernen Spielweise finden bei internationalen Turnieren wie Welt- und Europameisterschaften Anwendung\",\"evidence_source\":\"merged.md\",\"rationale\":\"Application at international championships is stated.\"},{\"claim_id\":\"A-050\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In der Rangliste der European Mahjong Association werden nur Ergebnisse berücksichtigt, die aufgrund dieser Spielregeln erzielt wurden\",\"evidence_source\":\"merged.md\",\"rationale\":\"The EMA ranking restriction is stated.\"},{\"claim_id\":\"A-051\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der finnische Hersteller Lagarto bietet eine kostenpflichtige Windows-Version des traditionellen Mah-Jongg namens Four Winds an\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"A-052\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Spieler kann gegen drei durch die Software nachgebildete Spieler antreten\",\"evidence_source\":\"merged.md\",\"rationale\":\"Play against three simulated players is stated.\"},{\"claim_id\":\"A-053\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ebenso können über ein Netzwerk mehrere reale Spieler gegeneinander oder gegen die Software antreten\",\"evidence_source\":\"merged.md\",\"rationale\":\"Network play is stated.\"},{\"claim_id\":\"A-054\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es kann nach verschiedenen Regeln gespielt werden\",\"evidence_source\":\"merged.md\",\"rationale\":\"Play under various rules is stated.\"},{\"claim_id\":\"A-055\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Das KDE-Projekt enthält eine kostenfreie Version von Mah-Jongg, die Kajongg genannt wird\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"A-056\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In verschiedenen Teilen der Yakuza-Spieleserie, wie zum Beispiel Yakuza 0 ist die japanische Variante von Mah-Jongg (Riichi Mahjong) als Minispiel vorhanden\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"A-057\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Für iPhone und iPad gibt es im Apple App Store unter dem Namen Mahjong! von POK-Software eine traditionelle Version\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"A-058\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die bis zu 3 Mitspieler simuliert\",\"evidence_source\":\"merged.md\",\"rationale\":\"Simulation of up to 3 players is stated.\"},{\"claim_id\":\"A-059\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es gibt zahlreiche Plattformen, auf denen man gegen andere Spieler antreten kann\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"B-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Viele andere als Mah-Jongg bezeichnete Computerspiele verwenden zwar digitalisierte Formen der Spielsteine\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"B-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"sind jedoch meistens Spiele für nur eine Person\",\"evidence_source\":\"merged.md\",\"rationale\":\"Mostly single-person games is stated.\"},{\"claim_id\":\"B-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ähneln von den Regeln einer Patience (Mah-Jongg Solitaire)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Resemblance to a patience game is stated.\"},{\"claim_id\":\"B-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ab Mitte der 1980er Jahre wurde Mah-Jongg Solitaire zunächst unter dem Namen Shanghai als Computerspiel populär\",\"evidence_source\":\"merged.md\",\"rationale\":\"Popularity from the mid-1980s is stated.\"},{\"claim_id\":\"B-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ab Mitte der 1980er Jahre wurde Mah-Jongg Solitaire zunächst unter dem Namen Shanghai als Computerspiel populär\",\"evidence_source\":\"merged.md\",\"rationale\":\"The initial name Shanghai is stated.\"},{\"claim_id\":\"B-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"nachdem die verbesserten grafischen Möglichkeiten des neuen Amiga-Computers erstmals eine ansprechende Darstellung dieses Spiels erlaubten\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Amiga's role is stated.\"},{\"claim_id\":\"B-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Bei der beliebtesten Computerspiel-Variante liegen zu Spielbeginn alle 144 Steine auf dem Tisch\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"B-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"teils in mehreren Lagen übereinander\",\"evidence_source\":\"merged.md\",\"rationale\":\"Partial stacking in layers is stated.\"},{\"claim_id\":\"B-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Traditionell werden die Spielsteine in der Figur eines Drachen oder einer Schildkröte aufgebaut\",\"evidence_source\":\"merged.md\",\"rationale\":\"The dragon or turtle layout is stated.\"},{\"claim_id\":\"B-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Computerspielvarianten bieten oft viele verschiedene Startfiguren an\",\"evidence_source\":\"merged.md\",\"rationale\":\"Many starting layouts are stated.\"},{\"claim_id\":\"B-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein einzelner Spieler muss paarweise alle 144 Steine vom Tisch nehmen\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"B-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Paar darf nur abgetragen werden, wenn beide Steine von keinem anderen Stein teilweise oder vollständig überdeckt sind\",\"evidence_source\":\"merged.md\",\"rationale\":\"The covering condition is stated.\"},{\"claim_id\":\"B-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und an zumindest einer Längsseite freiliegen\",\"evidence_source\":\"merged.md\",\"rationale\":\"The free long side condition is stated.\"},{\"claim_id\":\"B-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Während die Steine der Hauptfarben jeweils nur einmal vorkommen und keine Paare bilden können\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"B-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"dürfen die Blumenziegel und die Jahreszeitenziegel jeweils untereinander beliebig kombiniert werden, beispielsweise Pflaume mit Orchidee\",\"evidence_source\":\"merged.md\",\"rationale\":\"Free combination of flower tiles with the plum/orchid example is stated.\"},{\"claim_id\":\"B-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"dürfen die Blumenziegel und die Jahreszeitenziegel jeweils untereinander beliebig kombiniert werden, beispielsweise Pflaume mit Orchidee oder Winter mit Frühling\",\"evidence_source\":\"merged.md\",\"rationale\":\"Free combination of season tiles with the winter/spring example is stated.\"},{\"claim_id\":\"B-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In einigen Varianten sind die Blumen- und Jahreszeitenziegel verdoppelt\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"B-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und dafür zum Ausgleich beispielsweise die Windziegel nur zweimal enthalten\",\"evidence_source\":\"merged.md\",\"rationale\":\"The compensating wind tile reduction is stated.\"},{\"claim_id\":\"B-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Mitunter kommen die Jahreszeitenziegel doppelt vor und dafür keine Blumenziegel\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"B-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Als Weiterentwicklung der Computerspiele gibt es heute Angebote auf dem Netz, auf denen Mahjong Solitaire online gespielt werden kann\",\"evidence_source\":\"merged.md\",\"rationale\":\"Online offerings are stated.\"},{\"claim_id\":\"B-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Dabei handelt es sich in der Regel meist um die Spielvariante für Einzelspieler\",\"evidence_source\":\"merged.md\",\"rationale\":\"The single-player variant is stated.\"},{\"claim_id\":\"B-022\",\"verdict\":\"SUPPORTED\",\"evidence\":\"aber durch Bestenlisten oder Wettkämpfe spielt man quasi gegen andere Mahjong-Spieler\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"B-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Oft gibt es zusätzliche Funktionen, wie die Anzeige der noch verfügbaren Paare\",\"evidence_source\":\"merged.md\",\"rationale\":\"Display of available pairs is stated.\"},{\"claim_id\":\"B-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"oder die Möglichkeit Spielzüge rückgängig zu machen\",\"evidence_source\":\"merged.md\",\"rationale\":\"The undo option is stated.\"},{\"claim_id\":\"B-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Bei den Online-Varianten haben sich viele Spielarten jenseits der traditionellen Regeln etabliert\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"B-026\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zum Beispiel können beim Mahjong Connect die identischen Spielsteine nur ausgewählt werden, wenn zwischen ihnen eine Linie gezogen werden kann\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"B-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Beim Mahjong Dimensions gibt es kein zweidimensionales Spielfeld\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"B-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"sondern die Spielsteine sind zu einem dreidimensionalen Objekt gefügt\",\"evidence_source\":\"merged.md\",\"rationale\":\"The three-dimensional object is stated.\"},{\"claim_id\":\"B-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In Japan entwickelte sich auf Grundlage des Spiels das Genre Mah-Jongg in Anime und Manga\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"B-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"(siehe auch: Saki, Tobaku Mokushiroku Kaiji, Akagi, The Legend of Koizumi)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Saki is listed as an example of the genre.\"},{\"claim_id\":\"B-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"(siehe auch: Saki, Tobaku Mokushiroku Kaiji, Akagi, The Legend of Koizumi)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Tobaku Mokushiroku Kaiji is listed as an example of the genre.\"},{\"claim_id\":\"B-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"(siehe auch: Saki, Tobaku Mokushiroku Kaiji, Akagi, The Legend of Koizumi)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Akagi is listed as an example of the genre.\"},{\"claim_id\":\"B-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"(siehe auch: Saki, Tobaku Mokushiroku Kaiji, Akagi, The Legend of Koizumi)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Legend of Koizumi is listed as an example of the genre.\"},{\"claim_id\":\"B-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Dabei dient das Spiel dort häufig als erzählerisches Mittel zur Zuspitzung strategischer und dramatischer Konflikte\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states this directly.\"},{\"claim_id\":\"B-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In der romantischen Filmkomödie Crazy Rich Asians (2018)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Crazy Rich Asians is described as a romantic film comedy.\"},{\"claim_id\":\"B-036\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In der romantischen Filmkomödie Crazy Rich Asians (2018)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The year 2018 is stated.\"},{\"claim_id\":\"B-037\",\"verdict\":\"SUPPORTED\",\"evidence\":\"bildet eine Mah-Jongg