{"duration_api_ms":76773,"stop_reason":"end_turn","session_id":"8b33a13c-7dcc-4100-9cc7-3b5a26e14f2e","total_cost_usd":0.3784678,"usage":{"input_tokens":2,"cache_creation_input_tokens":18736,"cache_read_input_tokens":1459,"output_tokens":11414,"output_tokens_details":{"thinking_tokens":787},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":18736,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":11414,"cache_read_input_tokens":1459,"cache_creation_input_tokens":18736,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18736},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-opus-5-5":{"inputTokens":2,"outputTokens":11414,"cacheReadInputTokens":1459,"cacheCreationInputTokens":18736,"webSearchRequests":0,"costUSD":0.3784678,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":787,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"verdicts\":[{\"claim_id\":\"B-042\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Im Kriminalroman Sous les vents de Neptune (dt. „Der vierzehnte Stein“) von Fred Vargas (Frédérique Audoin-Rouzeau)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference names Fred Vargas (Frédérique Audoin-Rouzeau) as author of the crime novel; Neptun versus Neptune is a spelling variant of the same title.\"},{\"claim_id\":\"B-043\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Sous les vents de Neptune (dt. „Der vierzehnte Stein“)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The German title is given as „Der vierzehnte Stein“.\"},{\"claim_id\":\"B-044\",\"verdict\":\"SUPPORTED\",\"evidence\":\"nimmt das Spiel Mah-Jongg eine zentrale Rolle ein\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that Mah-Jongg plays a central role in the novel.\"},{\"claim_id\":\"B-045\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Das Buch wurde 2008 verfilmt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that the book was filmed in 2008.\"},{\"claim_id\":\"B-046\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Im französisch-Schweizer Spielfilm Die Gleichung ihres Lebens (2023)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The film is described as a French-Swiss feature film.\"},{\"claim_id\":\"B-047\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Gleichung ihres Lebens (2023)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The film is dated 2023.\"},{\"claim_id\":\"B-048\",\"verdict\":\"SUPPORTED\",\"evidence\":\"lernt die Hauptperson Marguerite\",\"evidence_source\":\"merged.md\",\"rationale\":\"Marguerite is named as the main character.\"},{\"claim_id\":\"B-049\",\"verdict\":\"SUPPORTED\",\"evidence\":\"lernt die Hauptperson Marguerite nach dem Abbruch ihrer Mathematik-Promotion Mah-Jongg\",\"evidence_source\":\"merged.md\",\"rationale\":\"Marguerite learns Mah-Jongg after abandoning her mathematics doctorate.\"},{\"claim_id\":\"B-050\",\"verdict\":\"SUPPORTED\",\"evidence\":\"erzielt erhebliche Einnahmen damit\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that she earns considerable income from the game.\"},{\"claim_id\":\"B-051\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Struktur des Spiels liefert ihr wiederum Inspirationen für einen Wiedereinstieg in die Mathematik.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The structure of the game inspires her return to mathematics.\"},{\"claim_id\":\"C-001\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Mah-Jongg, auch Mahjongg oder Mahjong\",\"evidence_source\":\"merged.md\",\"rationale\":\"The alternative names Mahjongg and Mahjong are given.\"},{\"claim_id\":\"C-002\",\"verdict\":\"SUPPORTED\",\"evidence\":\"chinesisch 麻將 / 麻将, Pinyin májiàng, Jyutping maa4zoeng3\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Chinese name, Pinyin and Jyutping are stated as claimed.\"},{\"claim_id\":\"C-003\",\"verdict\":\"SUPPORTED\",\"evidence\":\"kantonesisch 麻雀, máquè, Jyutping maa4zoek3 – „Sperlingsvögel“\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Cantonese name and its meaning are stated as claimed.\"},{\"claim_id\":\"C-004\",\"verdict\":\"SUPPORTED\",\"evidence\":\"hist. 麻雀牌, máquèpái, Jyutping maa4zoek3paai4*2 – „Sperlingsspiel“\",\"evidence_source\":\"merged.md\",\"rationale\":\"The historical name and its meaning are stated as claimed.\"},{\"claim_id\":\"C-005\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ist ein chinesisches Spiel für vier Personen\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference calls Mah-Jongg a Chinese game for four people.\"},{\"claim_id\":\"C-006\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Joseph Park Babcock (1893–1949)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The life dates 1893–1949 are given.\"},{\"claim_id\":\"C-007\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ein amerikanischer Reisender in der Republik China\",\"evidence_source\":\"merged.md\",\"rationale\":\"Babcock is described as an American traveller in the Republic of China.\"},{\"claim_id\":\"C-008\",\"verdict\":\"SUPPORTED\",\"evidence\":\"verfasste in den 1920er Jahren ein Regelwerk basierend auf unterschiedlichen Varianten, die er kennengelernt hatte\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states he wrote a rulebook in the 1920s based on variants he had encountered.\"},{\"claim_id\":\"C-009\",\"verdict\":\"SUPPORTED\",\"evidence\":\"brachte das Spiel in die USA\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that Babcock brought the game to the USA.\"},{\"claim_id\":\"C-010\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Babcock gab ihm den Namen MAH-JONGG (in dieser Schreibweise)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that Babcock gave it the name MAH-JONGG in that spelling.\"},{\"claim_id\":\"C-011\",\"verdict\":\"SUPPORTED\",\"evidence\":\"den er als Marke eintragen ließ\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that he registered the name as a trademark.\"},{\"claim_id\":\"C-012\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Um den Markenschutz nicht zu verletzen, wurde diese Schreibung vielfältig variiert.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The spelling was varied widely to avoid trademark infringement.\"},{\"claim_id\":\"C-013\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Dieser im Westen gebräuchliche Name bezeichnet einen Sperling, der auf dem Spielstein Bambus-Eins abgebildet ist.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The name refers to a sparrow depicted on the Bamboo-One tile.\"},{\"claim_id\":\"C-014\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Babcock vereinfachte das Spiel für den amerikanischen Markt\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that Babcock simplified the game for the American market.\"},{\"claim_id\":\"C-015\",\"verdict\":\"SUPPORTED\",\"evidence\":\"versah die Steine unter anderem mit römischen Ziffern\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that he added Roman numerals to the tiles.\"},{\"claim_id\":\"C-016\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Babcock vereinfachte das Spiel für den amerikanischen Markt und versah die Steine unter anderem mit römischen Ziffern, was die Verbreitung des Spiels in den Vereinigten Staaten zusätzlich begünstigte.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The simplifications, including the Roman numerals, further promoted the game's spread in the US.\"},{\"claim_id\":\"C-017\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Babcock bezeichnet Mah-Jongg im Vorwort zu seinem Red Book als eine eigene Entwicklung, basierend auf dem alten chinesischen Spiel\",\"evidence_source\":\"merged.md\",\"rationale\":\"In the Red Book preface, Babcock calls Mah-Jongg his own development based on the old Chinese game.\"},{\"claim_id\":\"C-018\",\"verdict\":\"SUPPORTED\",\"evidence\":\"das seinerseits – zumindest sein Ursprung – Jahrhunderte alt sei\",\"evidence_source\":\"merged.md\",\"rationale\":\"The preface states that the Chinese game, at least its origin, is centuries old.\"},{\"claim_id\":\"C-019\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Als Entstehungsort nennt er an anderer Stelle die Stadt Ningpo (heute Ningbo) oder die Provinz Fukien (heute Fujian).\",\"evidence_source\":\"merged.md\",\"rationale\":\"Babcock names Ningpo or Fukien as the place of origin.\"},{\"claim_id\":\"C-020\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Stadt Ningpo (heute Ningbo)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Ningpo is identified as today's Ningbo.\"},{\"claim_id\":\"C-021\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Provinz Fukien (heute Fujian)\",\"evidence_source\":\"merged.md\",\"rationale\":\"Fukien is identified as today's Fujian.\"},{\"claim_id\":\"C-022\",\"verdict\":\"PARTIAL\",\"evidence\":\"der Vermarktung war es sicher zuträglich, Mah-Jongg als sehr altes Spiel auszugeben (dazu H. F. Müllers Spiel Glocke und Hammer)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference links H. F. Müller's game Glocke und Hammer to marketing a game as very old, but it does not state that Müller wrote on this subject.\"},{\"claim_id\":\"C-023\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es wurde behauptet, es habe das Spiel schon vor 4.000 Jahren zur Zeit der Shang-Dynastie gegeben\",\"evidence_source\":\"merged.md\",\"rationale\":\"The claim of a 4,000-year existence in the Shang dynasty is reported.\"},{\"claim_id\":\"C-024\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Mah-Jongg sei lange Zeit dem einfachen Volk verboten und nur der Oberschicht vorbehalten gewesen\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reported claim of a ban on commoners and reservation for the upper class is stated.\"},{\"claim_id\":\"C-025\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Tatsächlich entstand Mah-Jongg erst in der zweiten Hälfte des 19. Jahrhunderts.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that the game originated only in the second half of the 19th century.\"},{\"claim_id\":\"C-026\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die ältesten erhaltenen Spiele datieren um 1870\",\"evidence_source\":\"merged.md\",\"rationale\":\"The oldest surviving sets date to around 1870.\"},{\"claim_id\":\"C-027\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die ältesten schriftlichen Hinweise aus dem Jahr 1890\",\"evidence_source\":\"merged.md\",\"rationale\":\"The oldest written references date from 1890.\"},{\"claim_id\":\"C-028\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ursprünglich war Mah-Jongg ein Glücksspiel, das mit Teehäusern und Bordellen in Verbindung stand\",\"evidence_source\":\"merged.md\",\"rationale\":\"The game was originally a gambling game tied to teahouses and brothels.\"},{\"claim_id\":\"C-029\",\"verdict\":\"SUPPORTED\",\"evidence\":\"gegen Ende des 19. Jahrhunderts hatte es sich jedoch auch in bürgerlichen Haushalten etabliert\",\"evidence_source\":\"merged.md\",\"rationale\":\"By the end of the 19th century it had become established in middle-class households.\"},{\"claim_id\":\"C-030\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und sich von Shanghai aus in andere Teile Chinas verbreitet\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that the game spread from Shanghai to other parts of China in that period.\"},{\"claim_id\":\"C-031\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Das Mah-Jongg-Spiel verbreitete sich rasch in China und Japan.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that the game spread rapidly in China and Japan.\"},{\"claim_id\":\"C-032\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nachdem Babcock das Spiel in den USA bekanntgemacht hatte, erlangte Mah-Jongg weltweite Popularität\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states worldwide popularity followed Babcock's US popularisation.\"},{\"claim_id\":\"C-033\",\"verdict\":\"SUPPORTED\",\"evidence\":\"vergleichbar dem Canasta in den 1950er Jahren\",\"evidence_source\":\"merged.md\",\"rationale\":\"The comparison implies Canasta had comparable worldwide popularity in the 1950s.\"},{\"claim_id\":\"C-034\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es wurden eigens Fabriken gegründet, um die Nachfrage nach Mah-Jongg-Spielen zu befriedigen\",\"evidence_source\":\"merged.md\",\"rationale\":\"Factories were founded specifically to meet demand for the sets.\"},{\"claim_id\":\"C-035\",\"verdict\":\"SUPPORTED\",\"evidence\":\"zumal das Gerücht umging, importierte Spiele wären mit Viren verseucht\",\"evidence_source\":\"merged.md\",\"rationale\":\"The rumour about virus-contaminated imported sets is stated.\"},{\"claim_id\":\"C-036\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In Deutschland wurde das Spiel eingeführt durch F. Ad. Richter & Cie, Baukastenfabrik, Rudolstadt\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that F. Ad. Richter & Cie introduced the game in Germany.\"},{\"claim_id\":\"C-037\",\"verdict\":\"SUPPORTED\",\"evidence\":\"(Gebrauchsmusterschutz Nr. 722354 v. 6. November 1919)\",\"evidence_source\":\"merged.md\",\"rationale\":\"The utility model number and date are given for Richter's introduction of the game.\"},{\"claim_id\":\"C-038\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein weiterer Mah-Jongg-Hersteller in Deutschland war die Hamburger Nordicus-Golconda Werke.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Hamburg-based Nordicus-Golconda Werke is named as another German manufacturer.\"},{\"claim_id\":\"C-039\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es gab Mah-Jongg-Zeitschriften\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that Mah-Jongg magazines existed.\"},{\"claim_id\":\"C-040\",\"verdict\":\"SUPPORTED\",\"evidence\":\"in vielen amerikanischen Städten wurden Mah-Jongg-Turniere veranstaltet\",\"evidence_source\":\"merged.md\",\"rationale\":\"Tournaments were held in many American cities.\"},{\"claim_id\":\"C-041\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zu den prominenten Förderern des amerikanischen Mah-Jongg-Booms der 1920er-Jahre zählten Fred Astaire\",\"evidence_source\":\"merged.md\",\"rationale\":\"Fred Astaire is listed among the prominent promoters.\"},{\"claim_id\":\"C-042\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zu den prominenten Förderern des amerikanischen Mah-Jongg-Booms der 1920er-Jahre zählten Fred Astaire sowie Präsident Warren G. Harding\",\"evidence_source\":\"merged.md\",\"rationale\":\"President Warren G. Harding is listed among the prominent promoters.\"},{\"claim_id\":\"C-043\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zu den prominenten Förderern des amerikanischen Mah-Jongg-Booms der 1920er-Jahre zählten Fred Astaire sowie Präsident Warren G. Harding und First Lady Florence Harding.\",\"evidence_source\":\"merged.md\",\"rationale\":\"First Lady Florence Harding is listed among the prominent promoters.\"},{\"claim_id\":\"C-044\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In New York wurde 1937 die National Mah Jongg League gegründet\",\"evidence_source\":\"merged.md\",\"rationale\":\"The League was founded in New York in 1937.\"},{\"claim_id\":\"C-045\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die die Regeln weiter vereinheitlichte\",\"evidence_source\":\"merged.md\",\"rationale\":\"The League further standardised the rules.\"},{\"claim_id\":\"C-046\",\"verdict\":\"SUPPORTED\",\"evidence\":\"damit die heute als American Mahjong bekannte Spielart maßgeblich prägte\",\"evidence_source\":\"merged.md\",\"rationale\":\"The League significantly shaped the variant known today as American Mahjong.\"},{\"claim_id\":\"C-047\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Doch bereits wenige Jahre später verschwand Mah-Jongg wie eine Mode und ebenso schnell, wie sie gekommen war.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that the game disappeared like a fad a few years later, as quickly as it came.\"},{\"claim_id\":\"C-048\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Das Spiel ist in China und Japan überaus populär\",\"evidence_source\":\"merged.md\",\"rationale\":\"The game is stated to be very popular in China and Japan.\"},{\"claim_id\":\"C-049\",\"verdict\":\"SUPPORTED\",\"evidence\":\"außerhalb Ostasiens war die Zahl der Interessenten lange geringer\",\"evidence_source\":\"merged.md\",\"rationale\":\"Interest outside East Asia was lower for a long time.\"},{\"claim_id\":\"C-050\",\"verdict\":\"SUPPORTED\",\"evidence\":\"seit den 2020er Jahren lässt sich jedoch besonders in westlichen Großstädten wieder ein deutlicher Aufschwung beobachten\",\"evidence_source\":\"merged.md\",\"rationale\":\"A clear upswing since the 2020s, especially in Western large cities, is stated.\"},{\"claim_id\":\"C-051\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die weltweite Teilnahme an Mah-Jongg-Veranstaltungen hat sich innerhalb eines Jahres mehr als verdreifacht\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that worldwide event participation more than tripled within a year.\"},{\"claim_id\":\"C-052\",\"verdict\":\"SUPPORTED\",\"evidence\":\"regelmäßige Veranstaltungen finden unter anderem in Berlin, Helsinki, London, Los Angeles, New York, Paris und Sydney statt\",\"evidence_source\":\"merged.md\",\"rationale\":\"The same cities are listed for regular events.\"},{\"claim_id\":\"C-053\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Auch soziale Medien tragen zu dieser Entwicklung bei\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that social media contribute to the development.\"},{\"claim_id\":\"C-054\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Auf YouTube existieren zahlreiche Einführungs- und Lernvideos\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that numerous introductory and tutorial videos exist on YouTube.\"},{\"claim_id\":\"C-055\",\"verdict\":\"SUPPORTED\",\"evidence\":\"auf TikTok nahm die Menge der Mah-Jongg-bezogenen Inhalte innerhalb eines Jahres um rund 70 Prozent zu\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that TikTok content increased by around 70 percent in a year.\"},{\"claim_id\":\"C-056\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Von den Regeln her kann Mah-Jongg als eine Variante des Kartenspiels Rummy verstanden werden\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that, by its rules, Mah-Jongg can be understood as a Rummy variant.\"},{\"claim_id\":\"C-057\",\"verdict\":\"SUPPORTED\",\"evidence\":\"von dem es ebenfalls eine Variante mit Spielsteinen gibt\",\"evidence_source\":\"merged.md\",\"rationale\":\"A tile variant of Rummy is stated.\"},{\"claim_id\":\"C-058\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es gibt jedoch keine Hinweise, dass sich das Rummy-Spiel aus dem Mah-Jongg entwickelt hätte oder umgekehrt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states there is no evidence of development in either direction.\"},{\"claim_id\":\"C-059\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Abstammung von einem (hypothetischen) gemeinsamen Vorfahren ist nicht erwiesen.\",\"evidence_source\":\"merged.md\",\"rationale\":\"Common descent is stated as unproven.\"},{\"claim_id\":\"C-060\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Spielsteine sind bei den besseren Spielen aus zwei Teilen gearbeitet\",\"evidence_source\":\"merged.md\",\"rationale\":\"The tiles of better sets are made of two parts.\"},{\"claim_id\":\"C-061\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Bilder auf den Vorderseiten sind mit Sticheln in einen kleinen Block aus Bein – früher Elfenbein – eingraviert und koloriert\",\"evidence_source\":\"merged.md\",\"rationale\":\"The front images are engraved with gravers into a bone block and coloured.\"},{\"claim_id\":\"C-062\",\"verdict\":\"SUPPORTED\",\"evidence\":\"in einen kleinen Block aus Bein – früher Elfenbein – eingraviert\",\"evidence_source\":\"merged.md\",\"rationale\":\"The fronts were formerly made of ivory.\"},{\"claim_id\":\"C-063\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Rückseiten sind aus Bambus\",\"evidence_source\":\"merged.md\",\"rationale\":\"The backs are made of bamboo.\"},{\"claim_id\":\"C-064\",\"verdict\":\"SUPPORTED\",\"evidence\":\"diese beiden Teile sind üblicherweise nicht einfach verklebt, sondern verzinkt\",\"evidence_source\":\"merged.md\",\"rationale\":\"The two parts are usually dovetailed rather than simply glued.\"},{\"claim_id\":\"C-065\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Steine preisgünstigerer Spiele sind aus bedrucktem Holz oder aus Kunststoff gefertigt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The tiles of cheaper sets are printed wood or plastic.\"},{\"claim_id\":\"C-066\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Es gibt auch Mah-Jongg-Kartenspiele.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that Mah-Jongg card games exist.\"},{\"claim_id\":\"C-067\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Im 21. Jahrhundert werden Mah-Jongg-Sets zudem zunehmend als Designobjekte vermarktet\",\"evidence_source\":\"merged.md\",\"rationale\":\"Sets are increasingly marketed as design objects in the 21st century.\"},{\"claim_id\":\"C-068\",\"verdict\":\"SUPPORTED\",\"evidence\":\"auch Luxusmarken wie Hermès, Prada und Louis Vuitton eigene Ausführungen an\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that the named luxury brands offer their own sets.\"},{\"claim_id\":\"C-069\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Mah-Jongg-Spiel besteht aus 136 oder 144 Spielsteinen\",\"evidence_source\":\"merged.md\",\"rationale\":\"A set consists of 136 or 144 tiles.\"},{\"claim_id\":\"C-070\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Ziegel genannt werden\",\"evidence_source\":\"merged.md\",\"rationale\":\"The tiles are called Ziegel.\"},{\"claim_id\":\"C-071\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Mah-Jongg wird in unzähligen Regelvarianten von Chinese Traditional bis Jewish American gespielt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states countless variants from Chinese Traditional to Jewish American.\"},{\"claim_id\":\"C-072\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Hua Bao Rules, welche bis auf wenige Unterschiede den Regeln von Joseph P. Babcock entsprechen\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Hua Bao Rules match Babcock's rules apart from a few differences.\"},{\"claim_id\":\"C-073\",\"verdict\":\"SUPPORTED\",\"evidence\":\"den gemeinsamen Kern der mannigfaltigen Varianten darstellen\",\"evidence_source\":\"merged.md\",\"rationale\":\"The Hua Bao Rules represent the common core of the variants.\"},{\"claim_id\":\"C-074\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Diese ist die in Europa gängige Spielweise.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The reference states that this is the common way of playing in Europe.\"},{\"claim_id\":\"C-075\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In der Standard-Variante wird mit 136 Steinen gespielt\",\"evidence_source\":\"merged.md\",\"rationale\":\"The standard variant uses 136 tiles.\"},{\"claim_id\":\"C-076\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die acht Ziegel der Hauptfarbe werden nicht verwendet\",\"evidence_source\":\"merged.md\",\"rationale\":\"The eight Hauptfarbe tiles are not used in the standard variant.\"},{\"claim_id\":\"C-077\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Vor Beginn einer Partie stehen die vier Spieler an den vier Seiten eines quadratischen Tisches.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The players stand at the four sides of a square table before the game begins.\"},{\"claim_id\":\"C-078\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der älteste Spieler mischt verdeckt die vier Platzsteine und stapelt sie aufeinander.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The oldest player shuffles the seat tiles face down and stacks them.\"},{\"claim_id\":\"C-079\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Sodann wirft er zwei Würfel und zählt die Augensumme gegen den Uhrzeigersinn ab, wobei er bei sich selbst zu zählen beginnt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"He throws two dice and counts counter-clockwise starting with himself.\"},{\"claim_id\":\"C-080\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der solcherart bestimmte Spieler nimmt den obersten Platzstein, der nächste den zweiten usw.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The determined player takes the top seat tile and the next player takes the second.\"},{\"claim_id\":\"C-081\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Spielfläche des Tisches wird als Himmelskarte interpretiert.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The table surface is interpreted as a map of the sky.\"},{\"claim_id\":\"C-082\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der Spieler, der den Platzstein Ostwind erhält, wird Spielleiter im ersten Spiel und bleibt an seinem Platz\",\"evidence_source\":\"merged.md\",\"rationale\":\"The East Wind player becomes game leader in the first game and stays in place.\"},{\"claim_id\":\"C-083\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Westwind setzt sich gegenüber\",\"evidence_source\":\"merged.md\",\"rationale\":\"West Wind sits opposite East Wind.\"},{\"claim_id\":\"C-084\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Südwind zur Rechten (!) von Ostwind\",\"evidence_source\":\"merged.md\",\"rationale\":\"South Wind sits to the right of East Wind.\"},{\"claim_id\":\"C-085\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nordwind zur Linken\",\"evidence_source\":\"merged.md\",\"rationale\":\"North Wind sits to the left of East Wind.\"},{\"claim_id\":\"C-086\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Ziegel werden verdeckt auf dem Tisch gemischt.\",\"evidence_source\":\"merged.md\",\"rationale\":\"The tiles are shuffled face down on the table.\"},{\"claim_id\":\"C-087\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Anschließend baut jeder der vier Spieler eine Seite der Mauer, indem er 34 der Ziegel verdeckt nimmt\",\"evidence_source\":\"merged.md\",\"rationale\":\"Each player builds one wall side by taking 34 tiles face down.\"},{\"claim_id\":\"C-088\",\"verdict\":\"SUPPORTED\",\"evidence\":\"zu einer 17 Ziegel langen und zwei Ziegel hohen Mauer anordnet\",\"evidence_source\":\"merged.md\",\"rationale\":\"Each wall side is 17 tiles long and two tiles high.\"},{\"claim_id\":\"C-089\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird mit Blumen- und Jahreszeitenziegeln gespielt, so nimmt jeder Spieler 36 Ziegel\",\"evidence_source\":\"merged.md\",\"rationale\":\"With flower and season tiles, each player takes 36 tiles.\"},{\"claim_id\":\"C-090\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Breite der Mauer beträgt 18 Stapel\",\"evidence_source\":\"merged.md\",\"rationale\":\"With flower and season tiles, the wall width is 18 stacks.\"}]}","ttft_ms":7588,"type":"result","duration_ms":76840,"uuid":"53d8dfe5-0c6e-49bf-b14a-031961d6e179","ttft_stream_ms":1277,"time_to_request_ms":110,"first_content_frame_ms":1278,"queued_turn_count":0,"result_index":0}
