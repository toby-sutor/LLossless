{"duration_api_ms":115714,"stop_reason":"end_turn","session_id":"ac5915eb-f7eb-4291-8f92-61c99a092470","total_cost_usd":0.5092078,"usage":{"input_tokens":2,"cache_creation_input_tokens":18891,"cache_read_input_tokens":1459,"output_tokens":17889,"output_tokens_details":{"thinking_tokens":6193},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":18891,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":17889,"cache_read_input_tokens":1459,"cache_creation_input_tokens":18891,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18891},"type":"message"}],"speed":"standard"},"modelUsage":{"claude-opus-5-5":{"inputTokens":2,"outputTokens":17889,"cacheReadInputTokens":1459,"cacheCreationInputTokens":18891,"webSearchRequests":0,"costUSD":0.5092078,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":6193,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"{\"verdicts\":[{\"claim_id\":\"M-101\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die herausgenommenen Steine heißen lose Ziegel und markieren das tote Ende der Mauer\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the loose tiles mark the dead end of the wall.\"},{\"claim_id\":\"M-102\",\"verdict\":\"SUPPORTED\",\"evidence\":\"das Ende links der Lücke ist das lebende Ende der Mauer\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the end to the left of the gap is the live end.\"},{\"claim_id\":\"M-103\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Gezogen werden die Steine regulär vom lebenden Ende der Mauer\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that tiles are regularly drawn from the live end.\"},{\"claim_id\":\"M-104\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Vom toten Ende werden dagegen nur Ersatzziegel (siehe unten) genommen, beginnend mit den beiden losen Ziegeln\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that only replacement tiles come from the dead end, starting with the two loose tiles.\"},{\"claim_id\":\"M-105\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Spieler nehmen dreimal reihum gegen den Uhrzeigersinn jeder zwei Stapel zu zwei Ziegel vom lebenden Ende der Mauer\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states the three counterclockwise rounds of taking two stacks of two tiles.\"},{\"claim_id\":\"M-106\",\"verdict\":\"SUPPORTED\",\"evidence\":\"wobei sich Ostwind als erster bedient\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that East Wind takes first.\"},{\"claim_id\":\"M-107\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zuletzt nimmt jeder Spieler noch einen weiteren, dreizehnten\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that each player finally takes a thirteenth tile.\"},{\"claim_id\":\"M-108\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und Ostwind außerdem einen vierzehnten Ziegel\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that East Wind also takes a fourteenth tile.\"},{\"claim_id\":\"M-109\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Jeder der vier Spieler versucht, durch Ziehen und Abwerfen von Steinen seine ursprüngliche Hand zu verbessern\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that each player tries to improve their hand by drawing and discarding.\"},{\"claim_id\":\"M-110\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ein vollständiges Spielbild aus möglichst wertvollen Figuren zu formen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states the aim of forming a complete hand of the most valuable sets.\"},{\"claim_id\":\"M-111\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Steine werden von der Mauer gezogen oder nach Abwurf eines anderen Spielers aufgenommen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that tiles are drawn from the wall or picked up after a discard.\"},{\"claim_id\":\"M-112\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Hat ein Spieler ein vollständiges Spielbild bestehend aus vier Figuren und schließlich einem Paar gebildet, so darf er „Mah-Jongg“ rufen und das Spiel beenden\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a complete hand of four sets and a pair allows calling Mah-Jongg and ending the game.\"},{\"claim_id\":\"M-113\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die vier Figuren können wahlweise Drillinge, Vierlinge oder Folgen sein\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the four sets can be triplets, quadruplets or sequences.\"},{\"claim_id\":\"M-114\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Paar besteht aus zwei gleichen Steinen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a pair consists of two identical tiles.\"},{\"claim_id\":\"M-115\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Um Mah-Jongg rufen zu können, ist ein vollständiges Spielbild nötig\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a complete hand is needed to call Mah-Jongg.\"},{\"claim_id\":\"M-116\",\"verdict\":\"SUPPORTED\",\"evidence\":\"in diesem muss genau ein Paar, das Schlusspaar\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the complete hand must contain exactly one pair, the final pair.\"},{\"claim_id\":\"M-117\",\"verdict\":\"SUPPORTED\",\"evidence\":\"das Schlusspaar (將,  jiàng, manchmal 眼,  yǎn)\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C gives these names for the final pair.\"},{\"claim_id\":\"M-118\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Zur Vervollständigung eines Paares darf ein abgelegter Stein nur aufgerufen werden, wenn gleichzeitig Mah-Jongg gerufen wird\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states this restriction on calling a discard to complete a pair.\"},{\"claim_id\":\"M-119\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Pong (碰,  pèng) besteht aus drei gleichen Steinen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a Pong consists of three identical tiles.\"},{\"claim_id\":\"M-120\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird ein Pong ausschließlich aus Ziegeln der ursprünglichen Hand oder von der Mauer gezogenen Ziegeln gebildet, so handelt es sich um einen verdeckten Pong\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C defines the concealed Pong this way.\"},{\"claim_id\":\"M-121\",\"verdict\":\"SUPPORTED\",\"evidence\":\"der nicht gemeldet werden muss\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a concealed Pong need not be declared.\"},{\"claim_id\":\"M-122\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird er dennoch aufgedeckt, so sollte er durch ein Umdrehen eines der Steine als eigentlich verdeckt markiert werden\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a revealed concealed Pong is marked by turning over one tile.\"},{\"claim_id\":\"M-123\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Besitzt ein Spieler ein Paar und wird der dritte Stein von einem beliebigen anderen Spieler abgelegt, so darf der Spieler diesen Stein mit dem Ruf „Pong“ aufrufen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a player holding a pair may call the third tile from any discarder with Pong.\"},{\"claim_id\":\"M-124\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Er legt sein Paar und den aufgerufenen Ziegel offen vor sich auf den Tisch und besitzt einen offenen Pong\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the pair and the called tile are laid face up, forming an open Pong.\"},{\"claim_id\":\"M-125\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In den 1970er und 1980er Jahren wurde im deutschsprachigen Raum statt Pong oftmals der Begriff Pon verwendet\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states this usage of Pon.\"},{\"claim_id\":\"M-126\",\"verdict\":\"SUPPORTED\",\"evidence\":\"dem 1982 erschienenen Anleitungsbuch von Ursula Eschenbach\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that Eschenbach's instruction book appeared in 1982.\"},{\"claim_id\":\"M-127\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Auch in dem 1982 erschienenen Anleitungsbuch von Ursula Eschenbach ist durchgehend von Pon, Kan und Chii die Rede\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the book consistently uses Pon, Kan and Chii.\"},{\"claim_id\":\"M-128\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Begriffe Pon (jap. ポン, 碰 pon), Kan (カン, 槓, 杠 kan) oder Chii (チー, 吃 chī) stammen aus der japanischen Spielart des Riichi Mahjong\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that these terms come from Riichi Mahjong.\"},{\"claim_id\":\"M-129\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Riichi Mahjong (リーチ麻雀, 立直マージャン rīchi mājan)\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C gives these Japanese spellings for Riichi Mahjong.\"},{\"claim_id\":\"M-130\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Kong (槓 / 杠,  gàng) besteht aus vier gleichen Steinen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a Kong consists of four identical tiles.\"},{\"claim_id\":\"M-131\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird ein Kong ausschließlich aus Steinen der ursprünglichen Hand und von der Mauer gezogenen Ziegeln gebildet, so sollte der Spieler einen verdeckten Kong melden\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that such a Kong should be declared as concealed.\"},{\"claim_id\":\"M-132\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Tut er dies nicht, so kann er keinen Ersatzziegel aus der Mauer ziehen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that without declaring, no replacement tile can be drawn.\"},{\"claim_id\":\"M-133\",\"verdict\":\"SUPPORTED\",\"evidence\":\"der bei Kongs notwendig ist, um ein komplettes Spielbild zu erreichen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the replacement tile is necessary with Kongs to complete a hand.\"},{\"claim_id\":\"M-134\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird das Spiel beendet, bevor der Spieler den Vierling meldet, so wird der verdeckte Kong als verdeckter Pong gewertet\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that an undeclared concealed Kong scores as a concealed Pong.\"},{\"claim_id\":\"M-135\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein verdeckter Kong muss nicht sofort gemeldet werden, sondern kann auch später herausgelegt werden, wenn der Spieler erneut am Zug ist\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a concealed Kong may be declared later on the player's turn.\"},{\"claim_id\":\"M-136\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Bei der Meldung werden die vier Steine offen ausgelegt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the four tiles are laid out face up on declaration.\"},{\"claim_id\":\"M-137\",\"verdict\":\"SUPPORTED\",\"evidence\":\"verdeckten (auch: „halbverdeckten“, oder „aus der Hand gemeldeten“) Kong\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C gives these alternative names for a concealed Kong.\"},{\"claim_id\":\"M-138\",\"verdict\":\"SUPPORTED\",\"evidence\":\"werden die beiden äußeren Steine mit der Rückseite nach oben gelegt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the two outer tiles are placed face down to mark it.\"},{\"claim_id\":\"M-139\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Hält ein Spieler drei gleiche Steine in der Hand – also einen verdeckten Pong – so darf er, wenn ein Spieler den vierten Stein ablegt, diesen Ziegel mit dem Ruf „Kong“ für sich beanspruchen und erhält so einen offenen Kong\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states this rule for claiming a discarded fourth tile with Kong.\"},{\"claim_id\":\"M-140\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Hat ein Spieler bereits einen offenen Pong gemeldet und wird der fehlende vierte Stein von einem anderen Spieler abgelegt, so kann dieser Ziegel nicht zur Komplettierung des Kongs aufgerufen werden\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a discarded fourth tile cannot complete an open Pong into a Kong.\"},{\"claim_id\":\"M-141\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Hat ein Spieler bereits einen Pong gemeldet und zieht er den fehlenden vierten Stein von der Mauer, so darf er ihn an den Pong anlegen und besitzt damit einen offenen Kong\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a drawn fourth tile may be added to a declared Pong to form an open Kong.\"},{\"claim_id\":\"M-142\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In dieser Situation kann es zu einer Beraubung des Kong kommen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that robbing the Kong can occur in this situation.\"},{\"claim_id\":\"M-143\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der von der Mauer gezogene Stein kann von einem anderen Spieler für sich gefordert werden, wenn er damit „Mah-Jongg“ rufen kann\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that another player can claim the drawn tile to call Mah-Jongg.\"},{\"claim_id\":\"M-144\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Sobald ein Spieler einen offenen oder verdeckten Kong meldet, muss er einen Ersatzziegel vom toten Ende der Mauer ziehen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that declaring any Kong requires a replacement tile from the dead end.\"},{\"claim_id\":\"M-145\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Chow (吃,  chī, manchmal 上,  shàng) ist eine Sequenz aus genau drei aufeinanderfolgenden Steinen einer Grundfarbe\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C defines a Chow as exactly three consecutive tiles of one basic suit.\"},{\"claim_id\":\"M-146\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Sequenzen aus mehr als drei Steinen sind nicht gestattet\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that sequences longer than three are not permitted.\"},{\"claim_id\":\"M-147\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Chow aus Steinen der Trumpffarbe ist nicht möglich\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a trump-suit Chow is impossible.\"},{\"claim_id\":\"M-148\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein abgelegter Stein kann von einem Spieler mit „Chow“ aufgerufen werden, wenn der Spieler unmittelbar zur Rechten desjenigen Spielers sitzt, der den betreffenden Stein abgelegt hat\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the player immediately to the right of the discarder may call Chow.\"},{\"claim_id\":\"M-149\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der aufrufende Spieler legt dann die damit gebildete Folge offen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the calling player lays the sequence face up.\"},{\"claim_id\":\"M-150\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein anderer Spieler kann nur dann einen abgelegten Stein für eine Folge aufrufen, wenn er gleichzeitig Mah-Jongg ruft\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that other players may call a discard for a sequence only when calling Mah-Jongg.\"},{\"claim_id\":\"M-151\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Folgen, die aus Steinen der ursprünglichen Hand bzw. aus gezogenen Steinen gebildet werden, können bis zum Spielende verdeckt bleiben\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that such sequences can remain concealed until the game ends.\"},{\"claim_id\":\"M-152\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Mah-Jongg wird gegen den Uhrzeigersinn gespielt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the game is played counterclockwise.\"},{\"claim_id\":\"M-153\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nachdem sich Ostwind seine 14 Ziegel genommen hat, beginnt er das Spiel, indem er nach einer eventuellen Meldung einen Stein offen in der Mitte des Tisches ablegt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states how East Wind begins the game.\"},{\"claim_id\":\"M-154\",\"verdict\":\"SUPPORTED\",\"evidence\":\"dabei nennt er dessen Namen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that East Wind names the tile when discarding it.\"},{\"claim_id\":\"M-155\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wenn kein Spieler den abgelegten Stein aufruft, so zieht der rechte Nachbar einen Stein vom lebenden Ende der Mauer, meldet, wenn er möchte, eine oder mehrere Figuren und legt zuletzt einen Stein ab\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states this sequence of play when no discard is called.\"},{\"claim_id\":\"M-156\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird ein Stein abgelegt, so ist er tot, er bleibt offen in der Mitte des Tisches liegen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a discarded tile is dead and stays face up in the middle.\"},{\"claim_id\":\"M-157\",\"verdict\":\"SUPPORTED\",\"evidence\":\"der nächste Spieler kann einen Chow spielen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the next player can play a Chow with the discard.\"},{\"claim_id\":\"M-158\",\"verdict\":\"SUPPORTED\",\"evidence\":\"sowie jener und alle weiteren Spieler einen Pong oder einen Kong\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the next and all further players can play a Pong or Kong.\"},{\"claim_id\":\"M-159\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Danach ist der Stein nicht mehr für das Spiel verfügbar beziehungsweise aufnehmbar\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the tile is afterwards no longer available.\"},{\"claim_id\":\"M-160\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird ein Stein von einem Spieler aufgerufen, so nimmt der Spieler den abgelegten Stein und muss die betreffende Figur offen auflegen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a caller takes the tile and lays the set face up.\"},{\"claim_id\":\"M-161\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Danach wirft er einen Stein ab, und das Spiel wird mit diesem Spieler fortgesetzt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that the caller discards and play continues from them.\"},{\"claim_id\":\"M-162\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Auf diese Weise können auch Spieler übergangen werden\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that players can be skipped this way.\"},{\"claim_id\":\"M-163\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Legt beispielsweise Südwind einen Stein ab, der von Nordwind gerufen wird, so wird Westwind übersprungen\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C gives this exact example.\"},{\"claim_id\":\"M-164\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Benötigt ein Spieler den Stein für einen Mah-Jongg-Ruf, so hat er Vorrang gegenüber einem Kong- oder Pong-Ruf\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a Mah-Jongg call has priority over Kong or Pong.\"},{\"claim_id\":\"M-165\",\"verdict\":\"SUPPORTED\",\"evidence\":\"diese wiederum haben Vorrang vor einem Chow\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that Kong and Pong calls have priority over Chow.\"},{\"claim_id\":\"M-166\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Im letzteren Fall wird das Spiel nicht gewertet, die Steine werden erneut gemischt und das Spiel mit unveränderten Rollen wiederholt\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that an unscored game is reshuffled and repeated with unchanged roles.\"},{\"claim_id\":\"M-167\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Verdeckte Kombinationen zählen das Doppelte\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that concealed combinations count double.\"},{\"claim_id\":\"M-168\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ein Kong zählt viermal so viel wie der entsprechende Pong\",\"evidence_source\":\"source_c.md\",\"rationale\":\"Source C states that a Kong counts four times the corresponding Pong.\"},{\"claim_id\":\"M-169\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Der Mah-Jongg-Rufer erhält eine zusätzliche Prämie von 10 (häufig 20) Punkten gutgeschrieben\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the 10 (often 20) point bonus for the Mah-Jongg caller.\"},{\"claim_id\":\"M-170\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wenn ein Spieler zu einem offenen Pong (z. B. drei Bambus-5-Ziegel) den passenden vierten Stein von der Mauer zieht und den Pong so zum offenen Kong ergänzen möchte, kann ein anderer Spieler diesen vierten Stein für sich fordern, wenn er damit „Mah-Jongg“ rufen kann\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this robbing-the-Kong rule.\"},{\"claim_id\":\"M-171\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Für diese Beraubung des Kong erhält er einen zusätzlichen Bonus von 10 Punkten\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states the 10-point bonus for robbing the Kong.\"},{\"claim_id\":\"M-172\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nach der Bewertung der einzelnen Figuren darf ein Spieler den Punktewert eventuell noch ein oder mehrere Male verdoppeln\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that the value may be doubled one or more times after scoring the sets.\"},{\"claim_id\":\"M-173\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Verdopplungen werden nacheinander gerechnet\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that doublings are calculated successively.\"},{\"claim_id\":\"M-174\",\"verdict\":\"SUPPORTED\",\"evidence\":\"zweimaliges Verdoppeln vervierfacht beispielsweise den ursprünglichen Wert des Spielbildes\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that doubling twice quadruples the original value.\"},{\"claim_id\":\"M-175\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Infolge der mannigfachen Verdopplungen können die Punktezahlen der Spielbilder sehr große Werte erreichen\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that multiple doublings can produce very large scores.\"},{\"claim_id\":\"M-176\",\"verdict\":\"SUPPORTED\",\"evidence\":\"sodass üblicherweise ein Limit vereinbart wird\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that a limit is usually agreed.\"},{\"claim_id\":\"M-177\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Dieses beträgt meist 300 oder 500 Punkte\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that the limit is usually 300 or 500 points.\"},{\"claim_id\":\"M-178\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Übersteigt der errechnete Punktewert das vereinbarte Limit, so wird das Spielbild nur mit diesem Höchstwert gezählt\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that scores above the limit are capped at it.\"},{\"claim_id\":\"M-179\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Besteht das Spielbild des Mah-Jongg-Rufers ausschließlich aus Ziegeln der Trumpffarbe, also nur aus Wind- und Drachenziegeln, so wird diese Hand mit dem Punktemaximum bewertet\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that an all-trump hand scores the maximum.\"},{\"claim_id\":\"M-180\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Ziegeln der Trumpffarbe, also nur aus Wind- und Drachenziegeln\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A identifies the trump suit as the wind and dragon tiles.\"},{\"claim_id\":\"M-181\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Kann Ostwind sofort nach Aufnehmen seiner Ziegel Mah-Jongg rufen, so besitzt er den Segen des Himmels\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A defines the Blessing of Heaven this way.\"},{\"claim_id\":\"M-182\",\"verdict\":\"SUPPORTED\",\"evidence\":\"und erhält das Punktemaximum gutgeschrieben\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that the Blessing of Heaven is credited with the maximum.\"},{\"claim_id\":\"M-183\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Kann ein anderer Spieler den ersten von Ostwind abgelegten Stein aufrufen und damit Mah-Jongg erklären, so ist dies der Segen der Erde\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A defines the Blessing of Earth this way.\"},{\"claim_id\":\"M-184\",\"verdict\":\"SUPPORTED\",\"evidence\":\"der Spieler erhält die Hälfte des Limits gutgeschrieben\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that the Blessing of Earth earns half the limit.\"},{\"claim_id\":\"M-185\",\"verdict\":\"SUPPORTED\",\"evidence\":\"In vielen Regelbüchern finden sich weitere Punkteprämien oder Verdopplungen für Besonderheiten des Spielbildes des Mah-Jongg-Rufers\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that many rulebooks have further bonuses or doublings.\"},{\"claim_id\":\"M-186\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Haben alle Spieler den Wert ihrer Spielbilder ermittelt, so erfolgt die Abrechnung\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that settlement follows once all hand values are determined.\"},{\"claim_id\":\"M-187\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wird Mah-Jongg mit 144 Steinen, also einschließlich der Steine der Hauptfarbe (der Blumen- und Jahreszeitenziegel), gespielt, so besteht jede Seite der Mauer aus 18 Ziegelstapeln\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that with 144 tiles each wall side has 18 stacks.\"},{\"claim_id\":\"M-188\",\"verdict\":\"SUPPORTED\",\"evidence\":\"der Steine der Hauptfarbe (der Blumen- und Jahreszeitenziegel)\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A identifies the Hauptfarbe tiles as the flower and season tiles.\"},{\"claim_id\":\"M-189\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Sobald ein Spieler zu Beginn eines Spieles seine Steine aufnimmt, legt er seine Blumen- und Jahreszeitenziegel offen vor sich und zieht dafür einen Ersatzziegel vom toten Ende der Mauer\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that flower and season tiles are exposed and replaced from the dead end.\"},{\"claim_id\":\"M-190\",\"verdict\":\"SUPPORTED\",\"evidence\":\"ebenso wird verfahren, wenn ein Spieler einen solchen Stein von der Mauer kauft\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that the same applies when such a tile is drawn from the wall.\"},{\"claim_id\":\"M-191\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Die Ziegel der Hauptfarbe sind den vier Winden zugeordnet\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that the Hauptfarbe tiles are assigned to the four winds.\"},{\"claim_id\":\"M-192\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nr. 1 gilt für den Ostwind\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that No. 1 applies to East Wind.\"},{\"claim_id\":\"M-193\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nr. 2 für den Südwind\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that No. 2 applies to South Wind.\"},{\"claim_id\":\"M-194\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nr. 3 für den Westwind\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that No. 3 applies to West Wind.\"},{\"claim_id\":\"M-195\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Nr. 4. für den Nordwind\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that No. 4 applies to North Wind.\"},{\"claim_id\":\"M-196\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wenn Ostwind Mah-Jongg rufen kann, so bleibt er im nächsten Spiel weiter Ostwind und auch die übrigen Positionen bleiben unverändert\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that East Wind and the other positions stay unchanged after East Wind's Mah-Jongg.\"},{\"claim_id\":\"M-197\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Wenn ein anderer Spieler Mah-Jongg ruft, so übernimmt der bisherige Südwind die Rolle von Ostwind\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that South Wind becomes East Wind when another player wins.\"},{\"claim_id\":\"M-198\",\"verdict\":\"SUPPORTED\",\"evidence\":\"die Positionen wechseln um einen Platz gegen den Uhrzeigersinn\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that positions shift one place counterclockwise.\"},{\"claim_id\":\"M-199\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Eine Runde ist beendet, sobald der Spieler, der im ersten Spiel die Position des Nordwindes innehatte, ein Spiel als Ostwind verliert\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states this end-of-round condition.\"},{\"claim_id\":\"M-200\",\"verdict\":\"SUPPORTED\",\"evidence\":\"Eine Runde besteht aus mindestens vier Spielen\",\"evidence_source\":\"source_a.md\",\"rationale\":\"Source A states that a round consists of at least four games.\"}]}","ttft_ms":40839,"type":"result","duration_ms":115781,"uuid":"0080555a-7615-4b78-901e-3a7cd6057be3","ttft_stream_ms":1345,"time_to_request_ms":115,"first_content_frame_ms":1346,"queued_turn_count":0,"result_index":0}
