.llossless-cache/
__pycache__/
.venv/
*.pyc
.env
/internal/assets/

# Run output written into the repo root: -o merges and piped reports. These
# carry the source documents' content, and they are named by whoever ran the
# command, so they are matched by position rather than by name. Ignoring a path
# does nothing to a tracked one, so README.md and publication-manifest.txt keep
# showing their edits; only new root files are swallowed. A root file that
# genuinely belongs in the repo is named below, so a fresh repository staged
# by adding every file keeps it; everything else lives in docs/.
/*.md
/*.txt
!/README.md
!/publication-manifest.txt


# The role -> model id map. Untracked because it is one machine's configuration,
# not because a model id is secret; models.local.example.json shows the shape.
models.local.json

# Exploratory cross-model cassettes. Recorded from a dirty tree and against
# prompts that no longer exist, so no commit reproduces them and no current run
# can hit their keys. tests/eval/README.md is tracked and explains them; the
# cassettes are not.
tests/eval/*/

# What the last finished run of `tests/run_all.py` proved, and about which
# tree. Untracked because it is a fact about one working copy at one moment:
# committing it would publish a claim that the next person to clone has no way
# to have earned.
/.suite-stamp.json
publication-manifest.txt
paper/README.md
